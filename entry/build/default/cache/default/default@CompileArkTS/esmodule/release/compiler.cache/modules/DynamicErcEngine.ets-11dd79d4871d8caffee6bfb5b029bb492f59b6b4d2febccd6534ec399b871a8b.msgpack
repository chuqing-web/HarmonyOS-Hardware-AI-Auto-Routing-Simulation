                    violations.push(DynamicErcEngine.violation(ErcSeverity.ERROR, `é¢‘ç‡å¼‚å¸¸åé«˜: ${wave.probeName} â‰ˆ ${(freq / 1e6).toFixed(1)}MHz`, wave.netName, 'æ£€æŸ¥ä¿¡å·å®Œæ•´æ€§æˆ– EMI'));
                }
