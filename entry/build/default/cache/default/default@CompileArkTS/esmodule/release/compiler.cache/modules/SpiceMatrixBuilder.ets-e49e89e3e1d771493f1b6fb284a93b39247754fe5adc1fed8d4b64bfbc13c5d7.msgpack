        return lib.includes('VSIN') || lib.includes('VPULSE') || lib.includes('SIGNAL') ||
            lib.includes('VSOURCE') || lib.includes('FUNC_GEN');
    });
}
export class SpiceMatrixBuilder {
    static build(topo, tempC, stepSize, stopTime) {
