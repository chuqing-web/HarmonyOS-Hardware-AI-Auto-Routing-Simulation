                const nNeg = pinNodes.get(1) ?? '0';
                const amp = paramMapGet(params, 'amplitude', paramMapGet(params, 'amp', '5'));
                const freq = paramMapGet(params, 'frequency', paramMapGet(params, 'freq', '1k'));
                const offset = paramMapGet(params, 'offset', '0');
