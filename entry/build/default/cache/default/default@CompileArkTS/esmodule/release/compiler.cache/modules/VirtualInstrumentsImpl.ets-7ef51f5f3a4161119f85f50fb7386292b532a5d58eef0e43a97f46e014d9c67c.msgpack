        }
        this.uartTerminal.runTimedScript(commands);
        return ResultHelper.ok();
    }
    async exportUartLog(path) {
        const pathErr = Validate.filePath(path);
        if (pathErr !== null)
            return ResultHelper.fail(pathErr);
        try {
