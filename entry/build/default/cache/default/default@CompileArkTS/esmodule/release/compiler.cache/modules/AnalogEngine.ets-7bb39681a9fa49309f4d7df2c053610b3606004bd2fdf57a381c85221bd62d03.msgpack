  loadSchematic(doc: SchematicDocument, config: SimulationConfig): void {
    this.netUuidToNode.clear();
    this.compUuidToDevId.clear();
    this.compPinNets.clear();
    this.nodeVoltages.clear();
    this.branchCurrents.clear();
