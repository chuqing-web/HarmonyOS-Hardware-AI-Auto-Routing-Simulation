        } else if (libId.includes('3V3') || libId.includes('1117')) {
          defOut = '3.3';
        }
        const vNum = parseVoltageVolts(paramMapGet(comp.parameters, 'output', `${defOut}V`), parseFloat(defOut));
        nl += `VREG${rCount} ${nOut} ${nGnd} DC ${vNum}\n`;
