      parsed.errCode = ErrCode.ERR_PARAM_INVALID;

    }

    if (max !== undefined && parsed.numeric > max) {

      parsed.errCode = ErrCode.ERR_PARAM_INVALID;

    }

    return parsed;

  }



  static convertLength(value: number, from: 'mil' | 'mm' | 'inch', to: 'mil' | 'mm' | 'inch'): number {

    let mm = value;

    if (from === 'mil') {

