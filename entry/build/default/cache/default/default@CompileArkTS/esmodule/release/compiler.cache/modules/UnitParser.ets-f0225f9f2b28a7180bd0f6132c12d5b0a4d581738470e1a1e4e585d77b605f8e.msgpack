    m.set('u', 1e-6);

    m.set('U', 1e-6);

    m.set('Âµ', 1e-6);

    m.set('m', 1e-3);

    return m;

  }



  private static getIndMultipliers(): Map<string, number> {

    const m = new Map<string, number>();

    m.set('H', 1);

    m.set('m', 1e-3);

    m.set('u', 1e-6);

    m.set('n', 1e-9);

    return m;

  }



  private static getFreqMultipliers(): Map<string, number> {

    const m = new Map<string, number>();

    m.set('Hz', 1);

    m.set('hz', 1);

    m.set('K', 1e3);

    m.set('k', 1e3);

    m.set('M', 1e6);

    m.set('m', 1e6);

