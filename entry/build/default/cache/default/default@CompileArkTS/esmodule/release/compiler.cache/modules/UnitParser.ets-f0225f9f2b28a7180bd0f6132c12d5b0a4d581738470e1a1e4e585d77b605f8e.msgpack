import { ErrCode } from '../types/ErrCode';



export interface ParsedValue {

  numeric: number;

  unit: string;

  normalized: string;

  valid: boolean;

  errCode: ErrCode;

}



export class UnitParser {

  static parseResistance(input: string): ParsedValue {

