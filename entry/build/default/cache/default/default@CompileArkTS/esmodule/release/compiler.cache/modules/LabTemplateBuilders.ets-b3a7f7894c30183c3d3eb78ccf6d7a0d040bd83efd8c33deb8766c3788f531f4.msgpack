Ôr@Ÿªassertions¤code´customTransformCache¬dependencies¢id¤meta±moduleSideEffects¬originalCode±originalSourcemap«resolvedIds®sourcemapChainµsyntheticNamedExportsµtransformDependencies®transformFiles¨cacheAstÔrAÚ~Ù/**
 * å®éªŒæ¨¡æ¿ç”µè·¯æ„å»ºå™¨ â€” ä¸ tools/lab_templates/builders.mjs å¯¹é½
 * æ¯ä¸ªæ¨¡æ¿å™¨ä»¶å®Œæ•´ã€è¿çº¿æ­£ç¡®ã€å¯ä»¿çœŸ
 */
import { NetType } from 'common';
import { TemplateSchematicKit as K } from './TemplateSchematicKit';
const R = (doc, id, ref, x, y) => K.place(doc, id, ref, { x: x, y: y });
const C = (doc, id, ref, x, y) => K.place(doc, id, ref, { x: x, y: y });
function p(comp, pinId, pinName = pinId) {
    return { comp: comp, pinId: pinId, pinName: pinName };
}
function gate(id, ref, dual) {
    const g = { id: id, ref: ref, dual: dual };
    return g;
}
/** lab_power: LM7805 ç¨³å‹ + æ»¤æ³¢ + è´Ÿè½½æµ‹é‡ */
export function buildLabPower(doc) {
    // ä¸»è½¨ y=160ï¼›æ»¤æ³¢/è´Ÿè½½ä¸‹æŒ‚ï¼Œç”µå‹è¡¨ V+ ä¸è½¨é“åŒé«˜ï¼Œé¿å…æ­£äº¤å¼¯ç‚¹/å‚çº¿ç©¿è¿‡é‚»è„šé€ æˆ T ç»“å¹¶ç½‘
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 100 });
    const fuse = K.place(doc, 'FUSE_1A', 'F1', { x: 100, y: 160 });
    const cin = K.place(doc, 'C_100uF', 'C1', { x: 180, y: 240 });
    const reg = K.place(doc, 'LM7805', 'U1', { x: 280, y: 160 });
    const cout = K.place(doc, 'C_10uF', 'C2', { x: 400, y: 240 });
    const rLoad = K.place(doc, 'R_10k', 'R1', { x: 500, y: 240 });
    const vm = K.place(doc, 'VOLTMETER_DC', 'M1', { x: 620, y: 170 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 280, y: 340 });
    K.join(doc, 'VIN_SRC', NetType.SIGNAL, [p(vcc, '1', 'VCC'), p(fuse, '1')]);
    K.join(doc, 'REG_IN', NetType.SIGNAL, [p(fuse, '2'), p(cin, '1'), p(reg, '1')]);
    K.join(doc, 'VOUT', NetType.POWER, [
        p(reg, '3'), p(cout, '1'), p(rLoad, '1'), p(vm, 'V+', 'V+')
    ]);
    K.join(doc, 'GND', NetType.GROUND, [
        p(gnd, '1', 'GND'), p(reg, '2'), p(cin, '2'), p(cout, '2'),
        p(rLoad, '2'), p(vm, 'COM', 'COM')
    ]);
}
/** lab_amp: LM358 åŒç›¸æ”¾å¤§å™¨ + VAC æ¿€åŠ± */
export function buildLabAmp(doc) {
    const vac = K.place(doc, 'VAC', 'AC1', { x: 60, y: 200 });
    const ri = R(doc, 'R_10k', 'R1', 160, 160);
    const opa = K.place(doc, 'LM358', 'U1', { x: 300, y: 180 });
    const rf = R(doc, 'R_100k', 'Rf', 300, 80);
    const rg = R(doc, 'R_10k', 'Rg', 220, 280);
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 300, y: 40 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 220, y: 360 });
    const vm = K.place(doc, 'VOLTMETER_DC', 'M1', { x: 480, y: 160 });
    const osc = K.place(doc, 'OSCILLOSCOPE', 'OSC1', { x: 480, y: 280 });
    K.join(doc, 'SIG_SRC', NetType.SIGNAL, [p(vac, '1'), p(ri, '1')]);
    K.join(doc, 'SIG_IN', NetType.SIGNAL, [p(ri, '2'), p(opa, 'IN+1', 'IN+1')]);
    K.join(doc, 'FB', NetType.SIGNAL, [
        p(opa, 'IN-1', 'IN-1'), p(rf, '1'), p(rg, '1')
    ]);
    K.join(doc, 'SIG_OUT', NetType.SIGNAL, [
        p(opa, 'OUT1', 'OUT1'), p(rf, '2'), p(vm, 'V+', 'V+'), p(osc, 'CH1', 'CH1')
    ]);
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(opa, 'V+', 'V+')]);
    K.join(doc, 'GND', NetType.GROUND, [
        p(gnd, '1', 'GND'), p(vac, '2'), p(opa, 'V-', 'V-'), p(rg, '2'),
        p(vm, 'COM', 'COM'), p(osc, 'GND', 'GND')
    ]);
}
/** lab_filter: RC ä½é€š + LM358 ç”µå‹è·Ÿéš */
export function buildLabFilter(doc) {
    const vac = K.place(doc, 'VAC', 'AC1', { x: 60, y: 180 });
    const r1 = R(doc, 'R_1k', 'R1', 160, 160);
    const c1 = C(doc, 'C_100nF', 'C1', 260, 260);
    const opa = K.place(doc, 'LM358', 'U1', { x: 360, y: 180 });
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 360, y: 40 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 260, y: 360 });
    const vm = K.place(doc, 'VOLTMETER_DC', 'M1', { x: 520, y: 160 });
    const osc = K.place(doc, 'OSCILLOSCOPE', 'OSC1', { x: 520, y: 280 });
    K.join(doc, 'SIG_SRC', NetType.SIGNAL, [p(vac, '1'), p(r1, '1')]);
    K.join(doc, 'SIG_MID', NetType.SIGNAL, [
        p(r1, '2'), p(c1, '1'), p(opa, 'IN+1', 'IN+1')
    ]);
    // å•ä½å¢ç›Šè·Ÿéš: OUT1 â†’ IN-1
    K.join(doc, 'BUF_FB', NetType.SIGNAL, [
        p(opa, 'OUT1', 'OUT1'), p(opa, 'IN-1', 'IN-1'),
        p(vm, 'V+', 'V+'), p(osc, 'CH1', 'CH1')
    ]);
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(opa, 'V+', 'V+')]);
    K.join(doc, 'GND', NetType.GROUND, [
        p(gnd, '1', 'GND'), p(vac, '2'), p(c1, '2'), p(opa, 'V-', 'V-'),
        p(vm, 'COM', 'COM'), p(osc, 'GND', 'GND')
    ]);
}
/** lab_51_led: AT89C51 æµæ°´ç¯æœ€å°ç³»ç»Ÿ */
export function buildLab51Led(doc) {
    const mcu = K.place(doc, 'AT89C51', 'U1', { x: 200, y: 200 });
    const xtal = K.place(doc, 'XTAL_11M', 'Y1', { x: 60, y: 60 });
    const c1 = C(doc, 'C_100nF', 'C1', 40, 100);
    const c2 = C(doc, 'C_100nF', 'C2', 40, 40);
    const cDec = C(doc, 'C_100nF', 'C3', 300, 320);
    const rRst = R(doc, 'R_10k', 'R1', 100, 280);
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 140 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 380 });
    const rPwr = R(doc, 'R_1k', 'R_PWR', 360, 120);
    const ledPwr = K.place(doc, 'LED_GREEN', 'D9', { x: 440, y: 120 });
    const vm = K.place(doc, 'VOLTMETER_DC', 'M1', { x: 360, y: 320 });
    K.crystal(doc, mcu, xtal, c1, c2, 'P18', 'P19');
    K.mcuCore(doc, mcu, vcc, gnd, rRst, cDec, 'P40', 'P20', 'P9');
    // EA/VPP ä¸Šæ‹‰åˆ° VCC
    K.join(doc, 'VCC', NetType.POWER, [p(mcu, 'P31', 'P31'), p(vm, 'V+', 'V+')]);
    K.join(doc, 'GND', NetType.GROUND, [p(vm, 'COM', 'COM')]);
    K.ledBranch(doc, p(vcc, '1', 'VCC'), p(gnd, '1', 'GND'), rPwr, ledPwr, 'PWR', 'VCC');
    for (let i = 0; i < 8; i++) {
        const rx = 420 + i * 40;
        const rl = R(doc, 'R_330', `RL${i + 1}`, rx, 200);
        const led = K.place(doc, 'LED_RED', `D${i + 1}`, { x: rx, y: 280 });
        const pinId = `P${i + 1}`;
        K.ledBranch(doc, p(mcu, pinId, pinId), p(gnd, '1', 'GND'), rl, led, `L${i}`);
    }
}
/** lab_uart: STM32F103 UART + ç»ˆç«¯ */
export function buildLabUart(doc) {
    const mcu = K.place(doc, 'STM32F103C8', 'U1', { x: 200, y: 200 });
    const xtal = K.place(doc, 'XTAL_8M', 'Y1', { x: 60, y: 60 });
    const c1 = C(doc, 'C_100nF', 'C1', 40, 100);
    const c2 = C(doc, 'C_100nF', 'C2', 40, 40);
    const cDec = C(doc, 'C_100nF', 'C3', 300, 340);
    const rRst = R(doc, 'R_10k', 'R1', 100, 280);
    const uart = K.place(doc, 'UART_TERMINAL', 'TERM1', { x: 480, y: 180 });
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 140 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 380 });
    const rPwr = R(doc, 'R_1k', 'R_PWR', 360, 100);
    const ledPwr = K.place(doc, 'LED_GREEN', 'D1', { x: 440, y: 100 });
    const vm = K.place(doc, 'VOLTMETER_DC', 'M1', { x: 360, y: 340 });
    K.crystal(doc, mcu, xtal, c1, c2, 'P5', 'P6');
    K.mcuCore(doc, mcu, vcc, gnd, rRst, cDec, 'P48', 'P24', 'P7');
    K.join(doc, 'UART_TX', NetType.SIGNAL, [p(mcu, 'P10', 'P10'), p(uart, 'TX', 'TX')]);
    K.join(doc, 'UART_RX', NetType.SIGNAL, [p(mcu, 'P11', 'P11'), p(uart, 'RX', 'RX')]);
    K.join(doc, 'GND', NetType.GROUND, [
        p(uart, 'GND', 'GND'), p(vm, 'COM', 'COM')
    ]);
    K.join(doc, 'VCC', NetType.POWER, [p(vm, 'V+', 'V+')]);
    K.ledBranch(doc, p(vcc, '1', 'VCC'), p(gnd, '1', 'GND'), rPwr, ledPwr, 'PWR', 'VCC');
}
/** lab_passive: ç”µé˜»ä¸²/ç”µå®¹å»è€¦/LC/äº¤æµæ”¯è·¯ */
export function buildLabPassive(doc) {
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 60 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 520 });
    const vac = K.place(doc, 'VAC', 'AC1', { x: 40, y: 200 });
    const rIds = ['R_10', 'R_100', 'R_330', 'R_1k', 'R_4.7k', 'R_10k', 'R_47k', 'R_100k'];
    const cIds = ['C_10pF', 'C_100pF', 'C_1nF', 'C_10nF', 'C_100nF', 'C_1uF', 'C_10uF', 'C_100uF'];
    let x = 160;
    let prev = null;
    for (let i = 0; i < rIds.length; i++) {
        const r = R(doc, rIds[i], `R${i + 1}`, x, 100);
        if (prev === null) {
            // DIV_TOP ç”±ç”µæµè¡¨ I- æ±‡å…¥ï¼ˆè§ä¸‹æ–¹ä»ªè¡¨æ®µï¼‰
            K.join(doc, 'DIV_TOP', NetType.SIGNAL, [p(r, '1')]);
        }
        else {
            K.series2(doc, `NET_R${i}`, p(prev, '2'), p(r, '1'));
        }
        prev = r;
        x += 70;
    }
    if (prev !== null) {
        K.join(doc, 'GND', NetType.GROUND, [p(prev, '2'), p(gnd, '1', 'GND')]);
    }
    x = 160;
    for (let i = 0; i < cIds.length; i++) {
        const cap = C(doc, cIds[i], `C${i + 1}`, x, 240);
        K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(cap, '1')]);
        K.join(doc, 'GND', NetType.GROUND, [p(cap, '2'), p(gnd, '1', 'GND')]);
        x += 70;
    }
    const l1 = K.place(doc, 'L_10uH', 'L1', { x: 200, y: 360 });
    const cLc = C(doc, 'C_1uF', 'CLC', 320, 360);
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(l1, '1')]);
    K.series2(doc, 'LC_MID', p(l1, '2'), p(cLc, '1'));
    K.join(doc, 'GND', NetType.GROUND, [p(cLc, '2'), p(gnd, '1', 'GND')]);
    const fuse = K.place(doc, 'FUSE_1A', 'F1', { x: 140, y: 200 });
    const rAc = R(doc, 'R_1k', 'RAC', 240, 200);
    K.join(doc, 'AC_PATH', NetType.SIGNAL, [p(vac, '1'), p(fuse, '1')]);
    K.series2(doc, 'AC_LOAD', p(fuse, '2'), p(rAc, '1'));
    K.join(doc, 'GND', NetType.GROUND, [
        p(vac, '2'), p(rAc, '2'), p(gnd, '1', 'GND')
    ]);
    // ç”µæµè¡¨ä¸²åœ¨ç”µæºä¸ç”µé˜»é“¾ä¹‹é—´
    const am = K.place(doc, 'AMMETER_DC', 'A1', { x: 100, y: 40 });
    const vm = K.place(doc, 'VOLTMETER_DC', 'M1', { x: 400, y: 40 });
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(am, 'I+', 'I+')]);
    K.join(doc, 'DIV_TOP', NetType.SIGNAL, [p(am, 'I-', 'I-')]);
    K.join(doc, 'DIV_TOP', NetType.SIGNAL, [p(vm, 'V+', 'V+')]);
    K.join(doc, 'GND', NetType.GROUND, [p(vm, 'COM', 'COM')]);
}
/** lab_discrete: äºŒæç®¡/LED/BJT/MOS å…¸å‹æ¥æ³• */
export function buildLabDiscrete(doc) {
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 80 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 480 });
    const diodes = ['1N4148', '1N4007', '1N5819'];
    for (let i = 0; i < diodes.length; i++) {
        const d = K.place(doc, diodes[i], `D${i + 1}`, { x: 200 + i * 110, y: 160 });
        const rd = R(doc, 'R_1k', `RD${i + 1}`, 200 + i * 110, 100);
        K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(rd, '1')]);
        K.series2(doc, `DIO${i}`, p(rd, '2'), p(d, 'A', 'A'));
        K.join(doc, 'GND', NetType.GROUND, [p(d, 'K', 'K'), p(gnd, '1', 'GND')]);
    }
    const leds = ['LED_RED', 'LED_GREEN', 'LED_BLUE'];
    for (let i = 0; i < leds.length; i++) {
        const rl = R(doc, 'R_330', `RL${i + 1}`, 200 + i * 110, 240);
        const led = K.place(doc, leds[i], `LED${i + 1}`, { x: 200 + i * 110, y: 300 });
        K.ledBranch(doc, p(vcc, '1', 'VCC'), p(gnd, '1', 'GND'), rl, led, `L${i}`, 'VCC');
    }
    // NPN å…±å°„å¼€å…³ + é›†ç”µæ LED
    const npn = K.place(doc, '2N2222', 'Q1', { x: 560, y: 160 });
    const rb = R(doc, 'R_10k', 'RB1', 460, 160);
    const rc = R(doc, 'R_330', 'RC1', 660, 100);
    const ledN = K.place(doc, 'LED_RED', 'DN', { x: 740, y: 100 });
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(rb, '1'), p(rc, '1')]);
    K.series2(doc, 'BASE', p(rb, '2'), p(npn, 'B', 'B'));
    K.series2(doc, 'COLL', p(rc, '2'), p(ledN, 'A', 'A'));
    K.join(doc, 'COLL_LED', NetType.SIGNAL, [p(ledN, 'K', 'K'), p(npn, 'C', 'C')]);
    K.join(doc, 'GND', NetType.GROUND, [p(npn, 'E', 'E'), p(gnd, '1', 'GND')]);
    // PNP ä¸Šåç½®
    const pnp = K.place(doc, '2N2907', 'Q2', { x: 560, y: 320 });
    const rb2 = R(doc, 'R_10k', 'RB2', 460, 320);
    const rc2 = R(doc, 'R_1k', 'RC2', 660, 360);
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(pnp, 'E', 'E')]);
    K.series2(doc, 'BASE_P', p(rb2, '2'), p(pnp, 'B', 'B'));
    K.join(doc, 'GND', NetType.GROUND, [p(rb2, '1'), p(gnd, '1', 'GND')]);
    K.join(doc, 'COLL_P', NetType.SIGNAL, [p(pnp, 'C', 'C'), p(rc2, '1')]);
    K.join(doc, 'GND', NetType.GROUND, [p(rc2, '2')]);
    // NMOS å¼€å…³
    const nmos = K.place(doc, '2N7000', 'M1', { x: 820, y: 160 });
    const rg = R(doc, 'R_10k', 'RG1', 720, 160);
    const rd = R(doc, 'R_330', 'RD1', 920, 100);
    const ledM = K.place(doc, 'LED_GREEN', 'DM', { x: 1000, y: 100 });
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(rg, '1'), p(rd, '1')]);
    K.series2(doc, 'GATE', p(rg, '2'), p(nmos, 'G', 'G'));
    K.series2(doc, 'DRAIN', p(rd, '2'), p(ledM, 'A', 'A'));
    K.join(doc, 'DRAIN_LED', NetType.SIGNAL, [p(ledM, 'K', 'K'), p(nmos, 'D', 'D')]);
    K.join(doc, 'GND', NetType.GROUND, [p(nmos, 'S', 'S'), p(gnd, '1', 'GND')]);
    // MOSFET ä½è¾¹å¼€å…³ï¼ˆIRF540ï¼‰
    const pfet = K.place(doc, 'IRF540', 'M2', { x: 820, y: 320 });
    const rg2 = R(doc, 'R_10k', 'RG2', 720, 320);
    const rd2 = R(doc, 'R_330', 'RD2', 920, 280);
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(rd2, '1')]);
    K.series2(doc, 'GATE2', p(rg2, '2'), p(pfet, 'G', 'G'));
    K.join(doc, 'GND', NetType.GROUND, [p(rg2, '1'), p(gnd, '1', 'GND')]);
    K.join(doc, 'DRAIN2', NetType.SIGNAL, [p(pfet, 'D', 'D'), p(rd2, '2')]);
    K.join(doc, 'GND', NetType.GROUND, [p(pfet, 'S', 'S')]);
}
/** lab_analog_ic: è¿æ”¾ + ç¨³å‹å®Œæ•´ç”µè·¯ */
export function buildLabAnalogIc(doc) {
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 60 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 520 });
    const vac = K.place(doc, 'VAC', 'AC1', { x: 40, y: 160 });
    // UA741 åç›¸æ”¾å¤§
    const ua = K.place(doc, 'UA741', 'U1', { x: 220, y: 140 });
    const rIn = R(doc, 'R_10k', 'R1', 120, 120);
    const rf = R(doc, 'R_47k', 'Rf', 220, 60);
    const rG = R(doc, 'R_10k', 'Rg1', 120, 180);
    K.join(doc, 'SIG', NetType.SIGNAL, [p(vac, '1'), p(rIn, '1')]);
    K.join(doc, 'INV_IN', NetType.SIGNAL, [p(rIn, '2'), p(ua, 'IN-', 'IN-'), p(rf, '1')]);
    K.join(doc, 'GND_BIAS', NetType.GROUND, [p(ua, 'IN+', 'IN+'), p(rG, '1')]);
    K.join(doc, 'OUT741', NetType.SIGNAL, [p(ua, 'OUT', 'OUT'), p(rf, '2')]);
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(ua, 'VCC', 'VCC')]);
    K.join(doc, 'GND', NetType.GROUND, [
        p(gnd, '1', 'GND'), p(vac, '2'), p(ua, 'VEE', 'VEE'), p(rG, '2')
    ]);
    // TL082 è·Ÿéšå™¨
    const tl = K.place(doc, 'TL082', 'U2', { x: 420, y: 140 });
    const rTl = R(doc, 'R_10k', 'R2', 340, 120);
    K.join(doc, 'OUT741', NetType.SIGNAL, [p(rTl, '1')]);
    K.join(doc, 'TL_IN', NetType.SIGNAL, [p(rTl, '2'), p(tl, 'IN+1', 'IN+1')]);
    K.join(doc, 'TL_OUT', NetType.SIGNAL, [
        p(tl, 'OUT1', 'OUT1'), p(tl, 'IN-1', 'IN-1')
    ]);
    K.join(doc, 'VCC', NetType.POWER, [p(tl, 'V+', 'V+')]);
    K.join(doc, 'GND', NetType.GROUND, [p(tl, 'V-', 'V-')]);
    // LM358 åŒç›¸
    const lm = K.place(doc, 'LM358', 'U3', { x: 620, y: 140 });
    const ri3 = R(doc, 'R_10k', 'R3', 520, 120);
    const rf3 = R(doc, 'R_100k', 'Rf3', 620, 60);
    const rg3 = R(doc, 'R_10k', 'Rg3', 540, 220);
    K.join(doc, 'TL_OUT', NetType.SIGNAL, [p(ri3, '1')]);
    K.join(doc, 'LM_IN', NetType.SIGNAL, [p(ri3, '2'), p(lm, 'IN+1', 'IN+1')]);
    K.join(doc, 'LM_FB', NetType.SIGNAL, [p(lm, 'IN-1', 'IN-1'), p(rf3, '1'), p(rg3, '1')]);
    K.join(doc, 'LM_OUT', NetType.SIGNAL, [p(lm, 'OUT1', 'OUT1'), p(rf3, '2')]);
    K.join(doc, 'VCC', NetType.POWER, [p(lm, 'V+', 'V+')]);
    K.join(doc, 'GND', NetType.GROUND, [p(lm, 'V-', 'V-'), p(rg3, '2')]);
    const vm = K.place(doc, 'VOLTMETER_DC', 'M1', { x: 760, y: 120 });
    K.join(doc, 'LM_OUT', NetType.SIGNAL, [p(vm, 'V+', 'V+')]);
    K.join(doc, 'GND', NetType.GROUND, [p(vm, 'COM', 'COM')]);
    // ä¸‰è·¯çº¿æ€§ç¨³å‹ï¼ˆæ»¤æ³¢/è´Ÿè½½ä¸‹æŒ‚ï¼Œé¿å…ä¸ IN/OUT è½¨åŒé«˜é€ æˆ T ç»“ï¼‰
    const regs = ['LM7805', 'LM7812', 'AMS1117_3V3'];
    for (let i = 0; i < regs.length; i++) {
        const ox = 160 + i * 160;
        const u = K.place(doc, regs[i], `REG${i + 1}`, { x: ox + 60, y: 360 });
        const ci = C(doc, 'C_10uF', `CI${i + 1}`, ox, 440);
        const co = C(doc, 'C_100nF', `CO${i + 1}`, ox + 140, 440);
        const rl = R(doc, 'R_10k', `RL${i + 1}`, ox + 140, 500);
        K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(ci, '1'), p(u, '1')]);
        K.join(doc, `VOUT_R${i}`, NetType.POWER, [p(u, '3'), p(co, '1'), p(rl, '1')]);
        K.join(doc, 'GND', NetType.GROUND, [
            p(u, '2'), p(ci, '2'), p(co, '2'), p(rl, '2'), p(gnd, '1', 'GND')
        ]);
    }
    // LM2596 æœ€å° buckï¼šVIN/GND/VOUT/FB/SW
    const buck = K.place(doc, 'LM2596', 'U4', { x: 720, y: 360 });
    const cBin = C(doc, 'C_100uF', 'CBI', 640, 360);
    const cBout = C(doc, 'C_100uF', 'CBO', 820, 360);
    const lBuck = K.place(doc, 'L_10uH', 'LB', { x: 820, y: 300 });
    const rBfb = R(doc, 'R_10k', 'RFB', 760, 420);
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(cBin, '1'), p(buck, '1')]);
    K.join(doc, 'GND', NetType.GROUND, [p(buck, '2'), p(cBin, '2'), p(cBout, '2'), p(rBfb, '2')]);
    K.join(doc, 'BUCK_SW', NetType.SIGNAL, [p(buck, '3'), p(lBuck, '1')]);
    K.join(doc, 'BUCK_OUT', NetType.POWER, [
        p(lBuck, '2'), p(cBout, '1'), p(buck, '4'), p(buck, '5'), p(rBfb, '1')
    ]);
}
/** lab_digital: é—¨ç”µè·¯æ¿€åŠ± + LA æ¢å¤´ */
export function buildLabDigital(doc) {
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 60 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 420 });
    // è¾“å…¥æ‹‰é«˜/æ‹‰ä½äº§ç”Ÿé€»è¾‘ç”µå¹³
    const rHi = R(doc, 'R_10k', 'RHI', 120, 100);
    const rLo = R(doc, 'R_10k', 'RLO', 120, 200);
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(rHi, '1')]);
    K.join(doc, 'LOGIC_H', NetType.SIGNAL, [p(rHi, '2')]);
    K.join(doc, 'GND', NetType.GROUND, [p(gnd, '1', 'GND'), p(rLo, '2')]);
    K.join(doc, 'LOGIC_L', NetType.SIGNAL, [p(rLo, '1')]);
    const gateDefs = [
        gate('74HC00', 'U1', true),
        gate('74HC02', 'U2', true),
        gate('74HC04', 'U3', false),
        gate('74HC08', 'U4', true),
        gate('74HC32', 'U5', true),
        gate('74HC74', 'U6', true)
    ];
    const outs = [];
    for (let i = 0; i < gateDefs.length; i++) {
        const g = gateDefs[i];
        const u = K.place(doc, g.id, g.ref, { x: 220 + i * 100, y: 180 });
        K.join(doc, 'VCC', NetType.POWER, [p(u, '14'), p(vcc, '1', 'VCC')]);
        K.join(doc, 'GND', NetType.GROUND, [p(u, '7'), p(gnd, '1', 'GND')]);
        if (g.dual) {
            K.join(doc, 'LOGIC_H', NetType.SIGNAL, [p(u, '1')]);
            K.join(doc, 'LOGIC_L', NetType.SIGNAL, [p(u, '2')]);
            outs.push(p(u, '3'));
        }
        else {
            K.join(doc, 'LOGIC_H', NetType.SIGNAL, [p(u, '1')]);
            outs.push(p(u, '2'));
        }
    }
    const cnt = K.place(doc, 'CD4017', 'U7', { x: 860, y: 180 });
    K.join(doc, 'VCC', NetType.POWER, [p(cnt, '16'), p(vcc, '1', 'VCC')]);
    K.join(doc, 'GND', NetType.GROUND, [p(cnt, '8'), p(gnd, '1', 'GND')]);
    // CLOCK=14, ENABLE=13, RESET=15
    K.join(doc, 'LOGIC_H', NetType.SIGNAL, [p(cnt, '14')]);
    K.join(doc, 'LOGIC_L', NetType.SIGNAL, [p(cnt, '13'), p(cnt, '15')]);
    outs.push(p(cnt, '3')); // Q0
    const la = K.place(doc, 'LOGIC_ANALYZER', 'LA1', { x: 860, y: 340 });
    K.join(doc, 'GND', NetType.GROUND, [p(la, 'GND', 'GND')]);
    for (let ch = 0; ch < Math.min(outs.length, 8); ch++) {
        K.join(doc, `LA_CH${ch + 1}`, NetType.SIGNAL, [
            outs[ch], p(la, `CH${ch + 1}`, `CH${ch + 1}`)
        ]);
    }
}
/** lab_memory: MCU + I2C/SPI/å¹¶è¡Œå­˜å‚¨å™¨æ¥å£ */
export function buildLabMemory(doc) {
    const mcu = K.place(doc, 'STM32F103RC', 'U1', { x: 180, y: 220 });
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 100 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 420 });
    const cDec = C(doc, 'C_100nF', 'C1', 280, 380);
    const rRst = R(doc, 'R_10k', 'R1', 100, 340);
    const xtal = K.place(doc, 'XTAL_8M', 'Y1', { x: 40, y: 60 });
    const c1 = C(doc, 'C_100nF', 'CX1', 20, 100);
    const c2 = C(doc, 'C_100nF', 'CX2', 20, 40);
    K.crystal(doc, mcu, xtal, c1, c2, 'P5', 'P6');
    K.mcuCore(doc, mcu, vcc, gnd, rRst, cDec, 'P48', 'P24', 'P7');
    // 24C02 I2C: 1=A0,2=A1,3=A2,4=GND,5=SDA,6=SCL,7=WP,8=VCC
    const eep = K.place(doc, '24C02', 'M1', { x: 420, y: 120 });
    const rSda = R(doc, 'R_4.7k', 'RSDA', 360, 80);
    const rScl = R(doc, 'R_4.7k', 'RSCL', 360, 140);
    K.join(doc, 'GND', NetType.GROUND, [
        p(eep, '1'), p(eep, '2'), p(eep, '3'), p(eep, '4'), p(eep, '7')
    ]);
    K.join(doc, 'VCC', NetType.POWER, [p(eep, '8'), p(rSda, '1'), p(rScl, '1')]);
    K.join(doc, 'I2C_SDA', NetType.SIGNAL, [
        p(mcu, 'P18', 'P18'), p(eep, '5'), p(rSda, '2')
    ]);
    K.join(doc, 'I2C_SCL', NetType.SIGNAL, [
        p(mcu, 'P19', 'P19'), p(eep, '6'), p(rScl, '2')
    ]);
    // W25Q64 SPI: 1=CS,2=DO,3=WP,4=GND,5=DI,6=CLK,7=HOLD,8=VCC
    const flash = K.place(doc, 'W25Q64', 'M2', { x: 560, y: 120 });
    K.join(doc, 'VCC', NetType.POWER, [p(flash, '8'), p(flash, '3'), p(flash, '7')]);
    K.join(doc, 'GND', NetType.GROUND, [p(flash, '4')]);
    K.join(doc, 'SPI_CS', NetType.SIGNAL, [p(mcu, 'P20', 'P20'), p(flash, '1')]);
    K.join(doc, 'SPI_MISO', NetType.SIGNAL, [p(mcu, 'P21', 'P21'), p(flash, '2')]);
    K.join(doc, 'SPI_MOSI', NetType.SIGNAL, [p(mcu, 'P22', 'P22'), p(flash, '5')]);
    K.join(doc, 'SPI_SCK', NetType.SIGNAL, [p(mcu, 'P23', 'P23'), p(flash, '6')]);
    // 2764 EPROM ç®€åŒ–: VCC=28 GND=14 CE=20 OE=22
    const eprom = K.place(doc, '2764', 'M3', { x: 720, y: 160 });
    K.join(doc, 'VCC', NetType.POWER, [p(eprom, '28')]);
    K.join(doc, 'GND', NetType.GROUND, [p(eprom, '14')]);
    K.join(doc, 'MEM_CE', NetType.SIGNAL, [p(mcu, 'P25', 'P25'), p(eprom, '20')]);
    K.join(doc, 'MEM_OE', NetType.SIGNAL, [p(mcu, 'P26', 'P26'), p(eprom, '22')]);
    K.join(doc, 'MEM_D0', NetType.SIGNAL, [p(mcu, 'P27', 'P27'), p(eprom, '11')]);
    // 62256 SRAM: VCC=28 GND=14 CE=20 OE=22 WE=27
    const sram = K.place(doc, '62256', 'M4', { x: 860, y: 160 });
    K.join(doc, 'VCC', NetType.POWER, [p(sram, '28')]);
    K.join(doc, 'GND', NetType.GROUND, [p(sram, '14')]);
    K.join(doc, 'SRAM_CE', NetType.SIGNAL, [p(mcu, 'P28', 'P28'), p(sram, '20')]);
    K.join(doc, 'SRAM_OE', NetType.SIGNAL, [p(mcu, 'P29', 'P29'), p(sram, '22')]);
    K.join(doc, 'SRAM_WE', NetType.SIGNAL, [p(mcu, 'P30', 'P30'), p(sram, '27')]);
    K.join(doc, 'MEM_D0', NetType.SIGNAL, [p(sram, '11')]);
}
/** lab_mcu_8051: å››æ¬¾ 8051 æœ€å°ç³»ç»Ÿ */
export function buildLabMcu8051(doc) {
    const ids = ['AT89C51', 'AT89C52', 'STC89C52', 'STC15W408AS'];
    const xtals = ['XTAL_11M', 'XTAL_11M', 'XTAL_11M', 'XTAL_8M'];
    for (let i = 0; i < ids.length; i++) {
        const ox = 60 + i * 300;
        const mcu = K.place(doc, ids[i], `U${i + 1}`, { x: ox + 140, y: 220 });
        const xtal = K.place(doc, xtals[i], `Y${i + 1}`, { x: ox + 20, y: 60 });
        const c1 = C(doc, 'C_100nF', `C${i * 2 + 1}`, ox, 100);
        const c2 = C(doc, 'C_100nF', `C${i * 2 + 2}`, ox, 40);
        const cDec = C(doc, 'C_100nF', `CD${i + 1}`, ox + 240, 340);
        const rRst = R(doc, 'R_10k', `R${i + 1}`, ox + 60, 300);
        const vcc = K.place(doc, 'VCC', `PWR${i + 1}`, { x: ox, y: 140 });
        const gnd = K.place(doc, 'GND', `GND${i + 1}`, { x: ox, y: 380 });
        const ledR = R(doc, 'R_330', `RL${i + 1}`, ox + 240, 160);
        const led = K.place(doc, 'LED_RED', `D${i + 1}`, { x: ox + 320, y: 160 });
        K.crystal(doc, mcu, xtal, c1, c2, 'P18', 'P19', `M${i}_`);
        K.mcuCore(doc, mcu, vcc, gnd, rRst, cDec, 'P40', 'P20', 'P9', `M${i}_`);
        K.join(doc, 'VCC', NetType.POWER, [p(mcu, 'P31', 'P31')]);
        K.ledBranch(doc, p(mcu, 'P1', 'P1'), p(gnd, '1', 'GND'), ledR, led, `L${i}`);
    }
}
/** lab_mcu_stm32: äº”æ¬¾ STM32 æœ€å°ç³»ç»Ÿ */
export function buildLabMcuStm32(doc) {
    const ids = ['STM32F103C8', 'STM32F103RC', 'STM32F407VG', 'STM32L431CB', 'STM32F030F4'];
    for (let i = 0; i < ids.length; i++) {
        const ox = 40 + i * 260;
        const id = ids[i];
        const isF407 = id.includes('F407');
        const vccPin = isF407 ? 'P100' : 'P48';
        const gndPin = isF407 ? 'P50' : 'P24';
        const mcu = K.place(doc, id, `U${i + 1}`, { x: ox + 130, y: 220 });
        const xtal = K.place(doc, 'XTAL_8M', `Y${i + 1}`, { x: ox + 10, y: 60 });
        const c1 = C(doc, 'C_100nF', `C${i * 2 + 1}`, ox - 10, 100);
        const c2 = C(doc, 'C_100nF', `C${i * 2 + 2}`, ox - 10, 40);
        const cDec = C(doc, 'C_10uF', `CD${i + 1}`, ox + 220, 340);
        const rRst = R(doc, 'R_10k', `R${i + 1}`, ox + 50, 300);
        const vcc = K.place(doc, 'VCC', `PWR${i + 1}`, { x: ox, y: 140 });
        const gnd = K.place(doc, 'GND', `GND${i + 1}`, { x: ox, y: 400 });
        const ledR = R(doc, 'R_330', `RL${i + 1}`, ox + 220, 160);
        const led = K.place(doc, 'LED_GREEN', `D${i + 1}`, { x: ox + 300, y: 160 });
        K.crystal(doc, mcu, xtal, c1, c2, 'P5', 'P6', `S${i}_`);
        K.mcuCore(doc, mcu, vcc, gnd, rRst, cDec, vccPin, gndPin, 'P7', `S${i}_`);
        K.ledBranch(doc, p(mcu, 'P1', 'P1'), p(gnd, '1', 'GND'), ledR, led, `L${i}`);
    }
}
/** lab_peripheral: æŒ‰é”®/ç»§ç”µå™¨/èœ‚é¸£å™¨/LCD/OLED */
export function buildLabPeripheral(doc) {
    const mcu = K.place(doc, 'STM32F103C8', 'U1', { x: 180, y: 220 });
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 100 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 480 });
    const cDec = C(doc, 'C_100nF', 'C1', 280, 380);
    const rRst = R(doc, 'R_10k', 'R1', 100, 340);
    const xtal = K.place(doc, 'XTAL_8M', 'Y1', { x: 40, y: 60 });
    const cx1 = C(doc, 'C_100nF', 'CX1', 20, 100);
    const cx2 = C(doc, 'C_100nF', 'CX2', 20, 40);
    K.crystal(doc, mcu, xtal, cx1, cx2, 'P5', 'P6');
    K.mcuCore(doc, mcu, vcc, gnd, rRst, cDec, 'P48', 'P24', 'P7');
    // æŒ‰é”®ä¸Šæ‹‰
    const sw = K.place(doc, 'SW_PUSH', 'SW1', { x: 400, y: 140 });
    const rPull = R(doc, 'R_10k', 'R2', 320, 140);
    K.join(doc, 'KEY', NetType.SIGNAL, [p(mcu, 'P2', 'P2'), p(sw, '1'), p(rPull, '1')]);
    K.join(doc, 'VCC', NetType.POWER, [p(rPull, '2')]);
    K.join(doc, 'GND', NetType.GROUND, [p(sw, '2')]);
    // ç»§ç”µå™¨ MCU é©±åŠ¨
    const relay = K.place(doc, 'RELAY_SPDT', 'K1', { x: 480, y: 240 });
    const rRel = R(doc, 'R_330', 'RR', 400, 240);
    K.join(doc, 'REL_DRV', NetType.SIGNAL, [p(mcu, 'P3', 'P3'), p(rRel, '1')]);
    K.series2(doc, 'REL_COIL', p(rRel, '2'), p(relay, '1'));
    K.join(doc, 'GND', NetType.GROUND, [p(relay, '2')]);
    // èœ‚é¸£å™¨
    const buzz = K.place(doc, 'BUZZER', 'BZ1', { x: 600, y: 240 });
    const rb = R(doc, 'R_330', 'RBZ', 520, 300);
    K.join(doc, 'BUZ', NetType.SIGNAL, [p(mcu, 'P4', 'P4'), p(rb, '1')]);
    K.series2(doc, 'BUZ_DRV', p(rb, '2'), p(buzz, '1'));
    K.join(doc, 'GND', NetType.GROUND, [p(buzz, '2')]);
    // LCD1602 4-bit: 1=GND 2=VCC 3=VO 4=RS 5=RW 6=E 11-14=D4-D7 15=A 16=K
    const lcd = K.place(doc, 'LCD1602', 'LCD1', { x: 740, y: 160 });
    const rVo = R(doc, 'R_10k', 'RVO', 640, 200);
    K.join(doc, 'GND', NetType.GROUND, [p(lcd, '1'), p(lcd, '5'), p(lcd, '16'), p(rVo, '2')]);
    K.join(doc, 'VCC', NetType.POWER, [p(lcd, '2'), p(lcd, '15')]);
    K.join(doc, 'LCD_VO', NetType.SIGNAL, [p(lcd, '3'), p(rVo, '1')]);
    K.join(doc, 'GND', NetType.GROUND, [p(rVo, '2')]);
    K.join(doc, 'LCD_RS', NetType.SIGNAL, [p(mcu, 'P17', 'P17'), p(lcd, '4')]);
    K.join(doc, 'LCD_E', NetType.SIGNAL, [p(mcu, 'P16', 'P16'), p(lcd, '6')]);
    K.join(doc, 'LCD_D4', NetType.SIGNAL, [p(mcu, 'P12', 'P12'), p(lcd, '11')]);
    K.join(doc, 'LCD_D5', NetType.SIGNAL, [p(mcu, 'P13', 'P13'), p(lcd, '12')]);
    K.join(doc, 'LCD_D6', NetType.SIGNAL, [p(mcu, 'P14', 'P14'), p(lcd, '13')]);
    K.join(doc, 'LCD_D7', NetType.SIGNAL, [p(mcu, 'P15', 'P15'), p(lcd, '14')]);
    // OLED I2C
    const oled = K.place(doc, 'OLED_12864', 'OLED1', { x: 740, y: 360 });
    const rOsda = R(doc, 'R_4.7k', 'RODA', 640, 340);
    const rOscl = R(doc, 'R_4.7k', 'ROCL', 640, 380);
    K.join(doc, 'VCC', NetType.POWER, [
        p(oled, 'VCC', 'VCC'), p(rOsda, '1'), p(rOscl, '1')
    ]);
    K.join(doc, 'GND', NetType.GROUND, [p(oled, 'GND', 'GND')]);
    K.join(doc, 'OLED_SDA', NetType.SIGNAL, [
        p(mcu, 'P18', 'P18'), p(oled, 'SDA', 'SDA'), p(rOsda, '2')
    ]);
    K.join(doc, 'OLED_SCL', NetType.SIGNAL, [
        p(mcu, 'P19', 'P19'), p(oled, 'SCL', 'SCL'), p(rOscl, '2')
    ]);
}
/** lab_sensor: DS18B20 / éœå°” / å…‰æ• */
export function buildLabSensor(doc) {
    const mcu = K.place(doc, 'STM32F103C8', 'U1', { x: 180, y: 220 });
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 100 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 420 });
    const cDec = C(doc, 'C_100nF', 'C1', 280, 380);
    const rRst = R(doc, 'R_10k', 'R1', 100, 340);
    const xtal = K.place(doc, 'XTAL_8M', 'Y1', { x: 40, y: 60 });
    const cx1 = C(doc, 'C_100nF', 'CX1', 20, 100);
    const cx2 = C(doc, 'C_100nF', 'CX2', 20, 40);
    K.crystal(doc, mcu, xtal, cx1, cx2, 'P5', 'P6');
    K.mcuCore(doc, mcu, vcc, gnd, rRst, cDec, 'P48', 'P24', 'P7');
    // DS18B20 ä¸¤è„šåº“æ¨¡å‹ï¼š1=DQ, 2=GNDï¼Œä¸Šæ‹‰åˆ° VCC
    const ds = K.place(doc, 'DS18B20', 'T1', { x: 420, y: 140 });
    const rDs = R(doc, 'R_4.7k', 'R2', 340, 100);
    K.join(doc, '1WIRE', NetType.SIGNAL, [p(mcu, 'P4', 'P4'), p(rDs, '1'), p(ds, '1')]);
    K.join(doc, 'VCC', NetType.POWER, [p(rDs, '2')]);
    K.join(doc, 'GND', NetType.GROUND, [p(ds, '2')]);
    // éœå°”ï¼š1=VCC/OUT å¤åˆä¸¤è„šåº“ â†’ 1 æ¥ MCUï¼Œ2 æ¥åœ°ï¼›å¦ç”¨ä¸Šæ‹‰
    const hall = K.place(doc, 'HALL_SENSOR', 'H1', { x: 420, y: 240 });
    const rHall = R(doc, 'R_10k', 'RH', 340, 240);
    K.join(doc, 'VCC', NetType.POWER, [p(rHall, '1')]);
    K.join(doc, 'HALL', NetType.SIGNAL, [
        p(mcu, 'P8', 'P8'), p(hall, '1'), p(rHall, '2')
    ]);
    K.join(doc, 'GND', NetType.GROUND, [p(hall, '2')]);
    // LDR åˆ†å‹ â†’ ADC
    const ldr = K.place(doc, 'LDR', 'LDR1', { x: 520, y: 320 });
    const rLdr = R(doc, 'R_10k', 'R3', 420, 320);
    const vm = K.place(doc, 'VOLTMETER_DC', 'M1', { x: 620, y: 280 });
    K.join(doc, 'VCC', NetType.POWER, [p(rLdr, '1')]);
    K.join(doc, 'ADC', NetType.SIGNAL, [
        p(mcu, 'P9', 'P9'), p(rLdr, '2'), p(ldr, '1'), p(vm, 'V+', 'V+')
    ]);
    K.join(doc, 'GND', NetType.GROUND, [p(ldr, '2'), p(vm, 'COM', 'COM')]);
}
/** lab_instruments: åˆ†å‹ç½‘ç»œæ¥å…¨éƒ¨ä»ªå™¨ */
export function buildLabInstruments(doc) {
    const vcc = K.place(doc, 'VCC', 'PWR1', { x: 40, y: 80 });
    const gnd = K.place(doc, 'GND', 'GND1', { x: 40, y: 400 });
    const am = K.place(doc, 'AMMETER_DC', 'A1', { x: 140, y: 140 });
    const r1 = R(doc, 'R_10k', 'R1', 240, 160);
    const r2 = R(doc, 'R_10k', 'R2', 360, 160);
    K.join(doc, 'VCC', NetType.POWER, [p(vcc, '1', 'VCC'), p(am, 'I+', 'I+')]);
    K.series2(doc, 'HI', p(am, 'I-', 'I-'), p(r1, '1'));
    K.series2(doc, 'MID', p(r1, '2'), p(r2, '1'));
    K.join(doc, 'GND', NetType.GROUND, [p(r2, '2'), p(gnd, '1', 'GND')]);
    const vm = K.place(doc, 'VOLTMETER_DC', 'M1', { x: 480, y: 80 });
    K.join(doc, 'MID', NetType.SIGNAL, [p(vm, 'V+', 'V+')]);
    K.join(doc, 'GND', NetType.GROUND, [p(vm, 'COM', 'COM')]);
    const virt = K.place(doc, 'VIRTUAL_METER', 'VM1', { x: 480, y: 180 });
    K.join(doc, 'MID', NetType.SIGNAL, [p(virt, 'V', 'V')]);
    K.join(doc, 'GND', NetType.GROUND, [p(virt, 'COM', 'COM')]);
    const pm = K.place(doc, 'POWER_METER', 'PM1', { x: 600, y: 120 });
    K.join(doc, 'HI', NetType.SIGNAL, [p(pm, 'V+', 'V+'), p(pm, 'I+', 'I+')]);
    K.join(doc, 'GND', NetType.GROUND, [p(pm, 'V-', 'V-'), p(pm, 'I-', 'I-')]);
    const fc = K.place(doc, 'FREQ_COUNTER', 'FC1', { x: 600, y: 260 });
    K.join(doc, 'MID', NetType.SIGNAL, [p(fc, 'IN', 'IN')]);
    K.join(doc, 'GND', NetType.GROUND, [p(fc, 'GND', 'GND')]);
    const osc = K.place(doc, 'OSCILLOSCOPE', 'OSC1', { x: 740, y: 140 });
    K.join(doc, 'HI', NetType.SIGNAL, [p(osc, 'CH1', 'CH1')]);
    K.join(doc, 'MID', NetType.SIGNAL, [p(osc, 'CH2', 'CH2')]);
    K.join(doc, 'GND', NetType.GROUND, [p(osc, 'GND', 'GND')]);
}
