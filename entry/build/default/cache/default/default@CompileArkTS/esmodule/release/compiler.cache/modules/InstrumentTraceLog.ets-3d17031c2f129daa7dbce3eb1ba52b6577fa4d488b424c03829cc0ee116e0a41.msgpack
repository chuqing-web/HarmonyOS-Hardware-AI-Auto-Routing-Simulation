export function traceAnalogDeviceStamp(refDes, devId, libraryId, nodeA, nodeB, detail) {
    const shorted = nodeA === nodeB ? ' SHORTED' : '';
    Logger.info(INSTR_TRACE_TAG, `[MNA] ${refDes} ${devId} lib=${libraryId} ${nodeA}->${nodeB}${shorted} ${detail}`);
}
