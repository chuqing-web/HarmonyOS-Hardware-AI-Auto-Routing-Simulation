function getMaxFlashSize(family) {
    if (family === McuFamily.MCU_8051) {
        return 0xFFFF;
    }
    if (family === McuFamily.MCU_STM32F1) {
        return 0x10000;
    }
    if (family === McuFamily.MCU_STM32F4) {
