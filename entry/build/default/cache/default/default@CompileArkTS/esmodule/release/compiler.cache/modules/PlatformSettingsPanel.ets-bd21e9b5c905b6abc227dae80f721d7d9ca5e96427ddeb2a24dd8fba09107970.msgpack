                this.appService.privacyCleanup();
                this.statusMessage = 'å·²æ¸…ç† AI ç¼“å­˜ä¸ä¸´æ—¶æ–‡ä»¶';
              }
            })
            ProteusClassicBtn({
              label: 'åŒæ„éšç§æ”¿ç­–',
              widthVal: '92%',
              onAction: () => {
                void this.appService.acceptPrivacyPolicy();
                this.statusMessage = 'å·²è®°å½•éšç§æ”¿ç­–åŒæ„';
              }
            })
          }
          .width('100%')
          .padding({ left: 8, right: 8, top: 4, bottom: 12 })
