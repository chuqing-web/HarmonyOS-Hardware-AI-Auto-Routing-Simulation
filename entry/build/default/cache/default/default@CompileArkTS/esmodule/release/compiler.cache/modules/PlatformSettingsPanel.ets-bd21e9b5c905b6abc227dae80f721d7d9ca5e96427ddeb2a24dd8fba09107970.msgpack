              .width(110)
            Slider({ value: this.uiScale, min: 100, max: 150, step: 25 })
              .layoutWeight(1)
              .onChange((v: number) => {
                this.uiScale = v;
                this.applyAccessibility();
              })
          }
          .width('100%')
          .padding({ left: 8, right: 8, top: 4, bottom: 4 })

