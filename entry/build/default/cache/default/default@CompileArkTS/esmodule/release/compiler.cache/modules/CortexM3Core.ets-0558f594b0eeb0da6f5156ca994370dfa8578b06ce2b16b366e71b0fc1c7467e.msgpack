        this.exceptionActive.pop();
        // ç¡¬ä»¶è‡ªåŠ¨å‡ºæ ˆ
        let addr = this.sp;
        this.setReg(0, this.readMem32(addr));
        addr += 4;
        this.setReg(1, this.readMem32(addr));
        addr += 4;
        this.setReg(2, this.readMem32(addr));
        addr += 4;
        this.setReg(3, this.readMem32(addr));
        addr += 4;
        this.setReg(12, this.readMem32(addr));
        addr += 4;
        this.lr = this.readMem32(addr);
        addr += 4;
        this.pc = this.readMem32(addr);
        addr += 4;
        this.sp += 32;
