    /** PUSH multi (2.1.2) */
    pushMulti(hw) {
        const regList = hw & 0xFF;
        let count = 0;
        for (let r = 0; r < 8; r++) {
            if (regList & (1 << r))
                count++;
        }
        this.sp -= count * 4;
        let addr = this.sp;
        for (let r = 0; r < 8; r++) {
            if (regList & (1 << r)) {
                this.writeMem32(addr, this.reg(r));
                addr += 4;
            }
        }
