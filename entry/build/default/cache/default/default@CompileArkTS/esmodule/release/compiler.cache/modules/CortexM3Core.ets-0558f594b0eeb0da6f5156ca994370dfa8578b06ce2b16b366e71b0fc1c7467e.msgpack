    mulReg(hw) { const rd = hw & 0x7; const rn = (hw >> 3) & 0x7; this.setReg(rd, (this.reg(rn) * this.reg(rd)) >>> 0); this.pc += 2; }
    eorReg(hw) { const rd = hw & 0x7; const rn = (hw >> 3) & 0x7; this.setReg(rd, this.reg(rd) ^ this.reg(rn)); this.pc += 2; }
