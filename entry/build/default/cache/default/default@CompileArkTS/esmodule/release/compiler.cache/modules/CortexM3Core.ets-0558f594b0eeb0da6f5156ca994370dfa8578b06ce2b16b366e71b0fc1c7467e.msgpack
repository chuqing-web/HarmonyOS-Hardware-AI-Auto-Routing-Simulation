    addImm3(hw) { const rd = hw & 0x7; const imm = (hw >> 6) & 0x7; this.setReg(rd, this.reg(rd) + imm); this.pc += 2; }
    subImm3(hw) { const rd = hw & 0x7; const imm = (hw >> 6) & 0x7; this.setReg(rd, this.reg(rd) - imm); this.pc += 2; }
    addImm8(hw) { const rd = (hw >> 8) & 0x7; this.setReg(rd, this.reg(rd) + (hw & 0xFF)); this.pc += 2; }
    subImm8(hw) { const rd = (hw >> 8) & 0x7; this.setReg(rd, this.reg(rd) - (hw & 0xFF)); this.pc += 2; }
    andsImm5(hw) { const rd = hw & 0x7; const rm = (hw >> 3) & 0x7; this.setReg(rd, this.reg(rd) & this.reg(rm)); this.pc += 2; }
    lslsImm5(hw) { const rd = hw & 0x7; const rm = (hw >> 3) & 0x7; this.setReg(rd, this.reg(rd) << (rm & 0xFF)); this.pc += 2; }
    lsrsImm5(hw) { const rd = hw & 0x7; const rm = (hw >> 3) & 0x7; this.setReg(rd, this.reg(rd) >>> (rm & 0xFF)); this.pc += 2; }
    asrsImm5(hw) { const rd = hw & 0x7; const rm = (hw >> 3) & 0x7; this.setReg(rd, this.reg(rd) >> (rm & 0xFF)); this.pc += 2; }
