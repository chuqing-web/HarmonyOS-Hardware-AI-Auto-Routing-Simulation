        if (!gate.success) {
            return ResultHelper.fail(gate.errCode, gate.error);
        }
        const result = this.simulationKernel.injectFault(instUuid, faultType);
        if (result.success) {
            this.reloadSimulationFromSchematic();
        }
        return result;
