class BomLookupImpl {
    constructor(lib) {
        this.lib = lib;
    }
    getDisplayName(libraryId) {
        const r = this.lib.getComponent(libraryId);
        return r.success && r.data !== undefined ? r.data.name : libraryId;
    }
    getDefaultValue(libraryId) {
        const r = this.lib.getComponent(libraryId);
        if (r.success && r.data !== undefined) {
            const keys = ['value', 'Value', 'resistance', 'capacitance', 'voltage'];
            for (let i = 0; i < keys.length; i++) {
                const v = paramMapGet(r.data.defaultParams, keys[i], '');
                if (v.length > 0) {
                    return v;
                }
            }
        }
        return '';
    }
}
export class AppService {
