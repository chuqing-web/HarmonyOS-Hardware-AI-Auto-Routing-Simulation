  }

  /**
   * äº¤å‰ç‚¹æ˜¯å¦è¿œç¦»åŒæ–¹å…¨éƒ¨ç«¯ç‚¹ï¼ˆçœŸÂ·ä¸­æ®µç©¿è¶Šï¼Œé T æ¥/å…±ç«¯ç‚¹ï¼‰ã€‚
   */
  static isMidspanCross(
    cross: Point2D,
    aEnds: Point2D[],
    bEnds: Point2D[],
    endTol: number = 3
  ): boolean {
