 * æ ‡å·é”šç‚¹é¡»è½åœ¨å¯¼çº¿ç«¯ç‚¹æˆ–çº¿æ®µä¸Šï¼Œç¦æ­¢ 1.5Ã—grid æ¾å¸é™„è¯¯å¹¶é‚» stubã€‚
 */
export function labelCopperTouchTol(gridSize: number): number {
  const g = gridSize > 0 ? gridSize : 10;
  return Math.max(g * 0.5, 5);
}

/**
