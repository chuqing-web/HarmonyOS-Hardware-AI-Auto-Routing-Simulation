      '- å·¥å…·è¾¹ç•Œï¼šjoints ç”¨ä½å·ï¼›ç”µæºå…³èŠ‚å¿…æœ‰ POWER.VCC/GND';
  } else if (key === 'edit_plan') {
    body = 'ã€æœ¬é˜¶æ®µèƒ½åŠ› â€” edit_planã€‘:\n' +
      '- è¾“å‡ºï¼šå¢é‡ç¼–è¾‘ JSONï¼ˆaddRequireList/removeRefs/moves/netsï¼‰\n' +
      '- ä¸å¯ç”¨ï¼šself_review fixAction æšä¸¾ï¼ˆç”¨ç¼–è¾‘å­—æ®µè¡¨è¾¾å˜æ›´ï¼‰\n' +
      '- å·¥å…·è¾¹ç•Œï¼šnets èµ°å¢é‡ mergeï¼›ç¦æ­¢æ•´å›¾æ¨¡æ¿æ›¿æ¢';
  } else if (key === 'gen_sch') {
    body = 'ã€æœ¬é˜¶æ®µèƒ½åŠ› â€” gen_schï¼ˆé—ç•™ï¼‰ã€‘:\n' +
      '- éç”Ÿäº§æ•´å›¾è·¯å¾„ï¼›ç”Ÿäº§è¯·èµ° full pipeline\n' +
      '- ä¸å¯ç”¨ï¼šå½“ä½œæ¨¡æ¿å›é€€å…¥å£';
  } else if (key === 'pcb_placement') {
    body = 'ã€æœ¬é˜¶æ®µèƒ½åŠ› â€” pcb_placementã€‘:\n' +
      '- è¾“å‡ºï¼šboardWidthMil/boardHeightMilï¼ˆå¿…å¡«ï¼Œå®šæ¿å°ºå¯¸ï¼‰+ placements + groups + lockedIds\n' +
      '- å½“å‰æ¿æ¡†ä»…ä¾›å‚è€ƒï¼›é¡»ç”±æ¨¡å‹é‡æ–°ç»™å‡ºå®½é«˜ï¼ˆmilï¼‰\n' +
      '- å®‰è£…å­”å†™å…¥ lockedIdsï¼ˆç³»ç»ŸæŒ‰æ–°æ¿å››è§’é‡é’‰ï¼‰ï¼›ç¦æ­¢åŸä½å¤è¯»ï¼ˆecho é—¨ç¦ï¼‰\n' +
      '- footprintId å¿…é¡»é€å­—å¤åˆ¶åˆ—è¡¨ idï¼Œç¦æ­¢ç¼–é€ \n' +
      '- groups ä»…åŠŸèƒ½åˆ†ç»„ä¸”é¡»ç©ºé—´èšé›†ï¼›ç¦æ­¢æŠŠå®‰è£…å­”/MOUNT æ”¾å…¥ groups\n' +
      '- å·¥å…·ï¼šç„Šç›˜è¯¦è¡¨ï¼ˆxy/layers/typeï¼‰å·²æ³¨å…¥ï¼›å¼‚ç½‘ç„Šç›˜å‹¿å…±çº¿å †å \n' +
      '- ä¸å¯ç”¨ï¼štrack/via æŠ˜ç‚¹åæ ‡ï¼›æœ¬åœ°ç½‘æ ¼å†’å……å¸ƒå±€\n' +
      '- å·¥å…·è¾¹ç•Œï¼šå®šæ¿+ä½å§¿ï¼›å±‚ç­–ç•¥ pcb_routeï¼›æŠ˜çº¿/è¿‡å­” pcb_geometry';
  } else if (key === 'pcb_net_plan') {
    body = 'ã€æœ¬é˜¶æ®µèƒ½åŠ› â€” pcb_net_planã€‘:\n' +
      '- è¾“å‡ºï¼šnets[] kind/routeMode/priority/layerHint/busYOffset + priorityOrder\n' +
      '- Cu=2 æœ‰ä¿¡å·æ—¶ç”µæº/åœ°ä¼˜å…ˆ forceTrackï¼ˆå‹¿ forcePourï¼‰\n' +
      '- busYOffsetï¼šåŒå±‚å¤šç”µæº Y é”™å¼€ï¼›layerHint ä¾›å‡ ä½•é€‰å±‚\n' +
      '- å·¥å…·ï¼šç„Šç›˜æ‘˜è¦+è¯¦è¡¨ï¼ˆå« MOUNT æ ‡è®°ï¼‰ï¼›å®‰è£…å­”ä¸å¼ºåˆ¶è¿é€š\n' +
      '- ä¸å¯ç”¨ï¼šå‘æ˜æ–°ç”µæ°”ç½‘ï¼›è¾“å‡ºé“œçº¿åæ ‡\n' +
      '- å·¥å…·è¾¹ç•Œï¼šè¦†ç›–å·²æœ‰ç½‘ç»œç­–ç•¥ï¼›å±‚è§’è‰²ç•™ç»™ pcb_route';
  } else if (key === 'pcb_route') {
