      TextArea({
        placeholder: 'ä¾‹å¦‚ï¼šSTM32F103 æœ€å°ç³»ç»Ÿ + LED é—ªçƒï¼Œå«ç¤ºæ³¢å™¨è§‚å¯Ÿ',
        text: this.promptText
      })
        .height(72)
