        const noFallback = await validator.validateApiFailureFallback();
        const lines = [];
        lines.push(`[LEDæœ€å°ç³»ç»Ÿ] ${led.passed ? 'PASS' : 'FAIL'}: ${led.checks.join('; ')}`);
        if (led.failures.length > 0)
            lines.push(`  å¤±è´¥: ${led.failures.join('; ')}`);
        lines.push(`[å¹»è§‰æ‹¦æˆª] ${ood.success ? 'PASS' : 'FAIL'}`);
