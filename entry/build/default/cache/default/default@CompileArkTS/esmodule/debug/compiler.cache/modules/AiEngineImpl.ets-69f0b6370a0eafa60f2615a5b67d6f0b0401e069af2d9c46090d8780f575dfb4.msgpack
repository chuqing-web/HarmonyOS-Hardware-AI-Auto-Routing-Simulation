            const w = doc.wires[i];
            routeLines.push(makeRouteLine(w.netId, w.points, false));
        }
        let totalLength = 0;
        for (let i = 0; i < doc.wires.length; i++) {
            totalLength += doc.wires[i].points.length * 10;
        }
        const result = {
            routeLines: routeLines,
