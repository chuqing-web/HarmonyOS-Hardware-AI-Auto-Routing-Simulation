            priorities.set(hint.netName, 7);
        }
        else if (hint.isPower) {
            priorities.set(hint.netName, 10);
        }
        else if (!priorities.has(hint.netName)) {
            priorities.set(hint.netName, 2);
        }
    }
    return priorities;
}
