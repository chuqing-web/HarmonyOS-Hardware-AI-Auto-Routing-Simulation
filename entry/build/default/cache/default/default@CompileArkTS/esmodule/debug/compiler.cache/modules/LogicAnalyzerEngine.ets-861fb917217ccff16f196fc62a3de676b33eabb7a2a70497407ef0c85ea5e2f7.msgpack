      }
      return waves;
    }

    // Use digital states keyed by net UUID / node name
    if (this.digitalStates.size > 0) {
      const keys: string[] = [];
      this.digitalStates.forEach((_level: number, key: string) => {
        const upper = key.toUpperCase();
        if (upper !== '0' && upper !== 'GND' && upper !== 'VCC' && upper !== 'VDD') {
          keys.push(key);
        }
