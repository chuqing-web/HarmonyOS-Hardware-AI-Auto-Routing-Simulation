  return { x: boardCx + x0, y: boardCy + y0 };
}

export function dist3(a: Point2D, b: Point2D): number {
  const dx = a.x - b.x;
  const dy = a.y - b.y;
  return Math.sqrt(dx * dx + dy * dy);
}

