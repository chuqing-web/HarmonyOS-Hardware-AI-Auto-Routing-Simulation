    if (L > bestLen) {
      bestLen = L;
      bestI = i;
    }
  }
  if (bestLen < pitch * 2) {
    return path.slice();
  }

  const a = path[bestI];
  const b = path[bestI + 1];
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  // å‚ç›´æ–¹å‘
  const px = -uy;
  const py = ux;

