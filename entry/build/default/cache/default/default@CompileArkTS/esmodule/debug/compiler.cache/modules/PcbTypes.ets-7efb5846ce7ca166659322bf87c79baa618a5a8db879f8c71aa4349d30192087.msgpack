}

export enum PcbDrcSeverity {
  ERROR = 'error',
  WARNING = 'warning'
}

export enum PcbDrcRuleType {
  CLEARANCE = 'clearance',
  UNROUTED_NET = 'unrouted_net',
  OFF_BOARD = 'off_board',
  SHORT = 'short',
  MIN_WIDTH = 'min_width',
  VIA_ANNULAR = 'via_annular',
  PAD_CLEARANCE = 'pad_clearance',
  DIFF_LENGTH = 'diff_length',
  KEEPOUT = 'keepout'
}

export interface PcbDrcViolation {
