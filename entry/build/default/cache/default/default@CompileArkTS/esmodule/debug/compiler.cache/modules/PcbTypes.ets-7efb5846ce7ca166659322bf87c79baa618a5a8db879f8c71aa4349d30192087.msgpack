export function defaultPcbDesignRules() {
    return {
        minTrackWidth: 6,
        minClearance: 6,
        minViaDrill: 12,
        defaultTrackWidth: 10,
        minAnnularRing: 4,
        minHoleToHole: 10,
        minSilkHeight: 31,
        silkToPadClearance: 8
    };
}
export function defaultPcbNetClasses() {
