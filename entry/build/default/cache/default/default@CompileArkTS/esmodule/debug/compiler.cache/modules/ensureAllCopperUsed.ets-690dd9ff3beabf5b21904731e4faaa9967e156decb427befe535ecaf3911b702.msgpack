import { copperLayersFromStack } from '../../types/PcbTypes';
import { IdUtil } from '../IdUtil';
import { pathClearBlockReason, trackWidthForNet, viaClearAt } from './PcbClearanceOracle';
import { resolveViaGeometry } from './PcbViaCostModel';
import { tracePcbWarn } from '../PcbTraceLog';
export function ensureAllCopperUsed(doc, tracks, zonesCountAsUsed = true) {
    const copper = copperLayersFromStack(doc.layerStack);
    const used = new Set();
    for (let i = 0; i < tracks.length; i++) {
        used.add(tracks[i].layer);
    }
    if (zonesCountAsUsed) {
        for (let i = 0; i < doc.zones.length; i++) {
            used.add(doc.zones[i].layer);
        }
    }
    const missing = [];
    for (let i = 0; i < copper.length; i++) {
        const lid = copper[i];
        if (!used.has(lid)) {
            missing.push(lid);
        }
    }
    return missing;
}
function findRoleLayer(policy, role) {
    const keys = Object.keys(policy.layerRoles);
    for (let i = 0; i < keys.length; i++) {
        if (policy.layerRoles[keys[i]] === role) {
            return keys[i];
        }
    }
    return null;
}
function pickNetForRole(role, netPlan, routed) {
    const preferGnd = role === 'gnd_bus';
    const preferPower = role === 'vcc_bus' || role === 'power_h' || role === 'power_v';
    for (let i = 0; i < netPlan.nets.length; i++) {
        const n = netPlan.nets[i];
        if (n.routeMode === 'defer') {
            continue;
        }
        if (preferGnd && n.kind === 'gnd') {
            return n;
        }
        if (preferPower && n.kind === 'power') {
            return n;
        }
    }
    for (let i = 0; i < netPlan.nets.length; i++) {
        const n = netPlan.nets[i];
        if (routed.indexOf(n.netId) >= 0) {
            return n;
        }
    }
    for (let i = 0; i < netPlan.nets.length; i++) {
        if (netPlan.nets[i].routeMode !== 'defer') {
            return netPlan.nets[i];
        }
    }
    return null;
}
/**
 * ä¸ºå£°æ˜ä½†æœªç”¨åˆ°çš„é“œå±‚è¡¥çœŸå®çŸ­æ®µï¼ˆæŒ‚å·²æœ‰ç”µæ°”ç½‘ï¼‰ï¼›é¡»è¿‡ clearanceï¼Œå¤±è´¥åˆ™è·³è¿‡è¯¥å±‚ã€‚
 * æ—  role æ—¶æŒ‰ signal_h å¤„ç†ï¼Œé¿å…ç©ºè§’è‰²å±‚è¢«æ°¸ä¹…è·³è¿‡ã€‚
 */
export function fillUnusedCopperLayers(doc, policy, netPlan, tracks, vias, routedNetIds, missing) {
    if (missing.length === 0) {
        return;
    }
    const grid = doc.metadata.gridSize ?? 5;
    const outline = doc.boardOutline?.points ?? [];
    let cx = 100;
    let cy = 100;
    if (outline.length > 0) {
        let sx = 0;
        let sy = 0;
        for (let i = 0; i < outline.length; i++) {
            sx += outline[i].x;
            sy += outline[i].y;
        }
        cx = Math.round(sx / outline.length / grid) * grid;
        cy = Math.round(sy / outline.length / grid) * grid;
    }
    const copperAll = copperLayersFromStack(doc.layerStack);
    const stub = findRoleLayer(policy, 'stub') ??
        (copperAll.length > 0 ? copperAll[0] : null);
    for (let mi = 0; mi < missing.length; mi++) {
        const lid = missing[mi];
        let role = policy.layerRoles[lid];
        if (!role) {
            // æ— è§’è‰²ä»é¡»å å±‚ï¼šæŒ‰å å±‚ä½ç½®æ¨æ–­
            if (copperAll.length > 0 && lid === copperAll[0]) {
                role = 'stub';
            }
            else if (copperAll.length > 0 && lid === copperAll[copperAll.length - 1]) {
                role = 'power_h';
            }
            else {
                const idx = copperAll.indexOf(lid);
                role = (idx >= 0 && (idx % 2) === 1) ? 'signal_h' : 'signal_v';
            }
            policy.layerRoles[lid] = role;
        }
        const ne = pickNetForRole(role, netPlan, routedNetIds);
        if (!ne) {
            continue;
        }
        const width = Math.max(trackWidthForNet(doc, ne.netId), grid);
        const horiz = role === 'signal_h' || role === 'power_h' || role === 'gnd_bus' ||
            role === 'vcc_bus' || role === 'stub';
        let placed = false;
        const yBases = [
            mi * grid * 4,
            mi * grid * 4 + grid * 10,
            0 - mi * grid * 4 - grid * 8,
            mi * grid * 6 + grid * 20,
            0 - mi * grid * 6 - grid * 16,
            grid * 30,
            0 - grid * 30
        ];
        const xBases = [0, grid * 12, 0 - grid * 12, grid * 24, 0 - grid * 24];
        for (let yi = 0; yi < yBases.length && !placed; yi++) {
            for (let xi = 0; xi < xBases.length && !placed; xi++) {
                const yOff = yBases[yi];
                const xOff = xBases[xi];
                const a = horiz
                    ? { x: cx - grid * 8 + xOff, y: cy + yOff }
                    : { x: cx + yOff + xOff, y: cy - grid * 8 };
                const b = horiz
                    ? { x: cx + grid * 8 + xOff, y: cy + yOff }
                    : { x: cx + yOff + xOff, y: cy + grid * 8 };
                const block = pathClearBlockReason(doc, lid, a, b, ne.netId, width, tracks, vias);
                if (block !== null) {
                    continue;
                }
                tracks.push({
                    id: IdUtil.generate('trk'),
                    layer: lid,
                    start: a,
                    end: b,
                    width,
                    netId: ne.netId,
                    netName: ne.netName
                });
                if (stub && stub !== lid) {
                    const spec = resolveViaGeometry(doc, stub, lid, 0, 0);
                    if (viaClearAt(doc, a, ne.netId, spec.diameter, spec.layers, tracks, vias)) {
                        vias.push({
                            id: IdUtil.generate('via'),
                            position: { x: a.x, y: a.y },
                            drill: spec.drill,
                            diameter: spec.diameter,
                            netId: ne.netId,
                            netName: ne.netName,
                            layers: spec.layers,
                            kind: spec.kind
                        });
                    }
                }
                placed = true;
            }
        }
        if (!placed) {
            tracePcbWarn('AI_CU_FILL', `skip filler on ${lid} â€” no clear corridor for ${ne.netName}`);
        }
    }
}
