            ammeters[i].y = this.snap(mcu.y - 140 + i * 100);
            ammeters[i].rotate = 0;
        }
        // å…¶ä»–ä»ªå™¨é å³å¤–ä¾§æ’åˆ—
        const instruments = topo.deviceList.filter(d => {
            const id = d.libDevId.toUpperCase();
