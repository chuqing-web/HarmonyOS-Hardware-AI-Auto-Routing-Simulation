                fitnessScore: s.fitness
            };
            top3.push(candidate);
        }
        const best = finalScored[0];
        const topo = this.buildTopology(matched, best.chrom, existingTopo);
        this.postProcessAlign(topo, constraints);
        return { topology: topo, candidates: top3, selectedIndex: 0 };
    }
