import { IdUtil, makeDeviceInst } from 'common';
import { getModuleGroupLists, moduleGroupToRecord, positionsFromChromosome, positionsToRecord, getModuleGroupValues } from '../internal/AiEngineHelpers';
import { runPlacementGaAsync } from './PlacementGaWorker';
const GRID = 10;
const CANVAS_W = 800;
const CANVAS_H = 600;
const POP_SIZE = 60;
