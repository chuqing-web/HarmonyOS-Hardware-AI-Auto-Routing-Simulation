                this.appendLog('system', 'ç”»å¸ƒå·²è§£é” Â· æ¿æœªæ”¹åŠ¨');
                if (detail.length === 0) {
                    this.statusMessage = 'PCB AI route failed (board unchanged)';
                }
            }
        }
        finally {
            this.appService.onAiProgress = prevProgress;
            this.aiBusy = this.appService.isAiGenerating();
