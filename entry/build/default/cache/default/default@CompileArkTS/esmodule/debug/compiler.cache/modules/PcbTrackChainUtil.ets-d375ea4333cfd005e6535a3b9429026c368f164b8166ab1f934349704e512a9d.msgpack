/**
 * æŠŠç¦»æ•£ PcbTrack æ®µåˆå¹¶ä¸ºæŠ˜çº¿ã€‚T å­—æ¥å¤´ä¼šæ‹†æˆå¤šæ¡æŠ˜çº¿ï¼Œè°ƒç”¨æ–¹åº”åœ¨èŠ‚ç‚¹ç”»åœ†è§’ç„Šç›˜è¡¥é½ã€‚
 */
export function buildTrackPolylines(tracks) {
    const out = [];
    if (tracks.length === 0)
        return out;
    const groups = new Map();
    for (let i = 0; i < tracks.length; i++) {
        const t = tracks[i];
        const k = groupKey(t);
        let arr = groups.get(k);
        if (!arr) {
            arr = [];
            groups.set(k, arr);
        }
        arr.push(t);
    }
    groups.forEach((segs) => {
        const used = [];
        for (let i = 0; i < segs.length; i++)
            used.push(false);
        // ç«¯ç‚¹ â†’ æ®µä¸‹æ ‡
        const atPoint = new Map();
        const addEnd = (x, y, idx) => {
            const k = ptKey(x, y);
            let list = atPoint.get(k);
            if (!list) {
                list = [];
                atPoint.set(k, list);
            }
            list.push(idx);
        };
        for (let i = 0; i < segs.length; i++) {
            addEnd(segs[i].start.x, segs[i].start.y, i);
            addEnd(segs[i].end.x, segs[i].end.y, i);
        }
        const degree = (x, y) => {
            const list = atPoint.get(ptKey(x, y));
            return list !== undefined ? list.length : 0;
        };
        const findNext = (from, excludeIdx) => {
            const list = atPoint.get(ptKey(from.x, from.y));
            if (!list)
                return -1;
            for (let j = 0; j < list.length; j++) {
                const idx = list[j];
                if (idx === excludeIdx || used[idx])
                    continue;
                return idx;
            }
            return -1;
        };
        const pickSeed = () => {
            // ä¼˜å…ˆä»åº¦æ•°=1 çš„ç«¯ç‚¹å‡ºå‘ï¼Œå¾—åˆ°æœ€é•¿å¼€é“¾
            for (let i = 0; i < segs.length; i++) {
                if (used[i])
                    continue;
                if (degree(segs[i].start.x, segs[i].start.y) === 1 ||
                    degree(segs[i].end.x, segs[i].end.y) === 1) {
                    return i;
                }
            }
            for (let i = 0; i < segs.length; i++) {
                if (!used[i])
                    return i;
            }
            return -1;
        };
        let guard = 0;
        while (guard++ < segs.length + 2) {
            const seed = pickSeed();
            if (seed < 0)
                break;
            used[seed] = true;
            const seedT = segs[seed];
            const pts = [
                { x: seedT.start.x, y: seedT.start.y },
                { x: seedT.end.x, y: seedT.end.y }
            ];
            const ids = [seedT.id];
            // å‘ç»ˆç‚¹æ–¹å‘å»¶ä¼¸
            let tip = pts[pts.length - 1];
            let prevIdx = seed;
            let extGuard = 0;
            while (extGuard++ < segs.length) {
                // åº¦æ•°>2 ä¸º T/åå­—ï¼Œåœæ­¢å»¶ä¼¸ï¼Œç•™ç»™å…¶å®ƒæŠ˜çº¿
                if (degree(tip.x, tip.y) > 2)
                    break;
                const nxt = findNext(tip, prevIdx);
                if (nxt < 0)
                    break;
                used[nxt] = true;
                const t = segs[nxt];
                ids.push(t.id);
                if (samePt(t.start, tip)) {
                    pts.push({ x: t.end.x, y: t.end.y });
                    tip = pts[pts.length - 1];
                }
                else {
                    pts.push({ x: t.start.x, y: t.start.y });
                    tip = pts[pts.length - 1];
                }
                prevIdx = nxt;
            }
            // å‘èµ·ç‚¹æ–¹å‘å»¶ä¼¸ï¼ˆå¾€æ•°ç»„å¤´æ’ï¼‰
            tip = pts[0];
            prevIdx = seed;
            extGuard = 0;
            while (extGuard++ < segs.length) {
                if (degree(tip.x, tip.y) > 2)
                    break;
                const nxt = findNext(tip, prevIdx);
                if (nxt < 0)
                    break;
                used[nxt] = true;
                const t = segs[nxt];
                ids.unshift(t.id);
                if (samePt(t.start, tip)) {
                    pts.unshift({ x: t.end.x, y: t.end.y });
                }
                else {
                    pts.unshift({ x: t.start.x, y: t.start.y });
                }
                tip = pts[0];
                prevIdx = nxt;
            }
            out.push({
                layer: seedT.layer,
                netId: seedT.netId,
                netName: seedT.netName,
                width: seedT.width,
                points: pts,
                trackIds: ids
            });
        }
    });
    return out;
}
/** æŠ˜çº¿æ‰€æœ‰æ‹ç‚¹ï¼ˆå«ç«¯ç‚¹ï¼‰ï¼Œç”¨äºç”»åœ†è§’æ¥å¤´å¡«æ»¡æ‹è§’ */
export function polylineJointPoints(poly) {
    return poly.points;
}
//# sourceMappingURL=PcbTrackChainUtil.js.mapÂÙLC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PcbTrackChainUtil.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¦commonÃÂÙ#C:\Projects\ElecDraw_Harmony\common¼C:\Projects\ElecDraw_Harmony¦common¥1.0.0ÔrC’§pkgNameªpkgVersion¦common¥1.0.0‘ÔrD’²hostDependencyName®hostModuleNameÙ&./src/main/ets/utils/PcbTrackChainUtil¦commonÙ#C:\Projects\ElecDraw_Harmony\commonÃÃÚv/**
 * å°†åŒç½‘åŒå±‚åŒå®½çš„èµ°çº¿æ®µä¸²æˆè¿ç»­æŠ˜çº¿ï¼Œæ‹è§’å¤„ä¸€æ¬¡ strokeï¼Œé¿å…æ¨ªç«–/æ–œçº¿æ®µâ€œæ–­å¼€â€æ„Ÿã€‚
