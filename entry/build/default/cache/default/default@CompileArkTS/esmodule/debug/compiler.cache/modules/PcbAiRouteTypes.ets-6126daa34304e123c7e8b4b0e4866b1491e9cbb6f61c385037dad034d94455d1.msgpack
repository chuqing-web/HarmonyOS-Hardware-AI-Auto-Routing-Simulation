export function policyCoversCopperLayers(policy, copperLayers) {
    const missing = [];
    for (let i = 0; i < copperLayers.length; i++) {
        const lid = copperLayers[i];
        if (!policy.layerRoles[lid]) {
            missing.push(lid);
        }
    }
    return missing;
}
function roleInPolicy(policy, role) {
    const keys = Object.keys(policy.layerRoles);
    for (let i = 0; i < keys.length; i++) {
        if (policy.layerRoles[keys[i]] === role) {
            return true;
        }
    }
    return false;
}
/**
