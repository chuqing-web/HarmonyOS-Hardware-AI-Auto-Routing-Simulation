/** æŒ‚ç‚¹ä¸Šä¸‹æ–‡ï¼ˆæ‘˜è¦æ–‡æœ¬ï¼Œæ§åˆ¶ tokenï¼‰ */
export interface PcbAutoRouteAgentContext {
