    aboutToAppear() {
        this.refreshList();
        if (this.defaultApiId.length > 0) {
            this.appService.aiApiManager.setLoadBalanceStrategy(LoadBalanceMode.SINGLE_DEFAULT);
            this.selectedStratIdx = 0;
        }
        else {
            this.selectedStratIdx = 1;
