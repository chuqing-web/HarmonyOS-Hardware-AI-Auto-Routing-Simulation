    }
    const expires = new Date(this.license.expiresAt).getTime();
    const now = Date.now();
    const daysRemaining = Math.max(0, Math.ceil((expires - now) / 86400000));
    if (now > expires) {
      this.license = null;
      return this.buildStatus(false, LicenseTier.FREE, 'æˆæƒå·²è¿‡æœŸ');
