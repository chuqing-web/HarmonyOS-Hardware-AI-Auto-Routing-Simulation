import { IdUtil } from './IdUtil';
import { copyStringMap, makeNetNodeRef, makeRouteLine, normalizeRotation } from './MapHelpers';
import { parsePinRef, buildPinRef } from './PinRefUtil';
import { TopologyPatchApplier } from './TopologyPatch';
export class TopologyAdapter {
    static toTopology(doc) {
        const netLabelList = [];
        if (doc.netLabels !== undefined) {
            for (let i = 0; i < doc.netLabels.length; i++) {
                const lb = doc.netLabels[i];
                netLabelList.push({
                    id: lb.id,
                    netUuid: lb.netId,
                    text: lb.text,
                    x: lb.position.x,
                    y: lb.position.y,
                    global: lb.global
                });
            }
        }
        return {
            schUuid: doc.id,
            schName: doc.name,
            layerDepth: 0,
            deviceList: doc.components.map(TopologyAdapter.toDeviceInst),
            netList: doc.nets.map(TopologyAdapter.toNetInfo),
            busList: [],
            wireList: doc.wires.map(w => makeRouteLine(w.netId, w.points, false)),
            subCircuitList: doc.subcircuits.map(TopologyAdapter.toSubBlock),
            probeList: [],
            textAnnotate: [],
            netLabelList: netLabelList,
            ercErrorList: [],
            gridStep: doc.metadata.gridSize,
            bgColor: '#0a0a1a'
        };
    }
    static fromTopology(topo) {
        const now = new Date().toISOString();
        const netLabels = [];
        const srcLabels = topo.netLabelList !== undefined ? topo.netLabelList : [];
        for (let i = 0; i < srcLabels.length; i++) {
            const lb = srcLabels[i];
            netLabels.push({
                id: lb.id.length > 0 ? lb.id : IdUtil.generate('lbl'),
                netId: lb.netUuid,
                text: lb.text,
                position: { x: lb.x, y: lb.y },
                global: lb.global
            });
        }
        return {
            id: topo.schUuid || IdUtil.generate('sch'),
            name: topo.schName,
            version: '2.0',
            components: topo.deviceList.map(TopologyAdapter.toComponent),
            wires: topo.wireList.map((w, _i) => {
                const wire = {
                    id: IdUtil.generate('wire'),
                    netId: w.netUuid,
                    points: w.points,
                    style: WireStyle.ORTHOGONAL
                };
                return wire;
            }),
            nets: topo.netList.map(TopologyAdapter.toNet),
            netLabels: netLabels,
            subcircuits: topo.subCircuitList.map(TopologyAdapter.toSubRef),
            metadata: {
                author: '',
                createdAt: now,
                modifiedAt: now,
                description: '',
                gridSize: topo.gridStep,
                units: 'mm',
                undoLimit: 1000
            }
        };
    }
    static toDeviceInst(c) {
        return {
            instUuid: c.id,
            libDevId: c.libraryId,
            refName: c.refDes,
            x: c.position.x,
            y: c.position.y,
            rotate: c.rotation,
            mirrorH: c.mirrored,
            mirrorV: false,
            params: copyStringMap(c.parameters),
            pinVoltage: new Map(),
            hidden: false,
            subCircuitRef: c.subcircuitId ?? '',
            ercErrorMsg: ''
        };
    }
    static toComponent(d) {
        const rotation = normalizeRotation(d.rotate);
        const comp = {
            id: d.instUuid,
            libraryId: d.libDevId,
            refDes: d.refName,
            position: { x: d.x, y: d.y },
            rotation: rotation,
            mirrored: d.mirrorH,
            parameters: copyStringMap(d.params)
        };
        if (d.subCircuitRef.length > 0) {
            comp.subcircuitId = d.subCircuitRef;
        }
        return comp;
    }
    static toNetInfo(n) {
        return {
            netUuid: n.id,
            netName: n.name,
            displayName: n.name,
            nodeList: n.pinIds.map((pinRef) => {
                const parsed = parsePinRef(pinRef);
                if (parsed !== null && parsed.compId.length > 0 && parsed.pinId.length > 0) {
                    return makeNetNodeRef(parsed.compId, parsed.pinId, parsed.pinName);
                }
                return makeNetNodeRef('', pinRef, pinRef);
            }),
            isPower: n.type === NetType.POWER || n.type === NetType.GROUND,
            isAnalog: false,
            isBusMember: n.type === NetType.BUS,
            busParentUuid: '',
            defaultVoltage: n.type === NetType.POWER ? 5.0 : 0.0,
            ercWarning: false,
            connectedProbeIds: []
        };
    }
    static toNet(n) {
        const upper = n.netName.toUpperCase();
        let netType = NetType.SIGNAL;
        if (n.isPower) {
            netType = (upper === 'GND' || upper === 'VSS' || upper === 'VEE' || upper === '0') ?
                NetType.GROUND : NetType.POWER;
        }
        else if (n.isBusMember) {
            netType = NetType.BUS;
        }
        else if (upper === 'GND' || upper === 'VSS' || upper === 'VEE') {
            netType = NetType.GROUND;
        }
        else if (upper === 'VCC' || upper === 'VDD') {
            netType = NetType.POWER;
        }
        return {
            id: n.netUuid,
            name: n.netName,
            type: netType,
            pinIds: n.nodeList.map(node => {
                if (node.devUuid.length > 0) {
                    const rawName = node.pinName;
                    const pinName = (rawName !== undefined && rawName.length > 0) ? rawName : node.pinId;
                    return buildPinRef(node.devUuid, node.pinId, pinName);
                }
                return node.pinId;
            })
        };
    }
    static toSubBlock(s) {
        const ports = s.ports ?? [];
        const portList = [];
        for (let i = 0; i < ports.length; i++) {
            const p = ports[i];
            let direction = 'inout';
            if (p.direction === 'input') {
                direction = 'in';
            }
            else if (p.direction === 'output') {
                direction = 'out';
            }
            portList.push({
                portId: p.id,
                portName: p.name,
                direction: direction,
                x: p.position.x,
                y: p.position.y
            });
        }
        return {
            subUuid: s.id,
            name: s.name,
            portList: portList,
            innerTopo: s.embeddedDocument ? TopologyAdapter.toTopology(s.embeddedDocument) : null
        };
    }
    static toSubRef(b) {
        const ports = [];
        for (let i = 0; i < b.portList.length; i++) {
            const p = b.portList[i];
            let direction = 'bidirectional';
            if (p.direction === 'in') {
                direction = 'input';
            }
            else if (p.direction === 'out') {
                direction = 'output';
            }
            ports.push({
                id: p.portId,
                name: p.portName,
                type: PinType.BIDIRECTIONAL,
                direction: direction,
                position: { x: p.x, y: p.y }
            });
        }
        const ref = {
            id: b.subUuid,
            name: b.name,
            documentId: b.subUuid,
            position: { x: 0, y: 0 },
            ports: ports
        };
        if (b.innerTopo) {
            ref.embeddedDocument = TopologyAdapter.fromTopology(b.innerTopo);
        }
        return ref;
    }
    static syncIncremental(doc, cached) {
        return TopologyPatchApplier.syncTopologyIncremental(doc, cached);
    }
}
//# sourceMappingURL=TopologyAdapter.js.mapÂ•ÙFC:\Projects\ElecDraw_Harmony\common\src\main\ets\types\CommonTypes.etsÙAC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\IdUtil.etsÙEC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\MapHelpers.etsÙEC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PinRefUtil.etsÙHC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\TopologyPatch.etsÙJC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\TopologyAdapter.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¦commonÃÂÙ#C:\Projects\ElecDraw_Harmony\common¼C:\Projects\ElecDraw_Harmony¦common¥1.0.0ÔrC’§pkgNameªpkgVersion¦common¥1.0.0’ÔrD’²hostDependencyName®hostModuleNameÙ$./src/main/ets/utils/TopologyAdapter¦commonD±./TopologyAdapter¦commonÙ#C:\Projects\ElecDraw_Harmony\commonÃÃÚ¨import {

  SchematicDocument, ComponentInstance, Net, NetType, SubcircuitRef, Port,

  WireStyle, PinType, Rotation, Wire, NetLabel

} from '../types/CommonTypes';

import {

  SchTopology, DeviceInst, NetInfo, SubCircuitBlock, SubCircuitPort, NetLabelInfo

} from '../types/TopologyTypes';

import { IdUtil } from './IdUtil';

import { copyStringMap, makeNetNodeRef, makeRouteLine, normalizeRotation } from './MapHelpers';
import { parsePinRef, buildPinRef } from './PinRefUtil';
import { TopologyPatchApplier } from './TopologyPatch';



export class TopologyAdapter {

  static toTopology(doc: SchematicDocument): SchTopology {

    const netLabelList: NetLabelInfo[] = [];
    if (doc.netLabels !== undefined) {
      for (let i = 0; i < doc.netLabels.length; i++) {
        const lb = doc.netLabels[i];
        netLabelList.push({
          id: lb.id,
          netUuid: lb.netId,
          text: lb.text,
          x: lb.position.x,
          y: lb.position.y,
          global: lb.global
        });
      }
    }

    return {

      schUuid: doc.id,

      schName: doc.name,

      layerDepth: 0,

      deviceList: doc.components.map(TopologyAdapter.toDeviceInst),

      netList: doc.nets.map(TopologyAdapter.toNetInfo),

      busList: [],

      wireList: doc.wires.map(w => makeRouteLine(w.netId, w.points, false)),

      subCircuitList: doc.subcircuits.map(TopologyAdapter.toSubBlock),

      probeList: [],

      textAnnotate: [],

      netLabelList: netLabelList,

      ercErrorList: [],

      gridStep: doc.metadata.gridSize,

      bgColor: '#0a0a1a'

    };

  }



  static fromTopology(topo: SchTopology): SchematicDocument {

    const now = new Date().toISOString();

    const netLabels: NetLabel[] = [];
    const srcLabels = topo.netLabelList !== undefined ? topo.netLabelList : [];
    for (let i = 0; i < srcLabels.length; i++) {
      const lb = srcLabels[i];
      netLabels.push({
        id: lb.id.length > 0 ? lb.id : IdUtil.generate('lbl'),
        netId: lb.netUuid,
        text: lb.text,
        position: { x: lb.x, y: lb.y },
        global: lb.global
      });
    }

    return {

      id: topo.schUuid || IdUtil.generate('sch'),

      name: topo.schName,

      version: '2.0',

      components: topo.deviceList.map(TopologyAdapter.toComponent),

      wires: topo.wireList.map((w, _i) => {
        const wire: Wire = {
          id: IdUtil.generate('wire'),
          netId: w.netUuid,
          points: w.points,
          style: WireStyle.ORTHOGONAL
        };
        return wire;
      }),

      nets: topo.netList.map(TopologyAdapter.toNet),

      netLabels: netLabels,

      subcircuits: topo.subCircuitList.map(TopologyAdapter.toSubRef),

      metadata: {

        author: '',

        createdAt: now,

        modifiedAt: now,

        description: '',

        gridSize: topo.gridStep,

        units: 'mm',

        undoLimit: 1000

      }

    };

  }



  static toDeviceInst(c: ComponentInstance): DeviceInst {

    return {

      instUuid: c.id,

      libDevId: c.libraryId,

      refName: c.refDes,

      x: c.position.x,

      y: c.position.y,

      rotate: c.rotation,

      mirrorH: c.mirrored,

      mirrorV: false,

      params: copyStringMap(c.parameters),

      pinVoltage: new Map<string, number>(),

      hidden: false,

      subCircuitRef: c.subcircuitId ?? '',

      ercErrorMsg: ''

    };

  }



  static toComponent(d: DeviceInst): ComponentInstance {

    const rotation: Rotation = normalizeRotation(d.rotate);

    const comp: ComponentInstance = {

      id: d.instUuid,

      libraryId: d.libDevId,

      refDes: d.refName,

      position: { x: d.x, y: d.y },

      rotation: rotation,

      mirrored: d.mirrorH,

      parameters: copyStringMap(d.params)

    };

    if (d.subCircuitRef.length > 0) {

      comp.subcircuitId = d.subCircuitRef;

    }

    return comp;

  }



  static toNetInfo(n: Net): NetInfo {

    return {

      netUuid: n.id,

      netName: n.name,

      displayName: n.name,

      nodeList: n.pinIds.map((pinRef: string) => {
        const parsed = parsePinRef(pinRef);
        if (parsed !== null && parsed.compId.length > 0 && parsed.pinId.length > 0) {
          return makeNetNodeRef(parsed.compId, parsed.pinId, parsed.pinName);
        }
        return makeNetNodeRef('', pinRef, pinRef);
      }),

      isPower: n.type === NetType.POWER || n.type === NetType.GROUND,

      isAnalog: false,

      isBusMember: n.type === NetType.BUS,

      busParentUuid: '',

      defaultVoltage: n.type === NetType.POWER ? 5.0 : 0.0,

      ercWarning: false,

      connectedProbeIds: []

    };

  }



  static toNet(n: NetInfo): Net {

    const upper = n.netName.toUpperCase();
    let netType = NetType.SIGNAL;
    if (n.isPower) {
      netType = (upper === 'GND' || upper === 'VSS' || upper === 'VEE' || upper === '0') ?
        NetType.GROUND : NetType.POWER;
    } else if (n.isBusMember) {
      netType = NetType.BUS;
    } else if (upper === 'GND' || upper === 'VSS' || upper === 'VEE') {
      netType = NetType.GROUND;
    } else if (upper === 'VCC' || upper === 'VDD') {
      netType = NetType.POWER;
    }

    return {

      id: n.netUuid,

      name: n.netName,

      type: netType,

      pinIds: n.nodeList.map(node => {
        if (node.devUuid.length > 0) {
          const rawName = node.pinName;
          const pinName = (rawName !== undefined && rawName.length > 0) ? rawName : node.pinId;
          return buildPinRef(node.devUuid, node.pinId, pinName);
        }
        return node.pinId;
      })

    };

  }



  private static toSubBlock(s: SubcircuitRef): SubCircuitBlock {

    const ports = s.ports ?? [];

    const portList: SubCircuitPort[] = [];

    for (let i = 0; i < ports.length; i++) {

      const p = ports[i];

      let direction: 'in' | 'out' | 'inout' = 'inout';

      if (p.direction === 'input') {

        direction = 'in';

      } else if (p.direction === 'output') {

        direction = 'out';

      }

      portList.push({

        portId: p.id,

        portName: p.name,

        direction: direction,

        x: p.position.x,

        y: p.position.y

      });

    }

    return {

      subUuid: s.id,

      name: s.name,

      portList: portList,

      innerTopo: s.embeddedDocument ? TopologyAdapter.toTopology(s.embeddedDocument) : null

    };

  }



  private static toSubRef(b: SubCircuitBlock): SubcircuitRef {

    const ports: Port[] = [];

    for (let i = 0; i < b.portList.length; i++) {

      const p = b.portList[i];

      let direction: 'input' | 'output' | 'bidirectional' = 'bidirectional';

      if (p.direction === 'in') {

        direction = 'input';

      } else if (p.direction === 'out') {

        direction = 'output';

      }

      ports.push({

        id: p.portId,

        name: p.portName,

        type: PinType.BIDIRECTIONAL,

        direction: direction,

        position: { x: p.x, y: p.y }

      });

    }

    const ref: SubcircuitRef = {

      id: b.subUuid,

      name: b.name,

      documentId: b.subUuid,

      position: { x: 0, y: 0 },

      ports: ports

    };

    if (b.innerTopo) {

      ref.embeddedDocument = TopologyAdapter.fromTopology(b.innerTopo);

    }

    return ref;

  }

  static syncIncremental(doc: SchematicDocument, cached: SchTopology | null): SchTopology {
    return TopologyPatchApplier.syncTopologyIncremental(doc, cached);
  }

}

