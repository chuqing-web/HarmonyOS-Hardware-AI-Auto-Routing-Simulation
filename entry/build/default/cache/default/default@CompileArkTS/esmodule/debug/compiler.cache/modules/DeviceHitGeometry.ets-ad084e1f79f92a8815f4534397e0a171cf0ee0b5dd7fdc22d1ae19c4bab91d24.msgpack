  }

  static transformLocal(local: Point2D, rotate: number, mirrorH: boolean): Point2D {
    let lx = local.x;
    let ly = local.y;
    if (mirrorH) {
      lx = -lx;
    }
    const rot = ((rotate % 360) + 360) % 360;
    if (rot === 90) {
      return { x: -ly, y: lx };
    }
    if (rot === 180) {
      return { x: -lx, y: -ly };
    }
    if (rot === 270) {
      return { x: ly, y: -lx };
    }
    return { x: lx, y: ly };
  }

