    const loaded = await GitHubDeviceAuth.loadFromDisk();
    if (loaded.accessToken.length > 0) {
      GitHubDeviceAuth.memoryToken = loaded.accessToken;
      GitHubDeviceAuth.memoryLogin = loaded.login;
