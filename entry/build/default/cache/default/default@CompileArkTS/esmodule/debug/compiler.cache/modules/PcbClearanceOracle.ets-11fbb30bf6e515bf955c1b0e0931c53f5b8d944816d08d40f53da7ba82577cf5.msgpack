function distPointSeg(p, a, b) {
    const dx = b.x - a.x;
    const dy = b.y - a.y;
    const len2 = dx * dx + dy * dy;
    if (len2 < 1e-9) {
        const ex = p.x - a.x;
        const ey = p.y - a.y;
        return Math.sqrt(ex * ex + ey * ey);
    }
    let t = ((p.x - a.x) * dx + (p.y - a.y) * dy) / len2;
    if (t < 0) {
        t = 0;
    }
    else if (t > 1) {
        t = 1;
    }
    const qx = a.x + t * dx;
    const qy = a.y + t * dy;
    const ex = p.x - qx;
    const ey = p.y - qy;
    return Math.sqrt(ex * ex + ey * ey);
}
function segClearance(a1, a2, b1, b2) {
    return Math.min(distPointSeg(a1, b1, b2), distPointSeg(a2, b1, b2), distPointSeg(b1, a1, a2), distPointSeg(b2, a1, a2));
}
export function clearanceForNet(doc, netId) {
    const base = doc.metadata.designRules.minClearance;
    if (netId.length === 0) {
        return base;
    }
    for (const n of doc.nets) {
        if (n.id === netId) {
            return findNetClass(doc, n.classId).clearance;
        }
    }
    return base;
}
export function trackWidthForNet(doc, netId) {
    const base = doc.metadata.designRules.defaultTrackWidth;
    if (netId.length === 0) {
        return base;
    }
    for (const n of doc.nets) {
        if (n.id === netId) {
            return findNetClass(doc, n.classId).trackWidth;
        }
    }
    return base;
}
function viaOnLayer(v, layer) {
    if (!v.layers || v.layers.length === 0) {
        return true;
    }
    return v.layers.indexOf(layer) >= 0;
}
