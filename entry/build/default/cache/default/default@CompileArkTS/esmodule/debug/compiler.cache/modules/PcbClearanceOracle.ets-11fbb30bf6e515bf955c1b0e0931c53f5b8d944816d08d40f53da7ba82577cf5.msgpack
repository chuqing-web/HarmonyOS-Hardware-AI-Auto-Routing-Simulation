            const posPad = padWorldPosition(fp, pad);
            const padR = padObstacleRadius(pad);
            const dx = posPad.x - pos.x;
            const dy = posPad.y - pos.y;
            if (Math.sqrt(dx * dx + dy * dy) < need + padR) {
                return false;
            }
        }
    }
    return true;
}
