function boardBounds(doc) {
    const pts = doc.boardOutline?.points ?? [];
    if (pts.length === 0) {
        return { minX: -1e9, minY: -1e9, maxX: 1e9, maxY: 1e9 };
    }
    let minX = pts[0].x;
    let minY = pts[0].y;
    let maxX = pts[0].x;
    let maxY = pts[0].y;
    for (let i = 1; i < pts.length; i++) {
        if (pts[i].x < minX) {
            minX = pts[i].x;
        }
        if (pts[i].y < minY) {
            minY = pts[i].y;
        }
        if (pts[i].x > maxX) {
            maxX = pts[i].x;
        }
        if (pts[i].y > maxY) {
            maxY = pts[i].y;
        }
    }
    return { minX, minY, maxX, maxY };
}
function snapRotation(deg) {
    const n = ((Math.round(deg / 90) * 90) % 360 + 360) % 360;
    if (n === 90) {
        return 90;
    }
    if (n === 180) {
        return 180;
    }
    if (n === 270) {
        return 270;
    }
    return 0;
}
function centersTooClose(a, b, minDist) {
    const dx = a.x - b.x;
    const dy = a.y - b.y;
    return Math.sqrt(dx * dx + dy * dy) < minDist;
}
