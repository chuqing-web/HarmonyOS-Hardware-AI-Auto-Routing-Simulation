        if (isMountHole(p.fp)) {
            continue;
        }
        echoable++;
        const dx = Math.abs(p.x - p.fp.position.x);
        const dy = Math.abs(p.y - p.fp.position.y);
        const sameRot = snapRotation(p.fp.rotation) === p.rot;
        if (dx <= grid && dy <= grid && sameRot) {
            echoed++;
