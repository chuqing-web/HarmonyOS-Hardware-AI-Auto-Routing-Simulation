    tracePcb('AI_BOARD', `size ${Math.round(prev.maxX - prev.minX)}x${Math.round(prev.maxY - prev.minY)}â†’${w}x${h}` +
        ` mounts=${Math.min(mounts.length, corners.length)}`);
