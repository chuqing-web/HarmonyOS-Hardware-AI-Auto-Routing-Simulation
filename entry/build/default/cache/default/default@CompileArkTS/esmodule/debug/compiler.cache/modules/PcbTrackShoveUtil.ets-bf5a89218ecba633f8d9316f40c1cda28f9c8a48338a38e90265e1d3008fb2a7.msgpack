export function shoveForeignTracksByLReroute(doc, movedTrackIds) {
    if (movedTrackIds.size === 0) {
        return 0;
    }
    const moved = [];
    for (const trk of doc.tracks) {
        if (movedTrackIds.has(trk.id)) {
            moved.push(trk);
        }
    }
    if (moved.length === 0) {
        return 0;
    }
    const colliding = [];
    for (const fr of doc.tracks) {
        if (movedTrackIds.has(fr.id)) {
            continue;
        }
        let hit = false;
        for (const mv of moved) {
            if (tracksClearanceConflict(fr, mv, doc)) {
                hit = true;
                break;
            }
        }
        if (hit) {
            colliding.push(fr);
        }
    }
    const seenNet = new Set();
    const ordered = [];
    for (const fr of colliding) {
        if (fr.netId.length > 0 && seenNet.has(fr.netId)) {
            continue;
        }
        if (fr.netId.length > 0) {
            seenNet.add(fr.netId);
        }
        ordered.push(fr);
        if (ordered.length >= MAX_FOREIGN_REROUTE) {
            break;
        }
    }
    if (ordered.length < MAX_FOREIGN_REROUTE) {
        for (const fr of colliding) {
            let already = false;
            for (const o of ordered) {
                if (o.id === fr.id) {
                    already = true;
                    break;
                }
            }
            if (already) {
                continue;
            }
            ordered.push(fr);
            if (ordered.length >= MAX_FOREIGN_REROUTE) {
                break;
            }
        }
    }
    let rerouted = 0;
    for (const fr of ordered) {
        const candidates = lCandidates(fr.start, fr.end);
        const obstacles = [];
        for (const t of doc.tracks) {
            if (t.id !== fr.id) {
                obstacles.push(t);
            }
        }
        let chosen = null;
        for (const pts of candidates) {
            if (pts.length < 2) {
                continue;
            }
            if (pathOk(doc, fr.layer, pts, fr.netId, fr.width, obstacles)) {
                chosen = pts;
                break;
            }
        }
        if (chosen === null) {
            continue;
        }
        if (chosen.length === 2
            && pointDist(chosen[0], fr.start) < 0.5
            && pointDist(chosen[1], fr.end) < 0.5) {
            continue;
        }
        const n = replaceTrackWithPolyline(doc, fr, chosen);
        if (n > 0) {
            rerouted++;
        }
    }
    if (rerouted > 0 || colliding.length > 0) {
        tracePcb('TRACK_SHOVE_L', `moved=${movedTrackIds.size} collide=${colliding.length} rerouted=${rerouted}`);
    }
    return rerouted;
}
