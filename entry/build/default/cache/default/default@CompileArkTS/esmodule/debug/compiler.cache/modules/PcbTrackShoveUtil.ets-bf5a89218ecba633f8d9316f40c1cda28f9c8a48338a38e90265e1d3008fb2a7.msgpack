export function shoveForeignTracksByLReroute(
  doc: PcbDocument,
  movedTrackIds: Set<string>
): number {
  if (movedTrackIds.size === 0) {
    return 0;
  }

  const moved: PcbTrack[] = [];
  for (const trk of doc.tracks) {
    if (movedTrackIds.has(trk.id)) {
      moved.push(trk);
    }
  }
  if (moved.length === 0) {
    return 0;
  }

