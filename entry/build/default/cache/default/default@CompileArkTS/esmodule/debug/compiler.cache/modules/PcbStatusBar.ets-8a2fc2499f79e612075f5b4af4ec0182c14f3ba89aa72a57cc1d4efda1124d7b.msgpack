//# sourceMappingURL=PcbStatusBar.js.mapÂ“Ù-C:\Projects\ElecDraw_Harmony\common\Index.etsÙFC:\Projects\ElecDraw_Harmony\entry\src\main\ets\theme\ProteusTheme.etsÙFC:\Projects\ElecDraw_Harmony\entry\src\main\ets\theme\ThemeManager.etsÙOC:\Projects\ElecDraw_Harmony\entry\src\main\ets\components\pcb\PcbStatusBar.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂÙ"C:\Projects\ElecDraw_Harmony\entry¼C:\Projects\ElecDraw_Harmony¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleName¾../components/pcb/PcbStatusBar¥entryÙ"C:\Projects\ElecDraw_Harmony\entryÃÃÚ	m/**
 * KiCad é£æ ¼çŠ¶æ€æ  â€” åæ ‡ / ç½‘æ ¼ / ç¼©æ”¾ / æ´»åŠ¨å±‚
 */
import { PcbLayerId } from 'common';
import { appVersionLabel } from 'common';
import { ProteusColors, ProteusDimens, ProteusFonts } from '../../theme/ProteusTheme';
import { PROTEUS_THEME_REV_KEY } from '../../theme/ThemeManager';

@Component
export struct PcbStatusBar {
  @StorageProp(PROTEUS_THEME_REV_KEY) themeRev: number = 0;
  @Prop statusMessage: string = '';
  @Prop worldX: number = 0;
  @Prop worldY: number = 0;
  @Prop zoomPercent: number = 100;
  @Prop activeLayer: PcbLayerId = PcbLayerId.F_CU;
  @Prop gridSize: number = 5;
  @Prop gridVisible: boolean = true;

  build() {
    Row() {
      // çŠ¶æ€æ¶ˆæ¯
      Text(this.statusMessage)
        .fontSize(ProteusFonts.STATUS)
        .fontColor(ProteusColors.TEXT_SECONDARY)
        .layoutWeight(2)
        .maxLines(1)
        .textOverflow({ overflow: TextOverflow.Ellipsis })
        .margin({ left: 8 })

      // åˆ†éš”
      this.sep()

      // åæ ‡
      Text(`X ${this.worldX.toFixed(1)}  Y ${this.worldY.toFixed(1)} mil`)
        .fontSize(ProteusFonts.STATUS)
        .fontColor(ProteusColors.TEXT_PRIMARY)
        .fontFamily('monospace')

      this.sep()

      // ç½‘æ ¼
      Text(this.gridVisible ? `Grid ${this.gridSize} mil` : 'Grid off')
        .fontSize(ProteusFonts.STATUS)
        .fontColor(ProteusColors.TEXT_SECONDARY)

      this.sep()

      // æ´»åŠ¨å±‚
      Text(this.activeLayer)
        .fontSize(ProteusFonts.STATUS)
        .fontColor(ProteusColors.SELECTED)
        .fontWeight(FontWeight.Medium)

      Blank()

      // ç¼©æ”¾
      Text(`${this.zoomPercent}%`)
        .fontSize(ProteusFonts.STATUS)
        .fontColor(ProteusColors.TEXT_PRIMARY)
        .fontWeight(FontWeight.Medium)
        .margin({ right: 12 })

      Text(appVersionLabel())
        .fontSize(ProteusFonts.STATUS)
        .fontColor(ProteusColors.TEXT_SECONDARY)
        .margin({ right: 8 })
    }
    .width('100%')
    .height(ProteusDimens.STATUS_HEIGHT)
    .backgroundColor(ProteusColors.STATUS_BAR_BG)
    .border({ width: { top: 1 }, color: ProteusColors.BORDER })
    .alignItems(VerticalAlign.Center)
  }

  @Builder
  sep() {
    Text('|')
      .fontSize(ProteusFonts.STATUS)
      .fontColor(ProteusColors.DIVIDER)
      .margin({ left: 8, right: 8 })
  }
}
