        }
        .width('100%')

        Scroll() {
          Text(this.uartOutput.length > 0 ? this.uartOutput : '(æ— è¾“å‡º)')
            .fontSize(ProteusFonts.STATUS)
            .fontColor(this.uartOutput.length > 0 ?
