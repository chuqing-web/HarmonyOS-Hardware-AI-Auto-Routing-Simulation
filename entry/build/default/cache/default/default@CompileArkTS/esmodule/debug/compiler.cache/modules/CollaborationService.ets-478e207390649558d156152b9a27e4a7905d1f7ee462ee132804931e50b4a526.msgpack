    this.changeLog.push(entry);
    if (this.changeLog.length > 5000) {
      this.changeLog = this.changeLog.slice(-5000);
    }
    return entry;
  }

  getChangeLog(): CollabChangeLogEntry[] {
    return copyCollabChangeLogArray(this.changeLog);
  }

