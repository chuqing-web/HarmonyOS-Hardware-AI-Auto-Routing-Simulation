        const maxPan = this.getMaxPanSec();
        const t = Math.max(0, Math.min(1000, norm)) / 1000;
        this.viewPanSec = this.clampPan((1 - t) * maxPan);
    }
    panSliderValue() {
        const maxPan = this.getMaxPanSec();
        if (maxPan <= 1e-15) {
