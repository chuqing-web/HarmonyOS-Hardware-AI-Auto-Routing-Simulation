  if (zh.indexOf('é€»è¾‘åˆ†æž') >= 0 || lower.indexOf('logic analyzer') >= 0) {
    parts.push(catalogSelectByKey('LOGIC_ANALYZER'));
  }
  if (zh.indexOf('é¢‘çŽ‡è®¡') >= 0 || lower.indexOf('freq') >= 0) {
    parts.push(catalogSelectByKey('FREQ_COUNTER'));
  }
  if (zh.indexOf('åŠŸçŽ‡è¡¨') >= 0) {
    parts.push(catalogSelectByKey('POWER_METER'));
  }
  if (zh.indexOf('ä¸‡ç”¨è¡¨') >= 0) {
    parts.push(catalogSelectByKey('VIRTUAL_METER'));
  }
  if (zh.indexOf('ä¿é™©ä¸') >= 0 || lower.indexOf('fuse') >= 0) {
    parts.push(catalogSelectByKey('FUSE_1A'));
  }
  if (zh.indexOf('äº¤æµæº') >= 0 || zh.indexOf('å¸‚ç”µ') >= 0 || lower.indexOf('vac') >= 0) {
    parts.push(catalogSelectByKey('VAC'));
  }
  const cleaned: string[] = [];
  for (let i = 0; i < parts.length; i++) {
    if (parts[i] && parts[i].length > 0) {
      cleaned.push(parts[i]);
    }
  }
  if (cleaned.length === 0) {
    return '';
  }
  return `\nã€å™¨ä»¶æ—å…³é”®è¯ç‰‡æ®µÂ·é€‰åž‹ã€‘\n` + cleaned.join('\n');
}

/**
 * ä»ªå™¨ç»†åˆ†ç‰‡æ®µï¼ˆåœ¨ hasInstruments æ—¶è¿½åŠ ï¼Œæ¯”æ€»è¡¨æ›´ç»†ï¼‰
