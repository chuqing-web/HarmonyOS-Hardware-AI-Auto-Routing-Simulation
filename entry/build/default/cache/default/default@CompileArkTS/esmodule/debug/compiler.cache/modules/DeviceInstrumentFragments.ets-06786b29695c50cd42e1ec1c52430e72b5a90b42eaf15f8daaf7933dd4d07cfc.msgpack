export const FRAG_INSTR_DETAIL_SELECT: string = `
ã€ä»ªå™¨ç»†åˆ†é€‰åž‹ã€‘:
- ç¤ºæ³¢å™¨/æ³¢å½¢/æ–¹æ³¢è§‚æµ‹ â†’ OSCILLOSCOPEï¼ˆCH1â€“4+GNDï¼‰
- ç”µæµ/ä¸²è”æµ‹æµ â†’ AMMETER_DCï¼ˆVCCâ†’I+â†’I-â†’è´Ÿè½½ï¼‰
- ç”µåŽ‹è¡¨/æµ‹åŽ‹ â†’ VOLTMETER_DCï¼ˆå¤šè¡¨ä¸åŒèŠ‚ç‚¹å¯¹ï¼‰
- ä¸‡ç”¨è¡¨/ç”µé˜»æ¡£/äºŒæžç®¡æ¡£ â†’ VIRTUAL_METERï¼ˆV/A/OHM/COMï¼‰
- åŠŸçŽ‡ â†’ POWER_METERï¼›é¢‘çŽ‡ â†’ FREQ_COUNTERï¼›é€»è¾‘ â†’ LOGIC_ANALYZER(CH1â€“8)ï¼›ä¸²å£ â†’ UART_TERMINAL
- ä¿¡å·æº/æ­£å¼¦/ä¸‰è§’æ¿€åŠ± â†’ SIGNAL_GENï¼ˆå†™å…¨ paramï¼‰`;

export const FRAG_INSTR_DETAIL_NET: string = `
ã€ä»ªå™¨ç»†åˆ†å»ºç½‘ã€‘:
- OSC: CHxâˆ¥è¢«æµ‹ç½‘åŒåï¼›GND stubLabelï¼›ç¦ PROBE_*ï¼›ç¦ CH æŒ‚ VCC/GND
- AMMETER: I+/I- å¼‚ç½‘ä¸²è”ï¼›ç¦å¹¶è”
- VOLTMETER: V+/COM å¹¶è”ï¼›å¤šè¡¨åˆ†å¸ƒ
- VIRTUAL_METER: çœŸè„š V,A,OHM,COMï¼›æœ‰ä¿¡å·å¿…æœ‰ COM
- POWER_METER: V å¹¶ I ä¸²ï¼›I è·¯â‰ V è·¯èŠ‚ç‚¹å¯¹
- LA: ä»… CH1â€“CH8ï¼›ç¦ CH0/D0ï¼›UART: TXâ†”RX äº¤å‰+GND
