let cachedCatalog = null;
function getCatalog() {
    if (cachedCatalog === null) {
        cachedCatalog = buildDevInstrCatalog();
    }
    return cachedCatalog;
}
function catalogSelectByKey(key) {
    const catalog = getCatalog();
    for (let i = 0; i < catalog.length; i++) {
        if (catalog[i].key === key) {
            return catalog[i].select;
        }
    }
    return '';
}
function matchEntry(libId, entry) {
    const id = (libId ?? '').toUpperCase();
    const key = (entry.key ?? '').toUpperCase();
    if (id.length === 0 || key.length === 0) {
        return false;
    }
    if (key.endsWith('*')) {
        const prefix = key.substring(0, key.length - 1);
        return id.indexOf(prefix) === 0;
    }
    return id === key;
}
/**
 * æŒ‰æ¿ä¸Š/é€‰åž‹ libDevId æ”¶é›†ç‰‡æ®µã€‚
 * stage=select ç”¨ select å­—æ®µï¼›net/edit ç”¨ net å­—æ®µï¼ˆedit ä¸¤è€…éƒ½å¯å¸¦ï¼‰ã€‚
 */
export function assembleLibIdFragments(libIds, stage) {
    if (!libIds || libIds.length === 0) {
        return '';
    }
    const catalog = getCatalog();
    const seenKeys = [];
    const parts = [];
    const hasSeen = (k) => {
        for (let si = 0; si < seenKeys.length; si++) {
            if (seenKeys[si] === k) {
                return true;
            }
        }
        return false;
    };
    for (let i = 0; i < libIds.length; i++) {
        const id = (libIds[i] ?? '').trim();
        if (id.length === 0) {
            continue;
        }
        for (let ci = 0; ci < catalog.length; ci++) {
            const e = catalog[ci];
            if (!matchEntry(id, e)) {
                continue;
            }
            if (hasSeen(e.key)) {
                continue;
            }
            seenKeys.push(e.key);
            if (stage === 'select') {
                if (e.select.length > 0) {
                    parts.push(e.select);
                }
            }
            else if (stage === 'net') {
                if (e.net.length > 0) {
                    parts.push(e.net);
                }
            }
            else {
                // editï¼šé€‰åž‹+å»ºç½‘éƒ½ç»™ï¼Œä¿®æŽ¥æ›´ç¨³
                if (e.select.length > 0) {
                    parts.push(e.select);
                }
                if (e.net.length > 0) {
                    parts.push(e.net);
                }
            }
        }
    }
    if (parts.length === 0) {
        return '';
    }
    return `\nã€å™¨ä»¶/ä»ªå™¨æ„å›¾ç‰‡æ®µÂ·æŒ‰æ¿ä¸Šåž‹å·æ³¨å…¥ Â· ${stage} Â· ${seenKeys.length}æ¡ã€‘\n` + parts.join('\n');
}
