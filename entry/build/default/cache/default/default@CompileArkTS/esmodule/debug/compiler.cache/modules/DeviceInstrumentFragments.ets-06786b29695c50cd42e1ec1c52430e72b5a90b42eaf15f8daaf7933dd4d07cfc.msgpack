        f('LED_*', 'ã€LEDã€‘å¿…é¡»é™æµç”µé˜»ï¼›N ç¯ N ç”µé˜»ã€‚', 'ã€LEDã€‘Aâ†ç» Râ†é©±åŠ¨ï¼›Kâ†’GNDï¼›ç¦æ— ç”µé˜»ç›´æŽ¥ç”µæºï¼›ç¦ K æŽ¥ VCC æ­£å‘ç¡¬çŒã€‚'),
        f('XTAL_*', 'ã€æ™¶æŒ¯ã€‘MCU æ—¶é’Ÿï¼›é…è´Ÿè½½ç”µå®¹ã€‚', 'ã€XTALã€‘æŽ¥ OSC_IN/OSC_OUTï¼›ä¸¤ç«¯å„ 22pFâ†’GNDï¼›èµ°çº¿æœ€çŸ­ã€‚'),
