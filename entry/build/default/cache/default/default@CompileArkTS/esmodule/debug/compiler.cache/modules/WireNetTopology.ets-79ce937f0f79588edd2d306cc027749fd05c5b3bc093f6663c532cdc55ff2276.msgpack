// Re-export helper access â€” defaultPinsForLib is not exported from NetPinRebuildUtil,
// duplicate minimal pin lookup inline via resolver pattern.

enum JunctionKind {
  VCC = 'vcc',
  GND = 'gnd',
  VEE = 'vee',
  SIGNAL = 'signal',
  UNKNOWN = 'unknown'
}

interface JunctionPinRef {
  compId: string;
  pinId: string;
  pinName: string;
  libraryId: string;
}

interface PinWorldRef {
  compId: string;
  pinId: string;
  pinName: string;
  libraryId: string;
  worldX: number;
  worldY: number;
}

interface Junction {
  key: string;
  x: number;
  y: number;
  pinRefs: JunctionPinRef[];
}

function makePinGeometry(id: string, name: string, x: number, y: number): PinGeometry {
  const geom: PinGeometry = { id: id, name: name, x: x, y: y };
  return geom;
}

function makePinWorldRef(compId: string, pinId: string, pinName: string, libraryId: string,
  worldX: number, worldY: number): PinWorldRef {
  const ref: PinWorldRef = {
    compId: compId, pinId: pinId, pinName: pinName, libraryId: libraryId,
    worldX: worldX, worldY: worldY
  };
  return ref;
}

function makeJunctionPinRef(compId: string, pinId: string, pinName: string,
  libraryId: string): JunctionPinRef {
  const ref: JunctionPinRef = {
    compId: compId, pinId: pinId, pinName: pinName, libraryId: libraryId
  };
  return ref;
}

function roundKey(p: Point2D): string {
  return `${Math.round(p.x)},${Math.round(p.y)}`;
}

/**
 * æ‹“æ‰‘ç»“ç‚¹å¸é™„åŠå¾„ï¼ˆä¸ MCU 10px è„šè·å…¼å®¹ï¼šä¸Šé™ 7ï¼‰ã€‚
 * ç¼–è¾‘å™¨ mergeNetsAtSharedWireEndpoints / ç”»å¸ƒ T ç»“é¡»ä¸æ­¤å¯¹é½ï¼Œç¦æ­¢å†ç”¨ 0.75Ã—grid åˆ° 12ã€‚
 */
export function computeTopoJunctionRadius(gridSize: number): number {
  const g = gridSize > 0 ? gridSize : 10;
  return Math.min(Math.max(3, g * 0.6), 7);
}

/** T æ¥ä¸­æ®µè§¦çº¿å®¹å·®ï¼ˆç«¯ç‚¹å‹åˆ°å¼‚çº¿é“œçš®ï¼‰ */
export function computeTopoTJunctionTol(gridSize: number): number {
  const g = gridSize > 0 ? gridSize : 10;
  return Math.min(Math.max(3, g * 0.4), 5);
}

/**
 * Auto / disposable signal net names that must NOT be inherited across topology rebuild.
 * Legacy SchematicEditorImpl used NET_${netId.substring(0,6)} â†’ all net_1784â€¦ became NET_net_17.
 */
function isAutoGeneratedSignalNetName(nm: string): boolean {
  if (nm.length === 0) {
    return true;
  }
  if (/^net_topo/i.test(nm)) {
    return true;
  }
  // NET_1, NET_12ï¼›ä»¥åŠæ—§ç‰ˆ NET_net_17ï¼ˆid.substring æ’åï¼‰
  if (/^NET_\d+$/i.test(nm) || /^NET_net_/i.test(nm)) {
    return true;
  }
  return false;
}

function isVccLib(lib: string): boolean {
  const u = lib.toUpperCase();
  return u === 'VCC' || u.endsWith('/VCC') || u === 'VDD' || u.endsWith('/VDD');
}

function isGndLib(lib: string): boolean {
  const u = lib.toUpperCase();
  return u === 'GND' || u.endsWith('/GND') || u === 'VSS' || u.endsWith('/VSS') || u === '0';
}

function isVeeLib(lib: string): boolean {
  const u = lib.toUpperCase();
  return u === 'VEE' || u.endsWith('/VEE');
}

function isPassiveLib(lib: string): boolean {
  const u = lib.toUpperCase();
  return u.startsWith('R_') || u.includes('RESISTOR') || u.startsWith('C_') ||
    u.includes('CAP') || u.startsWith('L_') || u.includes('INDUCTOR');
}

/**
 * Dense multi-pin packages (MCU / logic IC). Their pin junctions must count as
 * SIGNAL barriers so VCC/GND BFS cannot paint Port pins â†’ GPIO_MISS / LED always-on.
 */
function isDenseSignalLib(lib: string): boolean {
  const u = (lib ?? '').toUpperCase();
  if (u.includes('AT89') || u.includes('STC89') || u.includes('STC15') ||
    u.includes('8051') || u.includes('MCS51') || u.includes('STM32')) {
    return true;
  }
  if (u.startsWith('74HC') || u.startsWith('74LS') || u.startsWith('CD4') ||
    u.includes('LM555') || u.includes('NE555') || u === '555') {
    return true;
  }
  return false;
}

/** True if both junctions carry different pins of the same component (do not UF-merge). */
function sameComponentDistinctPins(a: Junction, b: Junction): boolean {
  for (let i = 0; i < a.pinRefs.length; i++) {
    const pa = a.pinRefs[i];
    for (let j = 0; j < b.pinRefs.length; j++) {
      const pb = b.pinRefs[j];
      if (pa.compId === pb.compId && pa.pinId !== pb.pinId) {
        return true;
      }
    }
  }
  return false;
}

/**
 * UF åˆå¹¶ keyA/keyB æ˜¯å¦ä¼šæŠŠåŒå™¨ä»¶çš„ä¸åŒè„šå¹¶åˆ°ä¸€ç½‘ï¼ˆç»å·²æœ‰åˆ†é‡ä¸Šçš„ pinRefsï¼‰ã€‚
 * ç”¨äºé˜»æ–­ã€Œä¸€æ ¹å¯¼çº¿ä¸¤ç«¯åˆ†åˆ«å¸åˆ° I+ / I-ã€è¿™ç±»æ‹“æ‰‘çŸ­è·¯ã€‚
 */
function wouldCreateSameCompShort(
  uf: UnionFind, junctions: Map<string, Junction>, keyA: string, keyB: string
): boolean {
  return describeSameCompShortConflict(uf, junctions, keyA, keyB).length > 0;
}

function refDesOfComp(doc: SchematicDocument | null, compId: string): string {
  if (doc === null) {
    return compId;
  }
  for (let i = 0; i < doc.components.length; i++) {
    if (doc.components[i].id === compId) {
      const rd = doc.components[i].refDes;
      return rd.length > 0 ? rd : compId;
    }
  }
  return compId;
}

/** è‹¥åˆå¹¶ä¼šæŠŠåŒå™¨ä»¶å¼‚è„šå¹¶åˆ°ä¸€ç½‘ï¼Œè¿”å›å¦‚ `R4:1â†”2`ï¼›å¦åˆ™ç©ºä¸²ã€‚ */
function describeSameCompShortConflict(
  uf: UnionFind, junctions: Map<string, Junction>, keyA: string, keyB: string,
  doc: SchematicDocument | null = null
): string {
  const ra = uf.find(keyA);
  const rb = uf.find(keyB);
  if (ra === rb) {
    return '';
  }
  const pinsA: JunctionPinRef[] = [];
  const pinsB: JunctionPinRef[] = [];
  junctions.forEach((j: Junction, k: string) => {
    const root = uf.find(k);
    if (root === ra) {
      for (let i = 0; i < j.pinRefs.length; i++) {
        pinsA.push(j.pinRefs[i]);
      }
    } else if (root === rb) {
      for (let i = 0; i < j.pinRefs.length; i++) {
        pinsB.push(j.pinRefs[i]);
      }
    }
  });
  for (let i = 0; i < pinsA.length; i++) {
    const pa = pinsA[i];
    for (let j = 0; j < pinsB.length; j++) {
      const pb = pinsB[j];
      if (pa.compId === pb.compId && pa.pinId !== pb.pinId) {
        const aLab = pa.pinName.length > 0 ? pa.pinName : pa.pinId;
        const bLab = pb.pinName.length > 0 ? pb.pinName : pb.pinId;
        return `${refDesOfComp(doc, pa.compId)}.${aLab}â†”${bLab}`;
      }
    }
  }
  return '';
}

function safeUnion(
  uf: UnionFind, junctions: Map<string, Junction>, keyA: string, keyB: string
): boolean {
  if (wouldCreateSameCompShort(uf, junctions, keyA, keyB)) {
    return false;
  }
  uf.union(keyA, keyB);
  return true;
}

/** æ”¶é›†è½ç‚¹é™„è¿‘çš„å¼•è„šï¼ˆç”¨äº T æ¥æ—¶ jEp.pinRefs å°šæœªå¸¦ä¸Šé‚»è¿‘è„šçš„æƒ…å½¢ï¼‰ */
function pinsNearPoint(
  pinList: PinWorldRef[], x: number, y: number, tol: number
): JunctionPinRef[] {
  const out: JunctionPinRef[] = [];
  for (let i = 0; i < pinList.length; i++) {
    const p = pinList[i];
    if (Math.hypot(p.worldX - x, p.worldY - y) <= tol) {
      out.push(makeJunctionPinRef(p.compId, p.pinId, p.pinName, p.libraryId));
    }
  }
  return out;
}

/** UF æ ¹ä¸Šæ˜¯å¦å·²æœ‰ä¸ probe åŒå™¨ä»¶çš„å¼‚è„š */
function ufRootConflictsWithPins(
  uf: UnionFind, junctions: Map<string, Junction>, rootKey: string,
  probes: JunctionPinRef[]
): boolean {
  if (probes.length === 0) {
    return false;
  }
  const root = uf.find(rootKey);
  const onRoot: JunctionPinRef[] = [];
  junctions.forEach((j: Junction, k: string) => {
    if (uf.find(k) !== root) {
      return;
    }
    for (let i = 0; i < j.pinRefs.length; i++) {
      onRoot.push(j.pinRefs[i]);
    }
  });
  for (let i = 0; i < probes.length; i++) {
    const pa = probes[i];
    for (let j = 0; j < onRoot.length; j++) {
      const pb = onRoot[j];
      if (pa.compId === pb.compId && pa.pinId !== pb.pinId) {
        return true;
      }
    }
  }
  return false;
}

/** çº¿æ®µæ˜¯å¦å‹è¿‡å¼•è„šï¼ˆéå¯¼çº¿ä¸¤ç«¯ç›®æ ‡è„šï¼‰â†’ è„šæ’çŸ­è·¯é£é™© */
function pinOnSegmentInterior(
