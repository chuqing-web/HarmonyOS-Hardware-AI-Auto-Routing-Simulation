            if (Math.abs(dx) > junctionRadius || Math.abs(dy) > junctionRadius) {
                continue;
            }
            if (sameComponentDistinctPins(ji, jj)) {
                continue;
            }
            safeUnion(uf, junctions, keys[i], keys[j]);
        }
    }
    // T-junctions: å¯¼çº¿ç«¯ç‚¹å‹åˆ°å¦ä¸€æ ¹çº¿çš„ä»»æ„ä½ç½®ï¼ˆä¸­æ®µ/æŠ˜ç‚¹/ç«¯ç‚¹ï¼‰å³å¹¶ç½‘ã€‚
    // ä½ç½®æ— å…³ â€” åªè¦è¿åˆ°æ­£ç¡®é“œçš®ï¼›å‹¿å› ã€Œé è¿‘æŠ˜ç‚¹ã€è·³è¿‡ï¼ˆæ—§ bugï¼šå›¾ä¸Šæœ‰çº¿ã€æ‹“æ‰‘æ‹†ç½‘ï¼‰ã€‚
    // Skip VCCâ†”GND crossings â€” layout stub collisions must not short the rails.
    let tJuncHit = 0;
    let tJuncRefuse = 0;
    for (let wi = 0; wi < doc.wires.length; wi++) {
        const wA = doc.wires[wi];
        if (wA.points.length < 2) {
            continue;
        }
        const railA = wireSupplyRailKind(doc, wA.netId);
        const epA = [wA.points[0], wA.points[wA.points.length - 1]];
        for (let ei = 0; ei < 2; ei++) {
            const ep = epA[ei];
            const epKey = roundKey(ep);
            for (let wj = 0; wj < doc.wires.length; wj++) {
                if (wj === wi) {
                    continue;
                }
                const wB = doc.wires[wj];
                const railB = wireSupplyRailKind(doc, wB.netId);
                if (railsWouldShort(railA, railB)) {
                    continue;
                }
                for (let si = 0; si < wB.points.length - 1; si++) {
                    if (!pointOnSegment(ep, wB.points[si], wB.points[si + 1], tJunctionTol)) {
                        continue;
                    }
                    // æŠ•å½±åˆ°çº¿æ®µï¼ˆä¸­æ®µæˆ–æŠ˜ç‚¹å‡å¯ï¼‰
                    const a = wB.points[si];
                    const b = wB.points[si + 1];
                    const abx = b.x - a.x;
                    const aby = b.y - a.y;
                    const len2 = abx * abx + aby * aby;
                    let t = 0;
                    if (len2 > 1e-6) {
                        t = ((ep.x - a.x) * abx + (ep.y - a.y) * aby) / len2;
                        if (t < 0) {
                            t = 0;
                        }
                        else if (t > 1) {
                            t = 1;
                        }
                    }
                    const foot = { x: a.x + t * abx, y: a.y + t * aby };
                    const footKey = roundKey(foot);
                    findOrCreateJunction(junctions, epKey, ep);
                    const jEp = junctions.get(epKey);
                    const jFoot = findOrCreateJunction(junctions, footKey, foot);
                    if (sameComponentDistinctPins(jEp, jFoot)) {
                        continue;
                    }
                    const nearTol = Math.max(junctionRadius + 1, Math.min(tJunctionTol, 8) + 1);
                    const epProbes = pinsNearPoint(pinList, ep.x, ep.y, nearTol);
                    for (let pri = 0; pri < jEp.pinRefs.length; pri++) {
                        const pr = jEp.pinRefs[pri];
                        let dup = false;
                        for (let qi = 0; qi < epProbes.length; qi++) {
                            if (epProbes[qi].compId === pr.compId && epProbes[qi].pinId === pr.pinId) {
                                dup = true;
                                break;
                            }
                        }
                        if (!dup) {
                            epProbes.push(pr);
                        }
                    }
                    const wB0 = roundKey(wB.points[0]);
                    const wB1 = roundKey(wB.points[wB.points.length - 1]);
                    const targetProbeKeys = [wB0, wB1, roundKey(a), roundKey(b), footKey];
                    let siblingOnTarget = false;
                    for (let tk = 0; tk < targetProbeKeys.length; tk++) {
                        if (ufRootConflictsWithPins(uf, junctions, targetProbeKeys[tk], epProbes)) {
                            siblingOnTarget = true;
                            break;
                        }
                        const tj = junctions.get(targetProbeKeys[tk]);
                        if (tj !== undefined && sameComponentDistinctPins(jEp, tj)) {
                            siblingOnTarget = true;
                            break;
                        }
                    }
                    if (siblingOnTarget) {
                        tJuncRefuse++;
                        if (tJuncRefuse <= 6) {
                            Logger.info(INSTR_TRACE_TAG, `[TOPO] T-junction REFUSE same-comp short at (${Math.round(ep.x)},${Math.round(ep.y)})`);
                        }
                        continue;
                    }
                    if (wouldCreateSameCompShort(uf, junctions, epKey, wB0) ||
                        wouldCreateSameCompShort(uf, junctions, epKey, wB1) ||
                        wouldCreateSameCompShort(uf, junctions, epKey, footKey)) {
                        tJuncRefuse++;
                        if (tJuncRefuse <= 6) {
                            Logger.info(INSTR_TRACE_TAG, `[TOPO] T-junction REFUSE UF short at (${Math.round(ep.x)},${Math.round(ep.y)})`);
                        }
                        continue;
                    }
                    if (uf.find(epKey) === uf.find(wB0) || uf.find(epKey) === uf.find(wB1)) {
                        continue;
                    }
                    if (!safeUnion(uf, junctions, epKey, footKey)) {
                        continue;
                    }
                    // å¹¶å…¥ç›®æ ‡å¯¼çº¿æ•´æ®µï¼ˆç«¯ç‚¹åˆ†é‡ï¼‰ï¼Œä¸è½ç‚¹åœ¨ä¸­æ®µè¿˜æ˜¯æŠ˜ç‚¹æ— å…³
                    safeUnion(uf, junctions, footKey, wB0);
                    safeUnion(uf, junctions, footKey, wB1);
                    tJuncHit++;
                    if (tJuncHit <= 8) {
                        Logger.info(INSTR_TRACE_TAG, `[TOPO] T-junction HIT ep=(${Math.round(ep.x)},${Math.round(ep.y)}) ` +
                            `foot=(${Math.round(foot.x)},${Math.round(foot.y)}) ` +
                            `d=${Math.hypot(ep.x - foot.x, ep.y - foot.y).toFixed(1)} ` +
                            `tol=${tJunctionTol.toFixed(1)} wireA=${wA.id} wireB=${wB.id}`);
                    }
                    break; // è¯¥ç«¯ç‚¹å·²å¹¶å…¥ wBï¼Œä¸å¿…å†æ‰« wB å…¶ä½™æ®µ
                }
            }
        }
    }
    if (tJuncHit > 0 || tJuncRefuse > 0) {
        Logger.info(INSTR_TRACE_TAG, `[TOPO] T-junction summary hit=${tJuncHit} refuse=${tJuncRefuse} ` +
            `tol=${tJunctionTol.toFixed(1)} junctionR=${junctionRadius}`);
    }
    // å¯¼çº¿ä¸­æ®µå‹è¿‡åŒå™¨ä»¶é‚»è„šï¼šæ‹’ç»å¹¶ç½‘å¹¶æ‰“æ—¥å¿—ï¼ˆOUT æ°´å¹³çº¿ç©¿è¿‡ GNDï¼‰
    // ä¿æŒç´§å®¹å·®ï¼Œå‹¿éš T æ¥æ”¾å®½ï¼ˆå¦åˆ™æ°´å¹³çº¿è·¯è¿‡é‚»è„šä¼šè¯¯å¹¶ï¼‰
    const pathPinTol = Math.min(Math.max(1.5, gridSize * 0.2), 2.5);
    const pathEndMargin = Math.max(junctionRadius + 2, pinThreshold * 0.35);
    for (let wi = 0; wi < doc.wires.length; wi++) {
        const wire = doc.wires[wi];
        if (wire.points.length < 2) {
            continue;
        }
        const k0 = roundKey(wire.points[0]);
        const k1 = roundKey(wire.points[wire.points.length - 1]);
        for (let si = 0; si < wire.points.length - 1; si++) {
            const a = wire.points[si];
            const b = wire.points[si + 1];
            for (let pi = 0; pi < pinList.length; pi++) {
                const p = pinList[pi];
                if (!pinOnSegmentInterior(p, a, b, pathPinTol, pathEndMargin)) {
                    continue;
                }
                const pinKey = roundKey({ x: p.worldX, y: p.worldY });
                findOrCreateJunction(junctions, pinKey, { x: p.worldX, y: p.worldY });
                const probes = [
                    makeJunctionPinRef(p.compId, p.pinId, p.pinName, p.libraryId)
                ];
                if (ufRootConflictsWithPins(uf, junctions, k0, probes) ||
                    ufRootConflictsWithPins(uf, junctions, k1, probes) ||
                    wouldCreateSameCompShort(uf, junctions, pinKey, k0) ||
                    wouldCreateSameCompShort(uf, junctions, pinKey, k1)) {
                    Logger.warn(INSTR_TRACE_TAG, `[TOPO] PIN_ROW_SHORT refuse ${p.pinName || p.pinId} ` +
                        `on wire segment (${Math.round(a.x)},${Math.round(a.y)})-` +
                        `(${Math.round(b.x)},${Math.round(b.y)}) â€” same-comp sibling already on net`);
                    traceWirePinRowShort(p.pinName || p.pinId, a.x, a.y, b.x, b.y);
                    continue;
                }
                // åˆæ³•ä¸­æ®µè¿‡è„šï¼šå¹¶å…¥è¯¥å¯¼çº¿é“œçš®ï¼ˆProteus è¿‡è„šå³è¿ï¼‰
                if (safeUnion(uf, junctions, pinKey, k0)) {
                    Logger.info(INSTR_TRACE_TAG, `[TOPO] PIN_ON_PATH attach ${p.pinName || p.pinId} ` +
                        `at (${Math.round(p.worldX)},${Math.round(p.worldY)})`);
                }
            }
        }
    }
    // Assign pins snapped to wire endpoints (within threshold).
    // Cap threshold by half the distance to the nearest sibling pin so dense
    // instrument pin rows (e.g. OSC CH4 vs GND at 20px) cannot steal each other's nets.
    for (let i = 0; i < pinList.length; i++) {
        const p = pinList[i];
        let siblingHalf = pinThreshold;
        for (let j = 0; j < pinList.length; j++) {
            if (j === i) {
                continue;
            }
            const o = pinList[j];
            if (o.compId !== p.compId) {
                continue;
            }
            const sdx = p.worldX - o.worldX;
            const sdy = p.worldY - o.worldY;
            const half = Math.sqrt(sdx * sdx + sdy * sdy) * 0.5;
            if (half > 1 && half < siblingHalf) {
                siblingHalf = half;
            }
        }
        let bestKey = '';
        let bestDist = siblingHalf;
        junctions.forEach((j, key) => {
            const dx = p.worldX - j.x;
            const dy = p.worldY - j.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < bestDist) {
                bestDist = dist;
                bestKey = key;
            }
        });
        if (bestKey.length > 0) {
            const j = junctions.get(bestKey);
            // æ‹’ç»ï¼šç›®æ ‡ç»“ç‚¹å·²æŒ‚åŒå™¨ä»¶å¦ä¸€è„š
            const siblingOnJunction = j.pinRefs.some(pr => pr.compId === p.compId && pr.pinId !== p.pinId);
            if (siblingOnJunction) {
                continue;
            }
            // æ‹’ç»ï¼šç›®æ ‡ UF æ ¹ä¸Šå·²æœ‰åŒå™¨ä»¶å¼‚è„šï¼ˆå¯¼çº¿å·²æŠŠä¸¤è„šå¹¶åˆ°ä¸€ç½‘ï¼‰
            const bestRoot = uf.find(bestKey);
            let siblingOnNet = false;
            junctions.forEach((oj, okey) => {
                if (siblingOnNet) {
                    return;
                }
                if (uf.find(okey) !== bestRoot) {
                    return;
                }
                for (let pri = 0; pri < oj.pinRefs.length; pri++) {
                    const pr = oj.pinRefs[pri];
                    if (pr.compId === p.compId && pr.pinId !== p.pinId) {
                        siblingOnNet = true;
                        break;
                    }
                }
            });
            if (siblingOnNet) {
                continue;
            }
            const exists = j.pinRefs.some(pr => pr.compId === p.compId && pr.pinId === p.pinId);
            if (!exists) {
                j.pinRefs.push(makeJunctionPinRef(p.compId, p.pinId, p.pinName, p.libraryId));
            }
            const pinKey = roundKey({ x: p.worldX, y: p.worldY });
            if (!safeUnion(uf, junctions, pinKey, bestKey)) {
                // å¹¶ç½‘ä¼šçŸ­è·¯åŒå™¨ä»¶å¼‚è„šï¼šæ’¤é”€åˆšå†™å…¥çš„ pinRefï¼ˆè‹¥æœ¬è½®æ–°å¢ï¼‰
                if (!exists) {
                    j.pinRefs = j.pinRefs.filter(pr => !(pr.compId === p.compId && pr.pinId === p.pinId));
                }
            }
        }
    }
    // Per-junction kind from local pins
    const junctionKind = new Map();
    junctions.forEach((j, key) => {
        junctionKind.set(key, classifyJunction(j));
    });
    // BFS from VCC/GND power-symbol junctions along wire graph only
    const rootKind = new Map();
    junctions.forEach((_j, key) => {
        rootKind.set(uf.find(key), JunctionKind.UNKNOWN);
    });
    const seeds = [];
    junctions.forEach((j, key) => {
        const k = classifyJunction(j);
        if (k === JunctionKind.VCC || k === JunctionKind.GND || k === JunctionKind.VEE) {
            seeds.push(key);
            rootKind.set(uf.find(key), k);
        }
    });
    // Build adjacency between junction keys via wires
    const adj = new Map();
    const addEdge = (a, b) => {
        if (!adj.has(a)) {
            adj.set(a, new Set());
        }
        adj.get(a).add(b);
        if (!adj.has(b)) {
            adj.set(b, new Set());
        }
        adj.get(b).add(a);
    };
    for (let wi = 0; wi < doc.wires.length; wi++) {
        const wire = doc.wires[wi];
        if (wire.points.length < 2) {
            continue;
        }
        const k0 = roundKey(wire.points[0]);
        const k1 = roundKey(wire.points[wire.points.length - 1]);
        addEdge(k0, k1);
    }
    // Merge co-located keys in adjacency
    const keyToRep = new Map();
    junctions.forEach((_j, key) => {
        keyToRep.set(key, uf.find(key));
    });
    const repAdj = new Map();
    adj.forEach((neighbors, key) => {
        const rep = uf.find(key);
        if (!repAdj.has(rep)) {
            repAdj.set(rep, new Set());
        }
        neighbors.forEach((n) => {
            repAdj.get(rep).add(uf.find(n));
        });
    });
    // BFS propagate VCC/GND from seeds
    const repKind = new Map();
    repAdj.forEach((_v, rep) => {
        repKind.set(rep, JunctionKind.UNKNOWN);
    });
    const queue = [];
    for (let si = 0; si < seeds.length; si++) {
        const rep = uf.find(seeds[si]);
        const sk = classifyJunction(junctions.get(seeds[si]));
        if (sk === JunctionKind.VCC || sk === JunctionKind.GND || sk === JunctionKind.VEE) {
            repKind.set(rep, sk);
            queue.push(rep);
        }
    }
    let qi = 0;
    while (qi < queue.length) {
        const cur = queue[qi++];
        const curK = repKind.get(cur);
        const neighbors = repAdj.get(cur);
        if (neighbors === undefined) {
            continue;
        }
        neighbors.forEach((n) => {
            if (repKind.get(n) !== JunctionKind.UNKNOWN) {
                return;
            }
            // ç¦æ­¢ç”µæºè½¨ BFS æ¶‚åˆ°çº¯ä¿¡å·/æ— æºç»“ï¼ˆç»è¢«åŠ¨å™¨ä»¶ä½“ã€Œåæ‰ã€ä¿¡å·ç½‘ï¼‰
            let neighborHasRailSym = false;
            let neighborHasSignal = false;
            junctions.forEach((j, key) => {
                if (uf.find(key) !== n) {
                    return;
                }
                const ck = classifyJunction(j);
                if (ck === JunctionKind.VCC || ck === JunctionKind.GND || ck === JunctionKind.VEE) {
                    neighborHasRailSym = true;
                }
                else if (ck === JunctionKind.SIGNAL) {
                    neighborHasSignal = true;
                }
            });
            if (neighborHasSignal && !neighborHasRailSym &&
                (curK === JunctionKind.VCC || curK === JunctionKind.GND || curK === JunctionKind.VEE)) {
                return;
            }
            repKind.set(n, curK);
            queue.push(n);
        });
    }
    // Final junction kind: BFS rail > local passive=SIGNAL > unknown=SIGNAL
    const finalKind = new Map();
    junctions.forEach((j, key) => {
        const rep = uf.find(key);
        const bfsK = repKind.get(rep);
        if (bfsK === JunctionKind.VCC || bfsK === JunctionKind.GND || bfsK === JunctionKind.VEE) {
            finalKind.set(key, bfsK);
            return;
        }
        const localK = classifyJunction(j);
        if (localK === JunctionKind.SIGNAL || localK === JunctionKind.UNKNOWN) {
            finalKind.set(key, JunctionKind.SIGNAL);
        }
        else {
            finalKind.set(key, localK);
        }
    });
    // Resolve net IDs for each kind
    const vccNetId = findNetByName(doc, 'VCC') ?? `net_topo_vcc_${doc.nets.length}`;
    const gndNetId = findNetByName(doc, 'GND') ?? `net_topo_gnd_${doc.nets.length + 1}`;
    const veeNetId = findNetByName(doc, 'VEE') ?? `net_topo_vee_${doc.nets.length + 2}`;
    ensureNet(doc, vccNetId, 'VCC', NetType.POWER);
    ensureNet(doc, gndNetId, 'GND', NetType.GROUND);
    ensureNet(doc, veeNetId, 'VEE', NetType.POWER);
    let signalIdx = 0;
    const signalNetForRep = new Map();
    traceTopoNetNameScan(doc);
    // é‡å»ºå‰ï¼šwire.netId â†’ æœ‰æ„ä¹‰ç½‘åï¼ˆéè‡ªåŠ¨åï¼‰ï¼Œç”¨äºä¿¡å·åˆ†é‡ç»§æ‰¿ï¼Œé¿å… HYST_NODE è¢«æ”¹æˆ NET_13ã€‚
    // å¿…é¡»ä¸¢å¼ƒ NET_N / NET_net_*ï¼ˆæ—§ç‰ˆ ensureNetExists ç”¨ id.substring(0,6) ç”Ÿæˆï¼Œå¤§é‡æ’å NET_net_17ï¼‰ï¼š
    // å¦åˆ™ä¸åŒ UF åˆ†é‡ä¼šå›  findNetByName å‘½ä¸­åŒä¸€è‡ªåŠ¨åè€Œè¢«å¹¶å›ä¸€ç½‘ã€‚
    const nameByOldNetId = new Map();
    let skipAutoNames = 0;
    let keepSemanticNames = 0;
    for (let i = 0; i < doc.nets.length; i++) {
        const n = doc.nets[i];
        const nm = (n.name ?? '').trim();
        if (isAutoGeneratedSignalNetName(nm)) {
            skipAutoNames++;
            continue;
        }
        keepSemanticNames++;
        nameByOldNetId.set(n.id, nm);
    }
    Logger.info(INSTR_TRACE_TAG, `[TOPO] NET_INHERIT filter skip_auto=${skipAutoNames} keep_semantic=${keepSemanticNames}`);
    const inheritedNameForRep = new Map();
    let inheritWireKeep = 0;
    let inheritWireSkip = 0;
    let inheritConflict = 0;
    for (let wi = 0; wi < doc.wires.length; wi++) {
        const w = doc.wires[wi];
        if (w.points.length < 2 || w.netId.length === 0) {
            continue;
        }
        const inherited = nameByOldNetId.get(w.netId);
        if (inherited === undefined) {
            inheritWireSkip++;
            continue;
        }
        const k0 = roundKey(w.points[0]);
        const rep = uf.find(k0);
        const prev = inheritedNameForRep.get(rep);
        if (prev === undefined) {
            inheritedNameForRep.set(rep, inherited);
            inheritWireKeep++;
        }
        else if (prev !== inherited) {
            // åŒå‡ ä½•åˆ†é‡å†²çªå¤šå â†’ æ”¾å¼ƒç»§æ‰¿ï¼Œèµ° NET_N
            inheritedNameForRep.set(rep, '');
            inheritConflict++;
            traceTopoNetInheritDecision('conflict_clear', `rep=${rep} prev=${prev} next=${inherited} wire=${w.id}`);
        }
    }
    if (inheritWireKeep > 0 || inheritConflict > 0) {
        Logger.info(INSTR_TRACE_TAG, `[TOPO] NET_INHERIT wires keep=${inheritWireKeep} skip_no_semantic=${inheritWireSkip} ` +
            `conflict_reps=${inheritConflict} reps_with_name=${inheritedNameForRep.size}`);
    }
    const wireKindForEndpoints = (k0, k1) => {
        const j0 = finalKind.get(k0) ?? JunctionKind.SIGNAL;
        const j1 = finalKind.get(k1) ?? JunctionKind.SIGNAL;
        // Never collapse distinct rails onto one net.
        if (railsWouldShort(j0, j1)) {
            return JunctionKind.SIGNAL;
        }
        if (j0 === JunctionKind.GND || j1 === JunctionKind.GND) {
            return JunctionKind.GND;
        }
        if (j0 === JunctionKind.VEE || j1 === JunctionKind.VEE) {
            return JunctionKind.VEE;
        }
        if (j0 === JunctionKind.VCC || j1 === JunctionKind.VCC) {
            return JunctionKind.VCC;
        }
        return mergeKind(j0, j1);
    };
    let assignFresh = 0;
    let assignInheritExisting = 0;
    let assignInheritNew = 0;
    const netIdToReps = new Map();
    const netIdForKind = (kind, rep) => {
        if (kind === JunctionKind.VCC) {
            return vccNetId;
        }
        if (kind === JunctionKind.GND) {
            return gndNetId;
        }
        if (kind === JunctionKind.VEE) {
            return veeNetId;
        }
        let sid = signalNetForRep.get(rep);
        if (sid === undefined) {
            const keepName = inheritedNameForRep.get(rep) ?? '';
            if (keepName.length > 0) {
                const existing = findNetByName(doc, keepName);
                if (existing !== null) {
                    sid = existing;
                    assignInheritExisting++;
                    Logger.info(INSTR_TRACE_TAG, `[TOPO] NET_ASSIGN inherit_existing rep=${rep} name=${keepName} â†’ id=${sid}`);
                }
                else {
                    signalIdx++;
                    sid = `net_topo_sig_${signalIdx}`;
                    ensureNet(doc, sid, keepName, NetType.SIGNAL);
                    assignInheritNew++;
                    Logger.info(INSTR_TRACE_TAG, `[TOPO] NET_ASSIGN inherit_new rep=${rep} name=${keepName} â†’ id=${sid}`);
                }
            }
            else {
                signalIdx++;
                sid = `net_topo_sig_${signalIdx}`;
                ensureNet(doc, sid, `NET_${signalIdx}`, NetType.SIGNAL);
                assignFresh++;
                if (assignFresh <= 8) {
                    Logger.info(INSTR_TRACE_TAG, `[TOPO] NET_ASSIGN fresh rep=${rep} â†’ name=NET_${signalIdx} id=${sid}`);
                }
            }
            signalNetForRep.set(rep, sid);
            const reps = netIdToReps.get(sid) ?? [];
            reps.push(rep);
            netIdToReps.set(sid, reps);
        }
        return sid;
    };
    const nameOfNet = (netId) => {
        for (let i = 0; i < doc.nets.length; i++) {
            if (doc.nets[i].id === netId) {
                return doc.nets[i].name || netId;
            }
        }
        return netId;
    };
    let reassignCount = 0;
    const reassignChanges = [];
    for (let wi = 0; wi < doc.wires.length; wi++) {
        const wire = doc.wires[wi];
        if (wire.points.length < 2) {
            continue;
        }
        const k0 = roundKey(wire.points[0]);
        const k1 = roundKey(wire.points[wire.points.length - 1]);
        const wKind = wireKindForEndpoints(k0, k1);
        const rep = uf.find(k0);
        const oldNet = wire.netId;
        const targetNet = netIdForKind(wKind, rep);
        if (wire.netId !== targetNet) {
            wire.netId = targetNet;
            reassignCount++;
            reassignChanges.push(`${wire.id} ${nameOfNet(oldNet)}(${oldNet}) â†’ ${nameOfNet(targetNet)}(${targetNet}) kind=${wKind}`);
        }
    }
    const collapseHits = [];
    netIdToReps.forEach((reps, nid) => {
        if (reps.length > 1) {
            collapseHits.push(`${nameOfNet(nid)}(${nid})â†${reps.length}reps`);
        }
    });
    traceTopoSignalAssignSummary(signalNetForRep.size, assignFresh, assignInheritExisting, assignInheritNew, collapseHits);
    const wireNets = new Map();
    for (let wi = 0; wi < doc.wires.length; wi++) {
        const nid = doc.wires[wi].netId;
        wireNets.set(nid, (wireNets.get(nid) ?? 0) + 1);
    }
    const netParts = [];
    wireNets.forEach((count, nid) => {
        netParts.push(`${nameOfNet(nid)}Ã—${count}`);
    });
    if (reassignCount > 0 || collapseHits.length > 0) {
        traceTopoWireNetReassign(reassignChanges, reassignCount, signalIdx, junctions.size, netParts.join(', '));
    }
    else if (doc.wires.length > 0) {
        Logger.info(INSTR_TRACE_TAG, `[TOPO] wire nets unchanged wires=${doc.wires.length} signalNets=${signalIdx} ` +
            `junctions=${junctions.size} wireNetBag={${netParts.join(', ')}}`);
    }
    return reassignCount;
}
