        // ä¸ FOREIGN_PIN_CLEARANCE å¯¹é½ï¼šé‚»è„š 20mil å†…ç¡¬æŒ¡ï¼ˆæ—§ clearRâ‰ˆ9 ä»ä¼šè´´è„šè€Œè¿‡ï¼‰
        const clearR = Math.max(FOREIGN_PIN_CLEARANCE, ctx.gridSize * 0.9);
        for (let pi = 0; pi < obs.pinWorlds.length; pi++) {
