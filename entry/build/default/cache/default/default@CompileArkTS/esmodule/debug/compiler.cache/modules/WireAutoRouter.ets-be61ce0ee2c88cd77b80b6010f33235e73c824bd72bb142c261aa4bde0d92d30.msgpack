                return obs;
            }
            // è„šåœ¨åŒºå¤–è¾¹ç¼˜ï¼šä»å½’å±è¯¥ç«¯ç‚¹å™¨ä»¶
            for (let ei = 0; ei < obs.escapePinWorlds.length; ei++) {
