            }
            let out = [];
            if (atStart) {
                out.push(pin);
                out.push(exit);
                for (let mi = 0; mi < mid.length; mi++) {
                    out.push(mid[mi]);
                }
                for (let ri = 0; ri < rest.length; ri++) {
                    out.push(rest[ri]);
                }
            }
            else {
                for (let ri = 0; ri < rest.length; ri++) {
                    out.push(rest[ri]);
                }
                for (let mi = 0; mi < mid.length; mi++) {
                    out.push(mid[mi]);
                }
                out.push(exit);
                out.push(pin);
            }
            out = WireAutoRouter.dedupe(out);
            if (WireAutoRouter.isFullyOrthogonal(out)) {
                return out;
            }
        }
