    /** å¼‚æ­¥æ®µè·¯ç”±ï¼šA* æ­¥å†…è®©å‡ºï¼›U/é€ƒé€¸å‡ ä½•å€™é€‰ä¸åŒæ­¥ç‰ˆç›¸åŒ */
    static async routeSegmentAsync(from, to, ctx) {
        const fail = { points: [], autoCorrected: false, blocked: true };
        const midH = { x: to.x, y: from.y };
        const midV = { x: from.x, y: to.y };
        const pathH = WireAutoRouter.dedupe([from, midH, to]);
        const pathV = WireAutoRouter.dedupe([from, midV, to]);
        const clearH = WireAutoRouter.pathHardClear(pathH, ctx);
