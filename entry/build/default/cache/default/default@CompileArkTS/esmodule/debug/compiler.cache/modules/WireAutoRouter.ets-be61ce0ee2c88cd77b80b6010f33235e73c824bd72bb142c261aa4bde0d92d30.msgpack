        return false;
    }
    /** æ˜¯å¦ä¸ºå…è®¸è½åˆ°æ—¢æœ‰å¯¼çº¿ä¸Šçš„ T æ¥ç‚¹ï¼ˆè·¯å¾„ç«¯ç‚¹ï¼‰ */
    static isWireJoinPoint(wx, wy, ctx) {
        const joins = ctx.wireJoinPoints;
        if (joins === undefined || joins.length === 0) {
            return false;
        }
        const tol = Math.max(ctx.gridSize * 0.85, 8);
