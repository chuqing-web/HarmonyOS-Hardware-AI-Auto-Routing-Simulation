        for (let i = 0; i < ctx.excludeCompIds.length; i++) {
            s.add(ctx.excludeCompIds[i]);
        }
        return s;
    }
    static expandHit(r, gridSize) {
        const pad = Math.max(1, gridSize * WireAutoRouter.SAFETY_GRID);
        const out = {
            x: r.x - pad,
            y: r.y - pad,
            w: r.w + pad * 2,
            h: r.h + pad * 2,
