    /** å¼•å‡ºç‚¹ï¼šè‡³å°‘ç¦»å¼€éšœç¢å¤–ç¼˜ extraï¼Œä¸”ä¸å°‘äº margin */
    static escapeExitBeyondObstacle(pin, edge, obs, ctx, margin) {
        const banned = WireAutoRouter.expandHit(obs.hitRect, ctx.gridSize);
        const g = Math.max(1, ctx.gridSize);
        const extra = Math.max(margin, g * WireAutoRouter.PIN_LEAD_EXTRA_GRID, WireAutoRouter.PIN_LEAD_EXTRA_MIN);
        const beyond = WireAutoRouter.computeLeadExit(pin, edge, banned, extra);
