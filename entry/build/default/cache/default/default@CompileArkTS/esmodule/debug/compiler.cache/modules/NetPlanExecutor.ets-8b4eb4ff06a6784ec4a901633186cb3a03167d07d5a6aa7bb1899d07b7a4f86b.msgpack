Ôr@Ÿªassertions¤code´customTransformCache¬dependencies¢id¤meta±moduleSideEffects¬originalCode±originalSourcemap«resolvedIds®sourcemapChainµsyntheticNamedExportsµtransformDependencies®transformFiles¨cacheAstÔrAÚP‚/**
 * ç½‘ç»œè®¡åˆ’æ‰§è¡Œå™¨ v1.0 â€” çº¯æ‰§è¡Œå¼•æ“ï¼Œä¸åŒ…å«ä»»ä½•æ‹“æ‰‘æ¨ç†é€»è¾‘
 *
 * èŒè´£: æ¥æ”¶ LLM ç”Ÿæˆçš„ netPlan JSONï¼Œåˆ›å»ºå¯¹åº”çš„ netã€labelã€stub wireã€‚
 * ä¸åšä»»ä½•æ‹“æ‰‘åˆ¤æ–­ â€” æ‰€æœ‰å†³ç­–ç”± LLM åœ¨ netPlan ä¸­å®Œæˆã€‚
 * ä»…åšæœ€ä½é™åº¦çš„å®‰å…¨æ£€æŸ¥ï¼ˆé˜²æ­¢çŸ­è·¯ã€æµ®ç©ºç­‰è‡´å‘½é”™è¯¯ï¼‰ã€‚
 */
import { IdUtil, makeRouteLine, DeviceHitGeometry, SELECTION_HIT_PAD } from 'common';
import { PinWorldResolver } from './PinWorldResolver';
export class NetPlanExecutor {
    /**
     * ç¡®å®šæ€§ä¿®å¤ï¼šåˆå¹¶æ¢é’ˆ/ä»ªå™¨é‡å¤è„šã€æ¶ˆé™¤ä¸€è„šåŒç½‘ã€‚
     * è¿”å›ä¿®å¤æ¡æ•°ï¼›è°ƒç”¨æ–¹åº”åœ¨ critique å‰æ‰§è¡Œã€‚
     */
    static sanitizeDuplicatePins(plan, topo) {
        if (!plan.nets || plan.nets.length === 0) {
            return 0;
        }
        let fixes = 0;
        const isInstrLib = (lib) => {
            const u = lib.toUpperCase();
            return u.indexOf('OSCILLOSCOPE') >= 0 || u.indexOf('VOLTMETER') >= 0 ||
                u.indexOf('AMMETER') >= 0 || u.indexOf('LOGIC_ANALYZER') >= 0 ||
                u.indexOf('UART') >= 0 || u.indexOf('FREQ') >= 0;
        };
        const libOf = (ref) => {
            const d = topo.deviceList.find(x => x.refName.toUpperCase() === ref.toUpperCase());
            return d ? d.libDevId : '';
        };
        const isInstrRef = (ref) => isInstrLib(libOf(ref));
        const isProbeNetName = (name) => {
            const u = name.toUpperCase();
            return u.indexOf('PROBE') === 0 || u.indexOf('OSC_') === 0 ||
                u.indexOf('OSCCH') === 0 || /^CH\d+$/.test(u) ||
                u.indexOf('SENSE_PROBE') >= 0;
        };
        const pinKey = (c) => `${c.compRef}:${c.pinId}`.toUpperCase();
        // Pass1: æ¢é’ˆç½‘ â†’ å¹¶å…¥å·²å«åŒä¸€ DUT è„šçš„ä¿¡å·ç½‘
        for (let pi = plan.nets.length - 1; pi >= 0; pi--) {
            const probe = plan.nets[pi];
            if (!isProbeNetName(probe.name ?? '')) {
                continue;
            }
            const conns = probe.connections ?? [];
            let targetIdx = -1;
            for (let ci = 0; ci < conns.length; ci++) {
                const c = conns[ci];
                if (isInstrRef(c.compRef)) {
                    continue;
                }
                const key = pinKey(c);
                for (let ni = 0; ni < plan.nets.length; ni++) {
                    if (ni === pi) {
                        continue;
                    }
                    const other = plan.nets[ni];
                    if (isProbeNetName(other.name ?? '')) {
                        continue;
                    }
                    const has = (other.connections ?? []).some(oc => pinKey(oc) === key);
                    if (has) {
                        targetIdx = ni;
                        break;
                    }
                }
                if (targetIdx >= 0) {
                    break;
                }
            }
            if (targetIdx < 0) {
                continue;
            }
            const target = plan.nets[targetIdx];
            const existing = new Set((target.connections ?? []).map(pinKey));
            for (let ci = 0; ci < conns.length; ci++) {
                const c = conns[ci];
                const k = pinKey(c);
                if (existing.has(k)) {
                    continue;
                }
                // åªæŠŠä»ªå™¨è„šå¹¶å…¥ï¼›DUT è„šå·²åœ¨ target
                if (isInstrRef(c.compRef)) {
                    target.connections.push(c);
                    existing.add(k);
                    fixes++;
                }
            }
            plan.nets.splice(pi, 1);
            fixes++;
        }
        // Pass2: æ®‹ç•™ä¸€è„šåŒç½‘ â€” ä»ªå™¨ä¾§ä¼˜å…ˆè®©è·¯ï¼›å¦åˆ™ä¿ç•™å…ˆå‡ºç°çš„éæ¢é’ˆç½‘
        const owner = new Map();
        for (let ni = 0; ni < plan.nets.length; ni++) {
            const net = plan.nets[ni];
            const conns = net.connections ?? [];
            const kept = [];
            for (let ci = 0; ci < conns.length; ci++) {
                const c = conns[ci];
                const k = pinKey(c);
                const prev = owner.get(k);
                if (prev === undefined) {
                    owner.set(k, ni);
                    kept.push(c);
                    continue;
                }
                if (prev === ni) {
                    kept.push(c);
                    continue;
                }
                const prevName = (plan.nets[prev].name ?? '').toUpperCase();
                const curName = (net.name ?? '').toUpperCase();
                const prevProbe = isProbeNetName(prevName);
                const curProbe = isProbeNetName(curName);
                // å½“å‰æ˜¯æ¢é’ˆ/ä»…ä»ªå™¨è„š â†’ ä¸¢å¼ƒæœ¬å¤„ DUT é‡å¤ï¼Œä»ªå™¨è„šæ”¹å¹¶å…¥ owner
                if (curProbe || isInstrRef(c.compRef)) {
                    if (isInstrRef(c.compRef)) {
                        const oConns = plan.nets[prev].connections ?? [];
                        if (!oConns.some(oc => pinKey(oc) === k)) {
                            oConns.push(c);
                            plan.nets[prev].connections = oConns;
                        }
                    }
                    fixes++;
                    continue;
                }
                // å…ˆå‰æ˜¯æ¢é’ˆ â†’ æ”¹ç”±å½“å‰ç½‘æ¥ç®¡
                if (prevProbe) {
                    const oNet = plan.nets[prev];
                    oNet.connections = (oNet.connections ?? []).filter(oc => pinKey(oc) !== k);
                    owner.set(k, ni);
                    kept.push(c);
                    fixes++;
                    continue;
                }
                // çœŸå†²çªï¼ˆå¦‚ B è„šæŒ‚ä¸¤è·¯é©±åŠ¨ï¼‰ï¼šä¼˜å…ˆä¿ç•™èœ‚é¸£å™¨é©±åŠ¨ç½‘ / é LED ç½‘
                const prevPrefer = prevName.indexOf('BUZZ') >= 0 || prevName.indexOf('BJT') >= 0;
                const curPrefer = curName.indexOf('BUZZ') >= 0 || curName.indexOf('BJT') >= 0;
                if (curPrefer && !prevPrefer) {
                    const oNet = plan.nets[prev];
                    oNet.connections = (oNet.connections ?? []).filter(oc => pinKey(oc) !== k);
                    owner.set(k, ni);
                    kept.push(c);
                    fixes++;
                    continue;
                }
                fixes++;
            }
            net.connections = kept;
        }
        // Pass3: åˆ ç©ºç½‘
        plan.nets = plan.nets.filter(n => (n.connections ?? []).length > 0);
        return fixes;
    }
    /**
     * æ‰§è¡Œ LLM ç”Ÿæˆçš„ netPlan â€” çº¯æ‰§è¡Œï¼Œæ— æ¨ç†ã€‚
     * å°† LLM çš„ç½‘ç»œè®¡åˆ’è½¬æ¢ä¸ºå®é™…çš„ NetInfo / NetLabelInfo / RouteLineã€‚
     */
    static execute(topo, plan) {
        const failures = [];
        let netCount = 0;
        let labelCount = 0;
        let stubWireCount = 0;
        // é˜Ÿåˆ—ç´¢å¼•ï¼šåŒå/åŒ libDevId å¤šå®ä¾‹æŒ‰å‡ºç°é¡ºåºæ¶ˆè´¹ï¼Œç¦æ­¢ Map è¦†ç›–ä¸¢å™¨ä»¶
        const refQueues = new Map();
        const libQueues = new Map();
        const libCounts = new Map();
        const stickyByKey = new Map();
        const allDevs = topo.deviceList.slice();
        for (let i = 0; i < topo.deviceList.length; i++) {
            const d = topo.deviceList[i];
            const rq = refQueues.get(d.refName) ?? [];
            rq.push(d);
            refQueues.set(d.refName, rq);
            const lq = libQueues.get(d.libDevId) ?? [];
            lq.push(d);
            libQueues.set(d.libDevId, lq);
            libCounts.set(d.libDevId, (libCounts.get(d.libDevId) ?? 0) + 1);
        }
        // æ¸…ç©ºæ—§ç½‘ç»œä¸å¯¼çº¿ï¼ˆé¿å…ç¼–è¾‘/é‡è·‘æ®‹ç•™è„çº¿å¹¶å…¥æ–° stubï¼‰
        topo.netList = [];
        topo.netLabelList = [];
        topo.wireList = [];
        // wiringHintsï¼šå¼ºåˆ¶æ ‡å· / å¼ºåˆ¶å¯¼çº¿ï¼ˆå…ˆäºæ‰‡å‡ºæˆªæ–­ï¼‰
        NetPlanExecutor.applyWiringHints(plan);
        // å•è„šæœ€å¤š 2 æ ¹ joinWiredï¼šè¶…å‡ºæ”¹ä¸º joinByLabel
        NetPlanExecutor.capJoinWiredFanout(plan);
        // é€ç½‘åˆ›å»º
        for (let ni = 0; ni < plan.nets.length; ni++) {
            const netPlan = plan.nets[ni];
            // éªŒè¯: è‡³å°‘2ä¸ªè¿æ¥
            if (netPlan.connections.length < 2) {
                failures.push(`ç½‘ç»œ "${netPlan.name}" åªæœ‰ ${netPlan.connections.length} ä¸ªè¿æ¥ï¼Œè·³è¿‡(éœ€â‰¥2)`);
                continue;
            }
            // è§£æè¿æ¥ â†’ NodeRefï¼ˆå•ç½‘å†…åŒ compRef å›ºå®šåŒä¸€å®ä¾‹ï¼›å”¯ä¸€ä½å·è·¨ç½‘ç²˜æ»ï¼‰
            const nodeList = [];
            const labelPins = [];
            const netLocal = new Map();
            for (let ci = 0; ci < netPlan.connections.length; ci++) {
                const conn = netPlan.connections[ci];
                let dev = netLocal.get(conn.compRef);
                if (!dev) {
                    dev = stickyByKey.get(conn.compRef);
                }
                if (!dev) {
                    const taken = NetPlanExecutor.takeDevice(conn.compRef, refQueues, libQueues, allDevs);
                    dev = taken !== null ? taken : undefined;
                    if (dev) {
                        // ç²¾ç¡®ä½å·å§‹ç»ˆè·¨ç½‘ç²˜æ»ï¼›åŒå‹å·å¤šå®ä¾‹ç¦æ­¢ç²˜æ»æ¨¡ç³Šå/libDevId
                        stickyByKey.set(dev.refName, dev);
                        if ((libCounts.get(dev.libDevId) ?? 0) <= 1) {
                            stickyByKey.set(dev.libDevId, dev);
                            stickyByKey.set(conn.compRef, dev);
                        }
                        else if (conn.compRef === dev.refName) {
                            stickyByKey.set(conn.compRef, dev);
                        }
                    }
                }
                if (dev) {
                    netLocal.set(conn.compRef, dev);
                }
                if (!dev) {
                    failures.push(`å™¨ä»¶ "${conn.compRef}" ä¸å­˜åœ¨ï¼Œè·³è¿‡è¿æ¥`);
                    continue;
                }
                const nodeRef = {
                    devUuid: dev.instUuid,
                    pinId: conn.pinId,
                    pinName: conn.pinName.length > 0 ? conn.pinName : conn.pinId
                };
                nodeList.push(nodeRef);
                if (conn.mode === 'joinByLabel') {
                    const lp = { dev: dev, pinId: conn.pinId, pinName: conn.pinName };
                    labelPins.push(lp);
                }
            }
            if (nodeList.length < 2) {
                failures.push(`ç½‘ç»œ "${netPlan.name}" è§£æåä¸è¶³2ä¸ªè¿æ¥`);
                continue;
            }
            // å®‰å…¨æ£€æŸ¥: ç”µæµè¡¨ I+/I- ä¸è¯¥åœ¨åŒä¸€ç½‘ç»œ
            if (netPlan.name.toUpperCase().includes('VCC') && !netPlan.name.includes('VCC_AM')) {
                let hasIPlus = false;
                let hasIMinus = false;
                for (const conn of netPlan.connections) {
                    if (conn.pinName === 'I+')
                        hasIPlus = true;
                    if (conn.pinName === 'I-')
                        hasIMinus = true;
                }
                if (hasIPlus && hasIMinus) {
                    failures.push(`ç”µæµè¡¨ I+/I- åœ¨åŒä¸€ç½‘ç»œ "${netPlan.name}" â†’ çŸ­è·¯ï¼æ‹’ç»æ‰§è¡Œ`);
                    continue;
                }
            }
            // ç¡®å®šç½‘ç»œç±»å‹
            const isPower = netPlan.type === 'power' || netPlan.type === 'ground';
            const netName = netPlan.name;
            const netInfo = {
                netUuid: IdUtil.generate('net'),
                netName: netName,
                displayName: netName,
                nodeList: nodeList,
                isPower: isPower,
                isAnalog: false,
                isBusMember: false,
                busParentUuid: '',
                defaultVoltage: netPlan.type === 'power' ? 5.0 : 0.0,
                ercWarning: false,
                connectedProbeIds: []
            };
            topo.netList.push(netInfo);
            netCount++;
            // ä¸º joinByLabel å¼•è„šåˆ›å»ºæ ‡å· + stub å¯¼çº¿
            for (const lp of labelPins) {
                const labelEntry = plan.labels.find(l => l.netName === netPlan.name && l.atComp === lp.dev.refName && l.atPin === lp.pinId);
                const text = labelEntry ? labelEntry.text : netPlan.name;
                const pinPos = PinWorldResolver.forDeviceInst(lp.dev, lp.pinId, lp.pinName);
                // æ²¿æœ€è¿‘è¾¹é€ƒé€¸å¼•å‡ºï¼Œç¦æ­¢ L æŠ˜çº¿ç©¿é€‰ä¸­åŒº
                const labelPos = NetPlanExecutor.stubLabelOutside(lp.dev, pinPos);
                // åˆ›å»ºæ ‡å·æ•°æ®
                const labelInfo = {
                    id: IdUtil.generate('lbl'),
                    netUuid: netInfo.netUuid,
                    text: text,
                    x: labelPos.x,
                    y: labelPos.y,
                    global: false
                };
                topo.netLabelList.push(labelInfo);
                labelCount++;
                // å•æ®µæ­£äº¤ stubï¼šå¼•è„š â†’ åŒºå¤–æ ‡å·
                const routeLine = makeRouteLine(netInfo.netUuid, [pinPos, labelPos], false);
                topo.wireList.push(routeLine);
                stubWireCount++;
            }
        }
        // æ—  LLM è®¡åˆ’çš„ fallback: æœ€å°‘ä¿è¯ VCC/GND ç½‘ç»œå­˜åœ¨
        if (topo.netList.length === 0 && topo.deviceList.length > 0) {
            NetPlanExecutor.ensureMinimumNets(topo, failures);
        }
        const notes = plan.topologyNotes.length > 0
            ? `LLMæ‹“æ‰‘æ¨ç†: ${plan.topologyNotes}`
            : `æ‰§è¡Œ ${netCount} ç½‘/${labelCount} æ ‡å·/${stubWireCount} stubå¯¼çº¿`;
        return { topology: topo, netCount, labelCount, stubWireCount, notes, failures };
    }
    /**
     * æŒ‰ wiringHints æ”¹å†™è¿æ¥ modeï¼šforceLabel ä¼˜å…ˆäº forceWireã€‚
     */
    static applyWiringHints(plan) {
        const hints = plan.wiringHints;
        if (!hints) {
            return;
        }
        const forceLabel = hints.forceLabel ?? [];
        const forceWire = hints.forceWire ?? [];
        if (forceLabel.length === 0 && forceWire.length === 0) {
            return;
        }
        for (let ni = 0; ni < plan.nets.length; ni++) {
            const net = plan.nets[ni];
            const nameUp = net.name.toUpperCase();
            let toLabel = false;
            let toWire = false;
            for (let i = 0; i < forceLabel.length; i++) {
                if (nameUp === forceLabel[i].toUpperCase()) {
                    toLabel = true;
                    break;
                }
            }
            for (let i = 0; i < forceWire.length; i++) {
                if (nameUp === forceWire[i].toUpperCase()) {
                    toWire = true;
                    break;
                }
            }
            // çº¿åœˆé©±åŠ¨ç½‘ç¦æ­¢ forceLabel è¯¯ä¼¤
            if (toLabel && (nameUp.indexOf('COIL') >= 0 || nameUp.indexOf('REL_COIL') >= 0)) {
                toLabel = false;
                toWire = true;
            }
            if (!toLabel && !toWire) {
                continue;
            }
            for (let ci = 0; ci < net.connections.length; ci++) {
                if (toLabel) {
                    net.connections[ci].mode = 'joinByLabel';
                }
                else if (toWire) {
                    net.connections[ci].mode = 'joinWired';
                }
            }
        }
    }
    /** æ ‡å· stub ç»ˆç‚¹ï¼šæ²¿å™¨ä»¶é€‰ä¸­åŒºæœ€è¿‘è¾¹å¼•å‡º */
    static stubLabelOutside(dev, pinPos) {
        const halfW = Math.max(Math.abs(pinPos.x - dev.x), 30) + SELECTION_HIT_PAD;
        const halfH = Math.max(Math.abs(pinPos.y - dev.y), 20) + SELECTION_HIT_PAD;
        const rect = {
            x: dev.x - halfW,
            y: dev.y - halfH,
            w: halfW * 2,
            h: halfH * 2,
            refName: dev.refName,
            instUuid: dev.instUuid,
            libDevId: dev.libDevId
        };
        return DeviceHitGeometry.stubLabelOutsidePin(pinPos, rect, 20);
    }
    /**
     * åŒä¸€å¼•è„šï¼ˆcompRef+pinIdï¼‰æœ€å¤š 2 æ¬¡ joinWiredï¼›è¶…å‡ºæ”¹ä¸º joinByLabelã€‚
     * é¿å…æ˜Ÿå½¢æ‰‡å‡ºåœ¨è§„åˆ’é˜¶æ®µå°±åŸ‹ä¸‹ >2 æ ¹å¯¼çº¿ã€‚
     */
    static capJoinWiredFanout(plan) {
        const wiredCount = new Map();
        for (let ni = 0; ni < plan.nets.length; ni++) {
            const conns = plan.nets[ni].connections;
            for (let ci = 0; ci < conns.length; ci++) {
                const conn = conns[ci];
                if (conn.mode !== 'joinWired') {
                    continue;
                }
                const key = `${conn.compRef}|${conn.pinId}`;
                const n = (wiredCount.get(key) ?? 0) + 1;
                if (n > 2) {
                    conn.mode = 'joinByLabel';
                }
                else {
                    wiredCount.set(key, n);
                }
            }
        }
    }
    /**
     * è§£æ LLM compRef â†’ å™¨ä»¶å®ä¾‹ã€‚
     * ä¼˜å…ˆç²¾ç¡® refNameï¼Œå…¶æ¬¡ libDevIdã€‚
     * ä»é˜Ÿåˆ— shiftï¼Œä¿è¯åŒåç¬¬äºŒé¢—ç”µé˜»ä¸ä¼šè¢«ç¬¬ä¸€é¢—è¦†ç›–ã€‚
     */
    static takeDevice(compRef, refQueues, libQueues, allDevs) {
        const fromQueue = (q, key) => {
            const list = q.get(key);
            if (list !== undefined && list.length > 0) {
                return list.shift();
            }
            return null;
        };
        let hit = fromQueue(refQueues, compRef);
        if (hit) {
            NetPlanExecutor.drainDevice(hit, refQueues, libQueues);
            return hit;
        }
        hit = fromQueue(libQueues, compRef);
        if (hit) {
            NetPlanExecutor.drainDevice(hit, refQueues, libQueues);
            return hit;
        }
        // ç¦æ­¢å­ä¸²æ¨¡ç³ŠåŒ¹é…ï¼ˆ"R"/"LED" ä¼šè¯¯ç»‘å¤šå®ä¾‹ï¼‰
        return null;
    }
    /** ä»æ‰€æœ‰é˜Ÿåˆ—ç§»é™¤è¯¥å®ä¾‹ï¼Œé¿å…é‡å¤åˆ†é… */
    static drainDevice(dev, refQueues, libQueues) {
        const rq = refQueues.get(dev.refName);
        if (rq) {
            refQueues.set(dev.refName, rq.filter(d => d.instUuid !== dev.instUuid));
        }
        const lq = libQueues.get(dev.libDevId);
        if (lq) {
            libQueues.set(dev.libDevId, lq.filter(d => d.instUuid !== dev.instUuid));
        }
    }
    /** æ ¹æ® pin å®é™…åæ ‡ + side è®¡ç®—æ ‡å·æ”¾ç½®ä½ç½® */
    static labelPosFromPin(pinPos, side) {
        const stubLen = 30;
        switch (side) {
            case 'left': return { x: pinPos.x - stubLen, y: pinPos.y };
            case 'right': return { x: pinPos.x + stubLen, y: pinPos.y };
            case 'top': return { x: pinPos.x, y: pinPos.y - stubLen };
            case 'bottom':
            default: return { x: pinPos.x, y: pinPos.y + stubLen };
        }
    }
    /** æœ€å°ç½‘ç»œä¿éšœ: æ— LLMè®¡åˆ’æ—¶ç¡®ä¿ VCC/GND å­˜åœ¨ */
    static ensureMinimumNets(topo, failures) {
        const hasVcc = topo.deviceList.some(d => d.libDevId === 'VCC');
        const hasGnd = topo.deviceList.some(d => d.libDevId === 'GND');
        if (hasVcc) {
            topo.netList.push({
                netUuid: IdUtil.generate('net'),
                netName: 'VCC',
                displayName: 'VCC',
                nodeList: [],
                isPower: true,
                isAnalog: false,
                isBusMember: false,
                busParentUuid: '',
                defaultVoltage: 5.0,
                ercWarning: false,
                connectedProbeIds: []
            });
        }
        if (hasGnd) {
            topo.netList.push({
                netUuid: IdUtil.generate('net'),
                netName: 'GND',
                displayName: 'GND',
                nodeList: [],
                isPower: true,
                isAnalog: false,
                isBusMember: false,
                busParentUuid: '',
                defaultVoltage: 0.0,
                ercWarning: false,
                connectedProbeIds: []
            });
        }
        failures.push('LLM netPlan ä¸ºç©ºæˆ–æ— æ•ˆï¼Œå·²åˆ›å»ºæœ€å° VCC/GND ç½‘ç»œ');
    }
}
