Ôr@Ÿªassertions¤code´customTransformCache¬dependencies¢id¤meta±moduleSideEffects¬originalCode±originalSourcemap«resolvedIds®sourcemapChainµsyntheticNamedExportsµtransformDependencies®transformFiles¨cacheAstÔrAÚy3/**
 * ç½‘ç»œè®¡åˆ’æ‰§è¡Œå™¨ v1.0 â€” çº¯æ‰§è¡Œå¼•æ“ï¼Œä¸åŒ…å«ä»»ä½•æ‹“æ‰‘æ¨ç†é€»è¾‘
 *
 * èŒè´£: æ¥æ”¶ LLM ç”Ÿæˆçš„ netPlan JSONï¼Œåˆ›å»ºå¯¹åº”çš„ netã€labelã€stub wireã€‚
 * ä¸åšä»»ä½•æ‹“æ‰‘åˆ¤æ–­ â€” æ‰€æœ‰å†³ç­–ç”± LLM åœ¨ netPlan ä¸­å®Œæˆã€‚
 * ä»…åšæœ€ä½é™åº¦çš„å®‰å…¨æ£€æŸ¥ï¼ˆé˜²æ­¢çŸ­è·¯ã€æµ®ç©ºç­‰è‡´å‘½é”™è¯¯ï¼‰ã€‚
 */
import { IdUtil, makeRouteLine, DeviceHitGeometry, SELECTION_HIT_PAD, Logger, INSTR_TRACE_TAG, traceAiDiag } from 'common';
import { PinWorldResolver } from './PinWorldResolver';
export class NetPlanExecutor {
    /** å°† LLM åŸå§‹ JSON è§„èŒƒæˆå¯å®‰å…¨ä½¿ç”¨çš„ NetPlanResultï¼ˆé˜² undefined.toUpperCaseï¼‰ */
    static normalizeLlmPlan(raw) {
        if (!raw || typeof raw !== 'object') {
            Logger.warn(INSTR_TRACE_TAG, '[AI_PIPE] net_plan normalize FAIL raw=null/non-object');
            return null;
        }
        const src = raw;
        const netsRaw = src['nets'];
        if (!Array.isArray(netsRaw) || netsRaw.length === 0) {
            Logger.warn(INSTR_TRACE_TAG, `[AI_PIPE] net_plan normalize FAIL nets=${netsRaw === undefined ? 'missing' :
                (Array.isArray(netsRaw) ? `empty(${netsRaw.length})` : typeof netsRaw)}`);
            return null;
        }
        const dropLines = [];
        let dropNet = 0;
        let dropConn = 0;
        let rawConn = 0;
        const nets = [];
        for (let i = 0; i < netsRaw.length; i++) {
            const nObj = netsRaw[i];
            if (!nObj || typeof nObj !== 'object') {
                dropNet++;
                if (dropLines.length < 12) {
                    dropLines.push(`net[${i}] skipped: non-object`);
                }
                continue;
            }
            const n = nObj;
            const name = `${n['name'] ?? n['netName'] ?? n['net_name'] ?? ''}`.trim();
            if (name.length === 0) {
                dropNet++;
                if (dropLines.length < 12) {
                    dropLines.push(`net[${i}] skipped: empty name keys=[${Object.keys(n).join(',')}]`);
                }
                continue;
            }
            const nameUp = name.toUpperCase();
            const typeRaw = `${n['type'] ?? n['netType'] ?? n['net_type'] ?? ''}`.toLowerCase();
            let type = typeRaw === 'power' ? 'power' : (typeRaw === 'ground' ? 'ground' : 'signal');
            // æŒ‰ç½‘åå¼ºåˆ¶çº æ­£ï¼šLLM å¸¸æ¼å†™ typeï¼Œé»˜è®¤ signal ä¼šè§¦å‘ HARD critique è¯¯æ€ VCC/GND
            if (nameUp === 'VCC' || nameUp === 'VDD' || nameUp === '+5V' || nameUp === '5V' ||
                nameUp === '3V3' || nameUp === '+3V3') {
                type = 'power';
            }
            else if (nameUp === 'GND' || nameUp === 'VSS' || nameUp === 'AGND' || nameUp === 'DGND') {
                type = 'ground';
            }
            const netModeHint = `${n['mode'] ?? ''}`.toLowerCase();
            const connsRaw = n['connections'] ?? n['pins'] ?? n['nodes'];
            const connections = [];
            if (Array.isArray(connsRaw)) {
                for (let ci = 0; ci < connsRaw.length; ci++) {
                    const cObj = connsRaw[ci];
                    rawConn++;
                    if (!cObj || typeof cObj !== 'object') {
                        dropConn++;
                        if (dropLines.length < 12) {
                            dropLines.push(`net[${i}].conn[${ci}] skipped: non-object`);
                        }
                        continue;
                    }
                    const c = cObj;
                    const compRef = `${c['compRef'] ?? c['comp'] ?? c['ref'] ?? c['refDes'] ?? ''}`.trim();
                    const pinId = `${c['pinId'] ?? c['pin'] ?? c['pin_id'] ?? ''}`.trim();
                    const pinName = `${c['pinName'] ?? c['pin_name'] ?? pinId}`.trim();
                    if (compRef.length === 0 || pinId.length === 0) {
                        dropConn++;
                        if (dropLines.length < 12) {
                            dropLines.push(`net[${i}](${name}).conn[${ci}] skipped: compRef="${compRef}" pinId="${pinId}" keys=[${Object.keys(c).join(',')}]`);
                        }
                        continue;
                    }
                    // ç»§æ‰¿ç½‘çº§ modeï¼ˆLLM å¸¸åªåœ¨ net ä¸Šå†™ joinByLabelï¼‰
                    const modeRaw = `${c['mode'] ?? netModeHint ?? 'joinWired'}`.toLowerCase();
                    const mode = modeRaw.indexOf('label') >= 0 ? 'joinByLabel' : 'joinWired';
                    connections.push({ compRef, pinId, pinName: pinName.length > 0 ? pinName : pinId, mode });
                }
            }
            if (connections.length === 0) {
                dropNet++;
                if (dropLines.length < 12) {
                    dropLines.push(`net[${i}](${name}) skipped: no valid connections`);
                }
                continue;
            }
            nets.push({ name, type, connections });
        }
        if (nets.length === 0) {
            Logger.warn(INSTR_TRACE_TAG, `[AI_PIPE] net_plan normalize FAIL all nets dropped rawNets=${netsRaw.length} dropNet=${dropNet} dropConn=${dropConn}`);
            if (dropLines.length > 0) {
                traceAiDiag('AI_PIPE', 'net_plan_drop', dropLines, 16);
            }
            return null;
        }
        const labels = [];
        const labelsRaw = src['labels'] ?? src['netLabels'] ?? src['net_labels'];
        if (Array.isArray(labelsRaw)) {
            for (let i = 0; i < labelsRaw.length; i++) {
                const lObj = labelsRaw[i];
                if (!lObj || typeof lObj !== 'object') {
                    continue;
                }
                const l = lObj;
                const netName = `${l['netName'] ?? l['net'] ?? l['name'] ?? ''}`.trim();
                const text = `${l['text'] ?? l['label'] ?? netName}`.trim();
                const atComp = `${l['atComp'] ?? l['compRef'] ?? l['ref'] ?? ''}`.trim();
                const atPin = `${l['atPin'] ?? l['pinId'] ?? l['pin'] ?? ''}`.trim();
                if (netName.length === 0 || atComp.length === 0 || atPin.length === 0) {
                    continue;
                }
                const sideRaw = `${l['side'] ?? 'right'}`.toLowerCase();
                let side = 'right';
                if (sideRaw === 'left' || sideRaw === 'top' || sideRaw === 'bottom') {
                    side = sideRaw;
                }
                labels.push({ netName, text: text.length > 0 ? text : netName, atComp, atPin, side });
            }
        }
        const hintsRaw = src['wiringHints'] ?? src['wiring_hints'] ?? src['connectionModeHints'];
        const wiringHints = {
            priorityOrder: NetPlanExecutor.safeStringList(hintsRaw && typeof hintsRaw === 'object'
                ? hintsRaw['priorityOrder'] ??
                    hintsRaw['priority_order'] : null),
            forceWire: NetPlanExecutor.safeStringList(hintsRaw && typeof hintsRaw === 'object'
                ? hintsRaw['forceWire'] ??
                    hintsRaw['force_wire'] : null),
            forceLabel: NetPlanExecutor.safeStringList(hintsRaw && typeof hintsRaw === 'object'
                ? hintsRaw['forceLabel'] ??
                    hintsRaw['force_label'] : null)
        };
        const notes = `${src['topologyNotes'] ?? src['topology_notes'] ?? src['notes'] ?? ''}`;
        let connKeep = 0;
        for (let ni = 0; ni < nets.length; ni++) {
            connKeep += nets[ni].connections.length;
        }
        Logger.info(INSTR_TRACE_TAG, `[AI_PIPE] net_plan normalize OK nets=${nets.length}/${netsRaw.length}` +
            ` conns=${connKeep}/${rawConn} dropNet=${dropNet} dropConn=${dropConn}` +
            ` labels=${labels.length} forceWire=${wiringHints.forceWire.length}` +
            ` forceLabel=${wiringHints.forceLabel.length}`);
        if (dropLines.length > 0) {
            traceAiDiag('AI_PIPE', 'net_plan_drop', dropLines, 16);
        }
        const sample = [];
        for (let i = 0; i < Math.min(nets.length, 8); i++) {
            const nn = nets[i];
            sample.push(`${nn.name}(${nn.type})Ã—${nn.connections.length}` +
                `[${nn.connections.slice(0, 3).map(c => `${c.compRef}:${c.pinId}`).join(',')}]`);
        }
        if (sample.length > 0) {
            traceAiDiag('AI_PIPE', 'net_plan_norm', sample, 10);
        }
        return { nets, labels, wiringHints, topologyNotes: notes };
    }
    static safeStringList(value) {
        const out = [];
        if (value === null || value === undefined || !Array.isArray(value)) {
            return out;
        }
        const arr = value;
        for (let i = 0; i < arr.length; i++) {
            if (arr[i] === null || arr[i] === undefined) {
                continue;
            }
            const s = `${arr[i]}`.trim();
            if (s.length > 0 && s !== 'undefined' && s !== 'null') {
                out.push(s);
            }
        }
        return out;
    }
    /**
     * ç¡®å®šæ€§ä¿®å¤ï¼šåˆå¹¶æ¢é’ˆ/ä»ªå™¨é‡å¤è„šã€æ¶ˆé™¤ä¸€è„šåŒç½‘ã€‚
     * è¿”å›ä¿®å¤æ¡æ•°ï¼›è°ƒç”¨æ–¹åº”åœ¨ critique å‰æ‰§è¡Œã€‚
     */
    static sanitizeDuplicatePins(plan, topo) {
        if (!plan.nets || plan.nets.length === 0) {
            return 0;
        }
        let fixes = 0;
        fixes += NetPlanExecutor.sanitizeUnknownDeviceRefs(plan, topo);
        const isInstrLib = (lib) => {
            const u = (lib ?? '').toUpperCase();
            return u.indexOf('OSCILLOSCOPE') >= 0 || u.indexOf('VOLTMETER') >= 0 ||
                u.indexOf('AMMETER') >= 0 || u.indexOf('LOGIC_ANALYZER') >= 0 ||
                u.indexOf('UART') >= 0 || u.indexOf('FREQ') >= 0;
        };
        const libOf = (ref) => {
            const want = (ref ?? '').toUpperCase();
            if (want.length === 0) {
                return '';
            }
            const d = topo.deviceList.find(x => (x.refName ?? '').toUpperCase() === want);
            return d ? (d.libDevId ?? '') : '';
        };
        const isInstrRef = (ref) => isInstrLib(libOf(ref));
        const isProbeNetName = (name) => {
            const u = (name ?? '').toUpperCase();
            return u.indexOf('PROBE') === 0 || u.indexOf('OSC_') === 0 ||
                u.indexOf('OSCCH') === 0 || /^CH\d+$/.test(u) ||
                u.indexOf('SENSE_PROBE') >= 0;
        };
        const pinKey = (c) => `${c.compRef ?? ''}:${c.pinId ?? ''}`.toUpperCase();
        // Pass1: æ¢é’ˆç½‘ â†’ å¹¶å…¥å·²å«åŒä¸€ DUT è„šçš„ä¿¡å·ç½‘
        for (let pi = plan.nets.length - 1; pi >= 0; pi--) {
            const probe = plan.nets[pi];
            if (!isProbeNetName(probe.name ?? '')) {
                continue;
            }
            const conns = probe.connections ?? [];
            let targetIdx = -1;
            for (let ci = 0; ci < conns.length; ci++) {
                const c = conns[ci];
                if (isInstrRef(c.compRef)) {
                    continue;
                }
                const key = pinKey(c);
                for (let ni = 0; ni < plan.nets.length; ni++) {
                    if (ni === pi) {
                        continue;
                    }
                    const other = plan.nets[ni];
                    if (isProbeNetName(other.name ?? '')) {
                        continue;
                    }
                    const has = (other.connections ?? []).some(oc => pinKey(oc) === key);
                    if (has) {
                        targetIdx = ni;
                        break;
                    }
                }
                if (targetIdx >= 0) {
                    break;
                }
            }
            if (targetIdx < 0) {
                continue;
            }
            const target = plan.nets[targetIdx];
            const existing = new Set((target.connections ?? []).map(pinKey));
            for (let ci = 0; ci < conns.length; ci++) {
                const c = conns[ci];
                const k = pinKey(c);
                if (existing.has(k)) {
                    continue;
                }
                // åªæŠŠä»ªå™¨è„šå¹¶å…¥ï¼›DUT è„šå·²åœ¨ target
                if (isInstrRef(c.compRef)) {
                    target.connections.push(c);
                    existing.add(k);
                    fixes++;
                }
            }
            plan.nets.splice(pi, 1);
            fixes++;
        }
        // Pass2: æ®‹ç•™ä¸€è„šåŒç½‘ â€” ä»ªå™¨ä¾§ä¼˜å…ˆè®©è·¯ï¼›å¦åˆ™ä¿ç•™å…ˆå‡ºç°çš„éæ¢é’ˆç½‘
        const owner = new Map();
        for (let ni = 0; ni < plan.nets.length; ni++) {
            const net = plan.nets[ni];
            const conns = net.connections ?? [];
            const kept = [];
            for (let ci = 0; ci < conns.length; ci++) {
                const c = conns[ci];
                const k = pinKey(c);
                const prev = owner.get(k);
                if (prev === undefined) {
                    owner.set(k, ni);
                    kept.push(c);
                    continue;
                }
                if (prev === ni) {
                    kept.push(c);
                    continue;
                }
                const prevName = (plan.nets[prev].name ?? '').toUpperCase();
                const curName = (net.name ?? '').toUpperCase();
                const prevProbe = isProbeNetName(prevName);
                const curProbe = isProbeNetName(curName);
                // å½“å‰æ˜¯æ¢é’ˆ/ä»…ä»ªå™¨è„š â†’ ä¸¢å¼ƒæœ¬å¤„ DUT é‡å¤ï¼Œä»ªå™¨è„šæ”¹å¹¶å…¥ owner
                if (curProbe || isInstrRef(c.compRef)) {
                    if (isInstrRef(c.compRef)) {
                        const oConns = plan.nets[prev].connections ?? [];
                        if (!oConns.some(oc => pinKey(oc) === k)) {
                            oConns.push(c);
                            plan.nets[prev].connections = oConns;
                        }
                    }
                    fixes++;
                    continue;
                }
                // å…ˆå‰æ˜¯æ¢é’ˆ â†’ æ”¹ç”±å½“å‰ç½‘æ¥ç®¡
                if (prevProbe) {
                    const oNet = plan.nets[prev];
                    oNet.connections = (oNet.connections ?? []).filter(oc => pinKey(oc) !== k);
                    owner.set(k, ni);
                    kept.push(c);
                    fixes++;
                    continue;
                }
                // çœŸå†²çªï¼ˆå¦‚ B è„šæŒ‚ä¸¤è·¯é©±åŠ¨ï¼‰ï¼šä¼˜å…ˆä¿ç•™èœ‚é¸£å™¨é©±åŠ¨ç½‘ / é LED ç½‘
                const prevPrefer = prevName.indexOf('BUZZ') >= 0 || prevName.indexOf('BJT') >= 0;
                const curPrefer = curName.indexOf('BUZZ') >= 0 || curName.indexOf('BJT') >= 0;
                if (curPrefer && !prevPrefer) {
                    const oNet = plan.nets[prev];
                    oNet.connections = (oNet.connections ?? []).filter(oc => pinKey(oc) !== k);
                    owner.set(k, ni);
                    kept.push(c);
                    fixes++;
                    continue;
                }
                fixes++;
            }
            net.connections = kept;
        }
        // Pass3: åˆ ç©ºç½‘
        plan.nets = plan.nets.filter(n => (n.connections ?? []).length > 0);
        return fixes;
    }
    /**
     * ä¸¢å¼ƒæ‹“æ‰‘ä¸­ä¸å­˜åœ¨çš„å™¨ä»¶å¼•ç”¨ï¼ˆå¹¶è¡Œæ¨¡å—ä¸²æ‰° / LLM å¹»è§‰ U1 ç­‰ï¼‰ï¼Œ
     * é¿å… LED æ¨¡å—æ¥å— 555 ç½‘è¡¨ã€‚
     */
    static sanitizeUnknownDeviceRefs(plan, topo) {
        if (!plan.nets || plan.nets.length === 0) {
            return 0;
        }
        const known = new Set();
        for (let i = 0; i < topo.deviceList.length; i++) {
            const d = topo.deviceList[i];
            known.add((d.refName ?? '').toUpperCase());
            known.add((d.libDevId ?? '').toUpperCase());
        }
        let fixes = 0;
        for (let ni = 0; ni < plan.nets.length; ni++) {
            const net = plan.nets[ni];
            const conns = net.connections ?? [];
            const kept = [];
            for (let ci = 0; ci < conns.length; ci++) {
                const c = conns[ci];
                const ref = (c.compRef ?? '').toUpperCase();
                if (ref.length > 0 && known.has(ref)) {
                    kept.push(c);
                }
                else {
                    fixes++;
                }
            }
            net.connections = kept;
        }
        const before = plan.nets.length;
        plan.nets = plan.nets.filter(n => (n.connections ?? []).length >= 1);
        fixes += before - plan.nets.length;
        return fixes;
    }
    /**
     * æ‰§è¡Œ LLM ç”Ÿæˆçš„ netPlan â€” çº¯æ‰§è¡Œï¼Œæ— æ¨ç†ã€‚
     * å°† LLM çš„ç½‘ç»œè®¡åˆ’è½¬æ¢ä¸ºå®é™…çš„ NetInfo / NetLabelInfo / RouteLineã€‚
     */
    static execute(topo, plan) {
        const failures = [];
        let netCount = 0;
        let labelCount = 0;
        let stubWireCount = 0;
        // é˜Ÿåˆ—ç´¢å¼•ï¼šåŒå/åŒ libDevId å¤šå®ä¾‹æŒ‰å‡ºç°é¡ºåºæ¶ˆè´¹ï¼Œç¦æ­¢ Map è¦†ç›–ä¸¢å™¨ä»¶
        const refQueues = new Map();
        const libQueues = new Map();
        const libCounts = new Map();
        const stickyByKey = new Map();
        const allDevs = topo.deviceList.slice();
        for (let i = 0; i < topo.deviceList.length; i++) {
            const d = topo.deviceList[i];
            const rq = refQueues.get(d.refName) ?? [];
            rq.push(d);
            refQueues.set(d.refName, rq);
            const lq = libQueues.get(d.libDevId) ?? [];
            lq.push(d);
            libQueues.set(d.libDevId, lq);
            libCounts.set(d.libDevId, (libCounts.get(d.libDevId) ?? 0) + 1);
        }
        // æ¸…ç©ºæ—§ç½‘ç»œä¸å¯¼çº¿ï¼ˆé¿å…ç¼–è¾‘/é‡è·‘æ®‹ç•™è„çº¿å¹¶å…¥æ–° stubï¼‰
        topo.netList = [];
        topo.netLabelList = [];
        topo.wireList = [];
        // wiringHintsï¼šå¼ºåˆ¶æ ‡å· / å¼ºåˆ¶å¯¼çº¿ï¼ˆå…ˆäºæ‰‡å‡ºæˆªæ–­ï¼‰
        NetPlanExecutor.applyWiringHints(plan);
        // å•è„šæœ€å¤š 2 æ ¹ joinWiredï¼šè¶…å‡ºæ”¹ä¸º joinByLabel
        NetPlanExecutor.capJoinWiredFanout(plan);
        // é€ç½‘åˆ›å»º
        for (let ni = 0; ni < plan.nets.length; ni++) {
            const netPlan = plan.nets[ni];
            // éªŒè¯: è‡³å°‘2ä¸ªè¿æ¥
            if (netPlan.connections.length < 2) {
                failures.push(`ç½‘ç»œ "${netPlan.name}" åªæœ‰ ${netPlan.connections.length} ä¸ªè¿æ¥ï¼Œè·³è¿‡(éœ€â‰¥2)`);
                continue;
            }
            // è§£æè¿æ¥ â†’ NodeRefï¼ˆå•ç½‘å†…åŒ compRef å›ºå®šåŒä¸€å®ä¾‹ï¼›å”¯ä¸€ä½å·è·¨ç½‘ç²˜æ»ï¼‰
            const nodeList = [];
            const labelPins = [];
            const netLocal = new Map();
            for (let ci = 0; ci < netPlan.connections.length; ci++) {
                const conn = netPlan.connections[ci];
                let dev = netLocal.get(conn.compRef);
                if (!dev) {
                    dev = stickyByKey.get(conn.compRef);
                }
                if (!dev) {
                    const taken = NetPlanExecutor.takeDevice(conn.compRef, refQueues, libQueues, allDevs);
                    dev = taken !== null ? taken : undefined;
                    if (dev) {
                        // ç²¾ç¡®ä½å·å§‹ç»ˆè·¨ç½‘ç²˜æ»ï¼›åŒå‹å·å¤šå®ä¾‹ç¦æ­¢ç²˜æ»æ¨¡ç³Šå/libDevId
                        stickyByKey.set(dev.refName, dev);
                        if ((libCounts.get(dev.libDevId) ?? 0) <= 1) {
                            stickyByKey.set(dev.libDevId, dev);
                            stickyByKey.set(conn.compRef, dev);
                        }
                        else if (conn.compRef === dev.refName) {
                            stickyByKey.set(conn.compRef, dev);
                        }
                    }
                }
                if (dev) {
                    netLocal.set(conn.compRef, dev);
                }
                if (!dev) {
                    failures.push(`å™¨ä»¶ "${conn.compRef}" ä¸å­˜åœ¨ï¼Œè·³è¿‡è¿æ¥`);
                    continue;
                }
                const nodeRef = {
                    devUuid: dev.instUuid,
                    pinId: conn.pinId,
                    pinName: conn.pinName.length > 0 ? conn.pinName : conn.pinId
                };
                nodeList.push(nodeRef);
                if (conn.mode === 'joinByLabel') {
                    const lp = { dev: dev, pinId: conn.pinId, pinName: conn.pinName };
                    labelPins.push(lp);
                }
            }
            if (nodeList.length < 2) {
                failures.push(`ç½‘ç»œ "${netPlan.name}" è§£æåä¸è¶³2ä¸ªè¿æ¥`);
                continue;
            }
            // å®‰å…¨æ£€æŸ¥: ç”µæµè¡¨ I+/I- ä¸è¯¥åœ¨åŒä¸€ç½‘ç»œ
            if (netPlan.name.toUpperCase().includes('VCC') && !netPlan.name.includes('VCC_AM')) {
                let hasIPlus = false;
                let hasIMinus = false;
                for (const conn of netPlan.connections) {
                    if (conn.pinName === 'I+')
                        hasIPlus = true;
                    if (conn.pinName === 'I-')
                        hasIMinus = true;
                }
                if (hasIPlus && hasIMinus) {
                    failures.push(`ç”µæµè¡¨ I+/I- åœ¨åŒä¸€ç½‘ç»œ "${netPlan.name}" â†’ çŸ­è·¯ï¼æ‹’ç»æ‰§è¡Œ`);
                    continue;
                }
            }
            // ç¡®å®šç½‘ç»œç±»å‹
            const isPower = netPlan.type === 'power' || netPlan.type === 'ground';
            const netName = netPlan.name;
            const netInfo = {
                netUuid: IdUtil.generate('net'),
                netName: netName,
                displayName: netName,
                nodeList: nodeList,
                isPower: isPower,
                isAnalog: false,
                isBusMember: false,
                busParentUuid: '',
                defaultVoltage: netPlan.type === 'power' ? 5.0 : 0.0,
                ercWarning: false,
                connectedProbeIds: []
            };
            topo.netList.push(netInfo);
            netCount++;
            // ä¸º joinByLabel å¼•è„šåˆ›å»ºæ ‡å· + stub å¯¼çº¿
            for (const lp of labelPins) {
                const labelEntry = plan.labels.find(l => l.netName === netPlan.name && l.atComp === lp.dev.refName && l.atPin === lp.pinId);
                const text = labelEntry ? labelEntry.text : netPlan.name;
                const pinPos = PinWorldResolver.forDeviceInst(lp.dev, lp.pinId, lp.pinName);
