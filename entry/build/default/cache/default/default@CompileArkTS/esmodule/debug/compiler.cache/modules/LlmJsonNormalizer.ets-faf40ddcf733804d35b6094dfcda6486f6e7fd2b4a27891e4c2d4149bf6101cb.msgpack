      result[ks[i]] = LlmJsonNormalizer.asNumber(cell, 0);
    }
    return result;
  }

  static normalizeDeviceSelect(raw: Object | null): DeviceSelectLlmOutput | null {
    if (!raw) {
      return null;
    }
    const src = raw as RawDeviceSelect;
    const functionModule = LlmJsonNormalizer.asStringArray(LlmJsonNormalizer.firstDefined(
      src.functionModule, src.function_module, src.functionModules, src.function_modules
