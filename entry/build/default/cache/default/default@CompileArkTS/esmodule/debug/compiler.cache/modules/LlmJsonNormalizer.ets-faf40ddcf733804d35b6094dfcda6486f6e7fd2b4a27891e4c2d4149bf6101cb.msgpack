      return `${value}`;
    }
    // å¯¹è±¡/æ•°ç»„ç¦æ­¢ `${obj}` â†’ "[object Object]"
    if (Array.isArray(value)) {
      return (value as Object[]).map(v => LlmJsonNormalizer.asText(v, '')).filter(s => s.length > 0).join(',');
