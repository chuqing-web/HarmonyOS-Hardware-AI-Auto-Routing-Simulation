export class LlmJsonNormalizer {
  static toCamelKey(key: string): string {
    if (key.indexOf('_') < 0) {
      return key;
    }
    const parts = key.split('_');
    let result = parts[0];
    for (let i = 1; i < parts.length; i++) {
      const p = parts[i];
      if (p.length === 0) {
        continue;
      }
      result += p.charAt(0).toUpperCase() + p.substring(1);
    }
    return result;
