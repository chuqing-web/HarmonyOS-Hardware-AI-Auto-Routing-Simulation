export class ProteusFonts {
    static setScale(s) {
        ProteusFonts.scale = Math.min(1.5, Math.max(1.0, s));
    }
    static getScale() {
        return ProteusFonts.scale;
    }
    static sz(base) {
        return Math.round(base * ProteusFonts.scale);
    }
    static get MENU() { return ProteusFonts.sz(12); }
    static get TOOLBAR() { return ProteusFonts.sz(11); }
    static get TITLE() { return ProteusFonts.sz(12); }
    static get PARAM_KEY() { return ProteusFonts.sz(11); }
    /** è¾“å…¥æ¡†æ­£æ–‡ä¸å ä½ç¬¦ç»Ÿä¸€ç”¨æ­¤å­—å· */
    static get PARAM_VALUE() { return ProteusFonts.sz(12); }
    static get INPUT() { return ProteusFonts.PARAM_VALUE; }
    static get STATUS() { return ProteusFonts.sz(10); }
    static get TAB_CHIP() { return ProteusFonts.sz(11); }
    static get BTN_LABEL() { return ProteusFonts.sz(12); }
    static get CANVAS_LABEL() { return ProteusFonts.sz(12); }
    static get RULER() { return ProteusFonts.sz(10); }
