import { PcbToolMode } from 'pcb_editor';
import { ProteusColors, ProteusDimens } from '../../theme/ProteusTheme';
import { PROTEUS_THEME_REV_KEY } from '../../theme/ThemeManager';
import { ProteusIcon, ProteusIconName } from '../proteus/ProteusIcons';
import { ProteusTooltipBubble } from '../proteus/ProteusWidgets';

@Component
export struct PcbVerticalToolbar {
  @StorageProp(PROTEUS_THEME_REV_KEY) themeRev: number = 0;
  @Prop toolMode: PcbToolMode = PcbToolMode.SELECT;
  @Prop gridActive: boolean = true;
  onToolSelect: (mode: PcbToolMode) => void = (_m: PcbToolMode) => {};
  onRotate: () => void = () => {};
  onDelete: () => void = () => {};
  onUndo: () => void = () => {};
  onRedo: () => void = () => {};
  onFit: () => void = () => {};
  onToggleGrid: () => void = () => {};
  onUpdatePcb: () => void = () => {};
  onDrc: () => void = () => {};
  onAutoRoute: () => void = () => {};

  build() {
    Column() {
      this.toolBtn(ProteusIconName.SELECT, 'é€‰æ‹© (S)', this.toolMode === PcbToolMode.SELECT, () => {
        this.onToolSelect(PcbToolMode.SELECT);
      })
      this.toolBtn(ProteusIconName.TRACK, 'èµ°çº¿ (X)', this.toolMode === PcbToolMode.ROUTE, () => {
        this.onToolSelect(PcbToolMode.ROUTE);
      })
      this.toolBtn(ProteusIconName.VIA, 'è¿‡å­” (V)', this.toolMode === PcbToolMode.VIA, () => {
        this.onToolSelect(PcbToolMode.VIA);
      })
      this.toolBtn(ProteusIconName.ZONE, 'è¦†é“œ (Z)', this.toolMode === PcbToolMode.POUR, () => {
        this.onToolSelect(PcbToolMode.POUR);
      })

      Divider().color(ProteusColors.DIVIDER).width('80%').margin({ top: 4, bottom: 4 })

      this.toolBtn(ProteusIconName.ROTATE, 'æ—‹è½¬ (R)', false, () => { this.onRotate(); })
      this.toolBtn(ProteusIconName.TRASH, 'åˆ é™¤ (Del)', false, () => { this.onDelete(); })
      this.toolBtn(ProteusIconName.UNDO, 'æ’¤é”€ (Ctrl+Z)', false, () => { this.onUndo(); })
      this.toolBtn(ProteusIconName.REDO, 'é‡åš (Ctrl+Y)', false, () => { this.onRedo(); })

      Divider().color(ProteusColors.DIVIDER).width('80%').margin({ top: 4, bottom: 4 })

      this.toolBtn(ProteusIconName.FIT, 'é€‚åº”çª—å£ (F)', false, () => { this.onFit(); })
      this.toolBtn(ProteusIconName.GRID, 'åˆ‡æ¢ç½‘æ ¼', this.gridActive, () => { this.onToggleGrid(); })

