Ôr@Ÿªassertions¤code´customTransformCache¬dependencies¢id¤meta±moduleSideEffects¬originalCode±originalSourcemap«resolvedIds®sourcemapChainµsyntheticNamedExportsµtransformDependencies®transformFiles¨cacheAstÔrAÚŸs/**
 * åç”ŸæˆéªŒè¯å™¨ â€” ç”»å¸ƒå¸ƒç½®å®Œæˆåè‡ªæ£€ + è‡ªåŠ¨ä¿®å¤
 *
 * æ£€æŸ¥é¡¹:
 *   1. VCC/GND å­˜åœ¨æ€§
 *   2. ä»ªå™¨æ‹“æ‰‘æ­£ç¡®æ€§ (ç”µæµè¡¨ä¸²è”/ç”µå‹è¡¨å¹¶è”)
 *   3. å¯¼çº¿ä¾µå…¥å™¨ä»¶é€‰ä¸­å‘½ä¸­åŒº (HIT_PAD=22)
 *   4. å¯¼çº¿è´´è¿‘æ— å…³å¼•è„š
 *   5. è·¨ç½‘ç»œå¯¼çº¿é‡å 
 *   6. æµ®ç©ºå¼•è„š (å§”æ‰˜ FaultDiagnoser)
 *
 * ä¿®å¤ç­–ç•¥: æœ€å¤š 3 è½®, æ¯è½®ä¿®å¤ â†’ é‡å¸ƒçº¿ â†’ å†æ£€æŸ¥
 */
import { ErcSeverity, IdUtil, TopologyAdapter, makeDeviceInst, stringMap1, getPinNetMap, Logger, INSTR_TRACE_TAG, traceAiDiag, DeviceHitGeometry, SELECTION_HIT_PAD, FOREIGN_PIN_CLEARANCE, WireConflictGeometry, mapAwareStringify, mapAwareParse, MainThreadYield } from 'common';
import { FaultDiagnoser } from './FaultDiagnoser';
import { ConstrainedWiringEngine } from './ConstrainedWiringEngine';
import { resolveHysteresisSafeAmplitude, parseSignalAmplitudeVolts, HYSTERESIS_MIN_SIGNAL_AMP_V, schematicLikelyHysteresisComparator } from './CircuitIntent';
import { PinWorldResolver } from './PinWorldResolver';
import { TemplateSchematicKit } from './TemplateSchematicKit';
import { AiTopologyFixKit } from './AiTopologyFixKit';
export class PostGenValidator {
    constructor(library) {
        this.circuitIntent = null;
        this.PIN_ESCAPE_GRID = 10;
        this.library = library;
        this.wiringEngine = new ConstrainedWiringEngine();
        this.wiringEngine.setComponentLibrary(library);
    }
    setCircuitIntent(intent) {
        this.circuitIntent = intent;
    }
    /** åªè¯»æ£€æŸ¥ â€” ä¸ä¿®æ”¹æ‹“æ‰‘, ä¾› pipeline å‡ ä½•ç¢°æ’æ£€æµ‹ä½¿ç”¨ */
    collectIssues(topo) {
        return this.collectAllIssues(topo);
    }
    /**
     * åŒæ­¥å…¥å£ï¼ˆä»…æµ‹è¯•/å°è§„æ¨¡ï¼‰ã€‚ç”Ÿäº§æµæ°´çº¿å¿…é¡»ç”¨ validateAndFixAsyncï¼Œ
     * å¦åˆ™ routeUntilClean åŒæ­¥ A* ä¼šè§¦å‘ THREAD_BLOCK_3S/6Sã€‚
     */
    validateAndFix(topo) {
        return this.validateAndFixCoreSync(topo);
    }
    /** ç”Ÿäº§ä¸»å…¥å£ï¼šå¼‚æ­¥ä¿®å¤ + æ¯è½®è®©å‡ºä¸»çº¿ç¨‹ */
    async validateAndFixAsync(topo) {
        return await this.validateAndFixCoreAsync(topo);
    }
    async yieldMain() {
        await MainThreadYield.yield();
    }
    validateAndFixCoreSync(topo) {
        const maxRounds = 3;
        let totalFixed = 0;
        let current = topo;
        let prevErrorCount = -1;
        for (let round = 0; round < maxRounds; round++) {
            const issues = this.collectAllIssues(current);
            const errors = issues.filter(i => i.severity === 'error');
            if (errors.length === 0) {
                const warns = issues.filter(i => i.severity === 'warning');
                if (warns.length > 0) {
                    Logger.info('PostGenValidator', `[VALIDATE] round=${round + 1} pass (${warns.length} warnings)`);
                }
                else {
                    Logger.info('PostGenValidator', `[VALIDATE] round=${round + 1} all clear`);
                }
                return { passed: true, issues, fixedCount: totalFixed, topo: current };
            }
            Logger.info('PostGenValidator', `[VALIDATE] round=${round + 1} errors=${errors.length}` +
                ` issues=[${errors.map(e => e.type).join(',')}]`);
            for (const e of errors) {
                Logger.info('PostGenValidator', `  ${e.type}: ${e.desc}`);
            }
            // é”™è¯¯æ•°æœªä¸‹é™ â†’ åœæ­¢ç©ºè½¬ A*ï¼ˆé˜² THREAD_BLOCKï¼‰
            if (prevErrorCount >= 0 && errors.length >= prevErrorCount) {
                Logger.warn('PostGenValidator', `[VALIDATE] round=${round + 1} no progress (${errors.length} errors) â€” stop`);
                return { passed: false, issues, fixedCount: totalFixed, topo: current };
            }
            prevErrorCount = errors.length;
            const fixResult = this.attemptFixesSync(current, errors);
            current = fixResult.topo;
            totalFixed += fixResult.fixed;
            if (fixResult.fixed === 0) {
                Logger.warn('PostGenValidator', `[VALIDATE] round=${round + 1} cannot fix remaining ${errors.length} errors`);
                return { passed: false, issues, fixedCount: totalFixed, topo: current };
            }
        }
        const finalIssues = this.collectAllIssues(current);
        const remainingErrors = finalIssues.filter(i => i.severity === 'error');
        return {
            passed: remainingErrors.length === 0,
            issues: finalIssues,
            fixedCount: totalFixed,
            topo: current
        };
    }
    async validateAndFixCoreAsync(topo) {
        const maxRounds = 3;
        let totalFixed = 0;
        let current = topo;
        let prevErrorCount = -1;
        for (let round = 0; round < maxRounds; round++) {
            await this.yieldMain();
            const issues = this.collectAllIssues(current);
            const errors = issues.filter(i => i.severity === 'error');
            if (errors.length === 0) {
                const warns = issues.filter(i => i.severity === 'warning');
                if (warns.length > 0) {
                    Logger.info('PostGenValidator', `[VALIDATE] round=${round + 1} pass (${warns.length} warnings)`);
                }
                else {
                    Logger.info('PostGenValidator', `[VALIDATE] round=${round + 1} all clear`);
                }
                return { passed: true, issues, fixedCount: totalFixed, topo: current };
            }
            Logger.info('PostGenValidator', `[VALIDATE] round=${round + 1} errors=${errors.length}` +
                ` issues=[${errors.map(e => e.type).join(',')}]`);
            for (const e of errors) {
                Logger.info('PostGenValidator', `  ${e.type}: ${e.desc}`);
            }
            if (prevErrorCount >= 0 && errors.length >= prevErrorCount) {
                Logger.warn('PostGenValidator', `[VALIDATE] round=${round + 1} no progress (${errors.length} errors) â€” stop`);
                return { passed: false, issues, fixedCount: totalFixed, topo: current };
            }
            prevErrorCount = errors.length;
            const fixResult = await this.attemptFixesAsync(current, errors);
            current = fixResult.topo;
            totalFixed += fixResult.fixed;
            if (fixResult.fixed === 0) {
                Logger.warn('PostGenValidator', `[VALIDATE] round=${round + 1} cannot fix remaining ${errors.length} errors`);
                return { passed: false, issues, fixedCount: totalFixed, topo: current };
            }
        }
        const finalIssues = this.collectAllIssues(current);
        const remainingErrors = finalIssues.filter(i => i.severity === 'error');
        return {
            passed: remainingErrors.length === 0,
            issues: finalIssues,
            fixedCount: totalFixed,
            topo: current
        };
    }
    /** æ”¶é›†æ‰€æœ‰ç±»å‹çš„é—®é¢˜ */
    collectAllIssues(topo) {
        const all = [];
        all.push(...this.checkPowerSymbols(topo));
        all.push(...this.checkInstrumentTopology(topo));
        all.push(...this.checkHysteresisSignalAmplitude(topo));
        all.push(...this.checkWireBodyCollisions(topo));
        all.push(...this.checkWirePinProximity(topo));
        all.push(...this.checkCrossNetOverlaps(topo));
        all.push(...this.checkOrphanOptionalCaps(topo));
        all.push(...this.checkDualLedSwitchTopology(topo));
        all.push(...this.checkErc(topo));
        return all;
    }
    /**
     * åŒ LED + ç»§ç”µå™¨ï¼šé˜´æå¿…é¡»æ¥åˆ° NC/NOï¼ˆäº’æ–¥æŒ‡ç¤ºï¼‰ã€‚
     * ä»…ç”µè·¯å·²å« RELAY_SPDT æ—¶æ£€æŸ¥è§¦ç‚¹ï¼›SW_PUSH+åŒLED å¯èƒ½æ˜¯ç”µæºå¼€å…³+é—ªçƒç¯ï¼Œä¸å¾—å¼ºåˆ¶ç»§ç”µå™¨ã€‚
     */
    checkDualLedSwitchTopology(topo) {
        const issues = [];
        if (this.circuitIntent !== null &&
            !(this.circuitIntent.mutualLedIndicator || this.circuitIntent.relayContactTopo)) {
            return issues;
        }
        const leds = topo.deviceList.filter(d => d.libDevId.startsWith('LED_'));
        if (leds.length < 2) {
            return issues;
        }
        const hasRelay = topo.deviceList.some(d => d.libDevId === 'RELAY_SPDT' || (d.libDevId ?? '').toUpperCase().indexOf('RELAY') >= 0);
        if (!hasRelay) {
            if (this.circuitIntent !== null && this.circuitIntent.mutualLedIndicator) {
                issues.push({
                    type: 'instrument_topo',
                    severity: 'error',
                    desc: 'ç¼ºå°‘ RELAY_SPDT â€” äº’æ–¥åŒè‰²æŒ‡ç¤ºå¿…é¡»å«ç»§ç”µå™¨',
                    targetUuid: ''
                });
            }
            return issues;
        }
        // æ£€æŸ¥æ˜¯å¦æœ‰ LED é˜´ææ¥åˆ° RELAY çš„ NC/NO
        const relay = topo.deviceList.find(d => d.libDevId === 'RELAY_SPDT' || (d.libDevId ?? '').toUpperCase().indexOf('RELAY') >= 0);
        if (!relay) {
            return issues;
        }
        const isRelayContact = (n) => {
            const id = (n.pinId ?? '').toUpperCase();
            const nm = (n.pinName ?? '').toUpperCase();
            return id === 'NC' || id === 'NO' || nm === 'NC' || nm === 'NO' ||
                id === '4' || id === '5' || nm === '4' || nm === '5';
        };
        const isLedCathode = (n) => {
            const id = (n.pinId ?? '').toUpperCase();
            const nm = (n.pinName ?? '').toUpperCase();
            return id === 'K' || nm === 'K' || id === '2' || nm === '2';
        };
        let contactLinks = 0;
        for (const net of topo.netList) {
            const hasNcOrNo = net.nodeList.some(n => n.devUuid === relay.instUuid && isRelayContact(n));
            const hasLedK = net.nodeList.some(n => {
                const led = leds.find(l => l.instUuid === n.devUuid);
                return led !== undefined && isLedCathode(n);
            });
            if (hasNcOrNo && hasLedK) {
                contactLinks++;
            }
        }
        if (contactLinks < 2) {
            // ç”¨ net_integrity è¯­ä¹‰ï¼šå‹¿è§¦å‘æ•´ç½‘ Semantic æ¸…ç©ºï¼ˆLLM ç½‘å¯èƒ½å·²åŸºæœ¬æ­£ç¡®ï¼‰
            issues.push({
                type: 'erc',
                severity: 'error',
                desc: `ç»§ç”µå™¨è§¦ç‚¹æŒ‡ç¤ºä¸å®Œæ•´: ä»… ${contactLinks}/2 è·¯ LED æ¥åˆ° NC/NOï¼ˆéœ€å±€éƒ¨è¡¥ç½‘ï¼Œå‹¿æ•´å›¾é‡å»ºï¼‰`,
                targetUuid: relay.instUuid
            });
        }
        return issues;
    }
    /** é MCUï¼šå®Œå…¨æµ®ç©ºçš„ç”µå®¹è§†ä¸ºé”™è¯¯ï¼ˆè‡ªå®¡å¹»è§‰æ·»åŠ ï¼‰ */
    checkOrphanOptionalCaps(topo) {
        const issues = [];
        const hasMcu = topo.deviceList.some(d => {
            const id = (d.libDevId ?? '').toUpperCase();
            return id.indexOf('STM32') >= 0 || id.indexOf('AT89') >= 0 || id.indexOf('STC') >= 0;
        });
        if (hasMcu) {
            return issues;
        }
        const doc = TopologyAdapter.fromTopology(topo);
        for (const dev of topo.deviceList) {
            if (!dev.libDevId.startsWith('C_')) {
                continue;
            }
            const pinNets = getPinNetMap(dev.instUuid, doc.nets);
            if (pinNets.size === 0) {
                issues.push({
                    type: 'floating_pin',
                    severity: 'error',
                    desc: `æµ®ç©ºç”µå®¹ ${dev.refName}(${dev.libDevId}) â€” é MCU ç”µè·¯åº”ç§»é™¤`,
                    targetUuid: dev.instUuid
                });
            }
        }
        return issues;
    }
    // â”€â”€â”€ æ£€æŸ¥ 1: VCC/GND å­˜åœ¨æ€§ â”€â”€â”€
    checkPowerSymbols(topo) {
        const issues = [];
        const hasVcc = topo.deviceList.some(d => d.libDevId === 'VCC');
        const hasGnd = topo.deviceList.some(d => d.libDevId === 'GND');
        if (!hasVcc) {
            issues.push({ type: 'missing_power', severity: 'error',
                desc: 'ç¼ºå°‘ VCC ç”µæºç¬¦å· â€” ç”µè·¯å¿…é¡»æœ‰ç”µæº' });
        }
        if (!hasGnd) {
            issues.push({ type: 'missing_power', severity: 'error',
                desc: 'ç¼ºå°‘ GND æ¥åœ°ç¬¦å· â€” ç”µè·¯å¿…é¡»æœ‰åœ°' });
        }
        return issues;
    }
    // â”€â”€â”€ æ£€æŸ¥ 1b: æ»å›æ•´å½¢ SIGNAL_GEN å¹…åº¦ â”€â”€â”€
    checkHysteresisSignalAmplitude(topo) {
        const issues = [];
        const ids = topo.deviceList.map(d => d.libDevId ?? '');
        // æœ‰æ„å›¾æ—¶ä»¥æ„å›¾ä¸ºå‡†ï¼Œé¿å…è¯¯ä¼¤ã€Œè¿æ”¾+ä¿¡å·æºã€å°ä¿¡å·æ”¾å¤§
        if (this.circuitIntent !== null) {
            if (!this.circuitIntent.needsHysteresisComparator) {
                return issues;
            }
        }
        else if (!schematicLikelyHysteresisComparator(ids)) {
            return issues;
        }
        for (let i = 0; i < topo.deviceList.length; i++) {
            const d = topo.deviceList[i];
            if ((d.libDevId ?? '').toUpperCase().indexOf('SIGNAL_GEN') < 0) {
                continue;
            }
            const ampText = (d.params.get('amplitude') ?? '').trim();
            const ampV = parseSignalAmplitudeVolts(ampText);
            if (!Number.isFinite(ampV) || ampV < HYSTERESIS_MIN_SIGNAL_AMP_V) {
                issues.push({
                    type: 'signal_amp',
                    severity: 'error',
                    desc: `æ»å›æ•´å½¢ SIGNAL_GEN ${d.refName} amplitude=${ampText || '(ç©º)'} ` +
                        `è¿‡å°ï¼ˆé¡»â‰¥${HYSTERESIS_MIN_SIGNAL_AMP_V}Vï¼Œæ¨è 5Vï¼‰ï¼Œå¦åˆ™è¾“å‡ºä¼šé”æ­»å•è½¨`,
                    targetUuid: d.instUuid
                });
            }
        }
        return issues;
    }
    // â”€â”€â”€ æ£€æŸ¥ 2: ä»ªå™¨æ‹“æ‰‘ â”€â”€â”€
    checkInstrumentTopology(topo) {
        const issues = [];
        const doc = TopologyAdapter.fromTopology(topo);
        for (const dev of topo.deviceList) {
            const pinNets = getPinNetMap(dev.instUuid, doc.nets);
            const libId = (dev.libDevId ?? '').toUpperCase();
            if (libId === 'AMMETER_DC') {
                const iPlusNet = pinNets.get('I+') ?? pinNets.get('1');
                const iMinusNet = pinNets.get('I-') ?? pinNets.get('2');
                if (!iPlusNet || !iMinusNet) {
                    issues.push({ type: 'instrument_topo', severity: 'error',
                        desc: `ç”µæµè¡¨ ${dev.refName} å¼•è„šæµ®ç©º (I+æˆ–I-æœªå…¥ç½‘)`, targetUuid: dev.instUuid });
                }
                else if (iPlusNet === iMinusNet) {
                    issues.push({ type: 'instrument_topo', severity: 'error',
                        desc: `ç”µæµè¡¨ ${dev.refName} I+/I- åœ¨åŒä¸€ç½‘ç»œ â†’ çŸ­è·¯!`, targetUuid: dev.instUuid });
                }
            }
            if (libId === 'VOLTMETER_DC' || libId === 'VIRTUAL_METER') {
                const vPlusNet = pinNets.get('V+') ?? pinNets.get('V') ?? pinNets.get('1');
                const comNet = pinNets.get('COM') ?? pinNets.get('2');
                if (!vPlusNet || !comNet) {
                    issues.push({ type: 'instrument_topo', severity: 'error',
                        desc: `ç”µå‹è¡¨ ${dev.refName} å¼•è„šæµ®ç©º (V+/V æˆ– COM æœªå…¥ç½‘)`, targetUuid: dev.instUuid });
                }
                else if (vPlusNet === comNet) {
                    issues.push({ type: 'instrument_topo', severity: 'error',
                        desc: `ç”µå‹è¡¨ ${dev.refName} V+/COM åœ¨åŒä¸€ç½‘ç»œ â†’ è¯»æ•°ä¸º0!`, targetUuid: dev.instUuid });
                }
            }
            if (libId.indexOf('OSCILLOSCOPE') >= 0) {
                const ch1 = pinNets.get('CH1') ?? pinNets.get('1');
                const gnd = pinNets.get('GND') ?? pinNets.get('5');
                if (!ch1) {
                    issues.push({ type: 'instrument_topo', severity: 'error',
                        desc: `ç¤ºæ³¢å™¨ ${dev.refName} CH1 æœªå…¥ç½‘ â€” æ— æ³•è§‚æµ‹æ³¢å½¢`, targetUuid: dev.instUuid });
                }
                if (!gnd) {
                    issues.push({ type: 'instrument_topo', severity: 'error',
                        desc: `ç¤ºæ³¢å™¨ ${dev.refName} GND æœªå…¥ç½‘ â€” å¿…é¡»å…±åœ°`, targetUuid: dev.instUuid });
                }
                if (ch1 && gnd && ch1 === gnd) {
                    issues.push({ type: 'instrument_topo', severity: 'error',
                        desc: `ç¤ºæ³¢å™¨ ${dev.refName} CH1 ä¸ GND åŒç½‘ â†’ æ— å·®åˆ†ä¿¡å·`, targetUuid: dev.instUuid });
                }
                // æµ‹é‡é€šé“ç¦æ­¢æŒ‚åœ¨çº¯ç”µæºè½¨ï¼ˆæ’å‹æ— æ„ä¹‰ï¼‰
                const sensePins = ['CH1', 'CH2', 'CH3', 'CH4', '1', '2', '3', '4'];
                for (let si = 0; si < sensePins.length; si++) {
                    const sn = pinNets.get(sensePins[si]);
                    if (!sn) {
                        continue;
                    }
                    const net = doc.nets.find(n => n.id === sn);
                    const nName = (net?.name ?? '').toUpperCase();
                    if (nName === 'VCC' || nName === 'VDD' || nName === '+5V' || nName === '3V3') {
                        issues.push({ type: 'instrument_topo', severity: 'error',
                            desc: `ç¤ºæ³¢å™¨ ${dev.refName}.${sensePins[si]} æŒ‚åœ¨ç”µæºç½‘ ${nName} â€” åº”æ¥è¢«æµ‹ä¿¡å·èŠ‚ç‚¹`,
                            targetUuid: dev.instUuid });
                    }
                }
            }
        }
        return issues;
    }
    // â”€â”€â”€ æ£€æŸ¥ 3: å¯¼çº¿ä¾µå…¥å™¨ä»¶é€‰ä¸­èŒƒå›´ â”€â”€â”€
    checkWireBodyCollisions(topo) {
        const issues = [];
        const hitRects = this.buildHitRects(topo);
        for (const wire of topo.wireList) {
            for (let i = 1; i < wire.points.length; i++) {
                const a = wire.points[i - 1];
                const b = wire.points[i];
                // æ®µé‡‡æ ·ï¼šæœ¬ç½‘æœ¬å™¨ä»¶ä»…é€ƒé€¸èµ°å»Šæ”¾è¡Œï¼Œç¦æ­¢ç©¿ä½“/ç©¿å¼‚å™¨ä»¶
                const samples = DeviceHitGeometry.sampleSegment(a, b, 8);
                for (let si = 0; si < samples.length; si++) {
                    const pt = samples[si];
                    for (let ri = 0; ri < hitRects.length; ri++) {
                        const rect = hitRects[ri];
                        if (!DeviceHitGeometry.pointInRect(pt.x, pt.y, rect)) {
                            continue;
                        }
                        if (this.pointInOwnDeviceEscapeCorridor(pt, topo, wire.netUuid, rect)) {
                            continue;
                        }
                        issues.push({
                            type: 'wire_body', severity: 'error',
                            desc: `å¯¼çº¿ä¾µå…¥å™¨ä»¶é€‰ä¸­èŒƒå›´: net=${wire.netUuid} â†’ ${rect.refName}(${rect.libDevId}) ` +
                                `é€‰ä¸­åŒº(${Math.round(rect.x)},${Math.round(rect.y)},${Math.round(rect.w)}Ã—${Math.round(rect.h)})`,
                            targetUuid: wire.netUuid
                        });
                        break;
                    }
                }
                // æ•´æ®µ vs AABBï¼šéçº¯é€ƒé€¸èµ°å»Šåˆ™æŠ¥ç©¿åŒº
                for (let ri = 0; ri < hitRects.length; ri++) {
                    const rect = hitRects[ri];
                    if (DeviceHitGeometry.segmentIntersectsRect(a, b, rect)) {
                        if (this.segmentIsOwnEscapeOnly(a, b, topo, wire.netUuid, rect)) {
                            continue;
                        }
                        const already = issues.some(iss => iss.type === 'wire_body' && iss.targetUuid === wire.netUuid &&
                            iss.desc.indexOf(rect.refName) >= 0);
                        if (!already) {
                            issues.push({
                                type: 'wire_body', severity: 'error',
                                desc: `å¯¼çº¿è·¯å¾„ç©¿è¿‡å™¨ä»¶é€‰ä¸­èŒƒå›´: ${wire.netUuid} Ã— ${rect.refName}`,
                                targetUuid: wire.netUuid
                            });
                        }
                    }
                }
            }
        }
        return this.dedupeIssues(issues);
    }
    buildHitRects(topo) {
        const rects = [];
        for (const dev of topo.deviceList) {
            const def = this.getCompDef(dev.libDevId);
            if (def && def.pins.length > 0) {
                rects.push(DeviceHitGeometry.hitRectFromDeviceInst(dev, def.pins, SELECTION_HIT_PAD));
            }
            else {
                const locals = [
                    { x: -30, y: 0 }, { x: 30, y: 0 }, { x: 0, y: -20 }, { x: 0, y: 20 }
                ];
                rects.push(DeviceHitGeometry.hitRectFromLocalPoints(locals, dev.x, dev.y, dev.rotate, dev.mirrorH, SELECTION_HIT_PAD, dev.refName, dev.instUuid, dev.libDevId));
            }
        }
        return rects;
    }
    /** æœ¬ç½‘ã€æœ¬å™¨ä»¶é€‰ä¸­åŒºå†…çš„å¼•è„šé€ƒé€¸èµ°å»Šï¼ˆpinId/pinName å‡å¯ï¼Œå…¼å®¹ LLM æ•°å­—è„šå·ï¼‰ */
    pointInOwnDeviceEscapeCorridor(pt, topo, netUuid, rect) {
        const net = topo.netList.find(n => n.netUuid === netUuid);
        if (!net) {
            return false;
        }
        const hw = Math.max(this.PIN_ESCAPE_GRID, 10);
        for (const node of net.nodeList) {
