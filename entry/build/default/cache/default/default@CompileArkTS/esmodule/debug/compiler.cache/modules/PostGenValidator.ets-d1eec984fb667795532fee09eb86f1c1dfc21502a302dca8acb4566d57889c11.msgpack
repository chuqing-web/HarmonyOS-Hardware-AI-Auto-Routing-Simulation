export interface ValidationIssue {
  type: 'missing_power' | 'instrument_topo' | 'wire_body' | 'wire_cross' | 'floating_pin' | 'pin_proximity' | 'erc';
  severity: 'error' | 'warning';
  desc: string;
  targetUuid?: string;
}

export interface ValidationResult {
  passed: boolean;
  issues: ValidationIssue[];
  fixedCount: number;
  topo: SchTopology;
}

interface Segment {
  a: Point2D;
