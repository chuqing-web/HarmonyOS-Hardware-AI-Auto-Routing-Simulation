 * pin_id æ•°å­—/åˆ«å â†’ Builtin pin.idï¼ˆKit å‡ ä½•çœŸè„šï¼‰
 *
 * çº¦å®šï¼š
 * - DeviceLibrary: pin_id=å°è£…æ•°å­—, pin_label=è¯­ä¹‰å
 * - Builtin: pin.id=å‡ ä½•çœŸè„š, makePin ç¬¬3å‚=å°è£…å·
 * - Kit: å…ˆ PinIdRegistry.resolve å† pinOffset
 *
 * ç”Ÿæˆï¼šnode tools/gen_pin_id_registry.js
 * å®¡è®¡ï¼šnode tools/pin_convention_audit.js
 */
export class PinIdRegistry {
    static familyKey(libDevId) {
        const u = (libDevId ?? '').toUpperCase();
        if (u.startsWith('POT_')) {
            return 'POT_*';
        }
        if (u.startsWith('LED_')) {
            return 'LED_*';
        }
        if (u.startsWith('1N') || u.indexOf('DIODE') >= 0) {
            return '1N*';
        }
        return u;
    }
    static tableFor(libDevId) {
        const u = (libDevId ?? '').toUpperCase();
        return PinIdRegistry.MAP[u] ?? PinIdRegistry.MAP[PinIdRegistry.familyKey(libDevId)];
    }
    /** æœ‰æ˜ å°„è¿”å›ž Builtin pin.idï¼›æ— æ˜ å°„è¿”å›žç©ºä¸² */
    static canonicalize(libDevId, pinId, pinName = '') {
        const table = PinIdRegistry.tableFor(libDevId);
        if (!table) {
            return '';
        }
        const tryOne = (raw) => {
            const t = (raw ?? '').trim();
            if (t.length === 0) {
                return '';
            }
            const m = /^([A-Za-z0-9_.+-]+)\s*\([^)]*\)\s*$/.exec(t);
            const key = (m ? m[1] : t).toUpperCase();
            const hit = table[key];
            return hit !== undefined ? hit : '';
        };
        const a = tryOne(pinId);
        if (a.length > 0) {
            return a;
        }
        return tryOne(pinName);
    }
    /** è§„èŒƒåŒ–ï¼›æ— æ˜ å°„æ—¶è¿”å›žå‰¥æ‹¬å·åŽçš„åŽŸ pinId */
    static resolve(libDevId, pinId, pinName = '') {
        const c = PinIdRegistry.canonicalize(libDevId, pinId, pinName);
        if (c.length > 0) {
            return c;
        }
        const t = (pinId ?? '').trim();
        const m = /^([A-Za-z0-9_.+-]+)\s*\([^)]*\)\s*$/.exec(t);
        return m ? m[1] : t;
    }
    static knownTokens(libDevId) {
        const table = PinIdRegistry.tableFor(libDevId);
        if (!table) {
            return [];
        }
        const out = [];
        const seen = new Set();
        const keys = Object.keys(table);
        for (let i = 0; i < keys.length; i++) {
            const k = keys[i];
            const v = table[k];
            if (!seen.has(k)) {
                seen.add(k);
                out.push(k);
            }
            const vu = (v ?? '').toUpperCase();
            if (vu.length > 0 && !seen.has(vu)) {
                seen.add(vu);
                out.push(v);
            }
        }
        return out;
    }
    static hasDevice(libDevId) {
        return PinIdRegistry.tableFor(libDevId) !== undefined;
    }
}
