            const placeY = cursorY + ext.halfH + courtyardGap;
            cursorX += slotW;
            rowMaxH = Math.max(rowMaxH, slotH);
            const created = this.lib.instantiate(defId, comp.refDes, value, { x: placeX, y: placeY }, comp.rotation, comp.id);
