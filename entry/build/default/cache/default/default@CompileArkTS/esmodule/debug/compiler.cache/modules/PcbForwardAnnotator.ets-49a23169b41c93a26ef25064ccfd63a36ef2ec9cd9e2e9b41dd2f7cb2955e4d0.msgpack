            maxY -= shiftY;
        }
        const boardW = Math.max(maxX + margin, 800);
        const boardH = Math.max(maxY + margin, 600);
        doc.boardOutline.points = [
            { x: 0, y: 0 }, { x: boardW, y: 0 }, { x: boardW, y: boardH }, { x: 0, y: boardH }
