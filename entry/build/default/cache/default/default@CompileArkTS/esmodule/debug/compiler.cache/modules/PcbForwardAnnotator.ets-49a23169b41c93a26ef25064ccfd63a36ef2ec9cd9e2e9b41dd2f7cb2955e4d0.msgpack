    annotateFromTopology(topo, existing) {
        const schematic = {
            id: topo.schUuid,
            name: topo.schName,
            version: '1.0',
            components: [],
            wires: [],
            nets: [],
            netLabels: [],
            subcircuits: [],
            metadata: {
                author: '', createdAt: '', modifiedAt: '',
                description: '', gridSize: 10, units: 'mil', undoLimit: 1000
