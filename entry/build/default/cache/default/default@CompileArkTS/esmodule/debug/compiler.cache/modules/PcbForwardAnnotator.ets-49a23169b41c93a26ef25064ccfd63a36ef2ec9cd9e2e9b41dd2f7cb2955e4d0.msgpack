import { NetType } from '../types/CommonTypes';
import { createEmptyPcbDocument } from '../types/PcbTypes';
import { getGlobalPcbFootprintLibrary } from './PcbFootprintLibrary';
import { parsePinRef } from './PinRefUtil';
import { paramMapGet } from './MapHelpers';
import { registerSchPinToPadNet, lookupPadNet } from './PcbPinBindUtil';
import { tracePcbForwardResult } from './PcbTraceLog';
import { collectFootprintPadPositions, updateTracksForFootprintTransform, snapTrackEndpointsToPads, pruneZeroLengthTracks } from './PcbTrackBindUtil';
import { syncFootprintPadsFromSchematic } from './PcbSchPadSync';
import { rebuildPcbNets } from './PcbNetUtil';
import { ensureBoardAccessories, accessoryHintsFromSchematicNets } from './PcbBoardAccessories';
function extractFootprint(comp) {
    const keys = ['footprint', 'package', 'Package', 'å°è£…', 'pkg'];
    for (const k of keys) {
        const v = paramMapGet(comp.parameters, k, '');
        if (v.length > 0)
            return v;
    }
    return '';
}
function extractValue(comp) {
    return paramMapGet(comp.parameters, 'value', paramMapGet(comp.parameters, 'Value', comp.libraryId));
}
/** è·³è¿‡ç”µæº/åœ°/æ¢é’ˆ/ä»ªå™¨ç­‰ä¸å¯å¸ƒå±€å™¨ä»¶ â€” ä¸ export.mjs isLayoutable å¯¹é½ï¼ˆå« vac/å®Œæ•´ä»ªå™¨æ¸…å•ï¼‰ */
function isLayoutable(comp) {
    const lib = comp.libraryId.toLowerCase();
    if (lib.startsWith('gnd') || lib.startsWith('vcc') || lib.startsWith('vee') ||
        lib.startsWith('vac') || lib.startsWith('power') || lib.includes('probe') ||
        lib.includes('instrument') || lib.includes('oscilloscope') || lib.includes('multimeter') ||
        lib.includes('generator') || lib.includes('voltmeter') || lib.includes('ammeter') ||
        lib.includes('power_meter') || lib.includes('freq_counter') || lib.includes('logic_analyzer') ||
        lib.includes('uart_terminal') || lib.includes('virtual_meter') || lib.includes('signal_gen')) {
        return false;
    }
    if (comp.refDes.startsWith('#'))
        return false;
    return true;
}
/** æ ¹æ® courtyard ä¼°ç®—å°è£…å ä½åŠå®½/åŠé«˜ (mil) */
function footprintHalfExtents(lib, defId) {
    const def = lib.getDef(defId);
    let halfW = 60;
    let halfH = 40;
    if (!def) {
        const result = { halfW: halfW, halfH: halfH };
        return result;
    }
    for (const pad of def.pads) {
        halfW = Math.max(halfW, Math.abs(pad.pos.x) + pad.size.x / 2);
        halfH = Math.max(halfH, Math.abs(pad.pos.y) + pad.size.y / 2);
    }
    if (def.courtyard.length >= 2) {
        for (const pt of def.courtyard) {
            halfW = Math.max(halfW, Math.abs(pt.x));
            halfH = Math.max(halfH, Math.abs(pt.y));
        }
    }
    const result = { halfW: halfW, halfH: halfH };
    return result;
}
/** ä» refDes æå–å°¾éƒ¨æ•°å­—ï¼ˆU1â†’1ï¼ŒCX01â†’1ï¼ŒRL3â†’3ï¼‰ */
function refIndex(refDes) {
    let n = 0;
    let found = false;
    for (let i = 0; i < refDes.length; i++) {
        const c = refDes.charCodeAt(i);
        if (c >= 48 && c <= 57) {
            n = n * 10 + (c - 48);
            found = true;
        }
        else if (found) {
            break;
        }
    }
    return found ? n : 0;
}
/**
 * åŸç†å›¾ç›¸å¯¹ä½å§¿ â†’ PCBï¼šä¿ç•™åŠŸèƒ½ç°‡ï¼ˆMCU+æ™¶æŒ¯+ç”µå®¹+LEDï¼‰ï¼Œ
 * é€‚ä¸­é—´è·ã€è§£é‡å ï¼Œå¹¶æŒ‰åˆ—ç´§å‡‘åˆ©ç”¨æ¿é¢ã€‚
 */
function slotRole(refDes, defId) {
    const r = (refDes || '').toUpperCase();
    const d = (defId || '').toUpperCase();
    if (r.charAt(0) === 'U' || d.indexOf('STM32') >= 0 || d.indexOf('AT89') >= 0 ||
        d.indexOf('STC') >= 0) {
        return 'mcu';
    }
    if (r.charAt(0) === 'Y' || d.indexOf('XTAL') >= 0 || d.indexOf('CRYSTAL') >= 0) {
        return 'xtal';
    }
    if (r.indexOf('CX') === 0 || (r.charAt(0) === 'C' && d.indexOf('CAP') >= 0)) {
        return 'cap';
    }
    if (r.indexOf('CD') === 0) {
        return 'decap';
    }
    if (r.indexOf('RL') === 0) {
        return 'ledr';
    }
    if (r.charAt(0) === 'D' || d.indexOf('LED') >= 0) {
        return 'led';
    }
    return 'other';
}
function attractSlot(s, tx, ty, strength) {
    const k = Math.max(0, Math.min(1, strength));
    s.x = s.x * (1 - k) + tx * k;
    s.y = s.y * (1 - k) + ty * k;
}
function layoutNewSlotsFromSchematic(slots) {
    if (slots.length === 0) {
        return;
    }
    const margin = 120;
    const gap = 50; // courtyard å¤–ç¼˜é—´è·ï¼ˆé€‚ä¸­åç´§ï¼Œåˆ©äºå¸ƒçº¿é€šé“ï¼‰
    // 1) æŒ‰åŸç†å›¾åæ ‡ç¼©æ”¾ï¼ˆä¸Šé™æ”¶ç´§ï¼Œé¿å…ç¨€ç–æ•£è½ï¼‰
    let minSX = slots[0].comp.position.x;
    let maxSX = minSX;
    let minSY = slots[0].comp.position.y;
    let maxSY = minSY;
    for (let i = 1; i < slots.length; i++) {
        const p = slots[i].comp.position;
        if (p.x < minSX) {
            minSX = p.x;
        }
        if (p.x > maxSX) {
            maxSX = p.x;
        }
        if (p.y < minSY) {
            minSY = p.y;
        }
        if (p.y > maxSY) {
            maxSY = p.y;
        }
    }
    const schW = Math.max(maxSX - minSX, 1);
    const schH = Math.max(maxSY - minSY, 1);
    let avgHalf = 0;
    for (let i = 0; i < slots.length; i++) {
        avgHalf += (slots[i].halfW + slots[i].halfH) * 0.5;
    }
    avgHalf /= slots.length;
    const targetPitch = Math.max(avgHalf * 2 + gap, 120);
    const scaleX = Math.max(1.05, Math.min(1.85, (targetPitch * Math.sqrt(slots.length)) / schW));
    const scaleY = Math.max(1.05, Math.min(1.85, (targetPitch * Math.sqrt(slots.length) * 0.7) / schH));
    const scale = Math.min(scaleX, scaleY);
    for (let i = 0; i < slots.length; i++) {
        const s = slots[i];
        s.x = margin + (s.comp.position.x - minSX) * scale;
        s.y = margin + (s.comp.position.y - minSY) * scale;
    }
    // 2) åŒåºå·åŠŸèƒ½ç°‡ï¼šæ”¶ç´§ + å›ºå®šæ­é…å¸é™„ï¼ˆMCUâ†”æ™¶æŒ¯/å»è€¦ï¼ŒLEDâ†”é™æµï¼‰
    const byIdx = new Map();
    for (let i = 0; i < slots.length; i++) {
        const idx = refIndex(slots[i].comp.refDes);
        if (idx <= 0) {
            continue;
        }
        let list = byIdx.get(idx);
        if (list === undefined) {
            list = [];
            byIdx.set(idx, list);
        }
        list.push(slots[i]);
    }
    byIdx.forEach((list) => {
        if (list.length < 2) {
            return;
        }
        let cx = 0;
        let cy = 0;
        for (let i = 0; i < list.length; i++) {
            cx += list[i].x;
            cy += list[i].y;
        }
        cx /= list.length;
        cy /= list.length;
        for (let i = 0; i < list.length; i++) {
            list[i].x = cx + (list[i].x - cx) * 0.78;
            list[i].y = cy + (list[i].y - cy) * 0.78;
        }
        let mcu = null;
        let xtal = null;
        const caps = [];
        const leds = [];
        const ledRs = [];
        let decap = null;
        for (let i = 0; i < list.length; i++) {
            const role = slotRole(list[i].comp.refDes, list[i].defId);
            if (role === 'mcu') {
                mcu = list[i];
            }
            else if (role === 'xtal') {
                xtal = list[i];
            }
            else if (role === 'cap') {
                caps.push(list[i]);
            }
            else if (role === 'decap') {
                decap = list[i];
            }
            else if (role === 'led') {
                leds.push(list[i]);
            }
            else if (role === 'ledr') {
                ledRs.push(list[i]);
            }
        }
        if (mcu !== null) {
            if (xtal !== null) {
                attractSlot(xtal, mcu.x - (mcu.halfW + xtal.halfW + 70), mcu.y - 30, 0.65);
            }
            if (decap !== null) {
                attractSlot(decap, mcu.x + mcu.halfW + decap.halfW + 55, mcu.y + 40, 0.55);
            }
            for (let ci = 0; ci < caps.length; ci++) {
                const c = caps[ci];
                if (xtal !== null) {
                    const side = (ci % 2 === 0) ? -1 : 1;
                    attractSlot(c, xtal.x + side * (xtal.halfW + c.halfW + 45), xtal.y + 35, 0.6);
                }
                else {
                    attractSlot(c, mcu.x - mcu.halfW - 80 - ci * 40, mcu.y - 50, 0.45);
                }
            }
        }
        // LED + RL é™æµç”µé˜»æˆå¯¹ï¼ˆå‹¿æŠŠå¤ä½ç”µé˜» R* è¯¯é…è¿›æ¥ï¼‰
        const pairN = Math.min(leds.length, ledRs.length);
        for (let pi = 0; pi < pairN; pi++) {
            const led = leds[pi];
            const r = ledRs[pi];
            const mx = (led.x + r.x) * 0.5;
            const my = (led.y + r.y) * 0.5;
            attractSlot(r, mx - 35, my, 0.5);
            attractSlot(led, mx + 45, my, 0.5);
            if (mcu !== null) {
                attractSlot(r, mcu.x + mcu.halfW + 90, mcu.y + pi * 55, 0.35);
                attractSlot(led, mcu.x + mcu.halfW + 160, mcu.y + pi * 55, 0.35);
            }
        }
    });
    // 3) è§£ courtyard é‡å ï¼ˆæ¨å¼€ï¼Œä¿æŒé€‚ä¸­é—´éš™ï¼‰
    for (let pass = 0; pass < 56; pass++) {
        let moved = false;
        for (let i = 0; i < slots.length; i++) {
            for (let j = i + 1; j < slots.length; j++) {
                const a = slots[i];
                const b = slots[j];
                const needX = a.halfW + b.halfW + gap;
                const needY = a.halfH + b.halfH + gap;
                const dx = b.x - a.x;
                const dy = b.y - a.y;
                const ox = needX - Math.abs(dx);
                const oy = needY - Math.abs(dy);
                if (ox <= 0 || oy <= 0) {
                    continue;
                }
                moved = true;
                if (ox < oy) {
                    const push = ox * 0.5 + 0.5;
                    if (dx >= 0) {
                        a.x -= push;
                        b.x += push;
                    }
                    else {
                        a.x += push;
                        b.x -= push;
                    }
                }
                else {
                    const push = oy * 0.5 + 0.5;
                    if (dy >= 0) {
                        a.y -= push;
                        b.y += push;
                    }
                    else {
                        a.y += push;
                        b.y -= push;
                    }
                }
            }
        }
        if (!moved) {
            break;
        }
    }
    // 4) å¹³ç§»åˆ°æ­£è±¡é™ + margin
    let minX = slots[0].x - slots[0].halfW;
    let minY = slots[0].y - slots[0].halfH;
    for (let i = 1; i < slots.length; i++) {
        minX = Math.min(minX, slots[i].x - slots[i].halfW);
        minY = Math.min(minY, slots[i].y - slots[i].halfH);
    }
    const shiftX = margin - minX;
    const shiftY = margin - minY;
    for (let i = 0; i < slots.length; i++) {
        slots[i].x += shiftX;
        slots[i].y += shiftY;
    }
}
export class PcbForwardAnnotator {
    constructor(lib) {
        this.lib = lib ?? getGlobalPcbFootprintLibrary();
    }
    /**
     * æ—  schematicCompId çš„å°è£…æ˜¯å¦ä¿ç•™ï¼š
     * - ç”¨æˆ·é”å®šæ‰‹å¸ƒä»¶
     * - æ’é’ˆ J1 / defId å« PINHDRï¼ˆæ•™å­¦å¤–æ¥æ’é’ˆä¿ç•™ï¼‰
     * - å®‰è£…å­” H+æ•°å­—
     * å…¶å®ƒæ— ç»‘å®šæ®‹ç•™ï¼ˆå·²åˆ æ•™å­¦æ¨¡å—ï¼‰ä¸€å¾‹ä¸¢å¼ƒã€‚
     */
    static shouldKeepOrphanFootprint(fp) {
        if (fp.locked === true) {
            return true;
        }
        if (fp.refDes === 'J1') {
            return true;
        }
        const def = fp.defId ?? '';
        if (def.indexOf('PINHDR') >= 0) {
            return true;
        }
        const ref = fp.refDes ?? '';
        if (ref.length < 2 || ref.charAt(0) !== 'H') {
            return false;
        }
        for (let i = 1; i < ref.length; i++) {
            const c = ref.charCodeAt(i);
            if (c < 48 || c > 57) {
                return false;
            }
        }
        return true;
    }
    /** ä»åŸç†å›¾æ–‡æ¡£ç”Ÿæˆ/æ›´æ–° PCBï¼ˆä¿ç•™å·²æœ‰èµ°çº¿ï¼Œæ›´æ–°å°è£…ä½ç½®ä¸ç½‘ç»œï¼‰ */
    annotateFromSchematic(schematic, existing) {
        const doc = existing ?? createEmptyPcbDocument(schematic.name);
        doc.name = schematic.name;
        const messages = [];
        let placed = 0;
        let skipped = 0;
        /** å½“å‰åŸç†å›¾å¯å¸ƒå±€å™¨ä»¶ id â€” å”¯ä¸€æƒå¨ï¼›å·²åˆ é™¤æ•™å­¦æ¨¡å—çš„å°è£…ä¸€å¾‹ä¸è¿›æ¿ */
        const liveSchIds = new Set();
        for (const comp of schematic.components) {
            if (isLayoutable(comp)) {
                liveSchIds.add(comp.id);
            }
        }
        const existingBySchId = new Map();
        const orphanKeep = [];
        let staleDropped = 0;
        let orphanDropped = 0;
        for (const fp of doc.footprints) {
            const schId = fp.schematicCompId;
            if (schId !== undefined && schId.length > 0) {
                if (liveSchIds.has(schId)) {
                    existingBySchId.set(schId, fp);
                }
                else if (PcbForwardAnnotator.shouldKeepOrphanFootprint(fp)) {
                    // åŸç†å›¾å·²åˆ ï¼Œä½†æ’é’ˆ/å®‰è£…å­”ä»ä¿ç•™ï¼ˆæ¸…æ‰å¤±æ•ˆç»‘å®šï¼‰
                    fp.schematicCompId = undefined;
                    orphanKeep.push(fp);
                }
                else {
                    staleDropped++;
                }
            }
            else if (PcbForwardAnnotator.shouldKeepOrphanFootprint(fp)) {
                orphanKeep.push(fp);
            }
            else {
                orphanDropped++;
            }
        }
        const newFootprints = [];
        /** ç„Šç›˜å‡ ä½•åˆ·æ–°å‰çš„ä¸–ç•Œåæ ‡ï¼Œç”¨äºèµ°çº¿ç«¯ç‚¹è·Ÿéšï¼Œé¿å…ã€Œçº¿è¢«æ‹†å¼€ã€ */
        const pendingTrackFollow = [];
        const pendingFpIds = [];
        const pendingSlots = [];
        for (const comp of schematic.components) {
            if (!isLayoutable(comp)) {
                skipped++;
                continue;
            }
            const fpStr = extractFootprint(comp);
            const defId = this.lib.resolveFootprintId(fpStr, comp.libraryId);
            const value = extractValue(comp);
            let inst = existingBySchId.get(comp.id);
            if (inst) {
                inst.refDes = comp.refDes;
                inst.value = value;
                inst.rotation = comp.rotation;
                const oldDefId = inst.defId;
                const oldPadPos = collectFootprintPadPositions(inst);
                // å§‹ç»ˆä»åº“åˆ·æ–°ç„Šç›˜å‡ ä½•ï¼ˆä¿ç•™åŒå·ç½‘ç»œ/idï¼‰ï¼Œé¿å…åº“ä¿®æ­£åæ—§å®ä¾‹ä»ç”¨é”™è¯¯è„šè·
                this.lib.resyncPadsFromDef(inst, defId);
                // ä»¥åŸç†å›¾å¼•è„šæ•°é‡/è„šå·ä¸ºå‡†ï¼Œè£å‰ªæˆ–è¡¥é½ç„Šç›˜
                syncFootprintPadsFromSchematic(inst, comp.libraryId);
                pendingTrackFollow.push(oldPadPos);
                pendingFpIds.push(inst.id);
                if (oldDefId !== defId) {
                    messages.push(`${comp.refDes}: å°è£… ${oldDefId} â†’ ${defId}`);
                }
                newFootprints.push(inst);
                placed++;
                continue;
            }
            const ext = footprintHalfExtents(this.lib, defId);
            const slot = {
                comp: comp,
                defId: defId,
                value: value,
                halfW: ext.halfW,
                halfH: ext.halfH,
                x: 0,
                y: 0
            };
            pendingSlots.push(slot);
        }
        layoutNewSlotsFromSchematic(pendingSlots);
        for (let si = 0; si < pendingSlots.length; si++) {
            const slot = pendingSlots[si];
            const created = this.lib.instantiate(slot.defId, slot.comp.refDes, slot.value, { x: slot.x, y: slot.y }, slot.comp.rotation, slot.comp.id);
            if (created) {
                syncFootprintPadsFromSchematic(created, slot.comp.libraryId);
                newFootprints.push(created);
                placed++;
            }
            else {
                skipped++;
                messages.push(`æ— æ³•åˆ›å»ºå°è£…: ${slot.comp.refDes}`);
            }
        }
        // ä¿ç•™å·²æœ‰æ’é’ˆï¼›è‹¥æ—  J1 åˆ™æŒ‰æ•™å­¦æ¿è¡¥æ’é’ˆ+è§’å­”
        doc.footprints = newFootprints.concat(orphanKeep);
        const removed = staleDropped + orphanDropped;
        if (removed > 0) {
            messages.push(`å·²ç§»é™¤ ${removed} ä¸ªåŸç†å›¾ä¸­ä¸å­˜åœ¨çš„å°è£…ï¼ˆå«å·²åˆ æ•™å­¦æ¨¡å—ï¼‰`);
        }
        // ç„Šç›˜å±€éƒ¨åæ ‡å˜åŒ–åï¼ŒæŠŠä»æŒ‚åœ¨æ—§ç„Šç›˜ä¸–ç•Œåæ ‡ä¸Šçš„èµ°çº¿ç«¯ç‚¹ä¸€èµ·æŒªè¿‡å»
        for (let i = 0; i < pendingFpIds.length; i++) {
            const fpSet = new Set([pendingFpIds[i]]);
            updateTracksForFootprintTransform(doc, fpSet, pendingTrackFollow[i]);
        }
        snapTrackEndpointsToPads(doc);
        pruneZeroLengthTracks(doc);
        doc.metadata.modifiedAt = new Date().toISOString();
        this.bindNetsFromSchematic(schematic, doc);
        this.expandBoardOutline(doc);
        const acc = ensureBoardAccessories(doc, this.lib, accessoryHintsFromSchematicNets(schematic.nets));
        if (acc.message.length > 0) {
            messages.push(acc.message);
        }
        PcbForwardAnnotator.pruneCopperWithoutPads(doc);
        rebuildPcbNets(doc);
        if (placed === 0) {
            messages.push('åŸç†å›¾ä¸­æ²¡æœ‰å¯å¸ƒå±€çš„å™¨ä»¶');
        }
        else {
            messages.push(`å·²æ”¾ç½® ${placed} ä¸ªå°è£…`);
        }
        const out = {
            document: doc, placedCount: placed, skippedCount: skipped, messages
        };
        tracePcbForwardResult(schematic, doc, placed, skipped, messages);
        return out;
    }
    /** åˆ æ‰å·²æ— ä»»ä½•ç„Šç›˜å½’å±çš„èµ°çº¿/è¿‡å­”ï¼ˆæ•™å­¦æ¨¡å—ç§»é™¤åçš„æ®‹é“œï¼‰ */
    static pruneCopperWithoutPads(doc) {
        const padNets = new Set();
        for (const fp of doc.footprints) {
            for (const pad of fp.pads) {
                if (pad.netId !== undefined && pad.netId.length > 0) {
                    padNets.add(pad.netId);
                }
            }
        }
        doc.tracks = doc.tracks.filter((t) => t.netId.length === 0 || padNets.has(t.netId));
        doc.vias = doc.vias.filter((v) => v.netId.length === 0 || padNets.has(v.netId));
    }
    annotateFromTopology(topo, existing) {
        const schematic = {
            id: topo.schUuid,
            name: topo.schName,
            version: '1.0',
            components: [],
            wires: [],
            nets: [],
            netLabels: [],
            subcircuits: [],
            metadata: {
                author: '', createdAt: '', modifiedAt: '',
                description: '', gridSize: 10, units: 'mil', undoLimit: 1000
            }
        };
        for (const d of topo.deviceList) {
            schematic.components.push({
                id: d.instUuid,
                libraryId: d.libDevId,
                refDes: d.refName,
                position: { x: d.x, y: d.y },
                rotation: d.rotate,
                mirrored: d.mirrorH,
                parameters: d.params
            });
        }
        for (const n of topo.netList) {
            const pinIds = [];
            for (const node of n.nodeList) {
                const pinName = node.pinName && node.pinName.length > 0 ? node.pinName : node.pinId;
                pinIds.push(`${node.devUuid}:${node.pinId}:${pinName}`);
            }
            schematic.nets.push({
                id: n.netUuid,
                name: n.netName.length > 0 ? n.netName : n.displayName,
                type: n.isPower ? NetType.POWER : NetType.SIGNAL,
                pinIds
            });
        }
        return this.annotateFromSchematic(schematic, existing);
    }
    /** å°†åŸç†å›¾ç½‘ç»œåç»‘å®šåˆ°ç„Šç›˜ï¼ˆcompId:pinId + libraryId è„šä½è¡¨ï¼‰ */
    bindNetsFromSchematic(schematic, doc) {
        const libByComp = new Map();
        for (const comp of schematic.components) {
            libByComp.set(comp.id, comp.libraryId);
        }
        const netByCompPad = new Map();
        for (const net of schematic.nets) {
            for (const pinRef of net.pinIds) {
                const parsed = parsePinRef(pinRef);
                if (!parsed)
                    continue;
                const libId = libByComp.get(parsed.compId) ?? '';
                registerSchPinToPadNet(netByCompPad, parsed.compId, parsed.pinId, parsed.pinName, net.id, net.name, libId);
            }
        }
        for (const fp of doc.footprints) {
            if (!fp.schematicCompId)
                continue;
            for (const pad of fp.pads) {
                const bound = lookupPadNet(netByCompPad, fp.schematicCompId, pad.number);
                if (bound !== undefined) {
                    pad.netName = bound.netName;
                    pad.netId = bound.netId;
                }
                else {
                    pad.netName = undefined;
                    pad.netId = undefined;
                }
            }
        }
    }
    expandBoardOutline(doc) {
        let minX = Infinity;
        let minY = Infinity;
        let maxX = -Infinity;
        let maxY = -Infinity;
        let has = false;
        for (const fp of doc.footprints) {
            has = true;
            const ext = footprintHalfExtents(this.lib, fp.defId);
            minX = Math.min(minX, fp.position.x - ext.halfW);
            minY = Math.min(minY, fp.position.y - ext.halfH);
            maxX = Math.max(maxX, fp.position.x + ext.halfW);
            maxY = Math.max(maxY, fp.position.y + ext.halfH);
        }
        if (!has) {
            doc.boardOutline.points = [
                { x: 0, y: 0 }, { x: 1000, y: 0 }, { x: 1000, y: 700 }, { x: 0, y: 700 }
            ];
            return;
        }
        // è¾¹è·ï¼šå¤Ÿèµ°çº¿é€šé“ä¸å®‰è£…å­”ï¼Œæ¿é¢è´´å†…å®¹ç´§å‡‘åˆ©ç”¨
        const margin = 95;
        const shiftX = minX - margin;
        const shiftY = minY - margin;
        if (Math.abs(shiftX) > 0.5 || Math.abs(shiftY) > 0.5) {
            for (const fp of doc.footprints) {
                fp.position.x -= shiftX;
                fp.position.y -= shiftY;
            }
            maxX -= shiftX;
            maxY -= shiftY;
        }
        const boardW = Math.max(maxX + margin, 700);
        const boardH = Math.max(maxY + margin, 520);
        doc.boardOutline.points = [
            { x: 0, y: 0 }, { x: boardW, y: 0 }, { x: boardW, y: boardH }, { x: 0, y: boardH }
        ];
    }
}
export function forwardAnnotatePcb(schematic, existing) {
    return new PcbForwardAnnotator().annotateFromSchematic(schematic, existing);
}
//# sourceMappingURL=PcbForwardAnnotator.js.mapÂ›ÙFC:\Projects\ElecDraw_Harmony\common\src\main\ets\types\CommonTypes.etsÙCC:\Projects\ElecDraw_Harmony\common\src\main\ets\types\PcbTypes.etsÙNC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PcbFootprintLibrary.etsÙEC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PinRefUtil.etsÙEC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\MapHelpers.etsÙIC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PcbPinBindUtil.etsÙFC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PcbTraceLog.etsÙKC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PcbTrackBindUtil.etsÙHC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PcbSchPadSync.etsÙEC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PcbNetUtil.etsÙNC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PcbBoardAccessories.etsÙNC:\Projects\ElecDraw_Harmony\common\src\main\ets\utils\PcbForwardAnnotator.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¦commonÃÂÙ#C:\Projects\ElecDraw_Harmony\common¼C:\Projects\ElecDraw_Harmony¦common¥1.0.0ÔrC’§pkgNameªpkgVersion¦common¥1.0.0‘ÔrD’²hostDependencyName®hostModuleNameÙ(./src/main/ets/utils/PcbForwardAnnotator¦commonÙ#C:\Projects\ElecDraw_Harmony\commonÃÃÚS7/**
 * åŸç†å›¾ â†’ PCB æ­£å‘æ ‡æ³¨ï¼ˆKiCad Update PCB from Schematic è¯­ä¹‰ï¼‰
