                pinIds.push(`${node.devUuid}:${node.pinId}:${pinName}`);
            }
            schematic.nets.push({
                id: n.netUuid,
                name: n.netName.length > 0 ? n.netName : n.displayName,
                type: n.isPower ? NetType.POWER : NetType.SIGNAL,
                pinIds
