                    componentId: pm.id,
                    fixSuggestion: 'V+ æ¥è´Ÿè½½é«˜ç«¯ï¼ŒV- æ¥ç³»ç»Ÿåœ°'
                });
            }
            if (iPlus.id === iMinus.id) {
                result.push({
                    id: IdUtil.generate('erc'),
                    severity: ErcSeverity.ERROR,
                    ruleType: ErcRuleType.PARAM_MISMATCH,
                    message: `åŠŸç‡è¡¨ ${pm.refDes} I+/I- åŒç½‘ â€” æœªä¸²è”æµ‹æµ`,
                    componentId: pm.id,
                    fixSuggestion: 'I+/I- é¡»åˆ†å±ä¸åŒç½‘ç»œå¹¶ä¸²å…¥ç”µæºâ†’è´Ÿè½½å›è·¯'
                });
            }
            else if (iPlus.id === vPlus.id && iMinus.id === vMinus.id) {
                // å…¸å‹é”™è¯¯ï¼šå››è„šå…¨è·¨è´Ÿè½½ä¸¤ç«¯ï¼Œç”µæµè·¯å¾„æœªä¸²è”
                result.push({
                    id: IdUtil.generate('erc'),
                    severity: ErcSeverity.ERROR,
                    ruleType: ErcRuleType.PARAM_MISMATCH,
                    message: `åŠŸç‡è¡¨ ${pm.refDes} I è·¯ä¸ V è·¯å®Œå…¨åŒèŠ‚ç‚¹å¯¹ â€” ç”µæµæœªä¸²è”åˆ‡å…¥`,
                    componentId: pm.id,
                    fixSuggestion: 'æ­£ç¡®ï¼šç”µæºâ†’I+â†’I-â†’è´Ÿè½½ï¼›V+/V- å†è·¨æ¥è´Ÿè½½ä¸¤ç«¯'
                });
            }
        }
        // ---- é¢‘ç‡è®¡ ----
        const freqCounters = doc.components.filter(c => (c.libraryId ?? '').toUpperCase().includes('FREQ_COUNTER'));
        for (const fc of freqCounters) {
            const findFc = (hint) => {
                const h = hint.toUpperCase();
                return doc.nets.find(net => net.pinIds.some(p => {
                    const parts = p.split(':');
                    if (parts[0] !== fc.id) {
                        return false;
                    }
                    return (parts[1] ?? '').toUpperCase() === h || (parts[2] ?? '').toUpperCase() === h;
                }));
            };
            const inn = findFc('IN');
            const gnd = findFc('GND');
            if (inn === undefined || gnd === undefined) {
                result.push({
                    id: IdUtil.generate('erc'),
                    severity: ErcSeverity.ERROR,
                    ruleType: ErcRuleType.UNCONNECTED_PIN,
                    message: `é¢‘ç‡è®¡ ${fc.refDes} IN/GND æœªå®Œå…¨è¿æ¥`,
                    componentId: fc.id,
                    fixSuggestion: 'IN æ¥äº¤æµæˆ–è„‰å†²æºï¼ŒGND æ¥ç³»ç»Ÿåœ°'
                });
            }
            else if (inn.id === gnd.id) {
                result.push({
                    id: IdUtil.generate('erc'),
                    severity: ErcSeverity.ERROR,
                    ruleType: ErcRuleType.PARAM_MISMATCH,
                    message: `é¢‘ç‡è®¡ ${fc.refDes} IN ä¸ GND åŒç½‘ â€” æ— æœ‰æ•ˆä¿¡å·`,
                    componentId: fc.id,
                    fixSuggestion: 'IN æ¥ä¿¡å·ï¼ŒGND æ¥ç³»ç»Ÿåœ°'
                });
            }
        }
        // ---- é€»è¾‘åˆ†æä»ªï¼šè‡³å°‘ CH1+GNDï¼Œä¸”ä¸åŒç½‘ ----
        const analyzers = doc.components.filter(c => (c.libraryId ?? '').toUpperCase().includes('LOGIC_ANALYZER'));
        for (const la of analyzers) {
            const findLa = (hint) => {
                const h = hint.toUpperCase();
                return doc.nets.find(net => net.pinIds.some(p => {
                    const parts = p.split(':');
                    if (parts[0] !== la.id) {
                        return false;
                    }
                    return (parts[1] ?? '').toUpperCase() === h || (parts[2] ?? '').toUpperCase() === h;
                }));
            };
            const ch1 = findLa('CH1');
            const gnd = findLa('GND');
            if (ch1 === undefined) {
