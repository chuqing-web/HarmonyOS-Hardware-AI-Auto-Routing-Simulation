            }
            if (!connected) {
                result.push({
                    id: IdUtil.generate('erc'),
                    severity: ErcSeverity.ERROR,
                    ruleType: ErcRuleType.UNCONNECTED_PIN,
                    message: `å™¨ä»¶ ${comp.refDes}(${comp.libraryId}) å®Œå…¨æœªè¿æ¥ â€” æ— æ•ˆå™¨ä»¶`,
                    componentId: comp.id,
                    fixSuggestion: 'è¿æ¥è¯¥å™¨ä»¶åˆ°ç”µè·¯æˆ–ä»è®¾è®¡ä¸­ç§»é™¤'
                });
            }
        }
        return result;
    }
    /** GPIO ç›´è¿ VCC/GND æ£€æµ‹ â€” æ¨æŒ½è¾“å‡ºæ¥ç”µæºå¯èƒ½å¯¼è‡´çŸ­è·¯ */
    static checkGpioDirectPower(doc) {
        const result = [];
        const mcus = doc.components.filter(c => MCU_IDS.has(c.libraryId));
        if (mcus.length === 0) {
