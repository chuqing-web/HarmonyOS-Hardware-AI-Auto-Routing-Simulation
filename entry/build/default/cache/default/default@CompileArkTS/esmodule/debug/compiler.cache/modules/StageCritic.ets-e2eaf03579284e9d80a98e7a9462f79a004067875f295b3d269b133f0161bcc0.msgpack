        `ç”¨æˆ·éœ€æ±‚æ‘˜è¦: ${userPrompt.substring(0, 400)}\n` +
        `äº‹å®:\n- ${facts.join('\n- ')}\n\n` +
        `åªè¾“å‡ºä¸€ä¸ª JSONï¼š{"retry":trueæˆ–false,"reason":"ä¸€å¥è¯ä¸­æ–‡åŸå› "}\n` +
        `è§„åˆ™: é›¶åŒ¹é…/ç©ºç½‘/å¸ƒå±€æ— å™¨ä»¶ â†’ retry=trueï¼›ä»…è½»å¾®å‘Šè­¦å¯ retry=falseã€‚\n` +
        `ç¦æ­¢ markdownã€ä»£ç å›´æ ã€å…¶å®ƒæ–‡å­—ã€‚`;
    try {
        const chatOpts = {
            capability: AiCapability.COMPONENT_RECOMMEND,
            temperature: 0.1,
            maxTokens: 256,
            disableThinking: true
        };
        const apiRes = await api.chat(prompt, chatOpts);
        if (!apiRes.success || !apiRes.data) {
            Logger.warn(INSTR_TRACE_TAG, `[AI_AGENT] stage=${stage} llm_critique unavailable â€” use rule`);
            const fallback = { reason: ruleReason, fromLlm: false };
            return fallback;
        }
        const parsed = StageCriticParse.parse(apiRes.data);
        if (!parsed) {
            const fallback = { reason: ruleReason, fromLlm: false };
            return fallback;
        }
        Logger.info(INSTR_TRACE_TAG, `[AI_AGENT] stage=${stage} llm_critique retry=${parsed.retry} | ${parsed.reason}`);
        if (!parsed.retry) {
            // hard è§„åˆ™ä¸å¯è¢« LLM retry:false å¦å†³
            if (ctx.zeroMatch || ctx.warFailed ||
                (ctx.hardLines && ctx.hardLines.length > 0)) {
                const hard = {
                    reason: parsed.reason || ruleReason || 'hard gate', fromLlm: true
                };
                return hard;
            }
            const passLlm = { reason: null, fromLlm: true };
            return passLlm;
        }
        const retryOut = {
            reason: parsed.reason || ruleReason || 'llm retry', fromLlm: true
        };
        return retryOut;
    }
    catch (e) {
        Logger.warn(INSTR_TRACE_TAG, `[AI_AGENT] stage=${stage} llm_critique exception | ${e}`);
