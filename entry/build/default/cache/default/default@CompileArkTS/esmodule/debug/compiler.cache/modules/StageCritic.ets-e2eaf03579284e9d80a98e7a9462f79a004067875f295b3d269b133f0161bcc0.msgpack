    `ç¦æ­¢ markdownã€ä»£ç å›´æ ã€å…¶å®ƒæ–‡å­—ã€‚`;

  try {
    const chatOpts: ChatOptions = {
      capability: AiCapability.COMPONENT_RECOMMEND,
