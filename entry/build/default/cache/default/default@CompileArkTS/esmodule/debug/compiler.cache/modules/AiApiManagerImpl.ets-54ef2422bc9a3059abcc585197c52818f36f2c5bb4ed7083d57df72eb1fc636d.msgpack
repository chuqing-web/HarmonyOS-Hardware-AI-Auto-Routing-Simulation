/** HarmonyOS http / BusinessError å¸¸ä¸æ˜¯ Error å®ä¾‹ï¼Œ`${e}` ä¼šå˜æˆ [object Object] */
function formatCaughtError(e) {
    if (e === null || e === undefined) {
        return 'unknown';
    }
    if (typeof e === 'string') {
        return e.length > 0 ? e : 'empty string error';
    }
    if (typeof e === 'number' || typeof e === 'boolean') {
        return `${e}`;
    }
    if (e instanceof Error) {
        return e.message.length > 0 ? e.message : e.name;
    }
    try {
        const anyErr = e;
        const code = anyErr['code'];
        const message = anyErr['message'];
        const name = anyErr['name'];
        const parts = [];
        if (code !== undefined && code !== null) {
            parts.push(`code=${code}`);
        }
        if (typeof message === 'string' && message.length > 0) {
            parts.push(message);
        }
        else if (typeof name === 'string' && name.length > 0) {
            parts.push(name);
        }
        if (parts.length > 0) {
            return parts.join(' ');
        }
        return JSON.stringify(e);
    }
    catch (_jsonFail) {
        return 'unprintable error';
    }
}
function isDnsOrHostResolveError(errMsg) {
    const m = errMsg.toLowerCase();
    return m.indexOf('2300006') >= 0
        || m.indexOf('resolve the host') >= 0
        || m.indexOf('resolve host') >= 0
        || m.indexOf('couldn\'t resolve') >= 0
        || m.indexOf('could not resolve') >= 0
        || m.indexOf('name not resolved') >= 0;
}
function humanizeHttpError(errMsg, triedProxy) {
    if (isDnsOrHostResolveError(errMsg)) {
        if (triedProxy) {
            return 'åŸŸåè§£æå¤±è´¥(DNS)ã€‚å·²å°è¯•ç³»ç»Ÿä»£ç†ä»å¤±è´¥ï¼šè¯·ç¡®è®¤ Clash/VPN å·²å¼€å¯ä¸”ç³»ç»Ÿä»£ç†å¯ç”¨ï¼Œæˆ–åˆ°ã€Œå¹³å°è®¾ç½®ã€æ¸…ç©ºå…¨å±€ä»£ç†åç›´è¿é‡è¯•';
        }
        return 'åŸŸåè§£æå¤±è´¥(DNS)ã€‚è¯·æ£€æŸ¥è®¾å¤‡èƒ½å¦ä¸Šç½‘ï¼›è‹¥ä½¿ç”¨ Clash/VPNï¼Œè¯·åœ¨ã€Œå¹³å°è®¾ç½®ã€å¡«å†™ä»»æ„éç©ºä»£ç†å¼€å…³ä»¥å¯ç”¨ç³»ç»Ÿä»£ç†åé‡è¯•';
    }
    if (errMsg.indexOf('401') >= 0 || errMsg.toLowerCase().indexOf('unauthorized') >= 0) {
        return 'è®¤è¯å¤±è´¥(401)ï¼šè¯·æ£€æŸ¥ API Key æ˜¯å¦æ­£ç¡®ã€æ˜¯å¦è¿‡æœŸ';
    }
    if (errMsg.indexOf('429') >= 0) {
        return 'è§¦å‘é™æµ(429)ï¼šè¯·ç¨åé‡è¯•æˆ–æ›´æ¢é¢åº¦å……è¶³çš„ Key';
    }
    if (errMsg.toLowerCase().indexOf('timeout') >= 0 || errMsg.indexOf('2300029') >= 0) {
        return 'è¯·æ±‚è¶…æ—¶ï¼šç½‘ç»œè¿‡æ…¢æˆ–æœåŠ¡æ— å“åº”ï¼Œè¯·æ£€æŸ¥ä»£ç†/ç½‘ç»œåé‡è¯•';
    }
    return errMsg;
}
export class AiApiManagerImpl {
    constructor() {
        this.apis = new Map();
