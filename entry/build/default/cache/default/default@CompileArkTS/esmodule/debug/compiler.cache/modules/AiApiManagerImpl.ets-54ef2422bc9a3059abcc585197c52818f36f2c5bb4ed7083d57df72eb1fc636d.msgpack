      else if (result.error?.includes('429')) errCode = ErrCode.ERR_API_LIMIT;
      else if (result.error?.includes('timeout')) errCode = ErrCode.ERR_API_TIMEOUT;
      else errCode = ErrCode.ERR_API_TIMEOUT;
