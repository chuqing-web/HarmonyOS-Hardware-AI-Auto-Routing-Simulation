                    (err.indexOf('è¶…æ—¶') >= 0 || err.toLowerCase().indexOf('timeout') >= 0) ?
                        ApiConnectionStatus.TIMEOUT : ApiConnectionStatus.NETWORK_ERROR);
        this.updateApi(id, { lastStatus: status, lastTestedAt: new Date().toISOString() });
