        this.networkMode = new NetworkModeManager();
        this.networkFailCount = 0;
        /** ç”¨æˆ·å–æ¶ˆï¼šä¸­æ­¢ in-flight HTTPï¼Œå¹¶é˜»æ­¢é‡è¯• */
        this.chatCancelRequested = false;
        this.activeHttpRequests = [];
        /** apiId â†’ ä¸Šæ¬¡æˆåŠŸçš„ä»£ç†/DNS ç»„åˆï¼›æµ‹è¯•é€šäº†åç”Ÿå›¾ä¼˜å…ˆèµ°åŒä¸€æ¡£ */
        this.stickyTransportByApi = new Map();
