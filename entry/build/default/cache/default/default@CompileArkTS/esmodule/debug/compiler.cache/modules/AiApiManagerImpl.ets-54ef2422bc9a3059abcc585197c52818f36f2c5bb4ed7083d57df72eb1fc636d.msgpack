    return 'è§¦å‘é™æµ(429)ï¼šè¯·ç¨åé‡è¯•æˆ–æ›´æ¢é¢åº¦å……è¶³çš„ Key';
  }
  if (errMsg.toLowerCase().indexOf('timeout') >= 0 || errMsg.indexOf('2300029') >= 0) {
    return 'è¯·æ±‚è¶…æ—¶ï¼šç½‘ç»œè¿‡æ…¢æˆ–æœåŠ¡æ— å“åº”ï¼Œè¯·æ£€æŸ¥ä»£ç†/ç½‘ç»œåé‡è¯•';
  }
  return errMsg;
}

export class AiApiManagerImpl implements IAiApiManager {
