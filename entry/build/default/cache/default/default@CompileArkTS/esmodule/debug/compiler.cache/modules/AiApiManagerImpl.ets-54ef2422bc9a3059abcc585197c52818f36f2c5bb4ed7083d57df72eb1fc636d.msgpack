    exportConfigs(hideKeys = true) {
        const configs = [];
        this.apis.forEach((api) => {
            const copy = cloneAiApiConfig(api);
            if (hideKeys) {
                copy.apiKey = '***';
                copy.backupApiKey = copy.backupApiKey ? '***' : undefined;
            }
            else {
                const enc = this.encryptedKeys.get(api.id);
