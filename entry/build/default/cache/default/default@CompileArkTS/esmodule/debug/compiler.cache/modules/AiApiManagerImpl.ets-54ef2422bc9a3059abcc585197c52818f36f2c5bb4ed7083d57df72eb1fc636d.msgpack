    }
    return 'åŸŸåè§£æå¤±è´¥(DNS)ã€‚è¯·æ£€æŸ¥è®¾å¤‡èƒ½å¦ä¸Šç½‘ï¼›è‹¥ä½¿ç”¨ Clash/VPNï¼Œè¯·åœ¨ã€Œå¹³å°è®¾ç½®ã€å¡«å†™ä»»æ„éç©ºä»£ç†å¼€å…³ä»¥å¯ç”¨ç³»ç»Ÿä»£ç†åé‡è¯•';
  }
  if (errMsg.indexOf('401') >= 0 || errMsg.toLowerCase().indexOf('unauthorized') >= 0) {
