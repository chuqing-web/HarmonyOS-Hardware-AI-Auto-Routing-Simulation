            continue;
        }
        const delta = choices[0].delta;
        if (!delta) {
            continue;
        }
        const c = delta.content ?? '';
        if (c.length > 0) {
            out += c;
        }
        const rc = delta.reasoning_content ?? '';
        if (rc.length > 0) {
            reasoning += rc;
        }
    }
    if (!sawData) {
        return null;
    }
    if (out.length > 0) {
        return out;
    }
    // æ­£æ–‡ä¸ºç©ºä½†æ¨ç†éç©ºï¼šæ¨ç†å¸¸è¢« finish_reason=length æˆªæ–­ï¼Œ
    // ä½†æ¨¡å‹å¸¸åœ¨æ¨ç†æœ«å°¾å†™å‡ºå®Œæ•´ç­”æ¡ˆ â€”â€” éš”ç¦»æœ€åä¸€ä¸ªå®Œæ•´ JSON æ¢å¤
    if (reasoning.length > 0) {
