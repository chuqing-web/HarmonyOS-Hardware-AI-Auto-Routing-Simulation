function stripInlineThinkTags(text) {
    let s = text;
    s = s.replace(/<think>[\s\S]*?<\/think>/gi, '');
    s = s.replace(/<thinking>[\s\S]*?<\/thinking>/gi, '');
    s = s.replace(/<\/?think>/gi, '');
    s = s.replace(/<\/?thinking>/gi, '');
    return s;
}
function isolateJsonFromText(text) {
    const s = stripInlineThinkTags(text).trim();
    if (s.length < 2) {
        return null;
    }
    if (s.charAt(0) === '{' && s.charAt(s.length - 1) === '}') {
        try {
            JSON.parse(s);
            return s;
        }
        catch (_e) {
            // scan
        }
    }
    let lastOk = null;
    for (let i = 0; i < s.length; i++) {
        if (s.charAt(i) !== '{') {
            continue;
        }
        let depth = 0;
        let inStr = false;
        let esc = false;
        for (let j = i; j < s.length; j++) {
            const ch = s.charAt(j);
            if (inStr) {
                if (esc) {
                    esc = false;
                }
                else if (ch === '\\') {
                    esc = true;
                }
                else if (ch === '"') {
                    inStr = false;
                }
                continue;
            }
            if (ch === '"') {
                inStr = true;
                continue;
            }
            if (ch === '{') {
                depth++;
            }
            else if (ch === '}') {
                depth--;
                if (depth === 0) {
                    const cand = s.substring(i, j + 1);
                    try {
                        const v = JSON.parse(cand);
                        if (v !== null && typeof v === 'object' && !Array.isArray(v)) {
                            lastOk = cand;
                        }
                    }
                    catch (_e2) {
                        // ignore
                    }
                    break;
                }
            }
        }
    }
    return lastOk;
}
