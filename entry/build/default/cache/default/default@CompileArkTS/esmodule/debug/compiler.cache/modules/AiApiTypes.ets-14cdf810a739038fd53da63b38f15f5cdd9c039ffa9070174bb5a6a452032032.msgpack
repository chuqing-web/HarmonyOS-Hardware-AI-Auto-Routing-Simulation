        if (!choices || choices.length === 0) {
            continue;
        }
        const delta = choices[0].delta;
        if (!delta) {
            continue;
        }
        const c = delta.content ?? '';
        if (c.length > 0) {
            out += c;
        }
        const rc = delta.reasoning_content ?? '';
        if (rc.length > 0) {
