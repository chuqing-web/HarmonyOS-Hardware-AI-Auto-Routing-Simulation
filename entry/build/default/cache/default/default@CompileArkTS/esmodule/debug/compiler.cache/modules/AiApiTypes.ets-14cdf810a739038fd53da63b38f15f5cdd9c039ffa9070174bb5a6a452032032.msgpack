export function buildChatRequestBody(model, messages, maxTokens, temperature, disableThinking) {
    const body = {
        model: model,
        messages: messages,
        max_tokens: maxTokens,
        temperature: temperature
    };
    if (disableThinking) {
        const thinking = { type: 'disabled' };
        body.thinking = thinking;
    }
    return body;
}
