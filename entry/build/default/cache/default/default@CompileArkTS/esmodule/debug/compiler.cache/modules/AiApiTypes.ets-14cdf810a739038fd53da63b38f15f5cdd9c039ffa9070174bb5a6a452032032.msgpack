            return s;
        }
        catch (_e) {
            // scan
        }
    }
    let lastOk = null;
    for (let i = 0; i < s.length; i++) {
        if (s.charAt(i) !== '{') {
            continue;
        }
        let depth = 0;
        let inStr = false;
        let esc = false;
        for (let j = i; j < s.length; j++) {
            const ch = s.charAt(j);
            if (inStr) {
                if (esc) {
                    esc = false;
                }
                else if (ch === '\\') {
                    esc = true;
                }
                else if (ch === '"') {
                    inStr = false;
                }
                continue;
            }
            if (ch === '"') {
                inStr = true;
                continue;
            }
            if (ch === '{') {
                depth++;
            }
            else if (ch === '}') {
                depth--;
                if (depth === 0) {
                    const cand = s.substring(i, j + 1);
                    try {
                        const v = JSON.parse(cand);
                        if (v !== null && typeof v === 'object' && !Array.isArray(v)) {
                            lastOk = cand;
                        }
                    }
                    catch (_e2) {
                        // ignore
                    }
                    break;
                }
            }
        }
    }
    return lastOk;
}
