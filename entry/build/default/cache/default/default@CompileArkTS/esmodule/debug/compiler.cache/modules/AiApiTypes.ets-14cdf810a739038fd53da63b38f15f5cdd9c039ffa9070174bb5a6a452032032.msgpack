    if (typeof v === 'string' && v.length > 0) {
        return v;
    }
    return undefined;
}
export function getFirstBoundCapabilityId(binding) {
    const keys = Object.keys(binding);
    for (let i = 0; i < keys.length; i++) {
        const key = keys[i];
        const value = binding[key];
        if (typeof value === 'string') {
            return value;
        }
    }
    return undefined;
}
