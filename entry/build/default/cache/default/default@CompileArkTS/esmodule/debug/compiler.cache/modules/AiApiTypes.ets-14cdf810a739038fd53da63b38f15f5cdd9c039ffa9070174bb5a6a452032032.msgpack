export function buildChatRequestBody(model, messages, maxTokens, temperature, disableThinking, provider, stream) {
    const body = {
        model: model,
        messages: messages,
        max_tokens: maxTokens,
        temperature: temperature
    };
    // Qwen/agnesï¼ˆå« CUSTOMâ†’apihubï¼‰å¸¸å¿½ç•¥ OpenAI thinking å¯¹è±¡ï¼Œåªè®¤ enable_thinkingï¼›
    // åŒå†™ï¼šå…¼å®¹ DeepSeek thinking.type ä¸ DashScope/agnes enable_thinkingã€‚
    const isQwen = provider === AiProviderType.QWEN;
    if (disableThinking === true) {
        body.enable_thinking = false;
        if (!isQwen) {
            const thinking = { type: 'disabled' };
            body.thinking = thinking;
        }
    }
    else if (disableThinking === false && !isQwen) {
        const thinkingOn = { type: 'enabled' };
        body.thinking = thinkingOn;
    }
    if (stream === true) {
        body.stream = true;
    }
    return body;
}
