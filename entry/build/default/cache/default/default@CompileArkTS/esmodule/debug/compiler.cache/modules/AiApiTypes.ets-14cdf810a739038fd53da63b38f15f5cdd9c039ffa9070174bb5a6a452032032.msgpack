        id: existing.id,
        name: updates.name ?? existing.name,
        provider: updates.provider ?? existing.provider,
        baseUrl: updates.baseUrl ?? existing.baseUrl,
        apiKey: updates.apiKey && updates.apiKey !== '***' ? updates.apiKey : existing.apiKey,
