            Logger.error(INSTR_TRACE_TAG, '[AI_PIPE] ABORT: device_select LLM unavailable â€” no template fallback');
            onProgress?.(makeProgress(100, 'AI API ä¸å¯ç”¨', true));
            this.notifyDegraded('å™¨ä»¶é€‰å‹');
            return {
                selectResult: {
                    devices: [],
