        }
        onProgress?.(makeProgress(20, 'æœ¬åœ°å™¨ä»¶åº“åŒ¹é…'));
        traceAiOp('AI_PIPE', 'library_match', 'matchFromLlmOutput');
        const selectResult = this.selectEngine.matchFromLlmOutput(selectLlm.output, opts.prompt);
