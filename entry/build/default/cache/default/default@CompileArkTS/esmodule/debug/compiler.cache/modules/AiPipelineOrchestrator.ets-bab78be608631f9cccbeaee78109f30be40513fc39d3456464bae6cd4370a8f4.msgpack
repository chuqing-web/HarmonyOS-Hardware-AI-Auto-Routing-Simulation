    opts.onStreamSnapshot?.(topoWithNets, 'routing');

    // â”€â”€â”€ ERC é™æ€æ ¡éªŒ (å‡½æ•°: ç¡®å®šæ€§è§„åˆ™æ£€æŸ¥) â”€â”€â”€
    onProgress?.(makeProgress(90, 'ERC é™æ€æ ¡éªŒ'));
    traceAiOp('AI_PIPE', 'erc', 'FaultDiagnoser / collectErc');
