        }
        // AI é©±åŠ¨å¸ƒå±€: LLM ç›´æ¥è¾“å‡ºåæ ‡ (ä¼˜å…ˆ), GA ä»…ä½œå›é€€
        const aiPositions = layoutLlm.output.positions;
        let placement;
        if (aiPositions && aiPositions.length > 0) {
            onProgress?.(makeProgress(50, 'AI åæ ‡å¸ƒå±€'));
