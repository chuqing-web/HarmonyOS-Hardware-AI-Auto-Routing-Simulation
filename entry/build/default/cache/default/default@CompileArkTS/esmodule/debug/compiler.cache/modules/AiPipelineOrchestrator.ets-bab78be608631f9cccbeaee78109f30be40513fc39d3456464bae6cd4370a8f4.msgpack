    onProgress?.(makeProgress(92, 'å‡ ä½•ç¢°æ’æ£€æµ‹'));
    const geoIssues = this.collectGeometricIssues(topoWithNets);
    // é™„åŠ è¿çº¿æ‹¥æŒ¤åˆ†æ
