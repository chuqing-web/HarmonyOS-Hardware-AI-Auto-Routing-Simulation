        if (libraryId.includes('F407')) {
            const order100 = order48.slice();
            for (let i = 0; i < 16; i++)
                order100.push(`PD${i}`);
            for (let i = 0; i < 16; i++)
                order100.push(`PE${i}`);
            for (let i = 8; i < 16; i++)
                order100.push(`PC${i}`);
            for (let i = 0; i < 12; i++)
                order100.push(`PF${i}`);
