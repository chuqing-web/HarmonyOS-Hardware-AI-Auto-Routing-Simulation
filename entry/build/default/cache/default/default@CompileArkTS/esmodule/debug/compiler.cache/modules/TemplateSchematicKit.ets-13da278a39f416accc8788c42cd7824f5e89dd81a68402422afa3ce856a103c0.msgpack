        const rightCount = Math.floor(count / 2);
        const bodyHalf = Math.max(leftCount, rightCount) * 10 / 2;
        const idx = n - 1;
        if (idx < leftCount) {
            return { x: -50, y: idx * 10 - bodyHalf };
        }
        const rightIdx = idx - leftCount;
        return { x: 50, y: rightIdx * 10 - bodyHalf };
    }
}
