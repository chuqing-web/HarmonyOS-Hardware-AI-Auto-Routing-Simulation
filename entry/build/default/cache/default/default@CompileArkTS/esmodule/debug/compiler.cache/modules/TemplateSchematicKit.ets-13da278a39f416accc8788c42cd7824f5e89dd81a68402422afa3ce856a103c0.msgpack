            pinId === 'NRST' || pinId === 'BOOT0' || pinId === 'OSC_IN' || pinId === 'OSC_OUT' ||
            pinId === 'VDD' || pinId === 'VSS' || pinId === 'VDDA' || pinId === 'VSSA') {
