            if (pinId === 'CH2')
                return { x: -40, y: -10 };
            if (pinId === 'CH3')
                return { x: -40, y: 10 };
            if (pinId === 'CH4')
                return { x: -40, y: 30 };
            if (pinId === 'GND')
                return { x: -40, y: 50 };
