TemplateSchematicKit.RESERVED_POWER_NAMES = new Set([
    'VCC', 'VDD', 'GND', 'VSS', '3V3', '3.3V', '5V', '12V', '-12V',
    'VCC_5V', 'VCC_3V3', 'AVCC', 'AVDD', 'DVCC', 'VCCIO', 'VREF',
