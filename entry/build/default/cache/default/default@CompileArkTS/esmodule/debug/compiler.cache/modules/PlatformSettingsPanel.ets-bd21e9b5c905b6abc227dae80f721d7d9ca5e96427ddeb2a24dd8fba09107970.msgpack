            })
            ProteusClassicBtn({
              label: 'éšç§æ¸…ç†',
              widthVal: '92%',
              onAction: () => {
                this.appService.privacyCleanup();
                this.statusMessage = 'å·²æ¸…ç† AI ç¼“å­˜ä¸ä¸´æ—¶æ–‡ä»¶';
