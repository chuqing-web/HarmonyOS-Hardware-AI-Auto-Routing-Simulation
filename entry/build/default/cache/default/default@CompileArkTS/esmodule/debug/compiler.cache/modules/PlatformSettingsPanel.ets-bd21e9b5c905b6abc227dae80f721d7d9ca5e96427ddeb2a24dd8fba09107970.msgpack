                this.appService.saveSnapshot('æ‰‹åŠ¨å¿«ç…§', 'ç”¨æˆ·æ‰‹åŠ¨ä¿å­˜');
                this.statusMessage = 'ç‰ˆæœ¬å¿«ç…§å·²ä¿å­˜';
                this.appService.announceIfScreenReader(this.statusMessage);
