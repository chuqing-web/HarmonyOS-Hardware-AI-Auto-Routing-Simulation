          Row({ space: 8 }) {
            Text('è¯­éŸ³æœ—è¯»æç¤º')
              .fontSize(ProteusFonts.PARAM_KEY)
              .fontColor(ProteusColors.TEXT_PRIMARY)
              .layoutWeight(1)
            ProteusSwitch({
              isOn: this.screenReader,
              onChange: (on: boolean) => {
                this.screenReader = on;
                this.applyAccessibility();
                this.statusMessage = on ? 'å·²å¼€å¯è¯­éŸ³æœ—è¯»æç¤ºï¼ˆçŠ¶æ€æ æ’­æŠ¥ï¼‰' : 'å·²å…³é—­è¯­éŸ³æœ—è¯»æç¤º';
