      if (Math.abs(avg) > Math.max(4.5, max * 0.92) && wave.waveType === 'voltage' && max > 4.0) {

        violations.push(DynamicErcEngine.violation(ErcSeverity.WARNING,

          `è¿æ”¾å¯èƒ½é¥±å’Œ: ${wave.probeName} å¹³å‡ ${avg.toFixed(2)}V`, wave.netName,

          'è°ƒæ•´å¢ç›Šæˆ–åç½®'));

      }

      if (max - min < 0.01 && max > 0.1 && max < 0.5) {

        violations.push(DynamicErcEngine.violation(ErcSeverity.WARNING,

          `æŒ¯è¡å¯èƒ½ä¸èµ·æŒ¯: ${wave.probeName} å¹…åº¦è¿‡å°`, wave.netName,

          'æ£€æŸ¥æ™¶æŒ¯å‚æ•°ä¸è´Ÿè½½ç”µå®¹'));

      }

      if (wave.timeAxis.length >= 4) {
        const freq = DynamicErcEngine.estimateFrequency(wave);
        if (freq > 0 && freq < 10) {
          violations.push(DynamicErcEngine.violation(ErcSeverity.WARNING,
            `é¢‘ç‡å¼‚å¸¸åä½: ${wave.probeName} â‰ˆ ${freq.toFixed(1)}Hz`, wave.netName,
            'æ£€æŸ¥æ—¶é’Ÿæºæˆ– RC æ—¶é—´å¸¸æ•°'));
        }
        if (freq > 50e6) {
          violations.push(DynamicErcEngine.violation(ErcSeverity.ERROR,
            `é¢‘ç‡å¼‚å¸¸åé«˜: ${wave.probeName} â‰ˆ ${(freq / 1e6).toFixed(1)}MHz`, wave.netName,
            'æ£€æŸ¥ä¿¡å·å®Œæ•´æ€§æˆ– EMI'));
        }
      }

      if (wave.waveType === 'current' || wave.currentAxis.length > 0) {
        const iMax = arrayMax(wave.currentAxis.length > 0 ? wave.currentAxis : wave.voltageAxis);
        if (iMax > 0.5) {
          violations.push(DynamicErcEngine.violation(ErcSeverity.ERROR,
            `è¿‡æµæ£€æµ‹: ${wave.probeName} å³°å€¼ ${iMax.toFixed(3)}A`, wave.netName,
            'æ£€æŸ¥è´Ÿè½½çŸ­è·¯æˆ–é™æµç”µé˜»'));
        }
      }

    }



    digitalStates.forEach((state: string, pinId: string) => {

      if (state === 'X' || state === 'conflict') {

        violations.push(DynamicErcEngine.violation(ErcSeverity.ERROR,

          `æ•°å­—æ€»çº¿å†²çª/é«˜é˜»å¼‚å¸¸: ${pinId}`, pinId, 'æ£€æŸ¥è¾“å‡ºå¼•è„šçŸ­æ¥'));

      }

    });



    return violations;

  }



  private static violation(severity: ErcSeverity, message: string, target: string, fix: string): ErcViolation {

    return {

      id: IdUtil.generate('derc'),

      severity: severity,

      ruleType: ErcRuleType.PIN_CONFLICT,

      message: message,

      netId: target,

      fixSuggestion: fix

    };

  }

  private static estimateFrequency(wave: WaveData): number {
    const v = wave.voltageAxis;
    const t = wave.timeAxis;
    if (v.length < 4 || t.length < 4) return 0;
