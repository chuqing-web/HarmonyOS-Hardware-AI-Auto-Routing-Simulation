            if (Math.abs(avg) > Math.max(4.5, max * 0.92) && wave.waveType === 'voltage' && max > 4.0) {
                violations.push(DynamicErcEngine.violation(ErcSeverity.WARNING, `è¿æ”¾å¯èƒ½é¥±å’Œ: ${wave.probeName} å¹³å‡ ${avg.toFixed(2)}V`, wave.netName, 'è°ƒæ•´å¢ç›Šæˆ–åç½®'));
            }
