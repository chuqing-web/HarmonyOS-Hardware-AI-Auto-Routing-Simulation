            }
            if (wave.timeAxis.length >= 4) {
                const freq = DynamicErcEngine.estimateFrequency(wave);
                if (freq > 0 && freq < 10) {
                    violations.push(DynamicErcEngine.violation(ErcSeverity.WARNING, `é¢‘ç‡å¼‚å¸¸åä½: ${wave.probeName} â‰ˆ ${freq.toFixed(1)}Hz`, wave.netName, 'æ£€æŸ¥æ—¶é’Ÿæºæˆ– RC æ—¶é—´å¸¸æ•°'));
                }
                if (freq > 50e6) {
                    violations.push(DynamicErcEngine.violation(ErcSeverity.ERROR, `é¢‘ç‡å¼‚å¸¸åé«˜: ${wave.probeName} â‰ˆ ${(freq / 1e6).toFixed(1)}MHz`, wave.netName, 'æ£€æŸ¥ä¿¡å·å®Œæ•´æ€§æˆ– EMI'));
                }
            }
            if (wave.waveType === 'current' || wave.currentAxis.length > 0) {
                const iMax = arrayMax(wave.currentAxis.length > 0 ? wave.currentAxis : wave.voltageAxis);
                if (iMax > 0.5) {
                    violations.push(DynamicErcEngine.violation(ErcSeverity.ERROR, `è¿‡æµæ£€æµ‹: ${wave.probeName} å³°å€¼ ${iMax.toFixed(3)}A`, wave.netName, 'æ£€æŸ¥è´Ÿè½½çŸ­è·¯æˆ–é™æµç”µé˜»'));
                }
            }
        }
        digitalStates.forEach((state, pinId) => {
            if (state === 'X' || state === 'conflict') {
                violations.push(DynamicErcEngine.violation(ErcSeverity.ERROR, `æ•°å­—æ€»çº¿å†²çª/é«˜é˜»å¼‚å¸¸: ${pinId}`, pinId, 'æ£€æŸ¥è¾“å‡ºå¼•è„šçŸ­æ¥'));
            }
        });
        return violations;
    }
    static violation(severity, message, target, fix) {
        return {
            id: IdUtil.generate('derc'),
            severity: severity,
            ruleType: ErcRuleType.PIN_CONFLICT,
            message: message,
            netId: target,
            fixSuggestion: fix
        };
    }
    static estimateFrequency(wave) {
        const v = wave.voltageAxis;
        const t = wave.timeAxis;
        if (v.length < 4 || t.length < 4)
            return 0;
        const mid = (arrayMin(v) + arrayMax(v)) / 2;
        let crossings = 0;
        for (let i = 1; i < v.length; i++) {
            if ((v[i - 1] < mid && v[i] >= mid) || (v[i - 1] >= mid && v[i] < mid)) {
                crossings++;
            }
        }
