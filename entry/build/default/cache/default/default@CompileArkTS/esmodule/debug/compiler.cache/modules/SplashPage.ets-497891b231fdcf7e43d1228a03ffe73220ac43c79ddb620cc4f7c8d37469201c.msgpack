                    continue;
                }
                const zNorm = (edge.avgZ + 2.2) / 4.4;
                ctx.strokeStyle = this.edgeColor(zNorm, baseA * globalA);
                ctx.lineWidth = baseW;
                ctx.lineCap = 'round';
