            }
            if (stageIdx !== this.lastStageIdx) {
                this.lastStageIdx = stageIdx;
                this.statusText = this.stages[stageIdx].text;
            }
            if (elapsed >= this.TOTAL_MS) {
                this.beginExit();
            }
        }, frameMs);
