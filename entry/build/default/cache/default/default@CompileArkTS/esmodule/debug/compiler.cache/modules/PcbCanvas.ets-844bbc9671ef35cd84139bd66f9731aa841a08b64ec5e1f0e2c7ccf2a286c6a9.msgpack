            this.onStatusChange('é€‚åº”çª—å£');
            this.scheduleRedraw();
        }
    }
    /** æ»šè½®ï¼šä»¥é¼ æ ‡ä½ç½®ä¸ºä¸­å¿ƒç¼©æ”¾ */
    handleAxisZoom(event) {
        const v = event.getVerticalAxisValue();
        if (v === 0)
            return;
        const factor = v < 0 ? 1.12 : (1 / 1.12);
        this.getEditor().zoomAt(factor, event.x, event.y);
