// â”€â”€ Helpers â”€â”€
function isLayerVisible(doc, layer) {
    for (const l of doc.layers) {
        if (l.id === layer)
            return l.visible;
    }
    return true;
}
function getLayerColor(doc, layer) {
    for (const l of doc.layers) {
        if (l.id === layer)
            return l.color;
    }
    return layer === PcbLayerId.B_CU ? '#3478C8' : '#C83434';
}
function makeSpoke(center, dx, dy, w, h) {
    return { x: center.x + dx, y: center.y + dy, w, h };
}
/** ç”Ÿæˆ L å‹èµ°çº¿è·¯å¾„ç‚¹ï¼ˆå…¼å®¹ä¿ç•™ï¼Œä¼˜å…ˆç”¨ routeOrtho45Pointsï¼‰ */
function routeLPoints(a, b) {
    return routeOrtho45Points(a, b);
}
