        if (kt === 'v' && this.toolMode === PcbToolMode.ROUTE) {
            if (editor.isRouteActive()) {
                const cur = editor.getActiveLayer();
                const next = cur === PcbLayerId.F_CU ? PcbLayerId.B_CU : PcbLayerId.F_CU;
                editor.switchRouteLayer(next);
