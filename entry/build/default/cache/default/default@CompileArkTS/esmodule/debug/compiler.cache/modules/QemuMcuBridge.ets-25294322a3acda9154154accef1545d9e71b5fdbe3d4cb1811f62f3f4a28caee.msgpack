            return;
        }
        this.regs[n] = val;
    }
    // ---- GPIO å¯„å­˜å™¨è¯»/å†™ ----
    writeGpioReg(addr, value) {
        this.periphRegs.set(addr, value);
        const baseAddr = addr & 0xFFFFFC00;
        const offset = addr & 0x3FF;
        if (offset === GPIO_ODR) {
            for (let bit = 0; bit < 16; bit++) {
