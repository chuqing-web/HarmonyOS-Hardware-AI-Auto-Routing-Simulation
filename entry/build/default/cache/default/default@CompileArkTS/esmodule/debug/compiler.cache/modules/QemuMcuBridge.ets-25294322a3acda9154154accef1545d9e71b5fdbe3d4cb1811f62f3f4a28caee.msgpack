    unpackU32(src, offset) {
        return ((src[offset] << 24) | (src[offset + 1] << 16) |
            (src[offset + 2] << 8) | src[offset + 3]) >>> 0;
    }
    // ---- å…¬å…±æ¥å£ ----
    start(firmwarePath, machine = 'stm32f103') {
