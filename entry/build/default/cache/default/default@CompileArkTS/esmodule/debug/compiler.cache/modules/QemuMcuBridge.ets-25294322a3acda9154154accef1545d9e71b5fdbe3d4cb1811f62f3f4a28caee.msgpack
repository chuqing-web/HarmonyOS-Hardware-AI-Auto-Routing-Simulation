const SRAM_BASE = 0x20000000;
// ---- GPIO å¯„å­˜å™¨åç§» ----
const GPIO_CRL = 0x00;
const GPIO_CRH = 0x04;
const GPIO_IDR = 0x08;
const GPIO_ODR = 0x0C;
const GPIO_BSRR = 0x10;
const GPIO_BRR = 0x14;
const GPIO_LCKR = 0x18;
// ---- RCC å¯„å­˜å™¨åç§» ----
const RCC_CR = 0x00;
const RCC_CFGR = 0x04;
const RCC_CIR = 0x08;
const RCC_APB2RSTR = 0x0C;
const RCC_APB1RSTR = 0x10;
const RCC_AHBENR = 0x14;
const RCC_APB2ENR = 0x18;
const RCC_APB1ENR = 0x1C;
const RCC_BDCR = 0x20;
const RCC_CSR = 0x24;
// ---- USART å¯„å­˜å™¨åç§» ----
const USART_SR = 0x00;
const USART_DR = 0x04;
const USART_BRR = 0x08;
const USART_CR1 = 0x0C;
const USART_CR2 = 0x10;
const USART_CR3 = 0x14;
const USART_GTPR = 0x18;
// ---- TIM å¯„å­˜å™¨åç§» ----
const TIM_CR1 = 0x00;
const TIM_CR2 = 0x04;
const TIM_SMCR = 0x08;
const TIM_DIER = 0x0C;
const TIM_SR = 0x10;
const TIM_EGR = 0x14;
const TIM_CCMR1 = 0x18;
const TIM_CCMR2 = 0x1C;
const TIM_CCER = 0x20;
const TIM_CNT = 0x24;
const TIM_PSC = 0x28;
const TIM_ARR = 0x2C;
const TIM_CCR1 = 0x34;
const TIM_CCR2 = 0x38;
const TIM_CCR3 = 0x3C;
const TIM_CCR4 = 0x40;
export class QemuMcuBridge {
    constructor() {
        this.processHandle = -1;
        this.firmware = new Uint8Array(0);
        this.machine = 'stm32f103';
        this.periphRegs = new Map();
        this.sram = new Uint8Array(20 * 1024); // 20KB SRAM
        this.lastCommandTime = 0;
        this.connected = false;
        /** R0â€“R12, SP(R13), LR(R14), PC mirrored in state.pc */
        this.regs = new Array(16).fill(0);
        this.zFlag = false;
        this.uartTxPend = [];
        this.uartRxQueue = [];
        this.usartTxBusyLeft = 0;
        this.state = {
            running: false,
            pc: FLASH_BASE,
            gpioRegs: new Map(),
            adcRegs: new Map()
        };
    }
    // ---- IPC åè®®ç¼–ç  ----
    /** æ„å»ºäºŒè¿›åˆ¶IPCæ¶ˆæ¯å¸§ */
    buildFrame(command, payload) {
        const totalLen = 8 + payload.length;
        const frame = new Uint8Array(totalLen);
        frame[0] = PROTO_MAGIC[0];
        frame[1] = PROTO_MAGIC[1];
        frame[2] = PROTO_MAGIC[2];
        frame[3] = PROTO_MAGIC[3];
        frame[4] = command;
        frame[5] = (payload.length >> 8) & 0xFF;
        frame[6] = payload.length & 0xFF;
        frame.set(payload, 7);
        frame[totalLen - 1] = this.crc8(frame.subarray(0, totalLen - 1));
        return frame;
    }
    /** è§£æIPCå“åº”å¸§ */
    parseFrame(data) {
        if (data.length < 8)
            return null;
        if (data[0] !== PROTO_MAGIC[0] || data[1] !== PROTO_MAGIC[1] ||
            data[2] !== PROTO_MAGIC[2] || data[3] !== PROTO_MAGIC[3]) {
            return null;
        }
        const payloadLen = (data[5] << 8) | data[6];
        if (payloadLen > MAX_PAYLOAD_LEN)
            return null;
        const expectedCrc = data[7 + payloadLen];
        const actualCrc = this.crc8(data.subarray(0, 7 + payloadLen));
        if (expectedCrc !== actualCrc)
            return null;
        return {
            command: data[4],
            payload: data.subarray(7, 7 + payloadLen)
        };
    }
    /** CRC-8 (polynomial 0x07, ITU-T) */
    crc8(data) {
        let crc = 0;
        for (let i = 0; i < data.length; i++) {
            crc ^= data[i];
            for (let bit = 0; bit < 8; bit++) {
                if (crc & 0x80) {
                    crc = ((crc << 1) ^ 0x07) & 0xFF;
