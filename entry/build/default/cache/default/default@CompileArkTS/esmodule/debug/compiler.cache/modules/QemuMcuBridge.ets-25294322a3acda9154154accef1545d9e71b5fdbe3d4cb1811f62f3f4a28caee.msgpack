const TIM2_BASE = 0x40000000;
const TIM3_BASE = 0x40000400;
const TIM4_BASE = 0x40000800;
const ADC1_BASE = 0x40012400;
const ADC2_BASE = 0x40012800;
const NVIC_BASE = 0xE000E100;
const SCB_BASE = 0xE000ED00;
