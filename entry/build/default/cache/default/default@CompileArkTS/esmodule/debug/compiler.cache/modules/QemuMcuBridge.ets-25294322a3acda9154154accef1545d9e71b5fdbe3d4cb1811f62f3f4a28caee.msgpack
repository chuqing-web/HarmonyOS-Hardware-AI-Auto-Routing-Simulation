        }
        const out = this.uartTxPend.slice();
        this.uartTxPend = [];
        return out;
    }
    getUartOutput() {
        return this.uartTxPend.map((b) => String.fromCharCode(b & 0xFF)).join('');
    }
    readU32Flash(offset) {
        if (offset + 3 >= this.firmware.length) {
            return 0;
        }
        return (this.firmware[offset] | (this.firmware[offset + 1] << 8) |
