    /** Cortex-M vector table: MSP @ flash+0, Reset @ flash+4 */
    applyResetVector() {
        for (let i = 0; i < 16; i++) {
            this.regs[i] = 0;
        }
        if (this.firmware.length < 8) {
            this.state.pc = FLASH_BASE;
            this.regs[15] = this.state.pc;
            return;
