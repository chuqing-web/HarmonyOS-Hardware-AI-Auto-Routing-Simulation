}
/** æ ¹æ®ç„Šç›˜å°ºå¯¸è®¡ç®—å¸é™„å®¹å·®ï¼ˆä¿è¯èµ°çº¿ç«¯ç‚¹èƒ½åŒ¹é…åˆ°ç„Šç›˜ï¼‰ */
export function padSnapTolerance(pad, gridSize) {
    const padRadius = Math.max(pad.size.x, pad.size.y) / 2;
    const g = gridSize > 0 ? gridSize : 5;
    return Math.max(padRadius + g * 2, g * 4, 20);
}
/** æŠ˜ç‚¹/èµ°çº¿ç«¯ç‚¹åŒ¹é…å®¹å·® */
export function junctionMatchTolerance(gridSize) {
    const g = gridSize > 0 ? gridSize : 5;
    return Math.max(g, 8);
}
function pointDist(a, b) {
    const dx = a.x - b.x;
    const dy = a.y - b.y;
    return Math.sqrt(dx * dx + dy * dy);
}
function junctionKey(pos, netId, tol) {
    const q = tol > 0 ? tol : 8;
    return `${netId}|${Math.round(pos.x / q)}|${Math.round(pos.y / q)}`;
}
function getTrackEndpoint(trk, isStart) {
    return isStart ? trk.start : trk.end;
}
function netsCompatible(trackNetId, taskNetId) {
    if (taskNetId.length === 0 || trackNetId.length === 0) {
        return true;
    }
    return trackNetId === taskNetId;
}
function isEndpointOnStationaryPad(pt, doc, movedFootprintIds, gridSize) {
    for (const fp of doc.footprints) {
        if (movedFootprintIds.has(fp.id)) {
            continue;
        }
        for (const pad of fp.pads) {
            const wp = padWorldPosition(fp, pad);
            const tol = padSnapTolerance(pad, gridSize);
            if (pointDist(pt, wp) <= tol) {
                return true;
