import { PcbPadType } from '../types/PcbTypes';
import { padWorldPosition } from './PcbZoneUtil';
import { tracePcb } from './PcbTraceLog';
import { WireConflictGeometry } from './WireConflictGeometry';
import { IdUtil } from './IdUtil';
function copyPoint2D(p) {
    const pt = { x: p.x, y: p.y };
    return pt;
}
/** ç„Šç›˜ä¸–ç•Œåæ ‡ç´¢å¼•é”®ï¼šfootprintId:padId */
export function pcbPadPosKey(fpId, padId) {
    return `${fpId}:${padId}`;
}
/** æ”¶é›†å•ä¸ªå°è£…æ‰€æœ‰ç„Šç›˜çš„ä¸–ç•Œåæ ‡ */
export function collectFootprintPadPositions(fp) {
    const map = new Map();
    for (const pad of fp.pads) {
