    }
    if (pointDist(trk.start, pos) <= tol) {
      refs.push({ track: trk, isStart: true });
    }
    if (pointDist(trk.end, pos) <= tol) {
      refs.push({ track: trk, isStart: false });
    }
  }
  return refs;
