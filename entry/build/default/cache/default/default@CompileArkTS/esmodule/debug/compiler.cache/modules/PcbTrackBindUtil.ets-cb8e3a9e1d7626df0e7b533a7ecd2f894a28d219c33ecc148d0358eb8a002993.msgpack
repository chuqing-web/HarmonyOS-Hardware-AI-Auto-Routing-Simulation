function applyJunctionMove(doc, seed, movedFootprintIds, gridSize, junctionTol, visited, movedEnds, affectedNetIds) {
    const queue = [seed];
    let updated = 0;
    // ç„Šç›˜ç§å­ç”¨æ›´å¤§å®¹å·®åŒ¹é…ç«¯ç‚¹ï¼ˆä¸ padSnapTolerance å¯¹é½ï¼‰ï¼ŒæŠ˜ç‚¹ä¼ æ’­ä»ç”¨ junctionTol
    const seedFindTol = Math.max(junctionTol, 20);
    while (queue.length > 0) {
        const task = queue.shift();
        const oldKey = junctionKey(task.oldPos, task.netId, junctionTol);
        if (visited.has(oldKey)) {
