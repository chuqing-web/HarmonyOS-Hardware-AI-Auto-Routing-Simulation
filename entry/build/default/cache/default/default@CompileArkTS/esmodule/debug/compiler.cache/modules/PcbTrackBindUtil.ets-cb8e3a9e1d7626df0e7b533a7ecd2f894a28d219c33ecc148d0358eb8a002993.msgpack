        }
    }
    return false;
}
function findEndpointsAtJunction(doc, pos, netId, tol) {
    const refs = [];
    for (const trk of doc.tracks) {
        if (!netsCompatible(trk.netId, netId)) {
            continue;
        }
        if (pointDist(trk.start, pos) <= tol) {
            refs.push({ track: trk, isStart: true });
