        for (const ref of endpoints) {
            const endKey = trackEndKey(ref.track.id, ref.isStart);
            if (movedEnds.has(endKey)) {
                continue;
            }
            const pt = getTrackEndpoint(ref.track, ref.isStart);
            if (pointDist(pt, task.oldPos) > matchTol) {
