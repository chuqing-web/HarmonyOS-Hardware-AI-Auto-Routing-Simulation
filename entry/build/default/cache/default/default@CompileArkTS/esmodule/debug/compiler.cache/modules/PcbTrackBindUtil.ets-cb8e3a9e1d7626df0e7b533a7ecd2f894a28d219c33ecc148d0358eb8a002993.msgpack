export function updateTracksForFootprintTransform(doc, movedFootprintIds, oldPositions, affectedNetIds) {
    const result = updateTracksForFootprintTransformDetailed(doc, movedFootprintIds, oldPositions);
    if (affectedNetIds !== undefined) {
        result.affectedNetIds.forEach((nid) => affectedNetIds.add(nid));
