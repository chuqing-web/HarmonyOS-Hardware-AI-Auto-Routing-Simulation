export function padSnapTolerance(pad, gridSize) {
    const padRadius = Math.max(pad.size.x, pad.size.y) / 2;
    const g = gridSize > 0 ? gridSize : 5;
    return Math.max(padRadius + g * 2, g * 4, 20);
}
/** æŠ˜ç‚¹/èµ°çº¿ç«¯ç‚¹åŒ¹é…å®¹å·® */
export function junctionMatchTolerance(gridSize) {
    const g = gridSize > 0 ? gridSize : 5;
    return Math.max(g, 8);
}
function pointDist(a, b) {
    const dx = a.x - b.x;
    const dy = a.y - b.y;
    return Math.sqrt(dx * dx + dy * dy);
}
function junctionKey(pos, netId, tol) {
    const q = tol > 0 ? tol : 8;
