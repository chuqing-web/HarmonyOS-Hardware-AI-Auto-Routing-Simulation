function copyPoint2D(p: Point2D): Point2D {
  const pt: Point2D = { x: p.x, y: p.y };
  return pt;
}

/** ç„Šç›˜ä¸–ç•Œåæ ‡ç´¢å¼•é”®ï¼šfootprintId:padId */
export function pcbPadPosKey(fpId: string, padId: string): string {
  return `${fpId}:${padId}`;
}

