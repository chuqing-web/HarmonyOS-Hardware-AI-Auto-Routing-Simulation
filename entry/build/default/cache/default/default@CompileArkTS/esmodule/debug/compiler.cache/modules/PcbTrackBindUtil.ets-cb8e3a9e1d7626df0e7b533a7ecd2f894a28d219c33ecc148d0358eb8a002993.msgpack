/** å¸¦å—å½±å“ç½‘ç»œä¿¡æ¯çš„å°è£…ç§»åŠ¨èµ°çº¿è·Ÿéš */
export function updateTracksForFootprintTransformDetailed(
  doc: PcbDocument,
  movedFootprintIds: Set<string>,
  oldPositions: Map<string, Point2D>
