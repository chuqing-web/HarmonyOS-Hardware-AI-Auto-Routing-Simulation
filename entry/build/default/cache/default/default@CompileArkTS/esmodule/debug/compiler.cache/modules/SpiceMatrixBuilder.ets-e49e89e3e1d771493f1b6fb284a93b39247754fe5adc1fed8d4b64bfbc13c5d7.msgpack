                nl += `C${cCount} ${n1} ${n2} ${SpiceMatrixBuilder.toSpiceValue(val || '100n')} IC=0\n`;
                cCount++;
            }
            else if (lib.startsWith('L_') || lib.includes('INDUCTOR')) {
                const n1 = pinNodes.get(0) ?? '0';
