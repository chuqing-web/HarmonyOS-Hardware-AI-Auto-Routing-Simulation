                const n2 = pinNodes.get(1) ?? '0';
                nl += `R${rCount} ${n1} ${n2} ${SpiceMatrixBuilder.toSpiceValue(val || '1k')}\n`;
                rCount++;
            }
            else if (lib.startsWith('C_') || lib.includes('CAP') || lib === 'C') {
                const n1 = pinNodes.get(0) ?? '0';
