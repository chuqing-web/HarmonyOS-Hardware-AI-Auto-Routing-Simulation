  private static toSpiceValue(val: string): string {
    if (val.includes('k') || val.includes('K')) return val.replace(/[Kk]/, 'k');
    if (val.includes('M') && !val.includes('Meg')) return val.replace('M', 'Meg');
    if (val.includes('u') || val.includes('Âµ')) return val.replace(/[Âµu]/, 'u');
    if (val.includes('n')) return val;
    if (val.includes('p')) return val;
    return val.length > 0 ? val : '1k';
