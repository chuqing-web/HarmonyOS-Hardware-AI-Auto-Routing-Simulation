        tracePcb3d('VIEW3D_LAYER_CFG', `${ly.id} name=${ly.name} visible=${ly.visible} color=${ly.color} opacity=${op.toFixed(2)} ` +
            `focusPass=${focusPass} isCu=${isCu}`);
        if (isCu && (!ly.color || ly.color.length < 4)) {
