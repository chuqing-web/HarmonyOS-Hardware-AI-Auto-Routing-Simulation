    // è¯Šæ–­ç»“è®º
    const hasBotTrk = (byLayer.get('B.Cu') ?? byLayer.get(PcbLayerId.B_CU) ?? 0) > 0;
    if (zoneBot > 0 && !hasBotTrk) {
        tracePcb3d('VIEW3D_DIAG', `åº•å±‚è¿æ¥ä¾èµ– B.Cu é“ºé“œ(zones=${zoneBot}) è€Œéèµ°çº¿ï¼›è‹¥çœ‹ä¸åˆ°ç»¿è‰²é“ºé“œï¼Œæ£€æŸ¥ hideZones/ACTIVE_ONLY/opacity/æ¿é€æ˜åº¦`);
    }
    if (apMode === 'active_only' && activeLy.indexOf('F.Cu') >= 0 && zoneBot > 0) {
        tracePcbWarn('VIEW3D_DIAG', `å½“å‰ ACTIVE_ONLY=F.Cuï¼ŒB.Cu é“ºé“œè¢«è¿‡æ»¤ â€” ç‚¹å·¦æ  B.Cu æˆ–ã€Œå…¨éƒ¨ã€æ‰èƒ½çœ‹åˆ°è¿‡å­”ååº•å±‚`);
    }
    if (p.usePbr) {
        tracePcbWarn('VIEW3D_DIAG', `usePbr=true èµ° Z-Buffer è½»é‡è·¯å¾„ï¼Œé“ºé“œ/åˆ†è‰²å¯èƒ½ä¸å®Œæ•´ï¼›å¯å…³ PBR ç”¨å†™å® Canvas è·¯å¾„æ’æŸ¥é¢œè‰²`);
    }
    let interf = 0;
    for (let i = 0; i < doc.footprints.length; i++) {
        const a = doc.footprints[i];
        if (/^H\d+$/.test(a.refDes))
            continue;
        const ae = fpApproxHalf(a);
        for (let j = i + 1; j < doc.footprints.length; j++) {
            const b = doc.footprints[j];
            if (/^H\d+$/.test(b.refDes) || a.layer !== b.layer)
                continue;
            const be = fpApproxHalf(b);
            const dx = Math.abs(a.position.x - b.position.x);
            const dy = Math.abs(a.position.y - b.position.y);
