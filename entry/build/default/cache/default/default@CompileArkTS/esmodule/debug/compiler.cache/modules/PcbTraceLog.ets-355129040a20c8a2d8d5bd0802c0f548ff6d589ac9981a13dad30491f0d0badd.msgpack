export function tracePcbSchCompare(schematic, doc, reason) {
    Logger.info(INSTR_TRACE_TAG, `[PCB] ---------- SCHâ†”PCB AUDIT (${reason}) ----------`);
    const schPins = collectSchPinsByComp(schematic);
