            tracePcbWarn('VIEW3D_COLOR', `${ly.id} opacityè¿‡ä½=${op.toFixed(2)} å¯èƒ½å¯¼è‡´å‡ ä¹çœ‹ä¸è§`);
        }
        if (isCu && apMode === 'active_only' && idStr !== activeLy) {
