/** ç”»å¸ƒå®æ—¶çŠ¶æ€ï¼ˆç”±ç¼–è¾‘å™¨é‡‡é›†ï¼Œå†™å…¥ instr_traceï¼‰ */
export interface PcbCanvasTraceSnapshot {
  viewport: ViewportState;
  activeLayer: PcbLayerId;
  appearance: PcbAppearance;
