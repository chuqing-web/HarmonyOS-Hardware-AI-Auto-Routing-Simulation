    /**
     * ç”µå‹è¡¨é¢æ¿æ³¢å½¢ï¼šç”¨ä»¿çœŸç½‘ç”µå‹å·®ï¼ˆÂµs é‡‡æ ·ï¼‰é‡å»ºï¼Œé¿å… UI ä½é¢‘æŠ½ç‚¹æŠŠ 1kHz æ­£å¼¦æ··å æˆé”¯é½¿ã€‚
     */
    buildVoltmeterSimWave() {
        const binding = this.findMeterBinding('VOLTMETER');
        if (binding === null) {
            return null;
