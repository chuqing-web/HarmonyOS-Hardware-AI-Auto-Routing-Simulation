  setChannels(count: number): ApiResult<void> {
    if (count < 1 || count > 32) {
      return ResultHelper.fail(ErrCode.ERR_PARAM_INVALID, 'Channel count must be 1-32');
    }
    this.logicAnalyzer.setChannels(count);
    return ResultHelper.ok();
