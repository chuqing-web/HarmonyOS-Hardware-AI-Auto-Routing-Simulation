  feedScopeTimeSnapshot(time: number, voltages: Map<string, number>): void {
    // æ¯æ¬¡å–‚æ•°å‰æ¢å¤ç¤ºæ³¢å™¨æ¢é’ˆï¼ˆé˜²æ­¢ active=null / ç”µå‹è¡¨æŠ¢ç»‘æ¸…ç©º CHï¼‰
    this.applyScopeProbesFromAllBindings();
