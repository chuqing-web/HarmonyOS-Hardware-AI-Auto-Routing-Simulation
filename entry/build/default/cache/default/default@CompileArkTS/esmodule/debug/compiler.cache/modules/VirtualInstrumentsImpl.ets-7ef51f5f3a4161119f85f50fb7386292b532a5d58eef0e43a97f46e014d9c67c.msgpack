Ôr@Ÿªassertions¤code´customTransformCache¬dependencies¢id¤meta±moduleSideEffects¬originalCode±originalSourcemap«resolvedIds®sourcemapChainµsyntheticNamedExportsµtransformDependencies®transformFiles¨cacheAstÔrAÚ‰import { OscilloscopeEngine } from './engines/OscilloscopeEngine';
import { LogicAnalyzerEngine } from './engines/LogicAnalyzerEngine';
import { MultimeterEngine } from './engines/MultimeterEngine';
import { SignalGeneratorEngine } from './engines/SignalGeneratorEngine';
import { UartTerminalEngine } from './engines/UartTerminalEngine';
import { VoltmeterEngine } from './engines/VoltmeterEngine';
import { AmmeterEngine } from './engines/AmmeterEngine';
import { PowerMeterEngine } from './engines/PowerMeterEngine';
import { FrequencyCounterEngine } from './engines/FrequencyCounterEngine';
import { ErrCode, ResultHelper, Validate, IdUtil, MathChannelOp, traceActiveComponentChanged, formatBindingSummary, Logger, INSTR_TRACE_TAG, traceUart, formatUartBytesHex } from 'common';
import fs from '@ohos.file.fs';
export class VirtualInstrumentsImpl {
    constructor() {
        this.oscilloscope = new OscilloscopeEngine();
        this.logicAnalyzer = new LogicAnalyzerEngine();
        this.multimeter = new MultimeterEngine();
        this.signalGen = new SignalGeneratorEngine();
        this.uartTerminal = new UartTerminalEngine();
        this.voltmeter = new VoltmeterEngine();
        this.ammeter = new AmmeterEngine();
        this.powerMeter = new PowerMeterEngine();
        this.freqCounter = new FrequencyCounterEngine();
        this.componentBindings = new Map();
        this.activeCompId = null;
        this.uartTxSink = null;
        /** Explicit TX/RX same-net loopback (set by AppService on UART bind) */
        this.uartLoopback = false;
        /** æœ€è¿‘ä¸€å¸§ä»¿çœŸæ³¢å½¢ï¼ˆÂµs çº§ï¼‰ï¼Œä¾›ç”µå‹è¡¨/ç”µæµè¡¨é¢æ¿ç”»æ­£å¼¦ */
        this.lastSimWaves = [];
