    resolveTimeWindow(n) {
        // ç”¨ã€Œæœ‰é™ç”µå‹ã€æ ·ç‚¹ç•Œå®šçœŸå®å¯è§å†å²ï¼Œå¿½ç•¥å¼•æ“å¡«å……çš„ NaN ç©ºæ´
        let tFirst = Number.NaN;
        let tLast = Number.NaN;
