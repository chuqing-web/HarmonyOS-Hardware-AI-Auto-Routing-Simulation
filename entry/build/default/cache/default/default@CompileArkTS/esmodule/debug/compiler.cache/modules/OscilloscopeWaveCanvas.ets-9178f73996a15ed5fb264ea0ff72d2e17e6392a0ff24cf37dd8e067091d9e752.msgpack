        }
    }
    computeScale(n, i0, i1, tMin, tMax) {
        const rows = this.rows;
        const vDiv = Math.max(this.vPerDiv, 1e-6);
        let dataMin = Number.POSITIVE_INFINITY;
        let dataMax = Number.NEGATIVE_INFINITY;
        let sum = 0;
        let count = 0;
        const lo = Math.max(0, i0);
        const hi = Math.min(n - 1, i1);
        for (let i = lo; i <= hi; i++) {
            const v = this.voltageData[i];
            if (!Number.isFinite(v)) {
                continue;
            }
            if (v < dataMin) {
                dataMin = v;
            }
            if (v > dataMax) {
                dataMax = v;
            }
            sum += v;
            count++;
        }
        if (count < 1 || !Number.isFinite(dataMin) || !Number.isFinite(dataMax)) {
            dataMin = -vDiv * (rows / 2);
            dataMax = vDiv * (rows / 2);
            sum = 0;
            count = 1;
        }
        const mean = sum / count;
        const vpp = Math.max(dataMax - dataMin, 1e-6);
        let vMin;
        let vMax;
        if (this.autoFit) {
            // ä»¥ä¿¡å·ä¸­å¿ƒä¸ºåŸºå‡†ï¼Œä¸è¦å¼ºè¡ŒæŠŠ 0V æ‹‰è¿›ç”»é¢ï¼ˆå¦åˆ™ 2.2V æ­£å¼¦ä¼šè¢«å‹åˆ°é¡¶éƒ¨ï¼‰
            const half = Math.max(vpp * 0.65, vDiv * 1.5, 0.05);
            let targetMin = mean - half;
            let targetMax = mean + half;
            if (!this.scaleInit) {
                this.emaVMin = targetMin;
                this.emaVMax = targetMax;
                this.scaleInit = true;
            }
            else {
                const a = 0.28;
                this.emaVMin = a * targetMin + (1 - a) * this.emaVMin;
                this.emaVMax = a * targetMax + (1 - a) * this.emaVMax;
            }
            vMin = this.emaVMin;
            vMax = this.emaVMax;
        }
        else {
            this.scaleInit = false;
            // å›ºå®šæ¡£ï¼šæŒ‰ V/div Ã— æ ¼æ•°ï¼Œä¸­å¿ƒå¯¹é½ä¿¡å·å‡å€¼
            const half = vDiv * (rows / 2);
            vMin = mean - half;
            vMax = mean + half;
        }
        return {
            vMin: vMin,
            vMax: vMax,
            tMin: tMin,
            tMax: tMax
        };
    }
    drawZeroLine(ctx, w, h, vMin, vMax) {
