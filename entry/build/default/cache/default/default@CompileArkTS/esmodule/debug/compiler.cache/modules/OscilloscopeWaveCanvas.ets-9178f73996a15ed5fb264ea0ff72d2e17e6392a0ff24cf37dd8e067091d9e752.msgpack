    ctx.lineTo(w, h / 2);
    ctx.stroke();
    ctx.setLineDash([]);

    ctx.fillStyle = this.waveColor;
    ctx.font = 'bold 16px monospace';
    ctx.fillText(this.channelLabel, 8, 22);

    ctx.fillStyle = '#6b7a99';
    ctx.font = '18px monospace';
    ctx.fillText('NO SIGNAL', w / 2 - 52, h / 2 - 8);
    ctx.font = '14px monospace';
    if (this.channelLabel.indexOf('CH') === 0) {
      ctx.fillText('æ”¾ç½®å¹¶è¿æ¥ç¤ºæ³¢å™¨åè¿è¡Œä»¿çœŸ', Math.max(8, w / 2 - 140), h / 2 + 18);
    } else {
      ctx.fillText('è¿è¡Œä»¿çœŸåè‡ªåŠ¨åˆ·æ–°', Math.max(8, w / 2 - 90), h / 2 + 18);
