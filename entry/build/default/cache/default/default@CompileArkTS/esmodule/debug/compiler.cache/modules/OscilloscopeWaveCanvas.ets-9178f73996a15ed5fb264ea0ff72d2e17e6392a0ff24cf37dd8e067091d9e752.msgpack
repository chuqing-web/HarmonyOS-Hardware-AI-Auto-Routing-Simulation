    drawTrace(ctx, w, h, n, i0, i1, tMin, tMax, vMin, vMax) {
        const xs = [];
        const ys = [];
        const lo = Math.max(0, i0);
        const hi = Math.min(n - 1, i1);
        const count = hi - lo + 1;
        const tSpan = Math.max(tMax - tMin, 1e-15);
        if (count <= Math.floor(w) + 2) {
            for (let i = lo; i <= hi; i++) {
