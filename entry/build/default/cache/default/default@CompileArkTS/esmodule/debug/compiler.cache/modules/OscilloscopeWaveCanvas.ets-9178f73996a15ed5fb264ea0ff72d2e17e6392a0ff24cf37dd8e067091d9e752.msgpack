            }
            if (v < minV) {
                minV = v;
            }
            if (v > maxV) {
                maxV = v;
            }
            sum += v;
            count++;
        }
        if (count < 1) {
            return { vpp: 0, avg: 0, freq: 0, minV: 0, maxV: 0 };
        }
        const avg = sum / count;
        let crossings = 0;
        let firstT = -1;
        let lastT = -1;
        const thr = avg;
        for (let i = lo + 1; i <= hi; i++) {
            const a = this.voltageData[i - 1];
