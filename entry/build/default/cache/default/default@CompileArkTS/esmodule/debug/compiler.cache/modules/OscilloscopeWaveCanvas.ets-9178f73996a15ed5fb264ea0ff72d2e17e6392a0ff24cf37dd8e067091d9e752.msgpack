     * A) æœ‰æ•ˆå†å²ä¸è¶³ä¸€å± â†’ å·¦ç¼˜å¯¹é½é¦–ä¸ªæœ‰æ•ˆæ ·ç‚¹ï¼ˆè¿¹çº¿ä»å·¦å¾€å³å†™ï¼Œå³ä¾§å¯ç©ºï¼‰
     * B) å†å²å·²æ»¡ â†’ æœ€æ–°æ—¶åˆ»è´´å³ç¼˜ï¼ˆCRT æ»šåŠ¨ï¼‰
     * é¢‘åŸŸï¼šæ¨ªè½´ä¸º Hzï¼Œé»˜è®¤é“ºæ»¡ 0ï½Nyquistï¼ˆå¯ç”¨ viewZoom æ”¾å¤§ï¼‰ã€‚
     */
    resolveTimeWindow(n) {
        // ç”¨ã€Œæœ‰é™ç”µå‹ã€æ ·ç‚¹ç•Œå®šçœŸå®å¯è§å†å²ï¼Œå¿½ç•¥å¼•æ“å¡«å……çš„ NaN ç©ºæ´
        let tFirst = Number.NaN;
        let tLast = Number.NaN;
        for (let i = 0; i < n; i++) {
            const t = this.timeData[i];
            const v = this.voltageData[i];
            if (Number.isFinite(t) && Number.isFinite(v)) {
                tFirst = t;
                break;
            }
        }
        for (let i = n - 1; i >= 0; i--) {
            const t = this.timeData[i];
            const v = this.voltageData[i];
            if (Number.isFinite(t) && Number.isFinite(v)) {
                tLast = t;
                break;
            }
        }
        if (!Number.isFinite(tFirst) || !Number.isFinite(tLast)) {
            tFirst = Number.isFinite(this.timeData[0]) ? this.timeData[0] : 0;
            tLast = Number.isFinite(this.timeData[n - 1]) ? this.timeData[n - 1] : tFirst;
        }
        const zoom = Math.max(this.viewZoom, 0.05);
        const availableSpan = Math.max(tLast - tFirst, 0);
        let span;
        if (this.freqDomain) {
            // FFTï¼šä»¥å…¨é¢‘è°±ä¸ºåŸºå‡†çª—ï¼Œç¦æ­¢ç”¨ç§’æ—¶åŸºè£åˆ‡
            span = Math.max(availableSpan, 1) / zoom;
        }
        else {
            span = Math.max(this.tPerDiv * this.cols, 1e-12) / zoom;
        }
        const pan = Math.max(this.viewPanSec, 0);
        let tMin;
        let tMax;
        if (this.freqDomain) {
            tMin = tFirst;
            tMax = tFirst + span;
            if (tMax < tLast && zoom <= 1.0001) {
                tMax = tLast;
            }
            if (pan > 1e-15) {
                tMin = Math.min(tFirst + pan, Math.max(tLast - span, tFirst));
                tMax = tMin + span;
            }
        }
        else if (availableSpan < span - 1e-15 && pan <= 1e-15) {
            // å†™å±é˜¶æ®µï¼šä»å·¦å¡«å……
            tMin = tFirst;
            tMax = tFirst + span;
        }
        else {
            // æ»šåŠ¨é˜¶æ®µï¼šå³ç¼˜å¯¹é½æœ€æ–°ï¼ˆå¯å›çœ‹ï¼‰
            tMax = tLast - pan;
            if (tMax < tFirst) {
                tMax = tFirst;
            }
            if (tMax > tLast) {
                tMax = tLast;
            }
            tMin = tMax - span;
            // å›çœ‹æ—¶è‹¥è¶Šè¿‡é¦–æ ·ï¼Œé’³åˆ°é¦–æ ·å¹¶ä¿æŒçª—å®½è§‚æ„Ÿ
            if (tMin < tFirst && pan > 1e-15) {
                tMin = tFirst;
                tMax = tMin + span;
            }
        }
        let i0 = 0;
        let i1 = n - 1;
        for (let i = 0; i < n; i++) {
            const t = this.timeData[i];
            if (Number.isFinite(t) && t >= tMin) {
                i0 = i > 0 ? i - 1 : 0;
                break;
            }
        }
        for (let i = n - 1; i >= 0; i--) {
            const t = this.timeData[i];
            if (Number.isFinite(t) && t <= tMax) {
                i1 = i < n - 1 ? i + 1 : n - 1;
                break;
            }
        }
        if (i1 <= i0) {
            i0 = Math.max(0, n - 2);
            i1 = n - 1;
        }
        return { i0: i0, i1: i1, tMin: tMin, tMax: tMax };
    }
    drawBackground(ctx, w, h) {
        ctx.fillStyle = '#07070d';
