    }
    drawGrid(ctx, w, h) {
        const cols = this.cols;
        const rows = this.rows;
        ctx.strokeStyle = '#121826';
        ctx.lineWidth = 0.5;
        for (let i = 0; i <= cols * 5; i++) {
            const x = (w / (cols * 5)) * i;
            ctx.beginPath();
            ctx.moveTo(x, 0);
            ctx.lineTo(x, h);
