  private drawBackground(ctx: CanvasRenderingContext2D, w: number, h: number): void {
    ctx.fillStyle = '#07070d';
    ctx.fillRect(0, 0, w, h);
    ctx.strokeStyle = '#141a28';
    ctx.lineWidth = 2;
    ctx.strokeRect(1, 1, w - 2, h - 2);
