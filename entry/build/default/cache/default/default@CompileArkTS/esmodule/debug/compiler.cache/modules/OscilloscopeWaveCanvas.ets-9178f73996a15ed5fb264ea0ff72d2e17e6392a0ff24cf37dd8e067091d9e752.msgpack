            tMax = tFirst + span;
        }
        else {
            // æ»šåŠ¨é˜¶æ®µï¼šå³ç¼˜å¯¹é½æœ€æ–°ï¼ˆå¯å›çœ‹ï¼‰
            tMax = tLast - pan;
            if (tMax < tFirst) {
                tMax = tFirst;
            }
            if (tMax > tLast) {
                tMax = tLast;
            }
            tMin = tMax - span;
            // å›çœ‹æ—¶è‹¥è¶Šè¿‡é¦–æ ·ï¼Œé’³åˆ°é¦–æ ·å¹¶ä¿æŒçª—å®½è§‚æ„Ÿ
            if (tMin < tFirst && pan > 1e-15) {
                tMin = tFirst;
                tMax = tMin + span;
            }
        }
        let i0 = 0;
        let i1 = n - 1;
        for (let i = 0; i < n; i++) {
