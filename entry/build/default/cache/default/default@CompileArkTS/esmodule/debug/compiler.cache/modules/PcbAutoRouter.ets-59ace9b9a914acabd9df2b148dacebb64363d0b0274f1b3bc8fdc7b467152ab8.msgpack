function yieldToUi() {
    return new Promise((resolve) => {
        // 1msï¼šæ¯” 0 æ›´ç¨³åœ°æ’ç©º MMI/vSyncï¼Œé¿å… uvLoopTask è¿ç»­åƒæ»¡ä¸»çº¿ç¨‹
        setTimeout(() => {
