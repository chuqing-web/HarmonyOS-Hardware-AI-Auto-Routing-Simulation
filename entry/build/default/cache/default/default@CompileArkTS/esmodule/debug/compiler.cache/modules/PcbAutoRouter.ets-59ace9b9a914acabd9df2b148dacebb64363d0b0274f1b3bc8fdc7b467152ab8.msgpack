}
function snap(v, grid) {
    if (grid <= 0) {
        return v;
    }
    return Math.round(v / grid) * grid;
}
function dist(a, b) {
    const dx = a.x - b.x;
    const dy = a.y - b.y;
    return Math.sqrt(dx * dx + dy * dy);
}
function pathLength(pts) {
