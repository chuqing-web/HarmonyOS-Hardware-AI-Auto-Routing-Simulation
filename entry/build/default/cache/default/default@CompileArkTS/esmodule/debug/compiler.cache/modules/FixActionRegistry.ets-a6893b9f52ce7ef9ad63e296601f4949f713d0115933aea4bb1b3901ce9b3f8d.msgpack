/** å¯åŠ¨/é¦–è½®ä¿®å¤æ—¶æ‰“ä¸€æ¬¡å¯¹é½æ—¥å¿—ï¼›è¿”å›ç¼ºå¤±æ•° */
export function auditFixActionRegistryCoverage() {
    const impl = new Set();
    for (let i = 0; i < IMPLEMENTED_FIX_ACTIONS.length; i++) {
        impl.add(IMPLEMENTED_FIX_ACTIONS[i]);
    }
    let missing = 0;
    for (let i = 0; i < FIX_ACTION_DEFS.length; i++) {
        const id = FIX_ACTION_DEFS[i].id;
        if (id === 'none') {
            continue;
        }
        if (!impl.has(id)) {
            missing++;
        }
    }
    return missing;
}
