    if (id.startsWith('STC')) {
        manufacturer = 'STC';
    }
    const def = {
        id: id,
        name: id,
        category: ComponentCategory.MCU_8051,
        manufacturer: manufacturer,
        description: `8051 MCU ${id}`,
        pins: pins8051Dip40(),
        defaultParams: params1('clock', '11.0592MHz'),
        spiceModel: '',
        behaviorModel: '8051_behavioral',
        svgSymbol: 'mcu_8051.svg',
