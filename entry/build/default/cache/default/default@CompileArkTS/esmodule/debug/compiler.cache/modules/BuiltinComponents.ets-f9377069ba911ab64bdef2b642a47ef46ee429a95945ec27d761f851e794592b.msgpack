      aiWiringRules: ['input', 'pull-up']
    },
    twoPin('LDR', 'Photoresistor', ComponentCategory.SENSOR,
      params2('type', 'analog', 'value', '50k'), '', ['adc-input'])
  ];
}

function makeInstruments(): ComponentDefinition[] {
  return [
    makeOscilloscope(),
    makeVirtualMeter(),
    makeLogicAnalyzer(),
    makeUartTerminal(),
    makeVoltmeter(),
    makeAmmeter(),
    makePowerMeter(),
    makeFrequencyCounter(),
  ];
}

