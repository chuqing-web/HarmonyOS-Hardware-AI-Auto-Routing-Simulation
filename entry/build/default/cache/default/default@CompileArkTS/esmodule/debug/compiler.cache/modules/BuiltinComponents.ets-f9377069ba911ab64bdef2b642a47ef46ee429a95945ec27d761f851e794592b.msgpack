    makePin('CTRL', 'CTRL', '5', PinType.INPUT, 40, 30),
    makePin('THRES', 'THRES', '6', PinType.INPUT, 40, 10),
    makePin('DISCH', 'DISCH', '7', PinType.BIDIRECTIONAL, 40, -10),
    makePin('VCC', 'VCC', '8', PinType.POWER, 40, -30)
  ];
  const def: ComponentDefinition = {
