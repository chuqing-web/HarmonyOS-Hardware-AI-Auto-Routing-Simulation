function makeOscilloscope() {
    const def = {
        id: 'OSCILLOSCOPE',
        name: 'Virtual Oscilloscope',
        category: ComponentCategory.INSTRUMENT,
        manufacturer: 'AI-SCH',
        description: '4-channel virtual oscilloscope',
        pins: [
            makePin('CH1', 'CH1', '1', PinType.INPUT, -40, -20),
