function twoPin(id, name, cat, params, spice, rules, pinX = 30) {
    const def = {
        id: id,
        name: name,
        category: cat,
        manufacturer: 'Generic',
        description: name,
        pins: [
            makePin('1', '1', '1', PinType.PASSIVE, -pinX, 0),
            makePin('2', '2', '2', PinType.PASSIVE, pinX, 0)
        ],
        defaultParams: params,
        spiceModel: spice,
        behaviorModel: '',
        svgSymbol: `${id}.svg`,
        aiWiringRules: rules
    };
    return def;
}
/** ä¸‰ç«¯æ»‘åŠ¨å˜é˜»å™¨ï¼š1/2 ä¸ºç«¯ï¼ŒW ä¸ºæŠ½å¤´ï¼ˆwiper 0~1ï¼‰ */
function makePotentiometer(id, name, value) {
    const def = {
        id: id,
        name: name,
        category: ComponentCategory.PASSIVE,
        manufacturer: 'Generic',
        description: `${name}ï¼Œå¯è°ƒæŠ½å¤´åˆ†å‹`,
        pins: [
            makePin('1', '1', '1', PinType.PASSIVE, -30, 0),
            makePin('2', '2', '2', PinType.PASSIVE, 30, 0),
            makePin('W', 'W', '3', PinType.PASSIVE, 0, 28)
        ],
        defaultParams: params3('value', value, 'wiper', '0.5', 'power', '0.25W'),
        spiceModel: 'R{name}A {1} {W} {value}*{wiper}\nR{name}B {W} {2} {value}*(1-{wiper})',
        behaviorModel: 'potentiometer',
        svgSymbol: 'potentiometer.svg',
        aiWiringRules: ['voltage-divider', 'adjustable']
    };
    return def;
}
