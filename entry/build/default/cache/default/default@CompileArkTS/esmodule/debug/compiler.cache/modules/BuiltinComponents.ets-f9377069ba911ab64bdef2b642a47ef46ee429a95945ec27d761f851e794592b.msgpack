}
function makeSensors() {
    return [
        twoPin('DS18B20', 'DS18B20 Temperature', ComponentCategory.SENSOR, params2('range', '-55~125Â°C', 'interface', '1-Wire'), '', ['one-wire']),
        twoPin('HALL_SENSOR', 'Hall Sensor', ComponentCategory.SENSOR, params1('type', 'digital'), '', ['input']),
