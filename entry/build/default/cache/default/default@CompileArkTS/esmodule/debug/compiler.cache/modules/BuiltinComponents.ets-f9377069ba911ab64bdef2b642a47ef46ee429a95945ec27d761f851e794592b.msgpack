}

function makeSensors(): ComponentDefinition[] {
  return [
    twoPin('DS18B20', 'DS18B20 Temperature', ComponentCategory.SENSOR,
      params2('range', '-55~125Â°C', 'interface', '1-Wire'), '', ['one-wire']),
