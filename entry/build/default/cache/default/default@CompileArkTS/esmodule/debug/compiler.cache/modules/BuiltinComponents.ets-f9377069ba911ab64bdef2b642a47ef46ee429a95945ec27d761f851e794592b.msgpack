        makePin('V-', 'V-', '4', PinType.GROUND, 0, 50),
        makePin('IN+2', 'IN+2', '5', PinType.INPUT, -50, 20),
        makePin('IN-2', 'IN-2', '6', PinType.INPUT, -50, 40),
        makePin('OUT2', 'OUT2', '7', PinType.OUTPUT, 50, 30),
        makePin('V+', 'V+', '8', PinType.POWER, 0, -50)
    ];
}
