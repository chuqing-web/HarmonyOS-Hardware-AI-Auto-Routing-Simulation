        description: 'çº¿åœˆ 1/2 + è§¦ç‚¹ COM/NO/NC',
        pins: [
            makePin('1', '1', '1', PinType.PASSIVE, -30, -10),
            makePin('2', '2', '2', PinType.PASSIVE, 30, -10),
            makePin('COM', 'COM', '3', PinType.PASSIVE, 0, 20),
            makePin('NO', 'NO', '4', PinType.PASSIVE, 20, 20),
