    pins: [
      makePin('A', 'A', '1', PinType.PASSIVE, -30, 0),
      makePin('K', 'K', '2', PinType.PASSIVE, 30, 0)
    ],
    defaultParams: params1('type', 'signal'),
    spiceModel: `D{name} {A} {K}`,
    behaviorModel: 'diode',
    svgSymbol: 'diode.svg',
    aiWiringRules: ['rectifier']
  };
  return def;
}

