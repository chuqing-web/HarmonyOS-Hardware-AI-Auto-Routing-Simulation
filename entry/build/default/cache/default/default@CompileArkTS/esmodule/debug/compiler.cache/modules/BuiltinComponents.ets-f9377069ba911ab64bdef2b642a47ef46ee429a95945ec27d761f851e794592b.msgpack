      makePin('GND', 'GND', '2', PinType.GROUND, -30, 10)
    ],
    defaultParams: params2('gateTime', '1s', 'range', '10MHz'),
    spiceModel: '',
    behaviorModel: 'freq_counter',
    svgSymbol: 'freq_counter.svg',
    aiWiringRules: ['freq-measure']
  };
}
