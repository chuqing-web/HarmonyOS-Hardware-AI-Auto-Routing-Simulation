function make8051Mcu(id) {
    let manufacturer = 'Atmel';
    if (id.startsWith('STC')) {
        manufacturer = 'STC';
    }
    const def = {
        id: id,
        name: id,
        category: ComponentCategory.MCU_8051,
        manufacturer: manufacturer,
