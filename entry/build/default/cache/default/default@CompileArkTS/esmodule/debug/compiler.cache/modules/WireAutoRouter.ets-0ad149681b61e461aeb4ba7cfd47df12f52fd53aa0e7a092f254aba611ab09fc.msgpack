    }
    static pathHardClear(points, ctx) {
        for (let i = 0; i < points.length - 1; i++) {
            if (!WireAutoRouter.segmentHardClear(points[i], points[i + 1], ctx)) {
                return false;
            }
        }
        return true;
    }
    static isOrthogonalSeg(a, b) {
        return Math.abs(a.x - b.x) < 0.5 || Math.abs(a.y - b.y) < 0.5;
    }
    static isFullyOrthogonal(points) {
        for (let i = 0; i < points.length - 1; i++) {
            if (!WireAutoRouter.isOrthogonalSeg(points[i], points[i + 1])) {
                return false;
            }
        }
        return true;
    }
    static countTurns(points) {
        if (points.length < 3) {
            return 0;
        }
        let t = 0;
        for (let i = 1; i < points.length - 1; i++) {
            const dx1 = points[i].x - points[i - 1].x;
            const dy1 = points[i].y - points[i - 1].y;
            const dx2 = points[i + 1].x - points[i].x;
            const dy2 = points[i + 1].y - points[i].y;
            if (Math.abs(dx1) > 0.5 && Math.abs(dy2) > 0.5) {
                t++;
            }
            else if (Math.abs(dy1) > 0.5 && Math.abs(dx2) > 0.5) {
                t++;
            }
        }
        return t;
    }
    static pathLength(points) {
        let len = 0;
        for (let i = 1; i < points.length; i++) {
