            }
            out.push(b);
        }
        out.push(deduped[deduped.length - 1]);
        return out;
    }
}
/** è½çº¿ A* ä¸Šé™ï¼ˆåŸ 5000 åœ¨æ¨¡æ‹Ÿå™¨ä¸»çº¿ç¨‹å¯å¡æ•°ç§’ï¼‰ */
WireAutoRouter.MAX_STEPS = 1800;
/** open è¡¨è¿‡å¤§æ—¶æå‰æ”¾å¼ƒï¼Œé¿å… O(nÂ²) é€‰æœ€å° f å¡æ­» */
WireAutoRouter.MAX_OPEN = 2200;
/** è½¬è§’æƒ©ç½š Kï¼šæ‹ç‚¹ä¼˜å…ˆäºé•¿åº¦ï¼ˆåŸç†å›¾ç¾è§‚ï¼‰ */
