    /** å…±çº¿é‡å æˆ–è¿‘è·äº¤å‰è§†ä¸ºå†²çªï¼ˆç«¯ç‚¹ç›¸æ¥ / T æ¥åˆ°ä¸­æ®µå…è®¸ï¼‰ */
    static segmentsConflict(a0, a1, b0, b1, half, ctx) {
        // ç«¯ç‚¹ç›¸æ¥ï¼šå…è®¸å¹¶æ¥
        const eps = half * 1.5;
        const endTouch = Math.hypot(a0.x - b0.x, a0.y - b0.y) <= eps ||
