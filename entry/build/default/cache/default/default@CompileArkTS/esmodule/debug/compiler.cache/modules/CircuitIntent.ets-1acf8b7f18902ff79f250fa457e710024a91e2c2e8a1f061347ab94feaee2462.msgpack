            }
        }
        else {
            intent.needsSignalGen = false;
        }
    }
    // VCC ç”µå‹
    const dualRailM = zh.match(/[Â±]\s*(15|12|5)\s*[Vv]/);
    if (dualRailM) {
        intent.dualSupply = true;
        intent.preferredVccVoltage = `${dualRailM[1]}V`;
        intent.preferredVeeVoltage = `-${dualRailM[1]}V`;
        pushReason(intent, `dualRail=Â±${dualRailM[1]}V`);
    }
    const vccM = zh.match(/(?:VCC|VDD|ç”µæº|ä¾›ç”µ)\s*(?:=|ä¸º|:|ï¼š)?\s*(3\.3|5|12|15)\s*V/i);
    if (vccM) {
        intent.preferredVccVoltage = `${vccM[1]}V`;
        pushReason(intent, `vcc=${intent.preferredVccVoltage}`);
    }
    else if (!dualRailM) {
        const bareV = zh.match(/\b(3\.3|5|12|15)\s*V\b/i);
        if (bareV) {
            intent.preferredVccVoltage = `${bareV[1]}V`;
            pushReason(intent, `vcc=${intent.preferredVccVoltage}`);
        }
    }
    // VEE ç”µå‹
    const veeM = zh.match(/(?:VEE|è´Ÿå‹|è´Ÿç”µæº)\s*(?:=|ä¸º|:|ï¼š)?\s*(-?1?5|-?1?2|-?5)\s*V/i) ||
        zh.match(/(-\s*15|-\s*12|-\s*5)\s*V/i);
    if (veeM) {
        let v = veeM[1].replace(/\s/g, '');
        if (!v.startsWith('-')) {
            v = `-${v}`;
        }
        intent.preferredVeeVoltage = `${v}V`;
        intent.dualSupply = true;
        pushReason(intent, `vee=${intent.preferredVeeVoltage}`);
    }
    else if (intent.dualSupply && intent.preferredVeeVoltage.length === 0) {
        intent.preferredVeeVoltage = '-12V';
    }
    // åŒç”µæºï¼šæœªæŒ‡å®šæ­£è½¨æ—¶ä¸ |VEE| å¯¹ç§°
    if (intent.dualSupply && intent.preferredVccVoltage.length === 0) {
        const veeN = parseFloat((intent.preferredVeeVoltage || '-12').replace(/[Vv]/g, ''));
        const abs = Number.isFinite(veeN) ? Math.abs(veeN) : 12;
        intent.preferredVccVoltage = `${abs > 0 ? abs : 12}V`;
        pushReason(intent, `vccSym=${intent.preferredVccVoltage}`);
    }
    // ä¿¡å·å‘ç”Ÿå™¨ï¼šä»…ã€Œå¤–æ¥æ¿€åŠ±/ä¿¡å·æºã€æ‰ç½®ä½ï¼›å¦å®šè¯­å¢ƒï¼ˆæ— éœ€æ¿€åŠ±ï¼‰ä¸ç®—
    const deniesExcitation = /æ— éœ€\s*å¤–?æ¥?æ¿€åŠ±|ä¸è¦\s*å¤–?æ¥?æ¿€åŠ±|ç¦æ­¢\s*å¤–?æ¥?æ¿€åŠ±|å‹¿\s*å¤–?æ¥?æ¿€åŠ±|æ— \s*å¤–?éƒ¨?æ¿€åŠ±|ä¸éœ€è¦\s*ä¿¡å·æº|ç¦æ­¢\s*SIGNAL_GEN/i.test(zh);
    const wantSig = !deniesExcitation && (zh.indexOf('ä¿¡å·å‘ç”Ÿ') >= 0 || zh.indexOf('å‡½æ•°å‘ç”Ÿ') >= 0 ||
        zh.indexOf('ä¿¡å·æº') >= 0 || lower.indexOf('signal gen') >= 0 ||
        lower.indexOf('function gen') >= 0 || lower.indexOf('waveform gen') >= 0 ||
        (zh.indexOf('å¤–æ¥æ¿€åŠ±') >= 0 || zh.indexOf('å¤–éƒ¨æ¿€åŠ±') >= 0 || zh.indexOf('è¾“å…¥æ¿€åŠ±') >= 0) ||
        (/æ¿€åŠ±/.test(zh) && !deniesExcitation &&
            (zh.indexOf('è¾“å…¥') >= 0 || zh.indexOf('å¤–æ¥') >= 0) &&
            (zh.indexOf('æ­£å¼¦') >= 0 || zh.indexOf('æ–¹æ³¢') >= 0 || zh.indexOf('ä¸‰è§’') >= 0)));
    if (wantSig && !isOpAmpSelfOscillatorPrompt(prompt)) {
        intent.needsSignalGen = true;
        intent.hasInstruments = true;
        pushReason(intent, 'signal_gen');
    }
    // æ¿€åŠ±æ³¢å½¢ï¼šä¼˜å…ˆã€Œè¾“å…¥/æ¿€åŠ±/ä¿¡å·æºã€è¯­å¢ƒï¼›ã€Œæ•´å½¢/è¾“å‡ºæ–¹æ³¢ã€ä¸è¦†ç›–æ­£å¼¦æ¿€åŠ±
    const hasSine = zh.indexOf('æ­£å¼¦') >= 0 || lower.indexOf('sine') >= 0;
    const hasSquare = zh.indexOf('æ–¹æ³¢') >= 0 || lower.indexOf('square') >= 0;
    const hasTri = zh.indexOf('ä¸‰è§’') >= 0 || lower.indexOf('triangle') >= 0;
    const hasSaw = zh.indexOf('é”¯é½¿') >= 0 || lower.indexOf('saw') >= 0;
    const hasPulse = zh.indexOf('è„‰å†²') >= 0 || lower.indexOf('pulse') >= 0;
    const squareAsOutputOnly = hasSquare && hasSine && (zh.indexOf('æ•´å½¢') >= 0 || zh.indexOf('æ»å›') >= 0 || zh.indexOf('æ¯”è¾ƒå™¨') >= 0 ||
        zh.indexOf('è¾“å‡º') >= 0 || zh.indexOf('å‰Šæ³¢') >= 0 ||
        /è¾“å…¥\s*æ­£å¼¦|æ­£å¼¦\s*æ³¢?\s*ä¿¡å·|æ­£å¼¦\s*æ¿€åŠ±/.test(zh));
    const exciteCtx = (wave) => {
        const i = zh.indexOf(wave);
        if (i < 0) {
            return false;
        }
        const win = zh.substring(Math.max(0, i - 8), Math.min(zh.length, i + wave.length + 8));
        return win.indexOf('è¾“å…¥') >= 0 || win.indexOf('æ¿€åŠ±') >= 0 || win.indexOf('ä¿¡å·æº') >= 0 ||
            win.indexOf('ä¿¡å·å‘ç”Ÿ') >= 0 || win.indexOf('å‡½æ•°å‘ç”Ÿ') >= 0;
    };
    if (hasSine && (exciteCtx('æ­£å¼¦') || squareAsOutputOnly || !hasSquare)) {
        intent.signalWaveform = 'sine';
        if (wantSig || exciteCtx('æ­£å¼¦')) {
            intent.needsSignalGen = true;
        }
    }
    else if (hasSquare && !squareAsOutputOnly) {
        intent.signalWaveform = 'square';
        // ã€Œè§‚æµ‹æ³¢å½¢/ä¸¤è·¯æ³¢å½¢ã€æ˜¯ç¤ºæ³¢å™¨è¯­å¢ƒï¼Œä¸ä»£è¡¨å¤–æ¥ä¿¡å·æº
        if (wantSig || exciteCtx('æ–¹æ³¢')) {
            intent.needsSignalGen = true;
        }
    }
    else if (hasTri) {
        intent.signalWaveform = 'triangle';
        if (wantSig || exciteCtx('ä¸‰è§’')) {
            intent.needsSignalGen = true;
        }
    }
    else if (hasSaw) {
        intent.signalWaveform = 'saw';
        if (wantSig || exciteCtx('é”¯é½¿')) {
            intent.needsSignalGen = true;
        }
    }
    else if (hasPulse) {
        intent.signalWaveform = 'pulse';
        if (wantSig || exciteCtx('è„‰å†²')) {
            intent.needsSignalGen = true;
        }
    }
    else if (hasSine) {
        intent.signalWaveform = 'sine';
        if (wantSig) {
            intent.needsSignalGen = true;
        }
    }
    // é¢‘ç‡ï¼š1kHz / 500Hz / é¢‘ç‡=10kHz
    const freqM = zh.match(/(?:é¢‘ç‡|freq(?:uency)?)\s*(?:=|ä¸º|:|ï¼š)?\s*([\d.]+\s*[kKmM]?[Hh][Zz]?)/i) ||
        zh.match(/([\d.]+\s*[kKmM]?[Hh][Zz])/);
    if (freqM && (intent.needsSignalGen || wantSig || zh.indexOf('æ–¹æ³¢') >= 0 ||
        zh.indexOf('æ­£å¼¦') >= 0 || zh.indexOf('ä¸‰è§’') >= 0)) {
        let f = freqM[1].replace(/\s/g, '');
        if (!/[Hh][Zz]$/i.test(f)) {
            f = `${f}Hz`;
        }
        intent.preferredSignalFrequency = f;
        pushReason(intent, `sigFreq=${f}`);
    }
    // å ç©ºæ¯”ï¼šå ç©ºæ¯”50% / duty=25 / 25%å ç©º
    const dutyM = zh.match(/(?:å ç©ºæ¯”|duty(?:\s*cycle)?)\s*(?:=|ä¸º|:|ï¼š)?\s*([\d.]+)\s*%?/i) ||
        zh.match(/([\d.]+)\s*%\s*(?:å ç©º|duty)/i);
    if (dutyM) {
        const n = parseFloat(dutyM[1]);
        if (Number.isFinite(n) && n > 0 && n <= 100) {
            intent.preferredSignalDuty = `${n}%`;
            if (intent.needsSignalGen || wantSig) {
                pushReason(intent, `sigDuty=${intent.preferredSignalDuty}`);
