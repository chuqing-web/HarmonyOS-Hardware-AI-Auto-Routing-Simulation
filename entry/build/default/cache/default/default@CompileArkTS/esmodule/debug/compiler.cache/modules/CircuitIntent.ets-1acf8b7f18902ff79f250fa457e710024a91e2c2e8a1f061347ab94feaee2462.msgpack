  /** SIGNAL_GEN å ç©ºæ¯”æ–‡æ¡ˆï¼ˆå¦‚ 50% / 25ï¼‰ï¼Œç©º=é»˜è®¤ 50%ï¼›æ–¹æ³¢/è„‰å†²æœ‰æ•ˆ */
  preferredSignalDuty: string;
  /** SIGNAL_GEN å¹…åº¦æ–‡æ¡ˆï¼ˆå¦‚ 5V / 2Vï¼‰ï¼Œç©º=é»˜è®¤ 1Vï¼›æ»å›æ•´å½¢é»˜è®¤â‰¥5V */
  preferredSignalAmplitude: string;
  /** æ»å›/æ–½å¯†ç‰¹æ¯”è¾ƒå™¨æ•´å½¢ï¼šæ¿€åŠ±å³°å€¼é¡»è¶Šè¿‡ Â±Î²Â·|Vsat| */
  needsHysteresisComparator: boolean;
  /** è¿æ”¾ç§¯åˆ†å™¨ï¼ˆæ–¹æ³¢â†’ä¸‰è§’ç­‰ï¼‰ï¼šåç›¸ç§¯åˆ† + åŒç”µæº + SIGNAL_GEN */
  needsOpAmpIntegrator: boolean;
