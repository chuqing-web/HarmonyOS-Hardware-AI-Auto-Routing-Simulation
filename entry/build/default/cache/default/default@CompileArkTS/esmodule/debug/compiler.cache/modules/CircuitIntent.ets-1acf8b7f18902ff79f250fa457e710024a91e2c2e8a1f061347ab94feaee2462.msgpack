    return zh.indexOf('å……æ”¾ç”µ') >= 0 || zh.indexOf('æ—¶é—´å¸¸æ•°') >= 0 ||
        zh.indexOf('æŒ‡æ•°æ³¢å½¢') >= 0 || zh.indexOf('Ï„=RC') >= 0 || zh.indexOf('Ï„ï¼RC') >= 0 ||
        zh.indexOf('tau=RC') >= 0 || lower.indexOf('time constant') >= 0 ||
