/** è§£æç”µæºç”µå‹ / åŒç”µæº / ä¿¡å·å‘ç”Ÿå™¨æ„å›¾ */
function applyPowerAndSignalIntent(intent, prompt) {
    const zh = prompt ?? '';
    const lower = zh.toLowerCase();
    // åŒç”µæº / VEE
    if (zh.indexOf('åŒç”µæº') >= 0 || zh.indexOf('æ­£è´Ÿç”µæº') >= 0 || zh.indexOf('è´Ÿå‹') >= 0 ||
        zh.indexOf('VEE') >= 0 || lower.indexOf('vee') >= 0 ||
        zh.indexOf('Â±') >= 0 || zh.indexOf('+/-') >= 0 || lower.indexOf('+/-') >= 0 ||
        lower.indexOf('dual supply') >= 0 || lower.indexOf('split supply') >= 0 ||
        /[Â±]\s*1?2\s*v/i.test(zh) || /[Â±]\s*5\s*v/i.test(zh) ||
        /-12\s*v/i.test(zh) || /-5\s*v/i.test(zh)) {
        intent.dualSupply = true;
        intent.needsPowerRails = true;
        pushReason(intent, 'dual_supply');
