    // ä»éœ€æ±‚æ‘˜è¦æŠ ç”µå‹ï¼šç”µæº:VCC/GND(5V)
    const hintM = (prompt ?? '').match(/ç”µæº\s*:\s*VCC\s*\/\s*GND\s*\(([^)]+)\)/i);
