export function defaultCircuitIntent(): CircuitIntent {
  return {
    needsPowerRails: true,
    hasMcuMinSystem: false,
    mutualLedIndicator: false,
    blinkOscillator: false,
    relayContactTopo: false,
    seriesRcCharge: false,
