/**
 * ç”µæºè½¨å¥‘çº¦æ”¶å£ï¼šBOM æ—  VEE / éœ€æ±‚å•ç”µæº â†’ ç¦ dualï¼›BOM æœ‰ VEE â†’ å¼ºåˆ¶ dualã€‚
 * è¦†ç›–ç§¯åˆ†å™¨/è¿æ”¾å¯å‘å¼é»˜è®¤ Â±12Vã€‚
 */
export function applySupplyRailContract(intent, prompt, bomHasVcc, bomHasGnd, bomHasVee) {
    const singlePrompt = promptImpliesSingleSupply(prompt);
    const dualPrompt = promptImpliesDualSupply(prompt);
    // ä»éœ€æ±‚æ‘˜è¦æŠ ç”µå‹ï¼šç”µæº:VCC/GND(5V)
    const hintM = (prompt ?? '').match(/ç”µæº\s*:\s*VCC\s*\/\s*GND\s*\(([^)]+)\)/i);
    if (hintM && hintM[1] && intent.preferredVccVoltage.length === 0) {
        intent.preferredVccVoltage = hintM[1].trim();
        pushReason(intent, `vccReqHint=${intent.preferredVccVoltage}`);
    }
