    const deniesExcitation = /æ— éœ€\s*å¤–?æ¥?æ¿€åŠ±|ä¸è¦\s*å¤–?æ¥?æ¿€åŠ±|ç¦æ­¢\s*å¤–?æ¥?æ¿€åŠ±|å‹¿\s*å¤–?æ¥?æ¿€åŠ±|æ— \s*å¤–?éƒ¨?æ¿€åŠ±|ä¸éœ€è¦\s*ä¿¡å·æº|ç¦æ­¢\s*SIGNAL_GEN/i.test(zh);
    const wantSig = !deniesExcitation && (zh.indexOf('ä¿¡å·å‘ç”Ÿ') >= 0 || zh.indexOf('å‡½æ•°å‘ç”Ÿ') >= 0 ||
        zh.indexOf('ä¿¡å·æº') >= 0 || lower.indexOf('signal gen') >= 0 ||
        lower.indexOf('function gen') >= 0 || lower.indexOf('waveform gen') >= 0 ||
        (zh.indexOf('å¤–æ¥æ¿€åŠ±') >= 0 || zh.indexOf('å¤–éƒ¨æ¿€åŠ±') >= 0 || zh.indexOf('è¾“å…¥æ¿€åŠ±') >= 0) ||
        (/æ¿€åŠ±/.test(zh) && !deniesExcitation &&
            (zh.indexOf('è¾“å…¥') >= 0 || zh.indexOf('å¤–æ¥') >= 0) &&
            (zh.indexOf('æ­£å¼¦') >= 0 || zh.indexOf('æ–¹æ³¢') >= 0 || zh.indexOf('ä¸‰è§’') >= 0)));
    if (wantSig && !isOpAmpSelfOscillatorPrompt(prompt)) {
