/** è§£æå¹…åº¦æ–‡æ¡ˆä¸ºä¼ç‰¹å³°å€¼ï¼›æ— æ³•è§£æè¿”å› NaN */
export function parseSignalAmplitudeVolts(text: string): number {
  const s = (text ?? '').trim();
  if (s.length === 0) {
    return Number.NaN;
  }
  const m = s.match(/^([\d.]+)\s*[Vv]?$/);
  if (!m) {
    return Number.NaN;
  }
  const n = parseFloat(m[1]);
  return Number.isFinite(n) ? n : Number.NaN;
}

/** æ»å›æ•´å½¢æ¿€åŠ±æœ€å°å¯é å³°å€¼ï¼ˆRf/Rgâ‰ˆ10:1ã€Â±12V æ—¶ |Vth|â‰ˆ1Vï¼Œ1V å³°ä¼šé”æ­»ï¼‰ */
export const HYSTERESIS_MIN_SIGNAL_AMP_V: number = 2;
/** æ»å›æ•´å½¢æ¨èå³°å€¼ï¼ˆä½™é‡å……è¶³ï¼‰ */
