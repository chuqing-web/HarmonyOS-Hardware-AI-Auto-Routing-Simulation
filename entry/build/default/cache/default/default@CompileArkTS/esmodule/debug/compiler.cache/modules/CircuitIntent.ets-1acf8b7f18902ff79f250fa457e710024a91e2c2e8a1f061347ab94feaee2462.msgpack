        timer555Monostable: src.timer555Monostable,
        timer555Astable: src.timer555Astable,
        dualSupply: src.dualSupply,
        preferredVccVoltage: src.preferredVccVoltage,
        preferredVeeVoltage: src.preferredVeeVoltage,
