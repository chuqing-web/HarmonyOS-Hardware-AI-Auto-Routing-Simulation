        const zh2 = prompt ?? '';
        const lower2 = zh2.toLowerCase();
        const userSaidSineExcite = (zh2.indexOf('æ­£å¼¦') >= 0 || lower2.indexOf('sine') >= 0) &&
            (zh2.indexOf('è¾“å…¥') >= 0 || zh2.indexOf('æ¿€åŠ±') >= 0 || zh2.indexOf('ä¿¡å·æº') >= 0);
        if (!userSaidSineExcite) {
