            if (intent.signalWaveform.length === 0 || intent.signalWaveform === 'sine') {
                // ç§¯åˆ†ç¤ºæ•™é»˜è®¤æ–¹æ³¢æ¿€åŠ±ï¼ˆå¯è¢«ç”¨æˆ·æ˜¾å¼æ³¢å½¢è¦†ç›–ï¼Œè§ applyPowerAndSignalIntentï¼‰
                intent.signalWaveform = 'square';
