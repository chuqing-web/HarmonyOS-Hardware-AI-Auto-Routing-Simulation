    // ç§¯åˆ†å™¨ï¼šæ¿€åŠ±æ³¢å½¢ä»¥æ–¹æ³¢ä¸ºå‡†ï¼ˆã€Œä¸‰è§’ã€æ˜¯è¾“å‡ºè§‚æµ‹ï¼Œä¸æ˜¯ä¿¡å·æºï¼‰
    // è‡ªæ¿€é—­ç¯é™¤å¤– â€” æ— éœ€ SIGNAL_GEN
    if (intent.needsOpAmpIntegrator && !isOpAmpSelfOscillatorPrompt(prompt)) {
        intent.dualSupply = true;
        intent.needsSignalGen = true;
        const zh2 = prompt ?? '';
        const lower2 = zh2.toLowerCase();
        const userSaidSineExcite = (zh2.indexOf('æ­£å¼¦') >= 0 || lower2.indexOf('sine') >= 0) &&
            (zh2.indexOf('è¾“å…¥') >= 0 || zh2.indexOf('æ¿€åŠ±') >= 0 || zh2.indexOf('ä¿¡å·æº') >= 0);
        if (!userSaidSineExcite) {
