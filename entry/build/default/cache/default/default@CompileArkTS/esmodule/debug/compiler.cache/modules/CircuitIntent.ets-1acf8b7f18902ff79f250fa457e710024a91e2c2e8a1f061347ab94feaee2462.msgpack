        zh.indexOf('é€»è¾‘åˆ†æ') >= 0 || zh.indexOf('æµ‹ç”µæµ') >= 0 || zh.indexOf('æµ‹ç”µå‹') >= 0 ||
        lower.indexOf('voltmeter') >= 0 || lower.indexOf('ammeter') >= 0 ||
        lower.indexOf('scope') >= 0) {
