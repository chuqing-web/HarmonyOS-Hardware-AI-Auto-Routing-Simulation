/** HARD æ®‹å·®æŒ‡çº¹ï¼šå¿½ç•¥æ•°å­—æ³¢åŠ¨ï¼Œæ’åºåæ‹¼æ¥ */
export function hardResidualFingerprint(hard) {
    const norm = hard.map(s => s.replace(/\d+/g, '#').replace(/\s+/g, ' ').trim());
    norm.sort();
    return norm.join('|');
}
export function splitEmpty() {
    return { hard: [], soft: [] };
}
export function mergeSplit(a, b) {
    return { hard: a.hard.concat(b.hard), soft: a.soft.concat(b.soft) };
}
export function allCritiqueLines(split) {
    const lines = [];
    for (let i = 0; i < split.hard.length; i++) {
        lines.push(`[HARD] ${split.hard[i]}`);
    }
    for (let j = 0; j < split.soft.length; j++) {
        lines.push(`[SOFT] ${split.soft[j]}`);
    }
    return lines;
}
/** å…¼å®¹æ—§ isMutualLedSwitchPrompt è°ƒç”¨ */
export function intentIsMutualLedSwitch(prompt) {
    return isMutualLedSwitchPrompt(prompt);
}
