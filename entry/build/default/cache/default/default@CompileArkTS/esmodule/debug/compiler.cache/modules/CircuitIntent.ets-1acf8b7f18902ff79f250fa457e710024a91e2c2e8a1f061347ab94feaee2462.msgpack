  preferredSignalFrequency: string;
  /** SIGNAL_GEN å ç©ºæ¯”æ–‡æ¡ˆï¼ˆå¦‚ 50% / 25ï¼‰ï¼Œç©º=é»˜è®¤ 50%ï¼›æ–¹æ³¢/è„‰å†²æœ‰æ•ˆ */
  preferredSignalDuty: string;
