    // å¹…åº¦ï¼šå¹…åº¦5V / amp=2V / Â±5Vï¼ˆä½œå³°å³°å€¼æ—¶å–ä¸€åŠï¼Ÿæ­¤å¤„æŒ‰å³°å€¼æ–‡æ¡ˆï¼‰
    const ampM = zh.match(/(?:å¹…åº¦|å¹…å€¼|amplitude|amp)\s*(?:=|ä¸º|:|ï¼š)?\s*([\d.]+)\s*[Vv]?/i) ||
        zh.match(/[Â±]\s*([\d.]+)\s*[Vv]/);
    if (ampM) {
        const n = parseFloat(ampM[1]);
        if (Number.isFinite(n) && n > 0) {
