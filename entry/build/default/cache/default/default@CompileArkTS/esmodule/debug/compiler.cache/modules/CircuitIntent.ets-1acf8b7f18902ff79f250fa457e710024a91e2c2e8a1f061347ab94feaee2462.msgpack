        (zh.indexOf('RC') >= 0 && (zh.indexOf('ç”µå®¹') >= 0 || zh.indexOf('ç”µé˜»') >= 0) &&
            (zh.indexOf('å……ç”µ') >= 0 || zh.indexOf('æ”¾ç”µ') >= 0 || zh.indexOf('æ³¢å½¢') >= 0));
}
function pushReason(intent, reason) {
    if (intent.reasons.indexOf(reason) < 0) {
