}
/** è§£æç”µæºç”µå‹ / åŒç”µæº / ä¿¡å·å‘ç”Ÿå™¨æ„å›¾ */
function applyPowerAndSignalIntent(intent, prompt) {
    const zh = prompt ?? '';
    const lower = zh.toLowerCase();
    // åŒç”µæº / VEE
    if (zh.indexOf('åŒç”µæº') >= 0 || zh.indexOf('æ­£è´Ÿç”µæº') >= 0 || zh.indexOf('è´Ÿå‹') >= 0 ||
        zh.indexOf('VEE') >= 0 || lower.indexOf('vee') >= 0 ||
