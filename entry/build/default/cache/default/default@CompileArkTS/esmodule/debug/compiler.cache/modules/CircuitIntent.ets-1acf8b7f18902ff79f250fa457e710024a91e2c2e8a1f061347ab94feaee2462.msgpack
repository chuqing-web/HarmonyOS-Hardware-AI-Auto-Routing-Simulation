/** é€‰å‹å‰ï¼šä»…æ ¹æ®ç”¨æˆ·æç¤ºç²—åˆ†æ„å›¾ */
export function classifyCircuitIntent(prompt) {
    const intent = defaultCircuitIntent();
    const zh = prompt ?? '';
    const lower = zh.toLowerCase();
    if (isBlinkLike(zh, lower)) {
