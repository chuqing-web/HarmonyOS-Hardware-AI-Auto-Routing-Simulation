  seriesRcCharge: boolean;
  /** è¿æ”¾/æ¨¡æ‹ŸåŒç”µæºï¼šéœ€è¦ VEE è´Ÿå‹è½¨ */
  dualSupply: boolean;
  /** ç”¨æˆ·æŒ‡å®šçš„æ­£ç”µæºç”µå‹æ–‡æ¡ˆï¼ˆå¦‚ 3.3V / 5V / 12Vï¼‰ï¼Œç©º=é»˜è®¤ */
  preferredVccVoltage: string;
  /** ç”¨æˆ·æŒ‡å®šçš„è´Ÿç”µæºç”µå‹æ–‡æ¡ˆï¼ˆå¦‚ -12V / -5Vï¼‰ï¼Œç©º=é»˜è®¤ -12V */
  preferredVeeVoltage: string;
  /** éœ€è¦åŸç†å›¾ SIGNAL_GENï¼ˆæ­£å¼¦/æ–¹æ³¢/ä¸‰è§’ï¼‰ */
