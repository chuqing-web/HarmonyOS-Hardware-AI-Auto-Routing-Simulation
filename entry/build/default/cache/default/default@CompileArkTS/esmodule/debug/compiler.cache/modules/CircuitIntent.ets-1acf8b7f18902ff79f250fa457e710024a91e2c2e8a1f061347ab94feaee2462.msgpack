        // è‡ªæ¿€æŒ¯è¡ï¼šæ–¹æ³¢ç”±æ»å›æ¯”è¾ƒå™¨è‡ªäº§ï¼Œå‹¿å¼ºåˆ¶å¤–æ¥ SIGNAL_GEN
        if (!isOpAmpSelfOscillatorPrompt(prompt)) {
            intent.needsSignalGen = true;
