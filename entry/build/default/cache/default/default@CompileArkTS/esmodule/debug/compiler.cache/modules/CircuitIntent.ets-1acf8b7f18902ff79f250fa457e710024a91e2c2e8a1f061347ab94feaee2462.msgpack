    // æ¿€åŠ±æ³¢å½¢ï¼šä¼˜å…ˆã€Œè¾“å…¥/æ¿€åŠ±/ä¿¡å·æºã€è¯­å¢ƒï¼›ã€Œæ•´å½¢/è¾“å‡ºæ–¹æ³¢ã€ä¸è¦†ç›–æ­£å¼¦æ¿€åŠ±
    const hasSine = zh.indexOf('æ­£å¼¦') >= 0 || lower.indexOf('sine') >= 0;
    const hasSquare = zh.indexOf('æ–¹æ³¢') >= 0 || lower.indexOf('square') >= 0;
    const hasTri = zh.indexOf('ä¸‰è§’') >= 0 || lower.indexOf('triangle') >= 0;
    const hasSaw = zh.indexOf('é”¯é½¿') >= 0 || lower.indexOf('saw') >= 0;
    const hasPulse = zh.indexOf('è„‰å†²') >= 0 || lower.indexOf('pulse') >= 0;
    const squareAsOutputOnly = hasSquare && hasSine && (zh.indexOf('æ•´å½¢') >= 0 || zh.indexOf('æ»å›') >= 0 || zh.indexOf('æ¯”è¾ƒå™¨') >= 0 ||
        zh.indexOf('è¾“å‡º') >= 0 || zh.indexOf('å‰Šæ³¢') >= 0 ||
        /è¾“å…¥\s*æ­£å¼¦|æ­£å¼¦\s*æ³¢?\s*ä¿¡å·|æ­£å¼¦\s*æ¿€åŠ±/.test(zh));
    const exciteCtx = (wave) => {
        const i = zh.indexOf(wave);
        if (i < 0) {
            return false;
        }
        const win = zh.substring(Math.max(0, i - 8), Math.min(zh.length, i + wave.length + 8));
        return win.indexOf('è¾“å…¥') >= 0 || win.indexOf('æ¿€åŠ±') >= 0 || win.indexOf('ä¿¡å·æº') >= 0 ||
            win.indexOf('ä¿¡å·å‘ç”Ÿ') >= 0 || win.indexOf('å‡½æ•°å‘ç”Ÿ') >= 0;
    };
    if (hasSine && (exciteCtx('æ­£å¼¦') || squareAsOutputOnly || !hasSquare)) {
        intent.signalWaveform = 'sine';
        if (wantSig || exciteCtx('æ­£å¼¦')) {
            intent.needsSignalGen = true;
        }
    }
    else if (hasSquare && !squareAsOutputOnly) {
        intent.signalWaveform = 'square';
        if (wantSig || zh.indexOf('æ³¢å½¢') >= 0 || exciteCtx('æ–¹æ³¢')) {
            intent.needsSignalGen = true;
        }
    }
    else if (hasTri) {
        intent.signalWaveform = 'triangle';
        if (wantSig || zh.indexOf('æ³¢å½¢') >= 0) {
            intent.needsSignalGen = true;
        }
    }
    else if (hasSaw) {
        intent.signalWaveform = 'saw';
        if (wantSig || zh.indexOf('æ³¢å½¢') >= 0) {
            intent.needsSignalGen = true;
        }
    }
    else if (hasPulse) {
        intent.signalWaveform = 'pulse';
