  return zh.indexOf('å……æ”¾ç”µ') >= 0 || zh.indexOf('æ—¶é—´å¸¸æ•°') >= 0 ||
    zh.indexOf('æŒ‡æ•°æ³¢å½¢') >= 0 || zh.indexOf('Ï„=RC') >= 0 || zh.indexOf('Ï„ï¼RC') >= 0 ||
    zh.indexOf('tau=RC') >= 0 || lower.indexOf('time constant') >= 0 ||
    lower.indexOf('rc charge') >= 0 || lower.indexOf('rc discharge') >= 0 ||
    (zh.indexOf('RC') >= 0 && (zh.indexOf('ç”µå®¹') >= 0 || zh.indexOf('ç”µé˜»') >= 0) &&
      (zh.indexOf('å……ç”µ') >= 0 || zh.indexOf('æ”¾ç”µ') >= 0 || zh.indexOf('æ³¢å½¢') >= 0));
}

/** 555 å•ç¨³æ€å»¶æ—¶ / æŒ‰é”®è§¦å‘ */
function is555MonostablePrompt(prompt: string): boolean {
  const zh = prompt ?? '';
  const lower = zh.toLowerCase();
  return zh.indexOf('å•ç¨³æ€') >= 0 || zh.indexOf('å•ç¨³') >= 0 ||
    zh.indexOf('å»¶æ—¶') >= 0 || zh.indexOf('å»¶è¿Ÿ') >= 0 ||
    zh.indexOf('å»¶æ—¶ç†„ç­') >= 0 ||
    lower.indexOf('monostable') >= 0 || lower.indexOf('one-shot') >= 0 ||
    lower.indexOf('oneshot') >= 0 || lower.indexOf('one shot') >= 0;
}

/** 555 æ— ç¨³æ€å¤šè° / æŒ¯è¡ */
function is555AstablePrompt(prompt: string): boolean {
  const zh = prompt ?? '';
  const lower = zh.toLowerCase();
  return zh.indexOf('å¤šè°') >= 0 || zh.indexOf('æŒ¯è¡') >= 0 ||
    zh.indexOf('æ–¹æ³¢') >= 0 || zh.indexOf('é—ªçƒ') >= 0 ||
