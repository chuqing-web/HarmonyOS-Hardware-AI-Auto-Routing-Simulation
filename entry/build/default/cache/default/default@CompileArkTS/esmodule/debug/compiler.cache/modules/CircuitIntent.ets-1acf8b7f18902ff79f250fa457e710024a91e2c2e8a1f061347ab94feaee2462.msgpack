    }
    if (zh.indexOf('I2C') >= 0 || lower.indexOf('i2c') >= 0 || zh.indexOf('IÂ²C') >= 0) {
        intent.needsI2cPullup = true;
        pushReason(intent, 'i2c_keyword');
    }
    if (zh.indexOf('è¿æ”¾') >= 0 || zh.indexOf('æ”¾å¤§å™¨') >= 0 || lower.indexOf('opamp') >= 0 ||
        lower.indexOf('op-amp') >= 0 || zh.indexOf('LM358') >= 0 || zh.indexOf('LM324') >= 0 ||
        zh.indexOf('741') >= 0 || zh.indexOf('TL082') >= 0 || zh.indexOf('æ¯”è¾ƒå™¨') >= 0 ||
        zh.indexOf('æ»å›') >= 0 || zh.indexOf('æ–½å¯†ç‰¹') >= 0 || lower.indexOf('schmitt') >= 0) {
