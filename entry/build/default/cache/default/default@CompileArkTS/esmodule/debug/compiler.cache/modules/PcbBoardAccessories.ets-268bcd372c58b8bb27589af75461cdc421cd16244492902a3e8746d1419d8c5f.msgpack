        }
        if (addedNew) {
            message = `å·²æ·»åŠ æ¿è¾¹å¤–æ¥ J1/å®‰è£…å­” ${created} ä»¶ï¼ˆ${railParts.join(' | ')}ï¼‰`;
        }
        tracePcb('BOARD_ACCESSORIES', `added=${created} J1=${defId} rails=[${railParts.join(',')}] totalPins=${assignment.length}`);
