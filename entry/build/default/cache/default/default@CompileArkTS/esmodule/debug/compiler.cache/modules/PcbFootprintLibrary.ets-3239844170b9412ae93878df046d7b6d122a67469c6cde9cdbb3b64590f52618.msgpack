/** TO-220 / ä¸‰ç«¯ç¨³å‹å™¨ â€” è„šä½ä¸åŸç†å›¾ LM7805 ä¸€è‡´ï¼š1=IN 2=GND 3=OUT */
function defTO2203(): PcbFootprintDef {
  return {
    id: 'FP_TO2203',
    name: 'TO-220-3',
    description: '3-pin linear regulator (TO-220)',
    pads: [
      thPad('1', -90, 0, 40, 70),
      thPad('2', 0, 90, 40, 70),
      thPad('3', 90, 0, 40, 70)
    ],
