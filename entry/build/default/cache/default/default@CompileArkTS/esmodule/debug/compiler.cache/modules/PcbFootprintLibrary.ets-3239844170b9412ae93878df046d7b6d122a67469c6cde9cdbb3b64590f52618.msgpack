import { IdUtil } from './IdUtil';
import { PcbPadShape, PcbPadType, PcbLayerId } from '../types/PcbTypes';
const MIL = 1;
function smdPad(num, x, y, w, h) {
    return {
        id: IdUtil.generate('pad'),
        number: num,
        type: PcbPadType.SMD,
        shape: PcbPadShape.RECT,
        pos: { x: x * MIL, y: y * MIL },
        size: { x: w * MIL, y: h * MIL },
        layers: [PcbLayerId.F_CU, PcbLayerId.F_MASK]
    };
}
function thPad(num, x, y, drill, outer) {
    return {
        id: IdUtil.generate('pad'),
        number: num,
        type: PcbPadType.TH,
        shape: PcbPadShape.CIRCLE,
        pos: { x: x * MIL, y: y * MIL },
        size: { x: outer * MIL, y: outer * MIL },
        drill: drill * MIL,
        layers: [PcbLayerId.F_CU, PcbLayerId.B_CU]
    };
}
function rectSilk(halfW, halfH) {
    return [[
            { x: -halfW, y: -halfH }, { x: halfW, y: -halfH },
            { x: halfW, y: halfH }, { x: -halfW, y: halfH }, { x: -halfW, y: -halfH }
        ]];
}
