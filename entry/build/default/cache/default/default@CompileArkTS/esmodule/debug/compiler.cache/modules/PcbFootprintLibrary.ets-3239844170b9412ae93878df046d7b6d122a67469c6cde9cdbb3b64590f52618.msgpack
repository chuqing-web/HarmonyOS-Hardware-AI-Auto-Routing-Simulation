        description: 'Corner mounting hole',
        pads: [thPad('1', 0, 0, 32, 40)],
        silkLines: [
            [{ x: -22, y: 0 }, { x: 22, y: 0 }],
            [{ x: 0, y: -22 }, { x: 0, y: 22 }]
        ],
