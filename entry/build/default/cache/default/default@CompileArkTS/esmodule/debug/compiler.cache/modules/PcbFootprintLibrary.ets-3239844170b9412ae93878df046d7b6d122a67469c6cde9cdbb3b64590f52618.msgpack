    // ä¸ tools/pcb_templates ä¸€è‡´ï¼šç´§å‡‘å­”ï¼Œä¸­å¿ƒå¯è´´åˆ°è·è¾¹â‰ˆåŠç„Šç›˜å¤„
    return {
        id: 'FP_MOUNT',
