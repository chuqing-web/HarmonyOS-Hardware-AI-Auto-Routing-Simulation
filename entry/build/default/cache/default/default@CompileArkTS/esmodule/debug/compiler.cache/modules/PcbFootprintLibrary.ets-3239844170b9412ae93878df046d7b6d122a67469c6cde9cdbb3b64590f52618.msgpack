    resolveFootprintId(footprintStr, libraryId) {
        const fp = footprintStr.toLowerCase();
        const lib = libraryId.toLowerCase();
        // --- SMD ç‰‡å¼å°ºå¯¸ ---
        if (fp.includes('0402') || fp.includes('1005'))
            return 'FP_0402';
        if (fp.includes('0603') || fp.includes('1608'))
            return 'FP_0603';
        if (fp.includes('0805') || fp.includes('2012'))
            return 'FP_0805';
        if (fp.includes('1206') || fp.includes('3216'))
            return 'FP_1206';
        // --- å°è£…å­—ç¬¦ä¸²æ˜¾å¼åŒ¹é… ---
        if (fp.includes('to-220') || fp.includes('to220'))
            return 'FP_TO2203';
        if (fp.includes('to-92') || fp.includes('to92'))
            return 'FP_TO92';
        if (fp.includes('sot') && fp.includes('23'))
            return 'FP_SOT23';
        if (fp.includes('tssop') && (fp.includes('20') || fp.includes('-20')))
            return 'FP_TSSOP20';
        if (fp.includes('qfp') && fp.includes('100'))
            return 'FP_QFP100';
        if (fp.includes('qfp') && fp.includes('64'))
            return 'FP_QFP64';
        if (fp.includes('qfp') && fp.includes('48'))
            return 'FP_QFP48';
        if (fp.includes('qfp') && fp.includes('44'))
            return 'FP_QFP44';
        if (fp.includes('soic') && (fp.includes('8') || fp.includes('-8')))
            return 'FP_SOIC8';
        if (fp.includes('dip') && fp.includes('40'))
            return 'FP_DIP40';
        if (fp.includes('dip') && fp.includes('28'))
            return 'FP_DIP28';
        if (fp.includes('dip') && fp.includes('16'))
            return 'FP_DIP16';
        if (fp.includes('dip') && fp.includes('14'))
            return 'FP_DIP14';
        if (fp.includes('dip') && fp.includes('8'))
            return 'FP_DIP8';
        if (fp.includes('dip') || fp.includes('pdip'))
            return 'FP_DIP8';
        // --- libraryId ç²¾å‡†åŒ¹é… ---
        // ç”µæº/ä¿¡å·ç«¯å­
        if (lib === 'vcc' || lib === 'gnd' || lib === 'vee' || lib === 'vac' || lib === 'signal_gen') {
            return 'FP_TERMINAL2';
        }
        // ç”µé˜»ç³»åˆ—
        if (lib.startsWith('r_'))
            return 'FP_0805';
        // ç”µå®¹ç³»åˆ—
        if (lib.startsWith('c_')) {
            if (lib === 'c_10uf' || lib === 'c_100uf')
                return 'FP_RADIAL_CAP';
            return 'FP_0805';
        }
        // ç”µæ„Ÿ
        if (lib.startsWith('l_'))
            return 'FP_AXIAL_IND';
        // æ™¶æŒ¯
        if (lib.startsWith('xtal_'))
            return 'FP_XTAL2';
        // ä¿é™©ä¸
        if (lib.startsWith('fuse_'))
            return 'FP_FUSE';
        // LED
        if (lib.startsWith('led_'))
            return 'FP_LED5';
        // äºŒæç®¡
        if (lib === '1n4148' || lib === '1n4007' || lib === '1n5819')
            return 'FP_AXIAL_DIODE';
        // ä¸‰æç®¡ TO-92 å°è£…
        if (lib === '2n2222' || lib === '2n2907')
            return 'FP_TO92';
        // MOSFET
        if (lib === '2n7000')
            return 'FP_TO92';
        if (lib === 'irf540')
            return 'FP_TO2203';
        // æ¨¡æ‹Ÿ IC
        if (lib === 'lm555')
            return 'FP_DIP8';
        if (lib === 'ua741' || lib === 'lm358' || lib === 'tl082')
            return 'FP_DIP8';
        // ç”µæºç®¡ç† IC
        if (lib === 'lm7805' || lib === 'lm7812')
            return 'FP_TO2203';
        if (lib === 'ams1117_3v3')
            return 'FP_SOT23';
        if (lib === 'lm2596')
            return 'FP_TO2203';
        // æ•°å­—é€»è¾‘ IC
        if (lib.startsWith('74hc'))
            return 'FP_DIP14';
        if (lib === 'cd4017')
            return 'FP_DIP16';
        // å­˜å‚¨å™¨
        if (lib === '2764' || lib === '62256')
            return 'FP_DIP28';
        if (lib === '24c02')
            return 'FP_SOP8';
        if (lib === 'w25q64')
            return 'FP_SOIC8W';
        // 8051 MCU
        if (lib === 'at89c51' || lib === 'at89c52' || lib === 'stc89c52')
            return 'FP_DIP40';
        if (lib === 'stc15w408as')
            return 'FP_QFP44';
        // STM32 MCU
        if (lib === 'stm32f103c8')
            return 'FP_QFP48';
        if (lib === 'stm32f103rc')
            return 'FP_QFP64';
        if (lib === 'stm32f407vg')
            return 'FP_QFP100';
        if (lib === 'stm32l431cb' || lib === 'stm32f030f4')
            return 'FP_TSSOP20';
        // å¼€å…³
        if (lib === 'sw_push')
            return 'FP_SW_PUSH';
        // ç»§ç”µå™¨
        if (lib.startsWith('relay_'))
            return 'FP_RELAY_SPDT';
        // èœ‚é¸£å™¨
        if (lib === 'buzzer')
            return 'FP_BUZZER';
        // æ˜¾ç¤ºå±
        if (lib === 'lcd1602' || lib.startsWith('lcd'))
            return 'FP_LCD1602';
        if (lib === 'oled_12864' || lib.startsWith('oled'))
            return 'FP_OLED';
        // ä¼ æ„Ÿå™¨
        if (lib === 'ds18b20')
            return 'FP_TO92_SENSOR';
        if (lib === 'hall_sensor')
            return 'FP_TO92_SENSOR';
        if (lib === 'ldr')
            return 'FP_LDR';
        // ä»ªå™¨æ¢é’ˆ
        if (lib === 'oscilloscope' || lib === 'virtual_meter' || lib === 'voltmeter_dc' ||
            lib === 'ammeter_dc' || lib === 'power_meter' || lib === 'freq_counter' ||
            lib === 'logic_analyzer' || lib === 'uart_terminal') {
            return 'FP_INSTRUMENT';
        }
        // ç”µä½å™¨
        if (lib === 'pot_1k' || lib === 'pot_10k' || lib === 'pot_100k')
            return 'FP_POT3';
        // refDes å›é€€
        if (lib.startsWith('r_') || lib.startsWith('c_') || lib.startsWith('l_'))
            return 'FP_0805';
        if (lib.includes('fuse'))
            return 'FP_FUSE';
        if (lib.includes('led'))
            return 'FP_LED5';
        if (lib.includes('diode'))
            return 'FP_AXIAL_DIODE';
        if (lib.includes('transistor') || lib.includes('bjt') || lib.includes('mosfet'))
            return 'FP_SOT23';
        if (lib.includes('voltmeter') || lib.includes('ammeter') || lib.includes('multimeter') ||
            lib.includes('oscilloscope') || lib.includes('probe')) {
            return 'FP_INSTRUMENT';
        }
        if (lib.includes('ic') || lib.includes('mcu') || lib.includes('opamp'))
            return 'FP_SOIC8';
        if (lib.includes('conn') || lib.includes('header'))
            return 'FP_THT2';
        return 'FP_0805';
    }
    /** å…‹éš†å°è£…å®šä¹‰ç”Ÿæˆæ¿ä¸Šå®ä¾‹ï¼ˆæ·±æ‹·è´ç„Šç›˜ï¼‰ */
    instantiate(defId, refDes, value, pos, rotation = 0, schematicCompId) {
        const def = this.defs.get(defId) ?? this.defs.get('FP_0805');
        if (!def)
            return null;
        const pads = [];
        for (const p of def.pads) {
            pads.push({
                id: IdUtil.generate('pad'),
                number: p.number,
                type: p.type,
                shape: p.shape,
                pos: { x: p.pos.x, y: p.pos.y },
                size: { x: p.size.x, y: p.size.y },
                drill: p.drill,
                layers: [...p.layers]
            });
        }
        return {
            id: IdUtil.generate('fp'),
            defId: def.id,
            refDes,
            value,
            position: { x: pos.x, y: pos.y },
            rotation: (rotation % 360),
            mirrored: false,
            layer: PcbLayerId.F_CU,
            locked: false,
            pads,
            schematicCompId
        };
    }
    /** æŒ‰åº“å®šä¹‰åˆ·æ–°ç„Šç›˜å‡ ä½•ï¼Œä¿ç•™åŒå·ç„Šç›˜çš„ç½‘ç»œç»‘å®š */
    resyncPadsFromDef(inst, defId) {
        const targetId = defId ?? inst.defId;
        const def = this.defs.get(targetId) ?? this.defs.get('FP_0805');
        if (!def)
            return;
        const netByNumber = new Map();
        for (const p of inst.pads) {
            const preserved = { netId: p.netId, netName: p.netName };
            netByNumber.set(p.number, preserved);
        }
        const pads = [];
        for (const p of def.pads) {
            const preserved = netByNumber.get(p.number);
            pads.push({
                id: IdUtil.generate('pad'),
                number: p.number,
                type: p.type,
                shape: p.shape,
                pos: { x: p.pos.x, y: p.pos.y },
                size: { x: p.size.x, y: p.size.y },
                drill: p.drill,
                layers: [...p.layers],
                netId: preserved?.netId,
                netName: preserved?.netName
            });
        }
        inst.defId = def.id;
        inst.pads = pads;
    }
}
export function getGlobalPcbFootprintLibrary() {
    if (!globalPcbLib) {
        globalPcbLib = new PcbFootprintLibrary();
    }
    return globalPcbLib;
}
let globalPcbLib = null;
