            let flashMax = 0;
            let hasFlash = false;
            memoryMap.forEach((_val, addr) => {
                if (addr >= FLASH_BASE && addr < FLASH_BASE + MAX_COMPACT_IMAGE_BYTES) {
                    hasFlash = true;
                    if (addr < flashMin)
                        flashMin = addr;
