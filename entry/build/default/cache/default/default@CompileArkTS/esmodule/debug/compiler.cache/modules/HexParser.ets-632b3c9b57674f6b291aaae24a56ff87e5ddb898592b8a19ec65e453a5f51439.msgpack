import { HexSegment } from '../types/CommonTypes';

export interface HexParseResult {
  data: Uint8Array;
  segments: HexSegment[];
  entryPoint: number;
  minAddress: number;
  maxAddress: number;
  checksumOk: boolean;
  invalidLines: number;
