                    break;
                }
                case 0x01:
                    break;
                case 0x02:
                    extendedAddress = ((bytes[4] << 8) | bytes[5]) << 4;
                    break;
                case 0x04:
                    extendedAddress = ((bytes[4] << 8) | bytes[5]) << 16;
                    break;
                case 0x05:
                    entryPoint = (bytes[4] << 24) | (bytes[5] << 16) | (bytes[6] << 8) | bytes[7];
                    break;
                default:
                    break;
            }
