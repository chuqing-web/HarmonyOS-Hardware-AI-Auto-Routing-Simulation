  private static toLabTemplate(def: LabTemplateDef): LabTemplate {
    return {
      id: def.id,
      name: def.name,
      category: def.category,
      description: def.description,
      knowledgePoints: def.knowledgePoints,
      libraryIds: def.libraryIds,
      firmware: def.firmware,
