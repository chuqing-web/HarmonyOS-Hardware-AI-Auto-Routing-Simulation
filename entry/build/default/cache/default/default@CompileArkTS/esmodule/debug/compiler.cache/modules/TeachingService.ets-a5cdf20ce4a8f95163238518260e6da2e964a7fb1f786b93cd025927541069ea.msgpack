      const n = topo.netList[i];
      let hit = false;
      for (let j = 0; j < (n.nodeList?.length ?? 0); j++) {
        if (n.nodeList[j].devUuid === selectedUuid) {
          hit = true;
          break;
        }
      }
      if (!hit) {
        continue;
      }
      const pins: string[] = [];
      for (let j = 0; j < (n.nodeList?.length ?? 0) && pins.length < 8; j++) {
        const node = n.nodeList[j];
