        return def.hexFile;
    }
    getTemplateFirmware(templateId) {
        const def = LabTemplateRegistry.findById(templateId);
        if (def === undefined || def.firmware === undefined) {
            return null;
        }
        if (def.firmware === '8051') {
            return TeachingService.FW_51;
        }
        if (def.firmware === 'STM32') {
