export class TeachingService {
    static toLabTemplate(def) {
        return {
            id: def.id,
            name: def.name,
            category: def.category,
            description: def.description,
            knowledgePoints: def.knowledgePoints,
            libraryIds: def.libraryIds,
            firmware: def.firmware,
            hexFile: def.hexFile
