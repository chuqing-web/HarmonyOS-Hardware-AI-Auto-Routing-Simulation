            `ã€å™¨ä»¶ä½¿ç”¨è¯´æ˜ã€‘\n${DeviceUsageManual.formatEntry(usage, 'full')}\n\n` +
            `ã€ç›¸å…³ç½‘ç»œã€‘\n${neighbors.length > 0 ? neighbors.join('\n') : '(æ— è¿æ¥ä¿¡æ¯)'}`;
    }
}
