        const neighbors = [];
        for (let i = 0; i < topo.netList.length; i++) {
            const n = topo.netList[i];
            let hit = false;
            for (let j = 0; j < (n.nodeList?.length ?? 0); j++) {
                if (n.nodeList[j].devUuid === selectedUuid) {
                    hit = true;
                    break;
                }
