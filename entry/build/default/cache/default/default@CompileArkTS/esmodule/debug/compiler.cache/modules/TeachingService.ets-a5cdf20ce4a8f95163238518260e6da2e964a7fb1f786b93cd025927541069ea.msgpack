                `ç¦ä¾‹: ${manual.forbidden}\nå‚æ•°: ${manual.params}\nä»¿çœŸ: ${manual.simNotes}`
        };
    }
    stepPowerOnSequence(topo, stepIndex) {
        const result = mapAwareParse(mapAwareStringify(topo));
        const powerNets = result.netList.filter(n => n.isPower);
        for (let i = 0; i <= stepIndex && i < powerNets.length; i++) {
            powerNets[i].defaultVoltage = 5.0;
        }
        return result;
    }
    buildAiQuestion(topo, selectedUuid) {
        const dev = topo.deviceList.find(d => d.instUuid === selectedUuid);
