export class Pcb3dMeshBuilder {
    static build(doc, maxTris = Pcb3dMeshBuilder.MAX_TRIS) {
        const mesh = new Mesh3d();
        mesh.name = doc.name;
        const outline = doc.boardOutline.points;
        if (outline.length < 3)
            return mesh;
