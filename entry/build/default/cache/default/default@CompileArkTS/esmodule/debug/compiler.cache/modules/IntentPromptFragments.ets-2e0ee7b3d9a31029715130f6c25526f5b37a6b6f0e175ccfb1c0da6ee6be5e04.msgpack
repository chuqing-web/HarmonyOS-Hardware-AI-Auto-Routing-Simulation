- GND: U.GND + C_timing.2 + C_ctrl.2 + LED.K + SW.1
- 555_RC: U.THRES + U.DISCH + R_timing.2 + C_timing.1（THRES≡DISCH，禁止贴 GND）
- TRIG_NET: U.TRIG + R_pull.2 + SW.2（按键拉低触发；禁止 C_ctrl 挂 TRIG）
- CTRL_NET: U.CTRL + C_ctrl.1（仅旁路，禁止与 TRIG 同网）
- OUT_NET: U.OUT + R_led.1；LED_DRIVE: R_led.2 + LED.A
- 【硬禁】禁止 VCC→SW→R→C→GND 串联 RC；禁止 THRES/DISCH 直接接 GND`;
export const FRAG_NET_555_ASTABLE = `
【555 无稳态接线 — 硬·脚级清单 — edit/net_plan 必须逐条满足】:
- VCC: U.VCC + U.RESET + Ra.1（Ra=较小定时电阻如 R_1k；仅 Ra 高端接 VCC）
- GND: U.GND + C_timing.2 + C_ctrl.2 + (C_decouple.2) + LED.K + OSC.GND
- 555_DISCH: U.DISCH + Ra.2 + Rb.1（仅此三脚；禁止 RESET/VCC/THRES 进本网）
- 555_THRES_TRIG: U.THRES + U.TRIG + Rb.2 + C_timing.1（THRES≡TRIG；禁止贴 GND；禁止 DISCH 进本网）
- 555_CTRL: U.CTRL + C_ctrl.1（仅旁路；禁止与 TRIG/THRES/DISCH 同网）
- （可选）VCC 去耦: C_decouple.1→VCC，C_decouple.2→GND（禁止挂到信号网）
- 555_OUT: U.OUT + R_led.1 (+ OSC.CH1)；LED_ANODE: R_led.2 + LED.A
- 示波器：CH1∥555_OUT；GND→GND；教学可 CH2∥THRES_TRIG、CH3∥DISCH、CH4∥CTRL（并入同名网）
- 【硬禁】禁止两颗定时 R 都接 VCC；禁止 Ra 接到 THRES 而绕过 DISCH；禁止 Rb 高端接 VCC
- 【硬禁】禁止 RESET≡DISCH；禁止 VCC→SW→R→C→GND 串联 RC；禁止另建无 DUT 的 *_SENSE 单脚网
- 【edit·硬】removeNetNames 不得包含仍出现在 nets 中的网名`;
export const FRAG_NET_OPAMP = `
【运放】UA741 用 IN+/IN-/OUT/VCC/VEE；LM358/TL082 用通道脚 OUT1/IN±1…；必须闭环；双电源时 VEE/V-→VEE（勿接 GND）；双运放未用半边接跟随`;
export const FRAG_NET_INTEGRATOR = `
【运放积分】SIG.OUT→R→IN-；IN+→GND；C 跨 OUT↔IN-；OUT→OSC.CH2；SIG.OUT→OSC.CH1；
单电源电源仅 VCC/GND（V-→GND），双电源 VCC/VEE/GND 分网。
禁止 RC 充放电拓扑；未用运放半边 IN-↔OUT、IN+→GND`;
export const FRAG_NET_SELF_OSC_HYST_INT = `
【自激振荡网】比较器 OUT（方波）→R→积分 IN-；C 跨积分 OUT↔IN-；积分 OUT 反馈→比较器输入；
网名推荐 SQUARE_OUT / TRIANGLE_OUT（或 TRI_OUT）；滞回 Rf/Rg 与 Rin 须入网（禁浮空电阻）。
OSC.CH1→SQUARE_OUT，OSC.CH2→TRIANGLE_OUT，GND→GND；【硬禁】CH∩GND、CH1∩CH2 同网。
VEE 符号只入 VEE 网（位号=VEE）；双电源 VCC/VEE/GND 分网。禁止 SIGNAL_GEN`;
export const FRAG_NET_DUAL = `
【双电源网】独立网名 VCC 与 VEE；VCC 符号→VCC 网，VEE 符号→VEE 网，GND→GND；禁止 VCC/VEE 同网`;
export const FRAG_NET_SIGNAL_GEN = `
【SIGNAL_GEN】OUT 并入激励信号网；GND→GND；可用 OSC CH1 观测同一信号网`;
export const FRAG_NET_HYSTERESIS = `
【滞回整形】SIGNAL_GEN.OUT→运放输入；正反馈 HYST 网；OSC 观 OUT。
SIGNAL_GEN amplitude 须 ≥2V（推荐 5V），禁止 1V 峰（越过不了负阈值）`;
export const FRAG_NET_INSTR = `
【仪器】测量脚并入被测信号网同名；禁止另建 PROBE 网重复 DUT 脚`;
export function assembleDeviceSelectSystem(intent, userPrompt = '', libIds = []) {
    let s = DEVICE_SELECT_BASE;
    if (intent.needsPowerRails) {
        s += FRAG_POWER_RAILS;
    }
    if (intent.dualSupply) {
        s += FRAG_DUAL_SUPPLY;
    }
    else if (intent.needsOpAmpFeedback || intent.needsOpAmpIntegrator) {
        s += FRAG_SINGLE_SUPPLY;
    }
    if (intent.needsSignalGen) {
        s += FRAG_SIGNAL_GEN;
    }
    if (intent.needsHysteresisComparator && intent.needsSignalGen) {
        s += FRAG_HYSTERESIS_SIG;
    }
    if (intent.hasMcuMinSystem) {
        s += FRAG_MCU_MIN;
    }
    if (intent.needsLedSeriesR) {
        s += FRAG_LED_SERIES_R;
    }
    if (intent.needsOpAmpFeedback) {
        s += FRAG_OPAMP;
    }
    if (intent.needsOpAmpIntegrator) {
        // 自激闭环：用专用片段，禁止再注入「必须 SIGNAL_GEN」的积分示教配方
        if (intent.needsSignalGen) {
            s += FRAG_INTEGRATOR;
        }
        else {
            s += FRAG_SELF_OSC_HYST_INT;
        }
    }
    if (intent.needsI2cPullup) {
        s += FRAG_I2C;
    }
    if (intent.mutualLedIndicator) {
        s += FRAG_MUTUAL_LED;
    }
    if (intent.blinkOscillator) {
        s += FRAG_BLINK_OK;
    }
    if (intent.timer555Monostable) {
        s += FRAG_555_MONOSTABLE;
    }
    else if (intent.timer555Astable || intent.reasons.indexOf('555_astable') >= 0) {
        s += FRAG_555_ASTABLE;
    }
    if (intent.seriesRcCharge && !intent.timer555Monostable && !intent.timer555Astable) {
        s += FRAG_SERIES_RC;
    }
    if (intent.hasInstruments) {
        s += FRAG_INSTRUMENTS_SELECT;
        s += FRAG_INSTR_DETAIL_SELECT;
    }
    // 关键词族片段（尚无 BOM）+ 板上/已有 libId 片段（edit 增量选型）
    s += assemblePromptKeywordFragments(userPrompt);
    if (libIds && libIds.length > 0) {
        s += assembleLibIdFragments(libIds, 'select');
    }
    return s;
}
export function assembleNetPlanSystem(intent, libIds = []) {
    let s = NET_PLAN_BASE;
    if (intent.hasMcuMinSystem) {
        s += FRAG_NET_MCU;
    }
    if (intent.needsLedSeriesR) {
        s += FRAG_NET_LED;
    }
    if (intent.mutualLedIndicator && !intent.seriesRcCharge) {
        s += FRAG_NET_MUTUAL;
    }
    if (intent.blinkOscillator) {
        s += FRAG_NET_BLINK;
    }
    if (intent.timer555Monostable) {
        s += FRAG_NET_555_MONOSTABLE;
    }
    else if (intent.timer555Astable) {
        s += FRAG_NET_555_ASTABLE;
    }
    if (intent.seriesRcCharge && !intent.timer555Monostable && !intent.timer555Astable) {
        s += FRAG_NET_SERIES_RC;
    }
    if (intent.needsOpAmpFeedback) {
        s += FRAG_NET_OPAMP;
    }
    if (intent.needsOpAmpIntegrator) {
        if (intent.needsSignalGen) {
            s += FRAG_NET_INTEGRATOR;
        }
        else {
            s += FRAG_NET_SELF_OSC_HYST_INT;
        }
    }
    if (intent.dualSupply) {
        s += FRAG_NET_DUAL;
    }
    if (intent.needsSignalGen) {
        s += FRAG_NET_SIGNAL_GEN;
    }
    if (intent.needsHysteresisComparator && intent.needsSignalGen) {
        s += FRAG_NET_HYSTERESIS;
    }
    if (intent.hasInstruments) {
        s += FRAG_NET_INSTR;
        s += FRAG_INSTR_DETAIL_NET;
    }
    // 按板上实际型号注入脚级片段（全库覆盖）
    if (libIds && libIds.length > 0) {
        s += assembleLibIdFragments(libIds, 'net');
    }
    return s;
}
