export function assembleDeviceSelectSystem(intent) {
    let s = DEVICE_SELECT_BASE;
    if (intent.needsPowerRails) {
        s += FRAG_POWER_RAILS;
    }
    if (intent.hasMcuMinSystem) {
        s += FRAG_MCU_MIN;
    }
    if (intent.needsLedSeriesR) {
        s += FRAG_LED_SERIES_R;
    }
    if (intent.needsOpAmpFeedback) {
        s += FRAG_OPAMP;
    }
    if (intent.needsI2cPullup) {
        s += FRAG_I2C;
    }
    if (intent.mutualLedIndicator) {
        s += FRAG_MUTUAL_LED;
    }
    if (intent.blinkOscillator) {
        s += FRAG_BLINK_OK;
    }
    if (intent.hasInstruments) {
        s += FRAG_INSTRUMENTS_SELECT;
    }
    return s;
}
export function assembleNetPlanSystem(intent) {
    let s = NET_PLAN_BASE;
    if (intent.hasMcuMinSystem) {
        s += FRAG_NET_MCU;
    }
    if (intent.needsLedSeriesR) {
        s += FRAG_NET_LED;
    }
    if (intent.mutualLedIndicator || intent.relayContactTopo) {
        s += FRAG_NET_MUTUAL;
    }
    if (intent.blinkOscillator) {
        s += FRAG_NET_BLINK;
    }
    if (intent.needsOpAmpFeedback) {
        s += FRAG_NET_OPAMP;
    }
    if (intent.hasInstruments) {
        s += FRAG_NET_INSTR;
    }
    return s;
}
