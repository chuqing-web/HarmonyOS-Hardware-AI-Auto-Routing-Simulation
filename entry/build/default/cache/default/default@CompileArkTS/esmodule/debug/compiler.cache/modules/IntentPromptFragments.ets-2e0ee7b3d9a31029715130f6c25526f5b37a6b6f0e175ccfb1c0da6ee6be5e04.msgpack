【运放】UA741 用 IN+/IN-/OUT/VCC/VEE；LM358/TL082 用通道脚 OUT1/IN±1…；必须闭环；双电源时 VEE/V-→VEE（勿接 GND）；双运放未用半边接跟随`;
export const FRAG_NET_INTEGRATOR = `
【运放积分】SIG.OUT→R→IN-；IN+→GND；C 跨 OUT↔IN-；OUT→OSC.CH2；SIG.OUT→OSC.CH1；电源 VCC/VEE/GND 分网。
禁止 RC 充放电拓扑；未用运放半边 IN-↔OUT、IN+→GND`;
export const FRAG_NET_SELF_OSC_HYST_INT = `
【自激振荡网】比较器 OUT（方波）→R→积分 IN-；C 跨积分 OUT↔IN-；积分 OUT 反馈→比较器输入；
OSC.CH1→方波网，OSC.CH2→三角网，GND→GND；电源 VCC/VEE/GND。禁止 SIGNAL_GEN`;
export const FRAG_NET_DUAL = `
【双电源网】独立网名 VCC 与 VEE；VCC 符号→VCC 网，VEE 符号→VEE 网，GND→GND；禁止 VCC/VEE 同网`;
export const FRAG_NET_SIGNAL_GEN = `
【SIGNAL_GEN】OUT 并入激励信号网；GND→GND；可用 OSC CH1 观测同一信号网`;
export const FRAG_NET_HYSTERESIS = `
【滞回整形】SIGNAL_GEN.OUT→运放输入；正反馈 HYST 网；OSC 观 OUT。
SIGNAL_GEN amplitude 须 ≥2V（推荐 5V），禁止 1V 峰（越过不了负阈值）`;
export const FRAG_NET_INSTR = `
【仪器】测量脚并入被测信号网同名；禁止另建 PROBE 网重复 DUT 脚`;
export function assembleDeviceSelectSystem(intent, userPrompt = '', libIds = []) {
    let s = DEVICE_SELECT_BASE;
    if (intent.needsPowerRails) {
        s += FRAG_POWER_RAILS;
    }
    if (intent.dualSupply) {
        s += FRAG_DUAL_SUPPLY;
    }
    if (intent.needsSignalGen) {
        s += FRAG_SIGNAL_GEN;
    }
    if (intent.needsHysteresisComparator && intent.needsSignalGen) {
        s += FRAG_HYSTERESIS_SIG;
    }
    if (intent.hasMcuMinSystem) {
        s += FRAG_MCU_MIN;
    }
    if (intent.needsLedSeriesR) {
        s += FRAG_LED_SERIES_R;
    }
    if (intent.needsOpAmpFeedback) {
        s += FRAG_OPAMP;
    }
    if (intent.needsOpAmpIntegrator) {
        // 自激闭环：用专用片段，禁止再注入「必须 SIGNAL_GEN」的积分示教配方
        if (intent.needsSignalGen) {
            s += FRAG_INTEGRATOR;
        }
        else {
            s += FRAG_SELF_OSC_HYST_INT;
        }
    }
    if (intent.needsI2cPullup) {
        s += FRAG_I2C;
    }
    if (intent.mutualLedIndicator) {
        s += FRAG_MUTUAL_LED;
    }
    if (intent.blinkOscillator) {
        s += FRAG_BLINK_OK;
    }
    if (intent.timer555Monostable) {
        s += FRAG_555_MONOSTABLE;
    }
    else if (intent.timer555Astable || intent.reasons.indexOf('555_astable') >= 0) {
        s += FRAG_555_ASTABLE;
    }
    if (intent.seriesRcCharge && !intent.timer555Monostable && !intent.timer555Astable) {
        s += FRAG_SERIES_RC;
    }
    if (intent.hasInstruments) {
        s += FRAG_INSTRUMENTS_SELECT;
        s += FRAG_INSTR_DETAIL_SELECT;
    }
    // 关键词族片段（尚无 BOM）+ 板上/已有 libId 片段（edit 增量选型）
    s += assemblePromptKeywordFragments(userPrompt);
    if (libIds && libIds.length > 0) {
        s += assembleLibIdFragments(libIds, 'select');
    }
    return s;
}
export function assembleNetPlanSystem(intent, libIds = []) {
    let s = NET_PLAN_BASE;
    if (intent.hasMcuMinSystem) {
        s += FRAG_NET_MCU;
    }
    if (intent.needsLedSeriesR) {
        s += FRAG_NET_LED;
    }
    if (intent.mutualLedIndicator && !intent.seriesRcCharge) {
        s += FRAG_NET_MUTUAL;
    }
    if (intent.blinkOscillator) {
        s += FRAG_NET_BLINK;
    }
    if (intent.timer555Monostable) {
        s += FRAG_NET_555_MONOSTABLE;
    }
    else if (intent.timer555Astable) {
        s += FRAG_NET_555_ASTABLE;
    }
    if (intent.seriesRcCharge && !intent.timer555Monostable && !intent.timer555Astable) {
        s += FRAG_NET_SERIES_RC;
    }
    if (intent.needsOpAmpFeedback) {
        s += FRAG_NET_OPAMP;
    }
    if (intent.needsOpAmpIntegrator) {
        if (intent.needsSignalGen) {
            s += FRAG_NET_INTEGRATOR;
        }
        else {
            s += FRAG_NET_SELF_OSC_HYST_INT;
        }
    }
    if (intent.dualSupply) {
        s += FRAG_NET_DUAL;
    }
    if (intent.needsSignalGen) {
        s += FRAG_NET_SIGNAL_GEN;
    }
    if (intent.needsHysteresisComparator && intent.needsSignalGen) {
        s += FRAG_NET_HYSTERESIS;
    }
    if (intent.hasInstruments) {
        s += FRAG_NET_INSTR;
        s += FRAG_INSTR_DETAIL_NET;
    }
    // 按板上实际型号注入脚级片段（全库覆盖）
    if (libIds && libIds.length > 0) {
        s += assembleLibIdFragments(libIds, 'net');
    }
    return s;
}
//# sourceMappingURL=IntentPromptFragments.js.map�lC:\Projects\ElecDraw_Harmony\features\ai_engine\src\main\ets\prompts\templates\DeviceInstrumentFragments.ets�hC:\Projects\ElecDraw_Harmony\features\ai_engine\src\main\ets\prompts\templates\IntentPromptFragments.ets�rB��moduleName�isLocalDependency�isNodeEntryFile�pkgPath�belongProjectPath�pkgName�pkgVersion�dependencyPkgInfo�hostModulesInfo�belongModulePath�shouldEmitJs�ai_engine���/C:\Projects\ElecDraw_Harmony\features\ai_engine�C:\Projects\ElecDraw_Harmony�ai_engine�1.0.0�rC��pkgName�pkgVersion�ai_engine�1.0.0��rD��hostDependencyName�hostModuleName�*../prompts/templates/IntentPromptFragments�ai_engineD�!./templates/IntentPromptFragments�ai_engine�/C:\Projects\ElecDraw_Harmony\features\ai_engine���P/**
 * 按 CircuitIntent 组装的 prompt 条件片段（默认骨架 + 命中才注入）
 */
import { CircuitIntent } from '../../algorithms/CircuitIntent';
import {
  assembleLibIdFragments, assemblePromptKeywordFragments,
  FRAG_INSTR_DETAIL_SELECT, FRAG_INSTR_DETAIL_NET
} from './DeviceInstrumentFragments';

export const DEVICE_SELECT_BASE: string = `你是资深硬件工程师。根据用户需求拆解电路功能模块与器件需求。

【最高优先级】你的整段回复只能是一个 JSON 对象（以 { 开头、以 } 结尾）。禁止先写分析再贴 JSON，禁止 markdown 代码围栏。

【核心拓扑铁律 — 严禁违反】:
1. 电流表(AMMETER_DC)必须串联在电源回路: VCC→I+→I-→负载。绝不并联！
2. 电压表(VOLTMETER_DC)必须分布在不同节点: N块表各自测量不同电阻的压降
3. 所有仪器统一使用网络标号，禁止长导线连接仪器
4. 电源名(VCC/GND)绝不能用于非电源网络

【输出规则】:
1. 只输出器件大类、功能描述、参数区间
2. 【硬】每个器件必须填 explicitModel，且必须是注入清单中的精确 libDevId
3. 陌生或无法归类的需求写入 oodFlags，禁止猜测编造
4. 电阻器件必须尽量指定 explicitModel (如 R_1k, R_10k, R_4.7k)，不要只写 "Resistor"
5. 简单电路不要追加电压表/电流表/滤波电容，除非用户明确要求或意图需要仪器
6. 【硬·电参由你决定并写入 param_constraint】电源与激励不可省略数值：
   - VCC → {"voltage":"5V"|"3.3V"|"12V"|…}（按电路需求选，运放双电源默认 12V）
   - VEE → {"voltage":"-12V"|"-5V"|…}（与 |VCC| 对称）
   - SIGNAL_GEN → 必须含 waveform、amplitude、frequency、offset、dutyCycle（幅度按门限/增益选，勿盲目抄库默认 1V）
   - 用户写明数值时原样采用；未写明时由你按拓扑给出合理默认并写进 JSON

【防幻觉规则】:
- 禁止编造库外型号
- 不确定的器件放入 oodFlags，不要猜测

【多轮对话编辑模式】:
- 如果 generation_mode=edit，必须在现有器件基础上增量修改，不要从零重建
- 参考 conversation_history 理解上下文，只调整用户要求变更的部分
- 保留未涉及修改的现有器件

输出纯 JSON（可用 snake_case 或 camelCase），无 markdown；第一字符 { 最后字符 }。
Schema: {"function_module":["..."],"device_require_list":[{"func":"...","dev_type":"...","param_constraint":{},"priority":1-10,"explicitModel":"..."|null}],"circuit_constraint":"...","oodFlags":["..."]}`;

export const FRAG_POWER_RAILS: string = `
【强制电源符号】:
- 必须输出 VCC: {"func":"电源正极","dev_type":"VCC","param_constraint":{"voltage":"5V"},"priority":10,"explicitModel":"VCC"}
- 必须输出 GND: {"func":"电源地","dev_type":"GND","param_constraint":{},"priority":10,"explicitModel":"GND"}
- 【决定电压】用户指定则写精确值；MCU/数字默认 "5V" 或 "3.3V"；运放双电源默认 "12V"；禁止空 {} 省略 voltage`;

export const FRAG_DUAL_SUPPLY: string = `
【双电源 / VEE 负压 — 强制】:
- 必须额外输出 VEE: {"func":"电源负极","dev_type":"VEE","param_constraint":{"voltage":"-12V"},"priority":10,"explicitModel":"VEE"}
- 【决定对称轨】同时将 VCC 的 voltage 改为与 |VEE| 对称（默认 VCC "12V" + VEE "-12V"；禁止 VCC 仍写 "5V" 配 VEE "-12V"）
- 运放 VCC/V+→VCC 网，VEE/V-→VEE 网（禁止把 VEE 接到 GND，除非用户明确单电源）
- 用户写 ±15V/±12V/±5V 时同步改 VCC 与 VEE 的 voltage`;

export const FRAG_SIGNAL_GEN: string = `
【信号发生器 SIGNAL_GEN】用户要求**外接**正弦/方波/三角/锯齿/脉冲激励时:
- 输出 SIGNAL_GEN: param_constraint 必须含 waveform、amplitude、frequency、offset、dutyCycle（全部由你决定并写出数值）
- frequency 按用户指定（如 1kHz/10kHz），未指定默认 "1kHz"；dutyCycle 对方波/脉冲有效，默认 "50%"
- amplitude：按被激励电路决定（普通小信号可用 "1V"；滞回/比较器整形须 ≥"2V"，推荐 "5V"）
- waveform 以「输入/激励/信号源」为准；若同时出现「正弦输入」与「整形/输出方波」，waveform 必须写 sine
- 拓扑: OUT→被激励节点，GND→GND；可用示波器观测
- 【硬禁】闭环自激/弛张振荡（滞回+积分）禁止输出 SIGNAL_GEN`;

export const FRAG_HYSTERESIS_SIG: string = `
【滞回/施密特整形 — SIGNAL_GEN 幅度强制】正反馈比较器阈值 ≈ ±β·|Vsat|（β=Rg/(Rf+Rg)）:
- param_constraint.amplitude 必须 ≥2V，推荐 "5V"；禁止写 "1V"（库默认会锁死单轨，示波器只见一次边沿后平线）
- 用户未指定幅度时写 amplitude:"5V"；waveform 写 sine（激励），勿把「输出方波」写成信号源方波
- 同步 Rf≈100k、Rg≈10k、VCC/VEE 对称 ±12V`;

export const FRAG_MCU_MIN: string = `
【MCU 最小系统】必须包含: 晶振、去耦电容(C_100nF)、复位上拉电阻(R_10k)、VCC、GND`;

export const FRAG_LED_SERIES_R: string = `
【LED / LED灯 选型与限流】
- 口语「LED」「LED灯」「指示灯」同一类：库内仅 LED_RED / LED_GREEN / LED_BLUE（两脚 A/K）
- 禁止把「LED灯」写成库外 libDevId；禁止用 OLED_12864 冒充指示灯
- 颜色：红→LED_RED，绿→LED_GREEN，蓝→LED_BLUE；未指颜色默认 LED_RED
- 必须配对限流电阻（优先 R_330）；N 颗 LED 配 N 颗电阻`;

export const FRAG_OPAMP: string = `
【运放选型·普通单运放 vs 单片双运放】
- UA741=普通单运放（一片一颗）：真脚 IN+/IN-/OUT/VCC/VEE；单级放大/跟随/滞回/积分优先；须双电源 VCC+VEE（±12V）
- LM358/TL082=单片双运放（一片两路）：真脚 OUT1/IN±1/…/OUT2/V+/V-；单电源或两路需求选 LM358；高阻双电源积分选 TL082
- 禁止把 UA741 当双运放，也禁止把 LM358 按 UA741 五脚符号连线
【运放接法】必须闭环反馈，输入不可浮空；滞回须正反馈（OUT→Rf→IN+，IN+→Rg→GND）；Rf/Rg≈10:1 或激励≥5V；双运放未用半边接跟随（IN-↔OUT，IN+→GND 或虚地）`;

export const FRAG_INTEGRATOR: string = `
【运放积分器 — 强制配方】方波→三角 / RC 积分观测时:
- 必须双电源: VCC voltage="12V" + VEE voltage="-12V" + GND（禁止单 5V）
- SIGNAL_GEN: waveform="square"，amplitude 推荐 "5V"，frequency 默认 "1kHz"，offset="0V"，dutyCycle="50%"
- 运放优先 UA741 或 TL082；积分电阻 R_10k、积分电容 C_100nF（τ≈1ms，与 1kHz 方波匹配）
- 拓扑: SIG.OUT→R→运放 IN-；IN+→GND；C 跨接 OUT↔IN-；可选 R_100k 并在 C 两端作直流复位
- 示波器 CH1→SIG.OUT（方波），CH2→运放 OUT（三角）；OSC.GND→GND
- 【硬禁】禁止当成串联 RC 充放电（VCC→SW→R→C）；禁止把「三角」写成信号源 waveform
- 双运放未用半边必须接跟随，禁止输入悬空`;

export const FRAG_SELF_OSC_HYST_INT: string = `
【运放自激振荡 — 滞回比较器 + 积分器闭环】:
- 必须双电源: VCC="12V" + VEE="-12V" + GND
- 【硬禁 SIGNAL_GEN】方波由滞回比较器自产，三角由积分器产生；禁止外接信号发生器
- 两片运放（UA741×2）或一片双运放（TL082/LM358）：一路滞回比较器，一路积分器
- 滞回: OUT→R_100k→IN+，IN+→R_10k→GND；积分: 方波经 R_10k→IN-，C_100nF 跨 OUT↔IN-，可选 R_100k 并 C
- 【硬】比较器 IN- 必须与积分 OUT（三角波）同网；积分器 IN+ 必须入 GND 网（≥2 脚）
- 【硬】禁止为 IN± 另建只有 1 连接的网（COMP_INV/INT_NON_INV 等）
- 示波器 CH1→方波 OUT，CH2→三角 OUT，GND→GND
- circuit_constraint 写明闭环自激，勿写 SIGNAL_GEN`;

export const FRAG_I2C: string = `
【I2C】必须配 4.7kΩ 上拉电阻（R_4.7k）`;

export const FRAG_MUTUAL_LED: string = `
【强制】开/闭两路互斥指示必须输出:
- RELAY_SPDT + SW_PUSH（仅驱线圈）+ LED_GREEN + LED_RED + 两颗 R_330 + VCC + GND
- SW_PUSH 仅 2 脚(SPST)，绝不能单独当作 SPDT
- circuit_constraint 写明: 断开→绿灯经 NC；闭合→红灯经 NO；COM→GND；线圈由 SW 驱动`;

export const FRAG_BLINK_OK: string = `
【闪烁/多谐/交替指示】电源开关(SW_PUSH)串联供电 + 振荡/驱动双灯交替闪烁是合法拓扑。
禁止套用「开/闭互斥双色 → RELAY_SPDT」规则；不要为闪烁电路强行加入继电器。`;

export const FRAG_555_ASTABLE: string = `
【555 无稳态多谐 — 强制配方】用户要 555/LM555 振荡/方波/闪烁时:
- explicitModel 必须用 LM555（禁止 NE555 等库外 ID）
- 定时: R_1k(或同类) 作 Ra（仅 VCC—DISCH）、R_10k 作 Rb（仅 DISCH—THRES≡TRIG）、C_*（仅 THRES/TRIG—GND）
- 【硬】追加至少一颗 C_100nF：CTRL 旁路到 GND（可再加一颗 VCC—C_100nF—GND 去耦）
- OUT→R_330→LED→GND；RESET→VCC；示波器 CH1→OUT、GND→GND
- 肉眼闪烁可选较大 C（如 C_10uF/C_100uF）；示波器观测优先 C_1uF（约几十 Hz，时基约 10ms/div）
- VCC param_constraint.voltage 写 "5V"（或用户指定）
- 【硬禁】禁止套用「串联 RC 充放电」配方（VCC→SW→R→C→GND）
- 【硬禁】禁止两颗定时电阻都接到 VCC；禁止 Ra/Rb 角色对调成「R 接 THRES、另一 R 接 VCC—DISCH」却漏 Rb→THRES
- 【硬禁】禁止 RESET 与 DISCH 同网；禁止去耦电容一端挂 THRES/DISCH 冒充测量`;

export const FRAG_555_MONOSTABLE: string = `
【555 单稳态延时 — 强制配方】用户要 555/LM555 单稳态/延时/按键触发时:
- explicitModel 必须用 LM555（禁止 NE555 等库外 ID）
- 定时: R_*（VCC—DISCH）、C_*（THRES≡DISCH 节点—GND）；THRES 与 DISCH 必须同网
- TRIG: R_10k 上拉到 VCC；SW_PUSH 一端接 TRIG、另一端接 GND（按下拉低触发）
- 【硬】C_100nF：CTRL 旁路到 GND；RESET→VCC
- OUT→R_330→LED→GND；按键触发后 OUT 高电平驱动 LED 延时后熄灭
- VCC param_constraint.voltage 写 "5V"（或用户指定）
- 【硬禁】禁止套用「串联 RC 充放电」：禁止 SW 串在 VCC→R→C→GND；禁止把定时 C 两端都接 GND
- 【硬禁】禁止把 CTRL 旁路电容接到 TRIG；禁止把 TRIG 与 THRES 短接（无稳态才是 THRES≡TRIG）`;

export const FRAG_SERIES_RC: string = `
【串联 RC 充放电 — 强制配方】观测 τ=RC / 指数波形时（无 555 定时器）:
- 必须: VCC + GND + R_* + C_* + SW_PUSH（充电通断）+（用户要求时）OSCILLOSCOPE
- 拓扑: VCC→SW→R→RC_MID→C→GND；示波器 CH1→RC_MID，GND→GND
- 【硬禁】禁止输出 RELAY_SPDT（RC 充放电不是互斥双色指示）
- 【硬禁】板上有 LM555 时禁止本配方 — 改用 555 单稳态/无稳态配方
- 未使用示波器 CH2/CH3/CH4 保持悬空，禁止接到 GND 或另建单脚网（教学全套仪器除外，应接满 CH1–4）`;

export const FRAG_INSTRUMENTS_SELECT: string = `
【仪器追加 — 仅用户明确要求或测量意图时】:
- "电流表/测电流" → AMMETER_DC
- "N个电压表" → N×VOLTMETER_DC
- "万用表/电阻档/二极管档" → VIRTUAL_METER（四端 V,A,OHM,COM）
- "功率表" → POWER_METER（V并/I串）
- "示波器/波形" → OSCILLOSCOPE（CH1–4+GND；GND stubLabel）
- "逻辑分析仪" → LOGIC_ANALYZER（CH1–CH8，禁止 CH0/D0）
- "频率计" → FREQ_COUNTER；"信号源" → SIGNAL_GEN
- 不要仅因含电阻/MCU 就自动堆仪器`;

export const NET_PLAN_BASE: string = `你是原理图网络拓扑规划专家。根据已放置的器件列表，推理并输出完整的网络连接计划。

你的任务：
1. 分析电路结构，识别功能模块
2. 为每个网络分配合理名称和类型
3. 【关键】可建议 mode；2～4 脚局部小网优先导线（WAR），仪器/大网标号
4. 【关键】为可能升级的 joinWired 规划 routeWaypoints：不穿选中区、不碰无关脚、不与异网交叉
5. 输出完整 netPlan JSON

【通用拓扑铁律】:
1. 电流表 I+ / I- 绝不在同一网络
2. 电压表分布在不同测量节点对；功率表 I 路≠V 路节点对
3. 仪器关键脚必须入网；GND/COM 最终到 GND（SIM_CONN）
4. VIRTUAL_METER 真脚 V,A,OHM,COM；LA 真脚 CH1–CH8（禁止 CH0/D0）
5. 局部小网导线优先；仪器脚/COM/大电源扇出保持 joinByLabel；示波器 GND 优先 stubLabel
6. 【硬】一脚一网；禁止 PROBE_* 重复列出被测脚
7. 【硬】NPN 基极 B 只接一路驱动
8. 导线正交；不得进入选中命中区(HIT_PAD=22)；无关脚间距≥20mil
9. 【硬】wiringHints.forceWire 须含若干可见直连网，禁止整图几乎无导线

【输出】严格 JSON，无 markdown；第一字符 { 最后字符 }。每个 net 至少 2 个 connections；joinWired 须含 routeWaypoints。
Schema 含 nets/labels/wiringHints/routeStrategy/topologyNotes。`;

export const FRAG_NET_MCU: string = `
【MCU 最小系统接线】:
- VDD→VCC+就近 100nF→GND；VSS→GND；NRST→10k→VCC；BOOT0→GND；EA→VCC
- 晶振 XTAL→OSC_IN/OSC_OUT + 22pF×2→GND（导线最短路径）`;

export const FRAG_NET_LED: string = `
【LED/LED灯 驱动】库仅 LED_RED/GREEN/BLUE；阳极经限流电阻；阴极→GND 或合法驱动节点；禁止 K 接 VCC；N 灯 N 电阻`;

export const FRAG_NET_MUTUAL: string = `
【互斥双色触点拓扑】必须用 RELAY_SPDT，禁止 SW_PUSH 当 SPDT:
- 线圈: VCC→SW→RELAY.1，RELAY.2→GND
- COM→GND；NC→绿灯支路；NO→红灯支路
- forceWire 含线圈驱动网；COM 禁止接 VCC`;

export const FRAG_NET_BLINK: string = `
【闪烁/振荡电路】SW_PUSH 仅作电源通断合法；双灯由三极管/MCU 等驱动交替闪烁。
不要要求 RELAY_SPDT，不要把 SW 当常开/常闭三端。`;

export const FRAG_NET_SERIES_RC: string = `
【串联 RC 充放电】VCC→(SW)→R.1；R.2 与 C.1 同网 RC_MID；C.2→GND。
示波器 CH1 并入 RC_MID（同名标号），OSC.GND→GND；未用 CH2/3/4 不入网。
禁止 RELAY 线圈直连 VCC/GND；禁止用继电器冒充充放电开关。
【硬】板上有 LM555 时禁止本拓扑 — 改用 555 单稳态/无稳态接线。`;

export const FRAG_NET_555_MONOSTABLE: string = `
【555 单稳态接线 — 硬】:
- VCC: U.VCC + U.RESET + R_timing.1 + R_pull.1
- GND: U.GND + C_timing.2 + C_ctrl.2 + LED.K + SW.1
- 555_RC: U.THRES + U.DISCH + R_timing.2 + C_timing.1（THRES≡DISCH，禁止贴 GND）
- TRIG_NET: U.TRIG + R_pull.2 + SW.2（按键拉低触发；禁止 C_ctrl 挂 TRIG）
- CTRL_NET: U.CTRL + C_ctrl.1（仅旁路，禁止与 TRIG 同网）
- OUT_NET: U.OUT + R_led.1；LED_DRIVE: R_led.2 + LED.A
- 【硬禁】禁止 VCC→SW→R→C→GND 串联 RC；禁止 THRES/DISCH 直接接 GND`;

export const FRAG_NET_555_ASTABLE: string = `
【555 无稳态接线 — 硬·脚级清单 — edit/net_plan 必须逐条满足】:
- VCC: U.VCC + U.RESET + Ra.1（Ra=较小定时电阻如 R_1k；仅 Ra 高端接 VCC）
- GND: U.GND + C_timing.2 + C_ctrl.2 + (C_decouple.2) + LED.K + OSC.GND
- 555_DISCH: U.DISCH + Ra.2 + Rb.1（仅此三脚；禁止 RESET/VCC/THRES 进本网）
- 555_THRES_TRIG: U.THRES + U.TRIG + Rb.2 + C_timing.1（THRES≡TRIG；禁止贴 GND；禁止 DISCH 进本网）
- 555_CTRL: U.CTRL + C_ctrl.1（仅旁路；禁止与 TRIG/THRES/DISCH 同网）
- （可选）VCC 去耦: C_decouple.1→VCC，C_decouple.2→GND（禁止挂到信号网）
- 555_OUT: U.OUT + R_led.1 (+ OSC.CH1)；LED_ANODE: R_led.2 + LED.A
- 示波器：CH1∥555_OUT；GND→GND；教学可 CH2∥THRES_TRIG、CH3∥DISCH、CH4∥CTRL（并入同名网）
- 【硬禁】禁止两颗定时 R 都接 VCC；禁止 Ra 接到 THRES 而绕过 DISCH；禁止 Rb 高端接 VCC
- 【硬禁】禁止 RESET≡DISCH；禁止 VCC→SW→R→C→GND 串联 RC；禁止另建无 DUT 的 *_SENSE 单脚网
- 【edit·硬】removeNetNames 不得包含仍出现在 nets 中的网名`;

export const FRAG_NET_OPAMP: string = `
【运放】UA741 用 IN+/IN-/OUT/VCC/VEE；LM358/TL082 用通道脚 OUT1/IN±1…；必须闭环；双电源时 VEE/V-→VEE（勿接 GND）；双运放未用半边接跟随`;

export const FRAG_NET_INTEGRATOR: string = `
【运放积分】SIG.OUT→R→IN-；IN+→GND；C 跨 OUT↔IN-；OUT→OSC.CH2；SIG.OUT→OSC.CH1；电源 VCC/VEE/GND 分网。
禁止 RC 充放电拓扑；未用运放半边 IN-↔OUT、IN+→GND`;

export const FRAG_NET_SELF_OSC_HYST_INT: string = `
【自激振荡网】比较器 OUT（方波）→R→积分 IN-；C 跨积分 OUT↔IN-；积分 OUT 反馈→比较器输入；
OSC.CH1→方波网，OSC.CH2→三角网，GND→GND；电源 VCC/VEE/GND。禁止 SIGNAL_GEN`;

export const FRAG_NET_DUAL: string = `
【双电源网】独立网名 VCC 与 VEE；VCC 符号→VCC 网，VEE 符号→VEE 网，GND→GND；禁止 VCC/VEE 同网`;

export const FRAG_NET_SIGNAL_GEN: string = `
【SIGNAL_GEN】OUT 并入激励信号网；GND→GND；可用 OSC CH1 观测同一信号网`;

export const FRAG_NET_HYSTERESIS: string = `
【滞回整形】SIGNAL_GEN.OUT→运放输入；正反馈 HYST 网；OSC 观 OUT。
SIGNAL_GEN amplitude 须 ≥2V（推荐 5V），禁止 1V 峰（越过不了负阈值）`;

export const FRAG_NET_INSTR: string = `
【仪器】测量脚并入被测信号网同名；禁止另建 PROBE 网重复 DUT 脚`;

export function assembleDeviceSelectSystem(intent: CircuitIntent, userPrompt: string = '',
  libIds: string[] = []): string {
  let s = DEVICE_SELECT_BASE;
  if (intent.needsPowerRails) {
    s += FRAG_POWER_RAILS;
  }
  if (intent.dualSupply) {
    s += FRAG_DUAL_SUPPLY;
  }
  if (intent.needsSignalGen) {
    s += FRAG_SIGNAL_GEN;
  }
  if (intent.needsHysteresisComparator && intent.needsSignalGen) {
    s += FRAG_HYSTERESIS_SIG;
  }
  if (intent.hasMcuMinSystem) {
    s += FRAG_MCU_MIN;
  }
  if (intent.needsLedSeriesR) {
    s += FRAG_LED_SERIES_R;
  }
  if (intent.needsOpAmpFeedback) {
    s += FRAG_OPAMP;
  }
  if (intent.needsOpAmpIntegrator) {
    // 自激闭环：用专用片段，禁止再注入「必须 SIGNAL_GEN」的积分示教配方
    if (intent.needsSignalGen) {
      s += FRAG_INTEGRATOR;
    } else {
      s += FRAG_SELF_OSC_HYST_INT;
    }
  }
  if (intent.needsI2cPullup) {
    s += FRAG_I2C;
  }
  if (intent.mutualLedIndicator) {
    s += FRAG_MUTUAL_LED;
  }
  if (intent.blinkOscillator) {
    s += FRAG_BLINK_OK;
  }
  if (intent.timer555Monostable) {
    s += FRAG_555_MONOSTABLE;
  } else if (intent.timer555Astable || intent.reasons.indexOf('555_astable') >= 0) {
    s += FRAG_555_ASTABLE;
  }
  if (intent.seriesRcCharge && !intent.timer555Monostable && !intent.timer555Astable) {
    s += FRAG_SERIES_RC;
  }
  if (intent.hasInstruments) {
    s += FRAG_INSTRUMENTS_SELECT;
    s += FRAG_INSTR_DETAIL_SELECT;
  }
  // 关键词族片段（尚无 BOM）+ 板上/已有 libId 片段（edit 增量选型）
  s += assemblePromptKeywordFragments(userPrompt);
  if (libIds && libIds.length > 0) {
    s += assembleLibIdFragments(libIds, 'select');
  }
  return s;
}

export function assembleNetPlanSystem(intent: CircuitIntent, libIds: string[] = []): string {
  let s = NET_PLAN_BASE;
  if (intent.hasMcuMinSystem) {
    s += FRAG_NET_MCU;
  }
  if (intent.needsLedSeriesR) {
    s += FRAG_NET_LED;
  }
  if (intent.mutualLedIndicator && !intent.seriesRcCharge) {
    s += FRAG_NET_MUTUAL;
  }
  if (intent.blinkOscillator) {
    s += FRAG_NET_BLINK;
  }
  if (intent.timer555Monostable) {
    s += FRAG_NET_555_MONOSTABLE;
  } else if (intent.timer555Astable) {
    s += FRAG_NET_555_ASTABLE;
  }
  if (intent.seriesRcCharge && !intent.timer555Monostable && !intent.timer555Astable) {
    s += FRAG_NET_SERIES_RC;
  }
  if (intent.needsOpAmpFeedback) {
    s += FRAG_NET_OPAMP;
  }
  if (intent.needsOpAmpIntegrator) {
    if (intent.needsSignalGen) {
      s += FRAG_NET_INTEGRATOR;
    } else {
      s += FRAG_NET_SELF_OSC_HYST_INT;
    }
  }
  if (intent.dualSupply) {
    s += FRAG_NET_DUAL;
  }
  if (intent.needsSignalGen) {
    s += FRAG_NET_SIGNAL_GEN;
  }
  if (intent.needsHysteresisComparator && intent.needsSignalGen) {
    s += FRAG_NET_HYSTERESIS;
  }
  if (intent.hasInstruments) {
    s += FRAG_NET_INSTR;
    s += FRAG_INSTR_DETAIL_NET;
  }
  // 按板上实际型号注入脚级片段（全库覆盖）
  if (libIds && libIds.length > 0) {
    s += assembleLibIdFragments(libIds, 'net');
  }
  return s;
}
