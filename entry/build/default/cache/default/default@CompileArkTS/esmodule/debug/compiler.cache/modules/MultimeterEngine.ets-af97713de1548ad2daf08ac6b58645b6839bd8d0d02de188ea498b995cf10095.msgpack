        for (let i = 0; i < this.dcSampleBuffer.length; i++) {
            sum += this.dcSampleBuffer[i];
        }
        const box = sum / this.dcSampleBuffer.length;
        if (!this.dcEmaInit) {
            this.dcEma = box;
