import { MultimeterMode } from 'common';
const RANGES_DCV = [0.2, 2, 20, 200, 1000];
const RANGES_ACV = [0.2, 2, 20, 200];
const RANGES_RES = [200, 2000, 20000, 200000, 2000000];
const DC_AVG_SAMPLES = 12;
const DC_EMA_ALPHA = 0.35;
