    clampToRange(value) {
        const max = this.getRanges()[this.rangeIndex] ?? Math.abs(value);
        return Math.min(Math.abs(value), max) * (value < 0 ? -1 : 1);
    }
    updateDcAverage(raw) {
        if (this.dcSampleBuffer.length < DC_AVG_SAMPLES) {
            this.dcSampleBuffer.push(raw);
        }
        else {
            this.dcSampleBuffer.shift();
            this.dcSampleBuffer.push(raw);
        }
