        this.lastDisplay = 0;
        this.dcSampleBuffer = [];
        this.dcEma = 0;
        this.dcEmaInit = false;
        this.rmsSampleBuffer = [];
        this.rmsSampleIndex = 0;
        this.dcOffset = 0;
        this.lastRms = 0;
    }
