import { WireStyle, IdUtil } from 'common';
export class MoveCommand {
    constructor(doc, compId, oldPos, newPos) {
        this.doc = doc;
        this.compId = compId;
        this.oldPos = { x: oldPos.x, y: oldPos.y };
        this.newPos = { x: newPos.x, y: newPos.y };
    }
    execute() {
        const c = this.doc.components.find(c => c.id === this.compId);
        if (c)
            c.position = { x: this.newPos.x, y: this.newPos.y };
    }
    undo() {
        const c = this.doc.components.find(c => c.id === this.compId);
        if (c)
            c.position = { x: this.oldPos.x, y: this.oldPos.y };
    }
    getMemoryEstimate() { return 32; }
}
export class PlaceCommand {
    constructor(doc, comp) {
        this.placed = false;
        this.doc = doc;
        this.comp = comp;
    }
    execute() {
        if (!this.placed) {
            this.doc.components.push(this.comp);
            this.placed = true;
        }
    }
    undo() {
        const idx = this.doc.components.findIndex(c => c.id === this.comp.id);
        if (idx >= 0)
            this.doc.components.splice(idx, 1);
        this.placed = false;
    }
    getMemoryEstimate() { return 256; }
}
export class DeleteCommand {
