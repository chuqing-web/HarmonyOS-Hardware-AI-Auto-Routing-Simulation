        id: c.id,
        libraryId: c.libraryId,
        refDes: c.refDes,
        name: c.name,
        position: { x: c.position.x, y: c.position.y },
        rotation: c.rotation,
        mirrored: c.mirrored,
        x: c.x,
        y: c.y,
        parameters: params,
        pinIds: pinIdsClone,
        attributes: c.attributes ? new Map(c.attributes) : undefined,
