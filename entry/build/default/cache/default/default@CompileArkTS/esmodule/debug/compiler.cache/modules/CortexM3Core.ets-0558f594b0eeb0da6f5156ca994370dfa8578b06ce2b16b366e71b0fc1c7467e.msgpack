            }
        }
        let count = 0;
        for (let r = 0; r < 8; r++) {
            if (regList & (1 << r))
                count++;
        }
        this.sp += count * 4;
        this.pc += 2;
    }
    // ---- å¼‚å¸¸å…¥å£/é€€å‡º (2.1.5) ----
    enterException(excNum, vectorAddr) {
