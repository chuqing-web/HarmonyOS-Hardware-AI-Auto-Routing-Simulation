    addSpImm7(hw) { this.sp = (this.sp + ((hw & 0x7F) << 2)) >>> 0; this.pc += 2; }
    /** PUSH multi (2.1.2) */
    pushMulti(hw) {
        const regList = hw & 0xFF;
        let count = 0;
        for (let r = 0; r < 8; r++) {
            if (regList & (1 << r))
                count++;
        }
        this.sp -= count * 4;
