        for (let r = 0; r < 8; r++) {
            if (regList & (1 << r)) {
                this.writeMem32(addr, this.reg(r));
                addr += 4;
            }
        }
        this.pc += 2;
    }
    /** POP multi (2.1.2) */
    popMulti(hw) {
        const regList = hw & 0xFF;
        let addr = this.sp;
        for (let r = 0; r < 8; r++) {
            if (regList & (1 << r)) {
                this.setReg(r, this.readMem32(addr));
