    }
    /** STRB imm5 (2.1.2) */
    strbImm(hw) {
        const rt = hw & 0x7;
        const rn = (hw >> 3) & 0x7;
        const imm = (hw >> 6) & 0x1F;
        this.writeMem8(this.reg(rn) + imm, this.reg(rt) & 0xFF);
