    ldrhImm(hw) {
        const rt = hw & 0x7;
        const rn = (hw >> 3) & 0x7;
        const imm = (hw >> 6) & 0x1F;
        this.setReg(rt, this.readMem16(this.reg(rn) + imm));
        this.pc += 2;
