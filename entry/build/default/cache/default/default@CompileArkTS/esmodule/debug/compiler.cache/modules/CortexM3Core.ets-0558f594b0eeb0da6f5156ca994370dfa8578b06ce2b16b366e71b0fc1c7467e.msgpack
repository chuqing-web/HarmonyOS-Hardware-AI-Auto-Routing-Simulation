const NVIC_ICER0 = 0xE000E180;
const NVIC_ISPR0 = 0xE000E200;
const NVIC_ICPR0 = 0xE000E280;
const NVIC_IABR0 = 0xE000E300;
const NVIC_IPR0 = 0xE000E400;
