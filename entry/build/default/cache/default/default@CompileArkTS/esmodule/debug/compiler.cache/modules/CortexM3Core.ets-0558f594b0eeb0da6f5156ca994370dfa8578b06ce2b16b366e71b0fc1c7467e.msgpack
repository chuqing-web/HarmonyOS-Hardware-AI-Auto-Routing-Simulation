    aluReg(hw) {
        const op = (hw >> 9) & 0x3;
        const rn = (hw >> 6) & 0x7;
        const rs = (hw >> 3) & 0x7;
        const rd = hw & 0x7;
        let val = this.reg(rs);
        if (op === 1)
            val = this.reg(rn) - val; // SUB
        else if (op === 2)
            val = this.reg(rn) + val; // ADD
        this.setReg(rd, val);
        this.pc += 2;
