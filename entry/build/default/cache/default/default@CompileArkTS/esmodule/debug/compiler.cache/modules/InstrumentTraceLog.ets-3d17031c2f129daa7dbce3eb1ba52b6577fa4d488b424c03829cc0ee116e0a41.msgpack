    `[CANVAS] doc=${doc.name} grid=${viewport.gridSize} zoom=${viewport.zoom.toFixed(2)} ` +

    `pan=(${viewport.panOffset.x.toFixed(0)},${viewport.panOffset.y.toFixed(0)}) ` +

