    Logger.info(INSTR_TRACE_TAG, `[LED] VF sample count=${lines.length}`);
    const maxShow = Math.min(lines.length, 10);
    for (let i = 0; i < maxShow; i++) {
        Logger.info(INSTR_TRACE_TAG, `[LED]   ${lines[i]}`);
