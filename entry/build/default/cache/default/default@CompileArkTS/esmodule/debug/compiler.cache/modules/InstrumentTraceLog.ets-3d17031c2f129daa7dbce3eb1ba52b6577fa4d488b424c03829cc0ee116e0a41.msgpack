function flattenAiTraceText(text) {
    let out = '';
    for (let i = 0; i < text.length; i++) {
        const ch = text.charAt(i);
        if (ch === '\n' || ch === '\r') {
            out += 'â';
        }
        else if (ch === '\t') {
            out += ' ';
        }
        else {
            out += ch;
        }
    }
    return out;
}
