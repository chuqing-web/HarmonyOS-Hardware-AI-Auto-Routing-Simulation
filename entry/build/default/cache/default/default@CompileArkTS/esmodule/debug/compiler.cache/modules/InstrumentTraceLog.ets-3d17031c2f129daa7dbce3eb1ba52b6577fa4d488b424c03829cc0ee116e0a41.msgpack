/** å·¥ç¨‹æ‰“å¼€åçš„å…¨é¢ç³»ç»Ÿå®¡è®¡ */

export function traceProjectOpenAudit(

  path: string, projectName: string, doc: SchematicDocument, viewport: ViewportState): void {

