/** é€‰ä¸­å™¨ä»¶å˜åŒ–æ—¶è¾“å‡º INFO çº§æ—¥å¿—ï¼ˆä¾¿äºåœ¨é»˜è®¤ log level ä¸‹è¿½è¸ªï¼‰ */
export function traceUiSelect(panel, compId, refDes, libraryId, instrKind, reading) {
