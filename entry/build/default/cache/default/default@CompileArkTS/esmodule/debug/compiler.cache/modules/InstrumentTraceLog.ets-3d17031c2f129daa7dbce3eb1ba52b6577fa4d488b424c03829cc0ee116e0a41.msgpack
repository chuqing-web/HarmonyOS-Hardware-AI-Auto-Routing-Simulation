  if (netVoltageDetail.length > 0) {

    msg += ` ${netVoltageDetail}`;

  }

  Logger.info(INSTR_TRACE_TAG, msg);

  if (!simActive) {

    Logger.warn(INSTR_TRACE_TAG,

      `bind ${refDes}: ä»¿çœŸæœªè¿è¡Œï¼Œä»ªå™¨è¯»æ•°ä¸å¯ç”¨ â€” è¯·å…ˆç‚¹å‡»ã€Œè¿è¡Œä»¿çœŸã€`);

  }

}



/** ç”µå‹/ç”µæµæµ‹é‡ç»“æœï¼ˆèŠ‚æµè¾“å‡ºï¼‰ */

let lastMeasureKey = '';

let lastMeasureTick = 0;



export function traceMeasure(

  refDes: string, kind: string, simActive: boolean, detail: string): void {

  const key = `${refDes}:${kind}:${detail}`;

  const now = Date.now();

  if (key === lastMeasureKey && now - lastMeasureTick < 2000) {

    return;

  }

  lastMeasureKey = key;

  lastMeasureTick = now;

  Logger.info(INSTR_TRACE_TAG,

    `measure ref=${refDes} kind=${kind} sim=${simActive ? 'RUNNING' : 'IDLE'} ${detail}`);

}



