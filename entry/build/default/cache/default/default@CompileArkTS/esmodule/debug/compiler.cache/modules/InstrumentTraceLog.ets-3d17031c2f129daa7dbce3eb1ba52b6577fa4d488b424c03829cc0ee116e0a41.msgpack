/** MCU æ‰§è¡Œæ­¥è¿›æ‘˜è¦ â€” [MCU] */
export function traceMcuTick(family, detail) {
    Logger.info(INSTR_TRACE_TAG, `[MCU] TICK | family=${family} ${detail}`);
