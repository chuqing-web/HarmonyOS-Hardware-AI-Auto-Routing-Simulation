        return;
    }
    let msg = `sim step=${stepCount} waves=${waveCount} active=${activeComp ?? 'null'} ` +
        `w=[${formatWaveSummary(waves, 4)}] V={${formatVoltageSample(voltages, 6)}}`;
    if (branchCurrents !== undefined) {
        msg += ` I={${formatCurrentSample(branchCurrents, 4)}}`;
