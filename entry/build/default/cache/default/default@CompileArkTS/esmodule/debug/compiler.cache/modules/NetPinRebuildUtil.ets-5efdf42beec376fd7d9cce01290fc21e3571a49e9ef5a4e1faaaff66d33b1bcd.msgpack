            { id: 'IN-', name: 'IN-', x: -50, y: 20 },
            { id: 'OUT', name: 'OUT', x: 50, y: 0 },
            { id: 'VCC', name: 'VCC', x: 0, y: -50 },
            { id: 'VEE', name: 'VEE', x: 0, y: 50 }
