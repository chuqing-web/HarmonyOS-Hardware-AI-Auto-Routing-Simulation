    const before = doc.nets.length;
    const railNames = new Set(['VCC', 'VDD', 'GND', 'VSS', 'VEE', '0']);
    doc.nets = doc.nets.filter((net) => {
        if (wireNetIds.has(net.id)) {
            return true;
        }
        if (labelNetIds.has(net.id)) {
            return true;
        }
        if (net.pinIds.length > 0) {
            return true;
