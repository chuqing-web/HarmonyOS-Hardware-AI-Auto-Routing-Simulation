                continue;
            }
            addPinToNet(doc, wire.netId, c.compId, c.pinId, c.pinName);
            pinOwnerNet.set(pinKey, wire.netId);
            connected++;
            midHits++;
            traceWirePinAttach('mid_segment', c.refDes, c.pinName, c.pinId, wire.id, wire.netId, bestSegDist, c.world.x, c.world.y);
            break;
        }
    }
