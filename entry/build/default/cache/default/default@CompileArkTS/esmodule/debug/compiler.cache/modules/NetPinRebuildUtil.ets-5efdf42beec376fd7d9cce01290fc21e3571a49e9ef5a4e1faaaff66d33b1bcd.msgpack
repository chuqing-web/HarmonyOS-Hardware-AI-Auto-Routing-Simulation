/** DIP MCU å…·åè„šï¼šä¸ NamedDevicePins / BuiltinComponents å¯¹é½ */
function toPinGeometry(src) {
    const out = [];
    for (let i = 0; i < src.length; i++) {
        const s = src[i];
        const g = { id: s.id, name: s.name, x: s.x, y: s.y };
        out.push(g);
    }
    return out;
}
function mcuDefaultPins(libUpper) {
    return toPinGeometry(namedMcuPinGeoms(libUpper));
}
function countPinRefs(doc) {
    let total = 0;
