  // æ¾å¸é™„é˜ˆå€¼å†…ä¸å…è®¸æŠŠç”µæº/åœ°ç¬¦å·è„šå¸åˆ°ä¿¡å· stub æ¸¸ç¦»ç«¯ï¼ˆlab_passive DIV_TOP æ ¹å› ï¼‰
  const strictSnap = Math.min(5, threshold);
  // Pre-collect all pin candidates with world positions
  interface PinCandidate {
