            { id: 'IN+1', name: 'IN+1', x: -50, y: -40 },
            { id: 'V-', name: 'V-', x: 0, y: 50 },
            { id: 'IN+2', name: 'IN+2', x: -50, y: 20 },
            { id: 'IN-2', name: 'IN-2', x: -50, y: 40 },
            { id: 'OUT2', name: 'OUT2', x: 50, y: 30 },
