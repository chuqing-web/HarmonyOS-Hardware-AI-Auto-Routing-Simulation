        // ä¿ç•™çœŸæ­£çš„ç”µæº/åœ°è½¨ï¼›ä¸¢å¼ƒæ‹“æ‰‘é‡å»ºåæ‚¬ç©ºçš„å‘½åç”µæºç½‘ï¼ˆå¦‚ç©º VOUTï¼‰
        if (net.type === NetType.POWER || net.type === NetType.GROUND) {
            return railNames.has(net.name.toUpperCase());
