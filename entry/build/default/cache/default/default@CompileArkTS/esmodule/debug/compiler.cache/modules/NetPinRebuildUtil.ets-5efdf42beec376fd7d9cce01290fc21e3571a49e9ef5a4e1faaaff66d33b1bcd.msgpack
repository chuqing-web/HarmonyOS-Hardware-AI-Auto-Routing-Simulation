function transformPin(local, rotation, mirrored) {
    let x = local.x;
    let y = local.y;
    if (mirrored) {
        x = -x;
    }
    switch (rotation) {
        case 90: return { x: -y, y: x };
        case 180: return { x: -x, y: -y };
        case 270: return { x: y, y: -x };
