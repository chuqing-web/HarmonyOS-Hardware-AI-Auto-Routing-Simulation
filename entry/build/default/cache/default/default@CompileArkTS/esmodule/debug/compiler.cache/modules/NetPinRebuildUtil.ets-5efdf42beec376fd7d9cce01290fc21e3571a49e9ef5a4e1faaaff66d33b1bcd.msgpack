    if (lib === 'GND' || lib.endsWith('/GND')) {
        return [{ id: '1', name: 'GND', x: 0, y: -10 }];
    }
    if (lib === 'VEE' || lib.endsWith('/VEE')) {
        return [{ id: '1', name: 'VEE', x: 0, y: -10 }];
    }
    if (lib === 'SIGNAL_GEN' || lib.startsWith('SIGNAL_GEN')) {
