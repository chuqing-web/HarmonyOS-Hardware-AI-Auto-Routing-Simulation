    refreshFileList() {
        const doc = this.getDocument();
        if (!doc) {
            this.fileNames = [];
            this.layerTitles = [];
            this.statusText = 'æ—  PCB æ–‡æ¡£';
            return;
        }
        const result = exportPcbGerber(doc);
        const names = [];
        const titles = [];
        for (let i = 0; i < result.files.length; i++) {
            const f = result.files[i];
            if (f.fileName.endsWith('.txt') && f.fileName.indexOf('README') >= 0)
                continue;
            names.push(f.fileName);
            titles.push(f.layerName);
        }
        this.fileNames = names;
        this.layerTitles = titles;
        if (this.selectedIdx >= names.length) {
            this.selectedIdx = 0;
        }
        this.statusText = `${names.length} ä¸ª Gerber/Drill æ–‡ä»¶`;
    }
    scheduleDraw() {
        setTimeout(() => {
            this.drawPreview();
        }, 16);
    }
    drawPreview() {
        const doc = this.getDocument();
        const c = this.ctx;
        c.clearRect(0, 0, this.viewW, this.viewH);
        c.fillStyle = '#0A0C10';
