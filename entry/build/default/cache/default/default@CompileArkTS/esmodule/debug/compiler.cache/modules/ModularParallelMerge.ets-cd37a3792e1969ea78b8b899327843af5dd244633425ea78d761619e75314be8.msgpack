            refName: 'VCC',
            x: 60, y: 80, rotate: 0,
            mirrorH: false, mirrorV: false,
            params: new Map(),
            pinVoltage: new Map(),
            hidden: false, subCircuitRef: '', ercErrorMsg: ''
        };
        merged.deviceList.push(vcc);
    }
