 * æ¨¡å—å¹¶è¡Œï¼šè®¡åˆ’ç±»å‹ã€é—¨ç¦ã€æ‹“æ‰‘åˆå¹¶ï¼ˆPOWER + pin-to-pin jointsï¼‰
 */
import { IdUtil, emptySchTopology, TopologyAdapter, Logger, INSTR_TRACE_TAG, NetType, mapAwareStringify, mapAwareParse } from 'common';
import { TemplateSchematicKit } from './TemplateSchematicKit';
function asText(v, fallback) {
    if (v === undefined || v === null) {
        return fallback;
    }
    return `${v}`.trim();
}
function stripBoundaryNote(s) {
    const eq = s.indexOf('=');
    return (eq >= 0 ? s.substring(0, eq) : s).trim();
}
/** å½’ä¸€åŒ–è¾¹ç•Œè„šé”®ï¼šRefDes.Pinï¼ˆå¤§å†™ï¼‰â€” orchestrator ERC è½¯åŒ–å…±ç”¨ */
export function normalizeBoundaryKey(raw) {
    const clean = stripBoundaryNote(raw).toUpperCase();
    const parts = clean.split('.');
    if (parts.length < 2) {
        return clean;
    }
    return `${parts[0]}.${parts.slice(1).join('.')}`;
}
/**
 * æ˜¯å¦æŠŠ libDevId/å‹å·è¯¯å½“ä½œ RefDesï¼ˆå¦‚ LM555ã€LED_REDï¼‰ã€‚
 * åˆæ³•ä½å·ï¼šU1/R12/RV1/LED1/SW1/AM1/VM1/SCOPE1ï¼ˆâ‰¤5 å­—æ¯ + â‰¤2 æ•°å­—ï¼‰ã€‚
 * æ³¨æ„ï¼šå‹¿æŠŠ SCOPE1 ç­‰ä»ªå™¨ä½å·è¯¯åˆ¤ä¸ºå‹å·ï¼ˆæ—§è§„åˆ™ â‰¤3 å­—æ¯ä¼šè¯¯ä¼¤ï¼‰ã€‚
 */
export function looksLikeLibIdAsRefDes(ref) {
    const r = (ref ?? '').trim().toUpperCase();
    if (r.length === 0) {
        return false;
    }
    if (r === 'VCC' || r === 'GND' || r === 'VDD' || r === 'VSS' || r === 'POWER') {
        return false;
    }
    if (r.indexOf('_') >= 0) {
        return true;
    }
    // æ ‡å‡†ä½å·ï¼š1ï½5 å­—æ¯ + 1ï½2 æ•°å­—ï¼ˆå« SCOPE1/UART1/OSC1/SW1 ç­‰ï¼‰
    if (/^[A-Z]{1,5}\d{1,2}$/.test(r)) {
        return false;
    }
    // å‹å·å½¢æ€ï¼šå«å­—æ¯ä¸æ•°å­—ä¸”é•¿åº¦â‰¥4ï¼ˆLM555ã€CD4017ã€2N2222ï¼‰
    if (r.length >= 4 && /[A-Z]/.test(r) && /\d/.test(r)) {
        return true;
    }
    // çº¯å¤§å†™é•¿è¯æ— æ•°å­—ï¼šåº“ IDï¼ˆOSCILLOSCOPEã€BUZZERï¼‰è€Œéä½å·
    if (r.length >= 6 && /^[A-Z]+$/.test(r)) {
        return true;
    }
    return false;
}
/** libDevId è¯¯å†™å…¥ boundary/joints æ—¶çš„æ¨èä½å·å‰ç¼€ */
export function suggestRefPrefixForLibId(libId) {
    const u = (libId ?? '').trim().toUpperCase();
    if (u === 'OSCILLOSCOPE') {
        return 'OSC';
    }
    if (u === 'VOLTMETER_DC' || u === 'VIRTUAL_METER') {
        return 'VM';
    }
    if (u === 'AMMETER_DC') {
        return 'AM';
    }
    if (u.indexOf('UART') >= 0) {
        return 'UART';
    }
    if (u.indexOf('LOGIC_ANALYZER') >= 0) {
        return 'LA';
    }
    if (u.indexOf('FREQ') >= 0) {
        return 'FC';
    }
    if (u.indexOf('POWER_METER') >= 0) {
        return 'PM';
    }
    if (u.startsWith('SW_') || u === 'SW') {
        return 'SW';
    }
    if (u.indexOf('RELAY') >= 0) {
        return 'K';
    }
    if (u === 'BUZZER') {
        return 'BZ';
    }
    if (u.startsWith('POT_')) {
        return 'RV';
    }
    if (u.startsWith('R_')) {
        return 'R';
    }
    if (u.startsWith('C_')) {
        return 'C';
    }
    if (u.startsWith('LED_') || u.startsWith('1N')) {
        return 'D';
    }
    if (u.length >= 1 && u.length <= 5 && /^[A-Z]+$/.test(u)) {
        return u.substring(0, Math.min(3, u.length));
    }
    return 'U';
}
/**
 * å½’ä¸€åŒ– modular planï¼šè¡¥å…¨ joints ç¼ºçš„ boundaryPinsï¼›æŠŠ libId å½“ RefDes æ”¹æˆä½å·ã€‚
 * åœ¨ critique å‰è°ƒç”¨ï¼Œå‡å°‘æ— è°“çš„ LLM é‡è¯•ï¼ˆå¦‚ POWERâ†’R1.1 æ¼å†™ boundaryï¼‰ã€‚
 */
export function healModularPlan(plan) {
    // 1) å„æ¨¡å—å†…ï¼šlibId-as-RefDes â†’ å”¯ä¸€ä½å·
    for (let mi = 0; mi < plan.modules.length; mi++) {
        const mod = plan.modules[mi];
        const used = new Set();
        const rewrite = new Map();
        const noteLibRef = (rawRef) => {
            const ref = (rawRef ?? '').trim();
            if (ref.length === 0 || !looksLikeLibIdAsRefDes(ref)) {
                return;
            }
            const key = ref.toUpperCase();
            if (rewrite.has(key)) {
                return;
            }
            const prefix = suggestRefPrefixForLibId(ref);
            let n = 1;
            let cand = `${prefix}${n}`;
            while (used.has(cand.toUpperCase())) {
                n++;
                cand = `${prefix}${n}`;
            }
            used.add(cand.toUpperCase());
            rewrite.set(key, cand);
        };
        for (let bi = 0; bi < mod.boundaryPins.length; bi++) {
            const key = normalizeBoundaryKey(mod.boundaryPins[bi]);
            const dot = key.indexOf('.');
            if (dot > 0) {
                const ref = key.substring(0, dot);
                if (!looksLikeLibIdAsRefDes(ref)) {
                    used.add(ref.toUpperCase());
                }
                else {
                    noteLibRef(ref);
                }
            }
        }
        for (let ji = 0; ji < plan.joints.length; ji++) {
            for (const side of [plan.joints[ji].from, plan.joints[ji].to]) {
                const ep = parseModularEndpoint(side);
                if (ep && ep.kind === 'module' && ep.moduleId === mod.id) {
                    if (!looksLikeLibIdAsRefDes(ep.refDes)) {
                        used.add(ep.refDes.toUpperCase());
                    }
                    else {
                        noteLibRef(ep.refDes);
                    }
                }
            }
        }
        if (rewrite.size === 0) {
            continue;
        }
        const applyRef = (ref) => {
            const mapped = rewrite.get(ref.toUpperCase());
            return mapped !== undefined ? mapped : ref;
        };
        const newBps = [];
        for (let bi = 0; bi < mod.boundaryPins.length; bi++) {
            const raw = stripBoundaryNote(mod.boundaryPins[bi]);
            const parts = raw.split('.');
            if (parts.length >= 2) {
                newBps.push(`${applyRef(parts[0])}.${parts.slice(1).join('.')}`);
            }
            else {
                newBps.push(raw);
            }
        }
        mod.boundaryPins = newBps;
        // promptï¼šä»…æ›¿æ¢ã€ŒLibId.Pinã€å½¢æ€ï¼›è‹¥ç¼ºæ–°ä½å·åˆ™è¿½åŠ ä¸€å¥ï¼Œæ»¡è¶³ critiqueã€ŒRefDes é¡»å‡ºç°åœ¨ promptã€
        let prompt = mod.prompt;
        const rewriteKeys = Array.from(rewrite.keys());
        for (let ri = 0; ri < rewriteKeys.length; ri++) {
            const fromLib = rewriteKeys[ri];
            const toRef = rewrite.get(fromLib);
            const pinForm = new RegExp(`${fromLib}\\.`, 'gi');
            prompt = prompt.replace(pinForm, `${toRef}.`);
            if (prompt.toUpperCase().indexOf(toRef.toUpperCase()) < 0) {
                prompt = `${prompt} ä½å·${toRef}ï¼ˆlibDevId=${fromLib}ï¼‰ã€‚`;
            }
        }
        mod.prompt = prompt;
        for (let ji = 0; ji < plan.joints.length; ji++) {
            const j = plan.joints[ji];
            const rewriteSide = (side) => {
                const ep = parseModularEndpoint(side);
                if (!ep || ep.kind !== 'module' || ep.moduleId !== mod.id) {
                    return side;
                }
                const nr = applyRef(ep.refDes);
                if (nr === ep.refDes) {
                    return side;
                }
                return `${ep.moduleId}.${nr}.${ep.pin}`;
            };
            j.from = rewriteSide(j.from);
            j.to = rewriteSide(j.to);
        }
    }
    // 2) joints ç«¯ç‚¹è‡ªåŠ¨è¡¥è¿›å¯¹åº”æ¨¡å— boundaryPinsï¼ˆå°¤å…¶ POWERâ†’R1.1ï¼‰
    for (let ji = 0; ji < plan.joints.length; ji++) {
        const j = plan.joints[ji];
        for (const side of [j.from, j.to]) {
            const ep = parseModularEndpoint(side);
            if (!ep || ep.kind !== 'module') {
                continue;
            }
            const mod = plan.modules.find(m => m.id === ep.moduleId);
            if (!mod) {
                continue;
            }
            if (looksLikeLibIdAsRefDes(ep.refDes)) {
                continue;
            }
            if (!boundaryContains(mod, ep.refDes, ep.pin)) {
                mod.boundaryPins.push(`${ep.refDes}.${ep.pin}`);
            }
        }
    }
    return plan;
}
function is555FamilyHint(hint) {
    const h = hint.toUpperCase();
    return h === 'NE555' || h === 'LM555' || h === 'SE555' || h === 'SA555' ||
        h === 'ICM7555' || h === 'TLC555' || h === '555';
}
/** 555 æ—ç­‰åˆ«åå½’ä¸€ï¼Œä¾¿äº joints æŒ‰ libDevId å›é€€ */
function normalizeLibAlias(libOrRef) {
    const u = (libOrRef ?? '').trim().toUpperCase();
    if (is555FamilyHint(u)) {
        return 'LM555';
    }
    return u;
}
/** è§£æ "M1.RV1.W" æˆ– "POWER.VCC" */
export function parseModularEndpoint(raw) {
    const t = raw.trim();
    if (t.length === 0) {
        return null;
    }
    const parts = t.split('.');
    if (parts.length < 2) {
        return null;
    }
    const head = parts[0].toUpperCase();
    if (head === 'POWER') {
        const rail = parts[1].toUpperCase();
        if (rail !== 'VCC' && rail !== 'GND' && rail !== 'VDD' && rail !== 'VSS' &&
            rail !== 'VEE') {
            return null;
        }
        const pin = rail === 'VDD' ? 'VCC' : (rail === 'VSS' ? 'GND' : rail);
        return { kind: 'power', moduleId: 'POWER', refDes: pin, pin: pin, raw: t };
    }
    if (parts.length < 3) {
        return null;
    }
    return {
        kind: 'module',
        moduleId: parts[0],
        refDes: parts[1],
        pin: parts.slice(2).join('.'),
        raw: t
    };
}
export function normalizeModularPlan(raw) {
    if (!raw) {
        return null;
    }
    const src = raw;
    const overview = asText(src['systemOverview'] ?? src['system_overview'], '');
    const modulesRaw = src['modules'];
    const jointsRaw = src['joints'];
    const modules = [];
    if (Array.isArray(modulesRaw)) {
        for (const mObj of modulesRaw) {
            const m = mObj;
            const id = asText(m['id'] ?? m['moduleId'] ?? m['module_id'], '');
            const title = asText(m['title'] ?? m['name'], id);
            const prompt = asText(m['prompt'] ?? m['subPrompt'] ?? m['sub_prompt'], '');
            const bpRaw = m['boundaryPins'] ?? m['boundary_pins'] ?? m['boundaries'];
            const boundaryPins = [];
            if (Array.isArray(bpRaw)) {
                for (const b of bpRaw) {
                    const s = stripBoundaryNote(asText(b, ''));
                    if (s.length > 0) {
                        boundaryPins.push(s);
                    }
                }
            }
            if (id.length > 0 && prompt.length > 0) {
                modules.push({ id, title, prompt, boundaryPins });
            }
        }
    }
    const joints = [];
    if (Array.isArray(jointsRaw)) {
        for (const jObj of jointsRaw) {
            const j = jObj;
            const from = asText(j['from'] ?? j['a'] ?? j['src'], '');
            const to = asText(j['to'] ?? j['b'] ?? j['dst'], '');
            if (from.length > 0 && to.length > 0) {
                joints.push({ from, to });
            }
        }
    }
    if (modules.length === 0) {
        return null;
    }
    return { systemOverview: overview, modules, joints };
}
function boundaryContains(mod, refDes, pin) {
    const key = `${refDes}.${pin}`.toUpperCase();
    for (let i = 0; i < mod.boundaryPins.length; i++) {
        if (normalizeBoundaryKey(mod.boundaryPins[i]) === key) {
            return true;
        }
    }
    return false;
}
function overviewAllowsNoPower(overview) {
    const t = overview.toLowerCase();
    return t.indexOf('æ— æº') >= 0 || t.indexOf('æµ®ç©º') >= 0 ||
        t.indexOf('æ•™å­¦') >= 0 || t.indexOf('æ— ç”µæº') >= 0 ||
        t.indexOf('battery-less') >= 0;
}
/** æ•™æå¸¸è§åº“å¤–å‹å· â€” å‡ºç°ä¸”åº“æ— æ³•è§£æåˆ™ HARD æ‹’æ”¶ plan */
const CLASSIC_OOD_HINTS = [
    'NE555', 'LM555', 'SE555', 'SA555', 'ICM7555', 'TLC555',
    '2N3904', '2N3906', 'BC547', 'BC557', 'BC337', 'BC327',
    'TIP120', 'TIP31C', 'TIP42C', 'Arduino', 'ATMEGA328',
    'ESP32', 'ESP8266', 'RASPBERRY'
];
function libraryHasId(library, id) {
    if (!id || id.length === 0) {
        return false;
    }
    try {
        const exact = library.getComponent(id);
        if (exact.success && exact.data) {
            return true;
        }
        // ä»…åšç²¾ç¡®/å¤§å°å†™å˜ä½“æŸ¥è¯¢ï¼Œé¿å… resolveLibraryId æ‰«å…¨åº“æ—¶å¯¹ç©º id è°ƒ toUpperCase å´©æ‰
        const upper = id.toUpperCase();
        if (upper !== id) {
            const byUpper = library.getComponent(upper);
            if (byUpper.success && byUpper.data) {
                return true;
            }
        }
    }
    catch (_e) {
        return false;
    }
    return false;
}
/** æ‰«ææ¨¡å— prompt ä¸­çš„åº“å¤–å‹å·æåŠ */
export function findOutOfLibraryMentions(text, library) {
    const found = [];
    const safe = text ?? '';
    const upper = safe.toUpperCase();
    for (let i = 0; i < CLASSIC_OOD_HINTS.length; i++) {
        const hint = CLASSIC_OOD_HINTS[i];
        const h = hint.toUpperCase();
        if (upper.indexOf(h) < 0) {
            continue;
        }
        if (!libraryHasId(library, hint)) {
            // 555 æ—åˆ«åå‡è§£æåˆ° LM555
            if (is555FamilyHint(hint) && libraryHasId(library, 'LM555')) {
                continue;
            }
            if (found.indexOf(hint) < 0) {
                found.push(hint);
            }
        }
    }
    // è£¸ 555 å®šæ—¶å™¨å†™æ³•ï¼ˆåº“æ—  LM555 æ—¶æ‹’æ”¶ï¼‰
    const has555Chip = upper.indexOf('NE555') >= 0 || upper.indexOf('LM555') >= 0 ||
        safe.indexOf('555å®šæ—¶') >= 0 || safe.indexOf('555 å®šæ—¶') >= 0 ||
        safe.indexOf('555æŒ¯è¡') >= 0 || safe.indexOf('555èŠ¯ç‰‡') >= 0 ||
        safe.indexOf('ï¼ˆ555') >= 0 || safe.indexOf('(555') >= 0 ||
        upper.indexOf('555ï¼‰') >= 0 || upper.indexOf('555)') >= 0;
    if (has555Chip || (upper.indexOf('555') >= 0 &&
        (safe.indexOf('æ— ç¨³æ€') >= 0 || safe.indexOf('å¤šè°') >= 0 || safe.indexOf('æŒ¯è¡å™¨') >= 0))) {
        if (!libraryHasId(library, 'NE555') && !libraryHasId(library, 'LM555') &&
            found.indexOf('555') < 0 && found.indexOf('NE555') < 0 && found.indexOf('NE555/555') < 0) {
            found.push('NE555/555');
        }
    }
    return found;
}
/**
 * ä»æ¨¡å— prompt è§£æ RefDes â†’ libDevIdï¼ˆlibDevId=XXX / U1ï¼ˆlibDevId=LM555ï¼‰/ U1=LM555ï¼‰ã€‚
 */
export function extractRefLibMapFromPrompt(prompt) {
    const map = new Map();
    const text = prompt ?? '';
    // RefDesï¼ˆlibDevId=XXXï¼‰æˆ– RefDes(libDevId=XXX)
    const re1 = /([A-Za-z]{1,5}\d{1,2})\s*[ï¼ˆ(]\s*libDevId\s*=\s*([A-Za-z0-9_.-]+)\s*[ï¼‰)]/gi;
    let m = re1.exec(text);
    while (m) {
        map.set((m[1] ?? '').toUpperCase(), (m[2] ?? '').trim());
        m = re1.exec(text);
    }
    // RefDes=LIB æˆ– RefDesï¼LIB
    const re2 = /([A-Za-z]{1,5}\d{1,2})\s*[=ï¼]\s*([A-Za-z0-9_.-]+)/gi;
    m = re2.exec(text);
    while (m) {
        const ref = (m[1] ?? '').toUpperCase();
        const lib = (m[2] ?? '').trim();
        if (!map.has(ref) && lib.length > 0 && looksLikeLibIdAsRefDes(lib)) {
            map.set(ref, lib);
        }
        m = re2.exec(text);
    }
    return map;
}
/** ä»æ–‡æœ¬æå–å‡ºç°çš„åº“å†… libDevId */
export function extractLibIdsInText(text, library) {
    const found = [];
    const upper = (text ?? '').toUpperCase();
    const re = /libDevId\s*=\s*([A-Za-z0-9_.-]+)/gi;
    let m = re.exec(text ?? '');
    while (m) {
        const id = (m[1] ?? '').trim();
        if (id.length > 0 && found.indexOf(id) < 0) {
            found.push(id);
        }
        m = re.exec(text ?? '');
    }
    const categories = library.getCategories();
    for (const cat of categories) {
        const result = library.listByCategory(cat, 1, 200);
        for (const d of result.items) {
            const id = d.id;
            if (id.length < 2) {
                continue;
            }
            if (upper.indexOf(id.toUpperCase()) >= 0 && found.indexOf(id) < 0) {
                found.push(id);
            }
        }
    }
    return found;
}
/** ç”µæº/æ— æº/å¸¸è§åˆ†ç«‹ä¸ç®—ã€Œæ“…è‡ªåŠ çš„å¤§å™¨ä»¶ã€ */
function isInfrastructureLib(libId) {
    const id = (libId ?? '').toUpperCase();
    if (id === 'VCC' || id === 'GND' || id === 'VAC' || id === 'VDD' || id === 'VSS') {
        return true;
    }
    if (id.indexOf('R_') === 0 || id.indexOf('C_') === 0 || id.indexOf('L_') === 0) {
        return true;
    }
    if (id.indexOf('POT_') === 0 || id.indexOf('XTAL_') === 0 || id.indexOf('FUSE_') === 0) {
        return true;
    }
    if (id.indexOf('LED_') === 0 || id.indexOf('1N') === 0) {
        return true;
    }
    if (id.indexOf('2N') === 0 || id.indexOf('IRF') === 0) {
        return true;
    }
    if (id === 'SW_PUSH' || id === 'BUZZER' || id === 'RELAY_SPDT') {
        return true;
    }
    return false;
}
function isInstrumentLib(libId) {
    const id = (libId ?? '').toUpperCase();
    return id.indexOf('OSCILLOSCOPE') >= 0 || id.indexOf('VOLTMETER') >= 0 ||
        id.indexOf('AMMETER') >= 0 || id.indexOf('UART_TERMINAL') >= 0 ||
        id.indexOf('LOGIC_ANALYZER') >= 0 || id.indexOf('POWER_METER') >= 0 ||
        id.indexOf('FREQ_COUNTER') >= 0 || id.indexOf('VIRTUAL_METER') >= 0;
}
/** ç”¨æˆ·éœ€æ±‚æ˜¯å¦è¶³ä»¥æ”¯æ’‘è¯¥ libDevIdï¼ˆé€šç”¨å¿ å®åº¦ï¼Œéåœºæ™¯ç‰¹ä¾‹ï¼‰ */
function userSolicitsLib(userPrompt, libId) {
    const u = (userPrompt ?? '').toLowerCase();
    const uUpper = (userPrompt ?? '').toUpperCase();
    const id = (libId ?? '').toUpperCase();
    if (id.length === 0) {
        return true;
    }
    if (uUpper.indexOf(id) >= 0) {
        return true;
    }
    // ä»ªå™¨ï¼šæµ‹é‡/è§‚æµ‹ç±»å…³é”®è¯
    if (isInstrumentLib(id)) {
        if (id.indexOf('OSCILLOSCOPE') >= 0) {
            return u.indexOf('ç¤ºæ³¢') >= 0 || u.indexOf('æ³¢å½¢') >= 0 || u.indexOf('æŒ‡æ•°') >= 0 ||
                u.indexOf('oscilloscope') >= 0 || u.indexOf('è§‚æµ‹') >= 0 || u.indexOf('Ï„') >= 0 ||
                u.indexOf('æ—¶é—´å¸¸æ•°') >= 0 || u.indexOf('å……æ”¾ç”µ') >= 0;
        }
        if (id.indexOf('VOLTMETER') >= 0) {
            return u.indexOf('ç”µå‹è¡¨') >= 0 || u.indexOf('æµ‹ç”µå‹') >= 0 || u.indexOf('åˆ†å‹') >= 0 ||
                u.indexOf('voltmeter') >= 0;
        }
        if (id.indexOf('AMMETER') >= 0) {
            return u.indexOf('ç”µæµè¡¨') >= 0 || u.indexOf('æµ‹ç”µæµ') >= 0 || u.indexOf('ammeter') >= 0;
        }
        if (id.indexOf('UART') >= 0) {
            return u.indexOf('uart') >= 0 || u.indexOf('ä¸²å£') >= 0 || u.indexOf('ç»ˆç«¯') >= 0;
        }
        if (id.indexOf('LOGIC') >= 0) {
            return u.indexOf('é€»è¾‘åˆ†æ') >= 0 || u.indexOf('æ•°å­—') >= 0 || u.indexOf('é—¨ç”µè·¯') >= 0;
        }
        // å…¶å®ƒä»ªå™¨ï¼šç”¨æˆ·ç‚¹åæµ‹é‡/ä»ªå™¨å³å…è®¸
        return u.indexOf('ä»ªå™¨') >= 0 || u.indexOf('æµ‹é‡') >= 0 || u.indexOf('meter') >= 0;
    }
    // å®šæ—¶å™¨æ—
    if (id.indexOf('555') >= 0) {
        return uUpper.indexOf('555') >= 0 || u.indexOf('æ–¹æ³¢') >= 0 || u.indexOf('æŒ¯è¡') >= 0 ||
            u.indexOf('å®šæ—¶') >= 0 || u.indexOf('å¤šè°') >= 0 || u.indexOf('æ— ç¨³æ€') >= 0;
    }
    // MCU æ—
    if (id.indexOf('STM32') >= 0 || id.indexOf('AT89') >= 0 || id.indexOf('STC') >= 0) {
        return uUpper.indexOf('STM32') >= 0 || uUpper.indexOf('AT89') >= 0 ||
            uUpper.indexOf('STC') >= 0 || u.indexOf('å•ç‰‡æœº') >= 0 || u.indexOf('mcu') >= 0 ||
            u.indexOf('å¾®æ§') >= 0 || u.indexOf('æœ€å°ç³»ç»Ÿ') >= 0;
    }
    // è¿æ”¾æ—
    if (id.indexOf('741') >= 0 || id.indexOf('LM358') >= 0 || id.indexOf('TL082') >= 0) {
        return u.indexOf('è¿æ”¾') >= 0 || u.indexOf('æ”¾å¤§') >= 0 || u.indexOf('è·Ÿéš') >= 0 ||
            uUpper.indexOf('741') >= 0 || uUpper.indexOf('LM358') >= 0 || uUpper.indexOf('TL082') >= 0;
    }
    // é€»è¾‘ IC
    if (id.indexOf('74HC') === 0 || id.indexOf('CD40') === 0) {
        return u.indexOf('é—¨ç”µè·¯') >= 0 || u.indexOf('é€»è¾‘') >= 0 || uUpper.indexOf('74HC') >= 0 ||
            uUpper.indexOf('CD40') >= 0 || u.indexOf('è®¡æ•°') >= 0;
    }
    // ç¨³å‹
    if (id.indexOf('LM78') === 0 || id.indexOf('AMS1117') === 0 || id.indexOf('LM2596') === 0) {
        return u.indexOf('ç¨³å‹') >= 0 || u.indexOf('ç”µæº') >= 0 || u.indexOf('ldo') >= 0 ||
            u.indexOf('é™å‹') >= 0 || uUpper.indexOf(id) >= 0;
    }
    // é»˜è®¤ï¼šç”¨æˆ·åŸæ–‡å‡ºç°å‹å·å…³é”®è¯ï¼ˆå»å‰ç¼€æ•°å­—æ¯”å¯¹å¼±åŒ¹é…ï¼‰
    const short = id.replace(/_/g, '');
    return short.length >= 4 && uUpper.indexOf(short) >= 0;
}
/**
 * é€šç”¨å¿ å®åº¦ï¼šplan ä¸­çš„é‡å¤§æœ‰æº/ä»ªå™¨å¿…é¡»èƒ½è¢«ç”¨æˆ·éœ€æ±‚æ”¯æ’‘ã€‚
 * æ— æºã€ç”µæºã€åŸºç¡€åˆ†ç«‹ä¸æ‹¦ã€‚
 */
function detectUnsolicitedMajorDevices(userPrompt, plan, library) {
    const issues = [];
    const planText = `${plan.systemOverview}\n${plan.modules.map(m => m.prompt).join('\n')}`;
    const libs = extractLibIdsInText(planText, library);
    const bad = [];
    for (let i = 0; i < libs.length; i++) {
        const id = libs[i];
        if (isInfrastructureLib(id)) {
            continue;
        }
        if (userSolicitsLib(userPrompt, id)) {
            continue;
        }
        if (bad.indexOf(id) < 0) {
            bad.push(id);
        }
    }
    if (bad.length > 0) {
        issues.push(`æ“…è‡ªåŠ å…¥ç”¨æˆ·æœªè¦æ±‚çš„å™¨ä»¶ [${bad.join(',')}] â€” ` +
            'è¯·å¿ å®ç”¨æˆ·éœ€æ±‚ï¼Œåˆ é™¤æ‰©å®¹èŠ¯ç‰‡/ä»ªå™¨ï¼Œæˆ–æ”¹ç”¨éœ€æ±‚æ˜ç¡®ç‚¹åçš„æ–¹æ¡ˆ');
    }
    return issues;
}
function libraryPinIds(library, libId) {
    const ids = [];
    try {
        const comp = library.getComponent(libId);
        if (comp.success && comp.data && comp.data.pins) {
            for (let i = 0; i < comp.data.pins.length; i++) {
                const p = comp.data.pins[i];
                const pid = `${p.id ?? ''}`.toUpperCase();
                const pname = `${p.name ?? ''}`.toUpperCase();
                if (pid.length > 0 && ids.indexOf(pid) < 0) {
                    ids.push(pid);
                }
                if (pname.length > 0 && ids.indexOf(pname) < 0) {
                    ids.push(pname);
                }
            }
            return ids;
        }
        const meta = library.getDeviceMeta(libId);
        if (meta.success && meta.data && meta.data.pin_list) {
            for (let i = 0; i < meta.data.pin_list.length; i++) {
                const mp = meta.data.pin_list[i];
                const pid = `${mp.pin_id ?? ''}`.toUpperCase();
                const pl = `${mp.pin_label ?? ''}`.toUpperCase();
                if (pid.length > 0 && ids.indexOf(pid) < 0) {
                    ids.push(pid);
                }
                if (pl.length > 0 && ids.indexOf(pl) < 0) {
                    ids.push(pl);
                }
            }
        }
    }
    catch (_e) {
        // ignore
    }
    return ids;
}
function pinMatchesLibrary(library, libId, pinHint) {
    const h = (pinHint ?? '').toUpperCase().trim();
    if (h.length === 0 || libId.length === 0) {
        return false;
    }
    const pins = libraryPinIds(library, libId);
    if (pins.length === 0) {
        return true; // æ— è„šä¿¡æ¯åˆ™ä¸è¯¯æ€
    }
    for (let i = 0; i < pins.length; i++) {
        if (pins[i] === h) {
            return true;
        }
    }
    return false;
}
/** çŒœæµ‹ RefDes å¯¹åº” libï¼ˆæ— æ˜¾å¼æ˜ å°„æ—¶ï¼‰ï¼šOSC*â†’ç¤ºæ³¢å™¨ï¼ŒRV*â†’ç”µä½å™¨ï¼ŒVM*â†’ç”µå‹è¡¨â€¦ */
function inferLibIdFromRefDes(refDes, modPrompt, library) {
    const ref = (refDes ?? '').toUpperCase();
    const map = extractRefLibMapFromPrompt(modPrompt);
    const hit = map.get(ref);
    if (hit && hit.length > 0) {
        return hit;
    }
    const libs = extractLibIdsInText(modPrompt, library);
    let wantKind = '';
    if (ref.indexOf('OSC') === 0 || ref.indexOf('SCOPE') === 0) {
        wantKind = 'OSC';
    }
    else if (ref.indexOf('VM') === 0) {
        wantKind = 'VM';
    }
    else if (ref.indexOf('AM') === 0) {
        wantKind = 'AM';
    }
    else if (ref.indexOf('RV') === 0) {
        wantKind = 'POT';
    }
    else if (ref.indexOf('UART') === 0) {
        wantKind = 'UART';
    }
    else if (ref.indexOf('LA') === 0) {
        wantKind = 'LA';
    }
    if (wantKind.length > 0) {
        for (let li = 0; li < libs.length; li++) {
            const idU = libs[li].toUpperCase();
            if (wantKind === 'OSC' && idU.indexOf('OSCILLOSCOPE') >= 0) {
                return libs[li];
            }
            if (wantKind === 'VM' && idU.indexOf('VOLTMETER') >= 0) {
                return libs[li];
            }
            if (wantKind === 'AM' && idU.indexOf('AMMETER') >= 0) {
                return libs[li];
            }
            if (wantKind === 'POT' && idU.indexOf('POT_') === 0) {
                return libs[li];
            }
            if (wantKind === 'UART' && idU.indexOf('UART') >= 0) {
                return libs[li];
            }
            if (wantKind === 'LA' && idU.indexOf('LOGIC') >= 0) {
                return libs[li];
            }
        }
    }
    if (ref.indexOf('R') === 0 && ref.indexOf('RV') !== 0) {
        for (let li = 0; li < libs.length; li++) {
            if (libs[li].indexOf('R_') === 0) {
                return libs[li];
            }
        }
    }
    if (ref.indexOf('C') === 0) {
        for (let li = 0; li < libs.length; li++) {
            if (libs[li].indexOf('C_') === 0) {
                return libs[li];
            }
        }
    }
    if (ref.indexOf('U') === 0) {
        for (let li = 0; li < libs.length; li++) {
            if (!isInfrastructureLib(libs[li]) && !isInstrumentLib(libs[li])) {
                return libs[li];
            }
        }
    }
    return '';
}
/** prompt/boundary è„šåå¹»è§‰ä¸åº“è„šæ ¡éªŒ */
function detectInvalidPins(mod, library) {
    const issues = [];
    const p = mod.prompt ?? '';
    if (p.indexOf('å‡è®¾') >= 0 || p.indexOf('å‡å®š') >= 0) {
        issues.push(`æ¨¡å— ${mod.id} prompt å«ã€Œå‡è®¾/å‡å®šã€è„šå â€” ç¦æ­¢çŒœæµ‹ï¼Œå¿…é¡»ä½¿ç”¨åº“å†…çœŸå® pinId`);
    }
    if (p.indexOf('æ‚¬ç©º') >= 0 && p.indexOf('å¯æ‚¬ç©º') < 0) {
        issues.push(`æ¨¡å— ${mod.id} prompt å°†å¼•è„šã€Œæ‚¬ç©ºã€å½“ä½œå®Œæˆæ€ â€” è¯·è¿æ¥ã€åˆ é™¤å™¨ä»¶æˆ–æ˜ç¡®æ ‡ä¸º NC ä¸”ä¸è¿› boundaryPins`);
    }
    if (!library) {
        return issues;
    }
    for (const bp of mod.boundaryPins) {
        const key = normalizeBoundaryKey(bp);
        const parts = key.split('.');
        if (parts.length < 2) {
            continue;
        }
        const ref = parts[0];
        const pin = parts.slice(1).join('.');
        if (looksLikeLibIdAsRefDes(ref)) {
            continue;
        }
        const libId = inferLibIdFromRefDes(ref, mod.prompt, library);
        if (libId.length === 0) {
            continue;
        }
        if (!pinMatchesLibrary(library, libId, pin)) {
            const ok = libraryPinIds(library, libId).slice(0, 8).join('/');
            issues.push(`æ¨¡å— ${mod.id} boundaryPin ${bp} è„šã€Œ${pin}ã€ä¸å±äº ${libId}` +
                (ok.length > 0 ? `ï¼ˆå¯ç”¨: ${ok}ï¼‰` : ''));
        }
    }
    return issues;
}
/** è¾¹ç•Œé—¨ç¦ï¼›è¿”å›é—®é¢˜åˆ—è¡¨ï¼ˆç©º=é€šè¿‡ï¼‰ã€‚ä¼ å…¥ library æ—¶é¢å¤–æ‹’æ”¶åº“å¤–å‹å·ã€‚ */
export function critiqueModularPlan(plan, library, userPrompt) {
    const issues = [];
    if (plan.systemOverview.trim().length < 8) {
        issues.push('systemOverview è¿‡çŸ­ â€” éœ€æè¿°æ•´ç”µè·¯åŠŸèƒ½ä¸ä¿¡å·æµ');
    }
    if (plan.modules.length < 2 || plan.modules.length > 4) {
        issues.push(`modules æ•°é‡é¡»ä¸º 2ï½4ï¼Œå½“å‰ ${plan.modules.length}`);
    }
    const idSet = new Set();
    const jointedBoundaries = new Set();
    for (const m of plan.modules) {
        if (idSet.has(m.id)) {
            issues.push(`æ¨¡å— id é‡å¤: ${m.id}`);
        }
        idSet.add(m.id);
        if (m.prompt.trim().length < 12) {
            issues.push(`æ¨¡å— ${m.id} prompt è¿‡çŸ­`);
        }
        if (m.boundaryPins.length === 0) {
            issues.push(`æ¨¡å— ${m.id} ç¼ºå°‘ boundaryPinsï¼ˆè¿æ¥è¾¹ç•Œï¼‰`);
        }
        for (const bp of m.boundaryPins) {
            const key = normalizeBoundaryKey(bp);
            if (key.indexOf('.') < 0) {
                issues.push(`æ¨¡å— ${m.id} boundaryPin æ ¼å¼é¡»ä¸º RefDes.Pin: ${bp}`);
                continue;
            }
            const ref = key.split('.')[0];
            if (looksLikeLibIdAsRefDes(ref)) {
                issues.push(`æ¨¡å— ${m.id} boundaryPin ${bp} æŠŠå‹å·/libDevIdã€Œ${ref}ã€å½“æˆäº† RefDes` +
                    ` â€” è¯·æ”¹ç”¨ä½å·å¦‚ U1/D1/R1ï¼ˆå‹å·å†™åœ¨ promptï¼Œå‹¿å†™å…¥ boundaryPins/jointsï¼‰`);
                continue;
            }
            // å¼±æ ¡éªŒï¼šprompt ä¸­åº”å‡ºç° RefDesï¼ˆé¿å…å®Œå…¨æ— å…³çš„è¾¹ç•Œï¼‰
            if (ref.length >= 1 && m.prompt.toUpperCase().indexOf(ref) < 0) {
                issues.push(`æ¨¡å— ${m.id} çš„ boundaryPin ${bp} ä¸­ RefDes=${ref} æœªåœ¨ prompt ä¸­å‡ºç°`);
            }
        }
        if (library) {
            const ood = findOutOfLibraryMentions(m.prompt, library);
            if (ood.length > 0) {
                issues.push(`æ¨¡å— ${m.id} prompt å«åº“å¤–å‹å· [${ood.join(',')}] â€” å¿…é¡»æ”¹ç”¨å¯ç”¨ libDevId`);
            }
        }
        const pinIssues = detectInvalidPins(m, library);
        for (let hi = 0; hi < pinIssues.length; hi++) {
            issues.push(pinIssues[hi]);
        }
    }
    if (library) {
        const oodOverview = findOutOfLibraryMentions(plan.systemOverview, library);
        if (oodOverview.length > 0) {
            issues.push(`systemOverview å«åº“å¤–å‹å· [${oodOverview.join(',')}] â€” æ”¹å†™ä¸ºåº“å†…æ–¹æ¡ˆæè¿°`);
        }
    }
    if (userPrompt && userPrompt.trim().length > 0 && library) {
        const creep = detectUnsolicitedMajorDevices(userPrompt, plan, library);
        for (let ci = 0; ci < creep.length; ci++) {
            issues.push(creep[ci]);
        }
    }
    if (plan.joints.length === 0) {
        issues.push('joints ä¸ºç©º â€” å¿…é¡»ç»™å‡ºæ¨¡å—é—´/ç”µæº pinâ†”pin');
    }
    let powerJoints = 0;
    for (const j of plan.joints) {
        const a = parseModularEndpoint(j.from);
        const b = parseModularEndpoint(j.to);
        if (!a || !b) {
            issues.push(`joint æ— æ³•è§£æ: ${j.from} â†” ${j.to}`);
            continue;
        }
        if (a.kind === 'power' || b.kind === 'power') {
            powerJoints++;
        }
        for (const ep of [a, b]) {
            if (ep.kind !== 'module') {
                continue;
            }
            if (!idSet.has(ep.moduleId)) {
                issues.push(`joint å¼•ç”¨æœªçŸ¥æ¨¡å— ${ep.moduleId}: ${ep.raw}`);
                continue;
            }
            if (looksLikeLibIdAsRefDes(ep.refDes)) {
                issues.push(`joint ${ep.raw} æŠŠå‹å·/libDevIdã€Œ${ep.refDes}ã€å½“æˆäº† RefDes` +
                    ` â€” è¯·æ”¹ç”¨ä½å·å¦‚ U1/D1/R1`);
            }
            const mod = plan.modules.find(x => x.id === ep.moduleId);
            if (!mod) {
                continue;
            }
            if (library) {
                const libId = inferLibIdFromRefDes(ep.refDes, mod.prompt, library);
                if (libId.length > 0 && !pinMatchesLibrary(library, libId, ep.pin)) {
                    const ok = libraryPinIds(library, libId).slice(0, 8).join('/');
                    issues.push(`joint ${ep.raw} è„šã€Œ${ep.pin}ã€ä¸å±äº ${libId}` +
                        (ok.length > 0 ? `ï¼ˆå¯ç”¨: ${ok}ï¼‰` : ''));
                }
            }
            if (!boundaryContains(mod, ep.refDes, ep.pin)) {
                issues.push(`joint ${ep.raw} ä¸åœ¨æ¨¡å— ${ep.moduleId} çš„ boundaryPins ä¸­ï¼ˆé¡»ç²¾ç¡® RefDes.Pinï¼‰`);
            }
            else {
                jointedBoundaries.add(`${ep.moduleId}|${ep.refDes}.${ep.pin}`.toUpperCase());
            }
        }
    }
    // æ¯ä¸ª boundaryPin åº”è‡³å°‘å‡ºç°åœ¨ä¸€æ¡ jointï¼ˆå« POWERï¼‰
    for (const m of plan.modules) {
        for (const bp of m.boundaryPins) {
            const key = normalizeBoundaryKey(bp);
            const tag = `${m.id}|${key}`.toUpperCase();
            if (!jointedBoundaries.has(tag)) {
                issues.push(`æ¨¡å— ${m.id} çš„ boundaryPin ${bp} æœªå‡ºç°åœ¨ä»»ä½• joint ä¸­`);
            }
        }
    }
    if (powerJoints === 0 && !overviewAllowsNoPower(plan.systemOverview)) {
        issues.push('ç¼ºå°‘ POWER.VCC / POWER.GND ç›¸å…³ jointsï¼ˆæ— æº/æ•™å­¦ç”µè·¯è¯·åœ¨ overview æ ‡æ˜ï¼‰');
    }
    return issues;
}
function offsetTopo(topo, dx, dy) {
    for (const d of topo.deviceList) {
        d.x += dx;
        d.y += dy;
    }
    for (const w of topo.wireList) {
        for (const p of w.points) {
            p.x += dx;
            p.y += dy;
        }
    }
    for (const lb of topo.netLabelList) {
        lb.x += dx;
        lb.y += dy;
    }
}
function prefixRefNames(topo, prefix) {
    for (const d of topo.deviceList) {
        if (d.refName.indexOf(prefix) !== 0) {
            d.refName = `${prefix}${d.refName}`;
        }
    }
}
function remapUuids(topo, tag) {
    const map = new Map();
    for (const d of topo.deviceList) {
        const neu = IdUtil.generate(`mod_${tag}`);
        map.set(d.instUuid, neu);
        d.instUuid = neu;
    }
    const netMap = new Map();
    for (const n of topo.netList) {
        const oldNet = n.netUuid;
        const neuNet = IdUtil.generate(`net_${tag}`);
        netMap.set(oldNet, neuNet);
        n.netUuid = neuNet;
        for (const p of n.nodeList) {
            const mapped = map.get(p.devUuid);
            if (mapped) {
                p.devUuid = mapped;
            }
        }
    }
    for (const w of topo.wireList) {
        const mappedNet = netMap.get(w.netUuid);
        if (mappedNet) {
            w.netUuid = mappedNet;
        }
    }
    for (const lb of topo.netLabelList) {
        const mappedNet = netMap.get(lb.netUuid);
        if (mappedNet) {
            lb.netUuid = mappedNet;
        }
    }
    return map;
}
/** ä¸¥æ ¼æŒ‰ M{id}_{Ref} / _{Ref} / ç²¾ç¡® Refï¼›å†æŒ‰æ¨¡å—å†… libDevIdï¼ˆå« 555 åˆ«åï¼‰å›é€€ */
function findDevice(topo, moduleId, refDes) {
    const pref = `${moduleId}_`;
    const want = (refDes ?? '').toUpperCase();
    if (want.length === 0) {
        return null;
    }
    const exactPref = `${pref}${want}`.toUpperCase();
    for (const d of topo.deviceList) {
        if ((d.refName ?? '').toUpperCase() === exactPref) {
            return d;
        }
    }
    for (const d of topo.deviceList) {
        if ((d.refName ?? '').toUpperCase() === want) {
            return d;
        }
    }
    for (const d of topo.deviceList) {
        const rn = (d.refName ?? '').toUpperCase();
        if (rn.endsWith(`_${want}`)) {
            return d;
        }
    }
    // å›é€€ï¼šplan è¯¯ç”¨ libDevId å½“ RefDesï¼ˆM1.LM555 â†’ æ¨¡å—å†… lib=LM555ï¼‰
    const wantLib = normalizeLibAlias(want);
    const prefUpper = pref.toUpperCase();
    const byLibInMod = [];
    for (const d of topo.deviceList) {
        if (d.libDevId === 'VCC' || d.libDevId === 'GND') {
            continue;
        }
        if (normalizeLibAlias(d.libDevId) !== wantLib) {
            continue;
        }
        if ((d.refName ?? '').toUpperCase().indexOf(prefUpper) === 0) {
            byLibInMod.push(d);
        }
    }
    if (byLibInMod.length >= 1) {
        return byLibInMod[0];
    }
    // ç¦æ­¢è·¨æ¨¡å— libDevId å”¯ä¸€æ€§å›é€€ï¼šå¤šæ¨¡å—åŒå‹å·ä¼šè¯¯ç»‘ä»–æ¨¡å—å™¨ä»¶ â†’ jointFail/é”™è„š
    return null;
}
/** åˆå¹¶åŒåç”µæºè½¨ç½‘ï¼ˆVCC/GND/VDD/VSSï¼‰ï¼Œæ¶ˆé™¤æ¨¡å—å¹¶è¡Œåçš„é‡å¤ç½‘ç»œæ ‡å· */
function unifyPowerRailNets(topo) {
    const railKey = (name) => {
        const u = (name ?? '').toUpperCase();
        if (u === 'VDD' || u === 'VCC') {
            return 'VCC';
        }
        if (u === 'VSS' || u === 'GND' || u === '0') {
            return 'GND';
        }
        return '';
    };
    const keepByRail = new Map();
    const drop = new Map();
    let merged = 0;
    for (let i = 0; i < topo.netList.length; i++) {
        const n = topo.netList[i];
        const key = railKey(n.netName);
        if (key.length === 0) {
            continue;
        }
        const keep = keepByRail.get(key);
        if (!keep) {
            n.netName = key;
            n.displayName = key;
            n.isPower = true;
            keepByRail.set(key, n);
            continue;
        }
        for (let j = 0; j < n.nodeList.length; j++) {
            const node = n.nodeList[j];
            const dup = keep.nodeList.some(p => p.devUuid === node.devUuid && p.pinId === node.pinId);
            if (!dup) {
                keep.nodeList.push(node);
            }
        }
        drop.set(n.netUuid, keep.netUuid);
        merged++;
    }
    if (drop.size === 0) {
        return 0;
    }
    topo.netList = topo.netList.filter(n => !drop.has(n.netUuid));
    for (let i = 0; i < topo.wireList.length; i++) {
        const w = topo.wireList[i];
        const neu = drop.get(w.netUuid);
        if (neu) {
            w.netUuid = neu;
        }
    }
    for (let i = 0; i < topo.netLabelList.length; i++) {
        const lb = topo.netLabelList[i];
        const neu = drop.get(lb.netUuid);
        if (neu) {
            lb.netUuid = neu;
        }
        const t = (lb.text ?? '').toUpperCase();
        if (t === 'VDD') {
            lb.text = 'VCC';
        }
        else if (t === 'VSS') {
            lb.text = 'GND';
        }
    }
    Logger.info(INSTR_TRACE_TAG, `[AI_PIPE] modular_merge unifyPowerRails merged=${merged}` +
        ` vcc=${keepByRail.has('VCC')} gnd=${keepByRail.has('GND')}`);
    return merged;
}
/**
 * æ¨¡å—å¹¶è¡Œæµå¼é¢„è§ˆï¼šæŒ‰ä¸ merge ç›¸åŒçš„åˆ—é—´è·/å‰ç¼€æ‹¼åˆå·²å®Œæˆçš„å­æ¨¡å—æ‹“æ‰‘ï¼ˆä¸å« jointsï¼‰ã€‚
 * ç”¨äºå¹¶è¡Œç”Ÿå›¾è¿‡ç¨‹ä¸­é€å¸§æŠŠå„æ¨¡å—æ‘†åˆ°ç”»å¸ƒä¸Šã€‚
 */
export function buildModularStreamPreview(moduleTopos, plan, colPitch = 400) {
    const preview = emptySchTopology();
    preview.schName = 'AI Modular Preview';
    preview.bgColor = '#FFFFFF';
    if (!plan || !plan.modules) {
        return preview;
    }
    for (let i = 0; i < plan.modules.length; i++) {
        const mod = plan.modules[i];
        const src = i < moduleTopos.length ? moduleTopos[i] : null;
        if (!mod || !src || !src.deviceList || src.deviceList.length === 0) {
            continue;
        }
        const topo = mapAwareParse(mapAwareStringify(src));
        offsetTopo(topo, i * colPitch, 0);
        prefixRefNames(topo, `${mod.id}_`);
        remapUuids(topo, `pv_${mod.id}`);
        for (let di = 0; di < topo.deviceList.length; di++) {
            preview.deviceList.push(topo.deviceList[di]);
        }
        for (let wi = 0; wi < topo.wireList.length; wi++) {
            preview.wireList.push(topo.wireList[wi]);
        }
        for (let ni = 0; ni < topo.netList.length; ni++) {
            preview.netList.push(topo.netList[ni]);
        }
        for (let li = 0; li < topo.netLabelList.length; li++) {
            preview.netLabelList.push(topo.netLabelList[li]);
        }
    }
    return preview;
}
/**
