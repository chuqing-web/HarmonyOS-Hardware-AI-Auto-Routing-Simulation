  parts.push('   - 【硬禁】禁止 wire_series_rc；禁止 VCC→SW→R→C→GND；禁止 THRES/DISCH 贴 GND；禁止 CTRL 旁路挂 TRIG');
  parts.push('   - 单稳态拓扑错 → wire_555_monostable；无稳态错 → reconnect_pin / join_by_label（按手册）');
  parts.push('12. 【串联 RC 充放电】仅当用户要充放电/τ=RC/指数波形，且板上无 LM555、无互斥双色时:');
  parts.push('   - 正确: VCC→(SW_PUSH)→R→RC_MID→C→GND；示波器 CH1→RC_MID，GND→GND');
  parts.push('   - 【硬】禁止用 RELAY_SPDT 冒充充放电开关；若板上有多余 RELAY → remove_component');
  parts.push('   - 错误并联/开路 → wire_series_rc');
  parts.push('   - 【硬】只要器件列表含 LM555 → 禁止本条，改走第 11 条');
  parts.push('13. 运放/双电源: 开环→wire_opamp_feedback；有 VEE 符号→wire_dual_supply；禁止挂库外假脚 V+/V-（UA741 用 VCC/VEE）');
  parts.push('14. 电位器三端未接好 → wire_potentiometer');
  parts.push('15. 【完整生图门禁】必须消除全部阻断项:');
  parts.push('   - 所有 severity=error/critical');
  parts.push('   - 严重影响功能的 warning（开环/未连接/短路风险/仪器接错/GPIO直连电源/LED不亮或烧毁风险等）');
  parts.push('   - 几何 error：wire_body / pin_proximity / wire_cross');
  parts.push('   - 仅软性建议可保留：去耦数量余量、入口电解、耐压余量、连线拥挤 warning');
  parts.push('   - passed=true 仅当无上述阻断项');
  parts.push('');
  parts.push('【修复目标】: 输出的 fixAction 必须能把 ERC 与几何阻断清零；优先修复 unconnected_pin / floating / 短路 / 缺电源 / 穿选中区。');
  parts.push('');
  parts.push('【工具选择决策表 — 必须按症状选工具，选错无效】:');
  parts.push('| 症状 | 正确 fixAction | 禁止 |');
  parts.push('|------|----------------|------|');
  parts.push('| 多网几何违规(pin_proximity/wire_body/wire_cross) | demote_geo_nets（首选）或 demote_to_label/demote_power_rails | rebuild_instrument、heal_floating |');
  parts.push('| 单网贴脚/穿体 | demote_to_label（必填 netName）或 move_device/nudge_device | rebuild_instrument |');
  parts.push('| 电源轨 stub 贴运放邻脚 | demote_power_rails 或 strip_phantom_pins | reconnect 假脚 V+/V- |');
  parts.push('| 库外假脚(V+/V- on UA741) | strip_phantom_pins | reconnect_pin 到假脚 |');
  parts.push('| 示波器未用 CH 互连/NC | prune_unused_osc_channels 或 disconnect_pin | rebuild_instrument 空转、reconnect→GND |');
  parts.push('| 仪器未接/接错/测量脚挂电源轨 | rebuild_instrument | 仅 reroute |');
  parts.push('| 浮空关键脚（非几何） | heal_floating 或 reconnect_pin | rebuild_instrument（除非同时是仪器） |');
  parts.push('| VCC↔GND 同网短路 | split_power_short | 仅 demote |');
  parts.push('| 仪器 I+/I- 等同网短路 | heal_electrical | 仅 demote |');
  parts.push('| 运放开环 | wire_opamp_feedback | 零散 reconnect |');
  parts.push('| 双电源轨未接 | wire_dual_supply | 挂假脚 V+/V- |');
  parts.push('| SIGNAL_GEN 缺 GND/OUT | ensure_signal_gen | 编造脚名 |');
  parts.push('| 板上有 LM555 单稳态拓扑错 | wire_555_monostable | wire_series_rc |');
  parts.push('| 板上有 LM555 无稳态拓扑错 | reconnect_pin / join_by_label（按手册） | wire_series_rc |');
  parts.push('| 串联 RC 拓扑错（且无 LM555） | wire_series_rc | wire_relay |');
  parts.push('| 互斥双色触点错 | wire_relay | wire_series_rc |');
  parts.push('| 电位器接线错 | wire_potentiometer | 零散 reconnect 漏脚 |');
  parts.push('| 缺库内器件 | add_component（精确 libDevId） | 编造库外 ID |');
  parts.push('| 器件重叠/通道不足 | move_device / nudge_device / rotate_device | demote_all 当唯一手段 |');
  parts.push('| 单脚孤儿网 | prune_singleton_nets | add_component |');
  parts.push('| 拓扑已正确仅布线差 | reroute | rebuild_instrument |');
  parts.push('');
  parts.push(catalog);
  parts.push('');
  parts.push('【严禁】:');
  parts.push('1. 禁止编造库外 ID；电阻用 R_330/R_1k，电容用 C_10uF/C_100nF');
  parts.push('2. 禁止非 MCU 随意 add 滤波电容；LED 已有足够 R 时禁止再加 R');
  parts.push('3. 纯几何禁止 rebuild_instrument；未用 OSC 通道禁止 rebuild 空转，用 prune_unused_osc_channels');
  parts.push('4. 禁止 reconnect 库外假脚；先 strip_phantom_pins');
  parts.push('5. 有 LM555 禁止 wire_series_rc；无 555 的纯 RC 充放电才用 wire_series_rc；互斥双色用 wire_relay；勿混用');
  parts.push('6. 同一问题不要重复多条相同 fixAction；多网几何优先一条 demote_geo_nets');
  parts.push('7. 修复方案不得与「器件使用手册」冲突');
  parts.push('8. fixAction 必须是目录中的精确名；禁止 invent 新名字');
  parts.push('');
  parts.push('输出纯 JSON（issues[].desc / summary 等说明必须写在 JSON 字段内，禁止 JSON 外散文）。');
  parts.push('Schema: {');
  parts.push('  "passed": true/false,');
  parts.push('  "issues": [');
  parts.push('    {"type":"missing_power|instrument_topo|wire_layout|component_value|mcu_system|floating_pin|net_integrity",');
  parts.push('     "severity":"error|warning",');
  parts.push('     "desc":"问题描述(中文)",');
  parts.push('     "targetDevice":"受影响的器件refName（必须与器件列表一致）",');
  parts.push('     "fixAction":"' + enumStr + '",');
  parts.push('     "fixDetail":{');
  parts.push('       "libDevId":"库内精确ID如R_330/C_100nF/RELAY_SPDT",');
  parts.push('       "refName":"位号",');
  parts.push('       "pinId":"1 / CH1 / GND / VCC",');
  parts.push('       "netName":"目标网名",');
  parts.push('       "toNet":"同 netName 别名",');
  parts.push('       "fromNet":"join_by_label 源网名",');
  parts.push('       "x":绝对坐标x,');
  parts.push('       "y":绝对坐标y,');
  parts.push('       "dx":相对位移x,');
  parts.push('       "dy":相对位移y,');
  parts.push('       "rotate":0|90|180|270,');
  parts.push('       "paramKey":"参数键名",');
  parts.push('       "paramValue":"参数值",');
  parts.push('       "reason":"修复原因(一句话)"');
  parts.push('     }}');
  parts.push('  ],');
  parts.push('  "summary":"审查总结(一句话中文)"');
  parts.push('}');
  return parts.join('\n');
}

export const SELF_REVIEW_PROMPT: PromptTemplate = {
  id: 'self_review_v14',
  version: '14.0.0',
  system: buildSelfReviewSystem(),
  userTemplate: '{{conversation_history}}用户原始需求：{{user_prompt}}\n\n=== 当前电路拓扑 ===\n器件({{device_count}}个):\n{{device_summary}}\n\n网络({{net_count}}个):\n{{net_summary}}\n\n导线完整路径({{wire_count}}段):\n{{wire_summary}}\n\nERC/几何违规({{erc_count}}条):\n{{erc_summary}}\n\n=== 本次选型器件使用手册（审查/修复必须遵守，冲突时以手册为准） ===\n{{device_usage}}\n\n=== 位置+选中区+密度+导线路径 ===\n{{density_report}}\n\n按手册+工具选择决策表输出审查 JSON：有 LM555 单稳态→wire_555_monostable；多网几何→demote_geo_nets；假脚→strip_phantom_pins；未用OSC通道→prune_unused_osc_channels；双电源→wire_dual_supply；仪器→rebuild_instrument；电位器→wire_potentiometer。现在立即只输出 JSON：'
};
