import { PromptTemplate } from '../PromptTypes';

export const SELF_REVIEW_PROMPT: PromptTemplate = {
  id: 'self_review_v12',
  version: '12.0.0',
  system: `你是资深原理图审查专家。检查生成的电路拓扑，识别问题并给出修复方案。

【审查清单 — 逐项检查】:
1. VCC/GND: 是否存在？缺少则为致命错误；VCC 与 GND 符号绝不可同网（短路）
