    static drawPowerMeter(ctx) {
        // Pins at x=-40, y={-20,0,20,40} â€” body covers y=-38..46
        const w = 64;
        const h = 84;
        ctx.strokeRect(-w / 2, -h / 2, w, h);
        // Display area
        ctx.fillStyle = '#E8F5E9';
        ctx.fillRect(-w / 2 + 5, -h / 2 + 5, w - 10, h - 34);
