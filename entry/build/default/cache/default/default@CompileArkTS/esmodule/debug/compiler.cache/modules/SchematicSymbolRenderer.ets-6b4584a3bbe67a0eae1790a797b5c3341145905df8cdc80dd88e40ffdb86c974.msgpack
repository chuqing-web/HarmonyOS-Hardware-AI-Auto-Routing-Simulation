    static drawLcd(ctx) {
        ctx.strokeRect(-35, -22, 70, 44);
        ctx.strokeRect(-28, -15, 56, 30);
        ctx.font = `${ProteusFonts.PARAM_KEY}px sans-serif`;
        ctx.fillStyle = ProteusColors.TEXT_LABEL;
        ctx.fillText('LCD', -10, 4);
