  private static drawOled(ctx: CanvasRenderingContext2D): void {
    // ä¸»ä½“è¦†ç›–è„šè· Â±20ï¼Œé¢„è§ˆå¤§é»‘æ¡†å†…å¯è§æ˜¾ç¤ºå±
    ctx.strokeRect(-28, -20, 56, 40);
