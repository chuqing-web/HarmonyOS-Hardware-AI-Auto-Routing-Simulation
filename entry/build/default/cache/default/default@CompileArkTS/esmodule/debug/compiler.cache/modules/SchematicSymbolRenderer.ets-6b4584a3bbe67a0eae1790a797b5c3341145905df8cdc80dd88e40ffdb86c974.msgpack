  static drawComponent(
    ctx: CanvasRenderingContext2D,
    originX: number,
    originY: number,
    def: ComponentDefinition,
    refDes: string,
    rotation: Rotation,
    mirrored: boolean,
    style: SymbolDrawStyle
  ): SymbolBounds {
    ctx.save();
    ctx.translate(originX, originY);
    if (rotation !== 0) {
