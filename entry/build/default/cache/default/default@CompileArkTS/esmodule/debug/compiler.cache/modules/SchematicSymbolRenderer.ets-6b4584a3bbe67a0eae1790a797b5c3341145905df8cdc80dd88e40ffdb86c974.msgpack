  /** Weak conduction / below full-lit threshold â€” same hue, dimmer alpha */
  ledDimmed?: boolean;
  /** Buzzer energised (sounding) â€” filled body + sound waves */
  buzzerActive?: boolean;
  /** Pushbutton pressed (contacts closed) */
  switchPressed?: boolean;
  /** Potentiometer wiper fraction 0..1 (arrow along track) */
  potWiper?: number;
  /** DS18B20 teaching temperature Â°C (âˆ’55â€¦125); undefined = generic sensor glyph */
  sensorTempC?: number;
  /** Hall sensor magnet field active */
  hallActive?: boolean;
