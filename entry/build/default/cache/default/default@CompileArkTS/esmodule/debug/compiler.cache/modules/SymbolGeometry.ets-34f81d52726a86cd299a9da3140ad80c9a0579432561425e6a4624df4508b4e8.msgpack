const INSTRUMENT_BODY_HALF_MIN = 50;
/**
 * å•ä¾§å¼•è„šç°‡ï¼ˆç¤ºæ³¢å™¨/ç”µå‹è¡¨ç­‰ï¼‰ï¼šç¬¦å·ä¸»ä½“ç”»åœ¨åŸç‚¹é™„è¿‘ï¼Œ
 * è‹¥ä»…ç”¨å¼•è„š AABBï¼Œé€‰ä¸­åŒºä¼šååˆ°å¼•è„šä¸€ä¾§ï¼Œä¸»ä½“å³åŠè½åœ¨åŒºå¤–ã€‚
