    legacyToSimConfig(cfg) {
        const def = defaultSimConfig();
        def.simMode = FilePersistenceImpl.legacyModeToSimMode(cfg.mode);
        def.transientTotalTime = cfg.stopTime;
        def.minTimeStep = cfg.stepSize;
        def.maxTimeStep = cfg.maxStep;
