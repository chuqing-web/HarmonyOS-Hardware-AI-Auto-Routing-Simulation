        switch (simMode) {
            case 'transient':
                return SimulationMode.TRANSIENT;
            case 'dc':
                return SimulationMode.DC;
            case 'ac':
                return SimulationMode.AC;
            case 'monte_carlo':
                return SimulationMode.MONTE_CARLO;
            case 'noise':
                return SimulationMode.NOISE;
            case 'mixed':
            default:
                return SimulationMode.MIXED;
        }
    }
