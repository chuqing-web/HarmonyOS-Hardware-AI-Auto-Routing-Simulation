                return 'transient';
            case SimulationMode.DC:
                return 'dc';
            case SimulationMode.AC:
                return 'ac';
            case SimulationMode.MONTE_CARLO:
                return 'monte_carlo';
            case SimulationMode.NOISE:
                return 'noise';
            case SimulationMode.MIXED:
            default:
                return 'mixed';
        }
    }
