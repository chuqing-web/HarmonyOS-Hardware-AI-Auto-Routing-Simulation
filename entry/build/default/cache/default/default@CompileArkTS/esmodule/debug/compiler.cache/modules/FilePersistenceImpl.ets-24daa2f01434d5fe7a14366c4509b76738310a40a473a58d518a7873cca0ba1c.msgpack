                return 'mixed';
        }
    }
    static simModeToLegacyMode(simMode) {
        switch (simMode) {
            case 'transient':
                return SimulationMode.TRANSIENT;
            case 'dc':
                return SimulationMode.DC;
            case 'ac':
                return SimulationMode.AC;
            case 'monte_carlo':
