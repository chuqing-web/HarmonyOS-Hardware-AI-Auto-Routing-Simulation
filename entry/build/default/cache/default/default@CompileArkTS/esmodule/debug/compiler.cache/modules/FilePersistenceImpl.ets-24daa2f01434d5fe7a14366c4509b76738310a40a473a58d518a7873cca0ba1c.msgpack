    projectDataToLegacy(data) {
        return {
            version: data.version,
            name: data.name,
            schematic: TopologyAdapter.fromTopology(data.topology),
            pcb: data.pcb,
            simulationConfig: this.simConfigToLegacy(data.simConfig),
