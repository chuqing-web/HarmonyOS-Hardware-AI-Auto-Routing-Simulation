    getTriggerLevel() { return this.triggerLevel; }
    getTriggerChannel() { return this.triggerChannel; }
    getCaptureMode() { return this.captureMode; }
    getMathOp() { return this.mathOp; }
    getFftLogScale() { return this.fftLogScale; }
    /** Capture waveform from real simulation data â€” æŒ‰æ—¶åŸºæˆªçª— + è§¦å‘å¯¹é½ï¼Œé¿å…æ•´æ®µç¼“å†²å å±å˜ä¹± */
    captureWave(channel = 0) {
