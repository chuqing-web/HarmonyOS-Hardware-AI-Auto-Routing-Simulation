            }
            winT.push(t);
            winV.push(volts[i]);
        }
        let useT = winT;
        let useV = winV;
        if (winT.length < 4) {
            // Take the newest chunk of equal length in samples
            const take = Math.min(n, Math.max(64, Math.floor(n * 0.5)));
