        this.triggerChannel = 0;
        this.captureMode = CaptureMode.ROLL;
        this.mathOp = MathChannelOp.ADD;
        this.fftLogScale = false;
        this.simulationWaveCache = [];
        this.simDataAge = 0;
        this.lastNodeVoltages = new Map();
