import { IdUtil, OscTimebase, OscVoltageScale, CouplingMode, TriggerMode, CaptureMode, MathChannelOp, traceCaptureWave } from 'common';
const DIVISIONS = 10;
const SAMPLE_POINTS = 1024;
function getTimebaseSec(timebase) {
    switch (timebase) {
