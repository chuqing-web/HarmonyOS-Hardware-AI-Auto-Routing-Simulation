        // Probe name â†’ channel index mapping
        this.channelProbes = ['', '', '', ''];
        // Historical voltage snapshots for time-domain display
        this.historyBuffer = [];
        /** Keep â‰¥20ms @ 1Âµs/step so 1kHz has many full cycles in the ring */
        this.historyMaxSize = 20000;
        this.lastSimTime = 0;
    }
    feedSimulationWaves(waves) {
