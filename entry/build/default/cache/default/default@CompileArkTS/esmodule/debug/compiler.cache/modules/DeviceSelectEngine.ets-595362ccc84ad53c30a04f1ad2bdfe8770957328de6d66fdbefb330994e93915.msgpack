        }
        // --- ç‹¬ç«‹ä»ªå™¨è¿½åŠ  ---
        if (!isMcu && !isAnalog && !isPower && !isLed && !isDigital && !isSensor) {
            // çº¯åˆ†ç«‹å…ƒä»¶ / æ— æºç”µè·¯
            if (lower.includes('ç”µé˜»') || lower.includes('ç”µå®¹') || lower.includes('åˆ†å‹') ||
                lower.includes('rc') || lower.includes('æ»¤æ³¢')) {
                modules.push('æ— æºç”µè·¯');
                reqs.push(makeDeviceRequirement('ç”µé˜»', 'resistor', 5, stringMap1('value', '1k')));
                reqs.push(makeDeviceRequirement('ç”µå®¹', 'cap', 5, stringMap1('value', '10uF')));
                reqs.push(makeDeviceRequirement('ç”µå‹è¡¨', 'voltmeter', 7, emptyStringMap(), 'VOLTMETER_DC'));
                // æ£€æµ‹ç”µæµè¡¨/ç”µå‹è¡¨éœ€æ±‚ â†’ æç¤ºä»ªå™¨æ‹“æ‰‘çº¦æŸ
                if (lower.includes('ç”µæµè¡¨') || lower.includes('ç”µæµ') || lower.includes('æµ‹æ€»ç”µæµ')) {
                    reqs.push(makeDeviceRequirement('ç”µæµè¡¨', 'ammeter', 8, emptyStringMap(), 'AMMETER_DC'));
                    circuitConstraint = 'ç”µæµè¡¨ä¸²è”åœ¨ VCC ä¸åˆ†å‹ç”µé˜»ä¹‹é—´,I+æ¥VCC,I-æ¥ç¬¬ä¸€ç”µé˜»';
                }
