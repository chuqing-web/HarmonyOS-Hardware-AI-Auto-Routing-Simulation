            }
            reqs.push(makeDeviceRequirement('æ™¶æŒ¯', 'crystal', 9, stringMap1('freq', '8MHz')));
            reqs.push(makeDeviceRequirement('å¤ä½ä¸Šæ‹‰', 'resistor', 9, stringMap1('value', '10k')));
            reqs.push(makeDeviceRequirement('å»è€¦ç”µå®¹', 'cap', 8, stringMap1('value', '100nF')));
