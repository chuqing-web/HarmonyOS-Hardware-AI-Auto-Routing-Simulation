        const isAnalog = lower.includes('è¿æ”¾') || lower.includes('æ”¾å¤§') ||
            lower.includes('opamp') || lower.includes('ua741') || lower.includes('lm358') ||
            lower.includes('åŒç›¸') || lower.includes('åç›¸') || lower.includes('è·Ÿéšå™¨');
        const isPower = lower.includes('ç”µæº') || lower.includes('ç¨³å‹') ||
            lower.includes('7805') || lower.includes('1117') || lower.includes('ldo') ||
            lower.includes('é™å‹') || lower.includes('å‡å‹');
        const isLed = lower.includes('led');
        const isDigital = lower.includes('74hc') || lower.includes('é—¨ç”µè·¯') ||
            lower.includes('ä¸é—¨') || lower.includes('æˆ–é—¨') || lower.includes('éé—¨') ||
            lower.includes('è§¦å‘å™¨') || lower.includes('è®¡æ•°å™¨');
        const isSensor = lower.includes('ä¼ æ„Ÿå™¨') || lower.includes('ds18b20') ||
            lower.includes('æ¸©åº¦') || lower.includes('å…‰æ•') || lower.includes('éœå°”');
        const isI2c = lower.includes('i2c') || lower.includes('iic') ||
            lower.includes('24c02') || lower.includes('oled');
        const isUart = lower.includes('uart') || lower.includes('ä¸²å£');
        // --- MCU ç”µè·¯: å¼ºåˆ¶å®Œæ•´å™¨ä»¶æ¸…å• ---
        if (isMcu) {
            modules.push('MCU æ ¸å¿ƒç³»ç»Ÿ');
            if (lower.includes('stm32')) {
                reqs.push(makeDeviceRequirement('MCU', 'mcu_stm32', 10, emptyStringMap(), 'STM32F103C8T6'));
                circuitConstraint = 'STM32 MCUå±…ä¸­,æ™¶æŒ¯ç´§é‚»,å»è€¦ç”µå®¹æ¯VDDé…1ä¸ª,BOOT0æ¥GND';
            }
            else {
                reqs.push(makeDeviceRequirement('MCU', 'mcu_51', 10, emptyStringMap(), 'AT89C51'));
                circuitConstraint = '51 MCUå±…ä¸­,æ™¶æŒ¯ç´§é‚»,EAæ¥VCC,å¤ä½ç”µè·¯å¿…å¤‡';
            }
            reqs.push(makeDeviceRequirement('æ™¶æŒ¯', 'crystal', 9, stringMap1('freq', '8MHz')));
            reqs.push(makeDeviceRequirement('å¤ä½ä¸Šæ‹‰', 'resistor', 9, stringMap1('value', '10k')));
            reqs.push(makeDeviceRequirement('å»è€¦ç”µå®¹', 'cap', 8, stringMap1('value', '100nF')));
            reqs.push(makeDeviceRequirement('å¤§ç”µå®¹', 'cap', 7, stringMap1('value', '10uF')));
            reqs.push(makeDeviceRequirement('æ™¶æŒ¯è´Ÿè½½ç”µå®¹Ã—2', 'cap', 8, stringMap1('value', '22pF')));
            // I2C è®¾å¤‡è¿½åŠ ä¸Šæ‹‰
            if (isI2c) {
                reqs.push(makeDeviceRequirement('I2Cä¸Šæ‹‰', 'resistor', 6, stringMap1('value', '4.7k')));
                reqs.push(makeDeviceRequirement('I2Cä¸Šæ‹‰', 'resistor', 6, stringMap1('value', '4.7k')));
            }
            // UART ç»ˆç«¯
            if (isUart) {
                reqs.push(makeDeviceRequirement('ä¸²å£ç»ˆç«¯', 'instrument', 5, emptyStringMap(), 'UART_TERMINAL'));
            }
        }
        // --- æ¨¡æ‹Ÿç”µè·¯ ---
        if (isAnalog) {
