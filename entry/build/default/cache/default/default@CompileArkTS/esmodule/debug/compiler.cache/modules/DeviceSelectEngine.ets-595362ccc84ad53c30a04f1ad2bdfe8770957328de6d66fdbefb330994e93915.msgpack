            lower.includes('è§¦å‘å™¨') || lower.includes('è®¡æ•°å™¨');
        const isSensor = lower.includes('ä¼ æ„Ÿå™¨') || lower.includes('ds18b20') ||
            lower.includes('æ¸©åº¦') || lower.includes('å…‰æ•') || lower.includes('éœå°”');
        const isI2c = lower.includes('i2c') || lower.includes('iic') ||
