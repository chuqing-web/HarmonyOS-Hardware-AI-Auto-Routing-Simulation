            if (lower.includes('ds18b20')) {
                reqs.push(makeDeviceRequirement('æ¸©åº¦ä¼ æ„Ÿå™¨', 'sensor', 7, emptyStringMap(), 'DS18B20'));
                reqs.push(makeDeviceRequirement('ä¸Šæ‹‰ç”µé˜»', 'resistor', 6, stringMap1('value', '4.7k')));
            }
