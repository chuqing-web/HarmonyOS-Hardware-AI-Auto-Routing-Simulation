            if (c.id !== libDevId && !alts.includes(c.id)) {
                alts.push(c.id);
            }
        }
        return alts.slice(0, 5);
    }
    /** æœ¬åœ°é€‰å‹å¢å¼º: ç”µè·¯æ¨¡å¼è¯†åˆ« + å¼ºåˆ¶å™¨ä»¶ + ä»ªå™¨è‡ªåŠ¨è¿½åŠ  */
