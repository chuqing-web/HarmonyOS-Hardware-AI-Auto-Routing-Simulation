      reqs.push(makeDeviceRequirement('åé¦ˆç”µé˜»', 'resistor', 7, stringMap1('value', '10k')));
      reqs.push(makeDeviceRequirement('è¾“å…¥ç”µé˜»', 'resistor', 7, stringMap1('value', '1k')));
      reqs.push(makeDeviceRequirement('å»è€¦ç”µå®¹', 'cap', 6, stringMap1('value', '100nF')));
      reqs.push(makeDeviceRequirement('ç¤ºæ³¢å™¨', 'oscilloscope', 8, emptyStringMap(), 'OSCILLOSCOPE'));
    }

    // --- ç”µæºç”µè·¯ ---
    if (isPower) {
      modules.push('ç”µæºç¨³å‹ç”µè·¯');
      if (lower.includes('3.3') || lower.includes('3v3')) {
        reqs.push(makeDeviceRequirement('LDO', 'ldo', 9, emptyStringMap(), 'AMS1117_3V3'));
      } else {
        reqs.push(makeDeviceRequirement('ç¨³å‹å™¨', 'ldo', 9, emptyStringMap(), 'LM7805'));
      }
      reqs.push(makeDeviceRequirement('è¾“å…¥ç”µå®¹', 'cap', 7, stringMap1('value', '10uF')));
      reqs.push(makeDeviceRequirement('è¾“å‡ºç”µå®¹', 'cap', 7, stringMap1('value', '100uF')));
      reqs.push(makeDeviceRequirement('å»è€¦', 'cap', 6, stringMap1('value', '100nF')));
