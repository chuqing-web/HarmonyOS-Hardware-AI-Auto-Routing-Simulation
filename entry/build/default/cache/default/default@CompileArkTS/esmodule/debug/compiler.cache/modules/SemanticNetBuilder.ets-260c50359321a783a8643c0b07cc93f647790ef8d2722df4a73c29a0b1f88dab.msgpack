                notes.push(`LED æ”¯è·¯: ${led.refDes}+${rLed.refDes}`);
            }
        }
        // ---- æ™¶æŒ¯ + è´Ÿè½½ç”µå®¹ ----
        if (mcu !== null && crystals.length > 0) {
            const xtal = crystals[0];
