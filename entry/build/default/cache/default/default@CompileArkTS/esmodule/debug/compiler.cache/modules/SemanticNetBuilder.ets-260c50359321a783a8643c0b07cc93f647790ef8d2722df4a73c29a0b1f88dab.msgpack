            }
            TemplateSchematicKit.crystal(doc, mcu, xtal, c1, c2, xtalIn, xtalOut, '', gnd);
            notes.push(`æ™¶æŒ¯: ${xtal.refDes}â†’${mcu.refDes}.${xtalIn}/${xtalOut}`);
        }
        // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        // é˜¶æ®µ B: ä»ªå™¨è¿çº¿ â€” åŸºäºæ‹“æ‰‘è§„åˆ’åˆ†å‘
        // ç”µæµè¡¨åœ¨ buildDividerChain ä¸­å·²ä¸²è”åµŒå…¥ï¼Œæ­¤å¤„å¤„ç†ç”µå‹è¡¨/ç¤ºæ³¢å™¨ç­‰
        // v3.1: MCUç”µè·¯ä¸­çš„ä»ªå™¨ä¹Ÿåœ¨æ­¤é˜¶æ®µå¤„ç†
        // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
        if (dividerTopo !== null) {
            // æœ‰åˆ†å‹é“¾æ‹“æ‰‘ â†’ ç”µå‹è¡¨æŒ‰èŠ‚ç‚¹å¯¹åˆ†å‘ (å„æµ‹ä¸åŒç”µé˜»)
            instrumentLinks += this.wireDividerInstruments(doc, dividerTopo, notes);
        }
        else if (vcc !== null && gnd !== null) {
            // æ— åˆ†å‹å™¨ä½†æœ‰ VCC/GND â†’ ä»ªå™¨ç”¨ signalHub æ–¹å¼ (å«MCUç”µè·¯)
            const signalHub = SemanticNetBuilder.pickSignalHub(doc, mcu, leds);
            instrumentLinks += this.wireStandaloneInstruments(doc, vcc, gnd, signalHub, notes);
        }
        // éåˆ†å‹å™¨ä»ªå™¨ (ç¤ºæ³¢å™¨ã€é¢‘ç‡è®¡ã€UARTç»ˆç«¯) â€”â€” å§‹ç»ˆæ‰§è¡Œ
        instrumentLinks += this.wireNonDividerInstruments(doc, vcc, gnd, mcu, notes);
        // ---- I2C ä¸Šæ‹‰ç”µé˜» (æ£€æµ‹ I2C å™¨ä»¶å¹¶è‡ªåŠ¨åŠ ä¸Šæ‹‰) ----
        this.wireI2cPullups(doc, vcc, resistors, notes, autoFixes);
        // ---- æœªè¿å™¨ä»¶è§„åˆ™æç¤º ----
        this.applyAiWiringRulesHints(doc, notes);
        const outTopo = TopologyAdapter.toTopology(doc);
        outTopo.schUuid = topo.schUuid;
        outTopo.schName = topo.schName.length > 0 ? topo.schName : outTopo.schName;
        outTopo.gridStep = topo.gridStep;
        outTopo.ercErrorList = topo.ercErrorList;
        const wiredNets = doc.nets.filter(n => n.pinIds.length >= 2).length;
        const wireCount = doc.wires.length;
        // ---- åéªŒ: éªŒè¯å…³é”®è¿æ¥å®Œæ•´æ€§ ----
        let validationErrors = 0;
        const pinCounts = TemplateSchematicKit.countConnectedPins(doc);
        // ä»ªå™¨å¼•è„šå®Œæ•´æ€§: ç¡®ä¿æ¯ä¸ªä»ªå™¨çš„å…³é”®å¼•è„šéƒ½å·²å…¥ç½‘
        const instrumentPins = [
            ['AMMETER_DC', ['I+', 'I-']],
            ['VOLTMETER_DC', ['V+', 'COM']],
            ['VIRTUAL_METER', ['V', 'COM']],
            ['OSCILLOSCOPE', ['CH1']],
            ['FREQ_COUNTER', ['IN', 'GND']],
            ['UART_TERMINAL', ['TX', 'RX', 'GND']],
        ];
        for (let ip = 0; ip < instrumentPins.length; ip++) {
            const libId = instrumentPins[ip][0];
            const reqPins = instrumentPins[ip][1];
            const comps = SemanticNetBuilder.findAllByLib(doc, (id) => id === libId);
            for (const comp of comps) {
                for (let rp = 0; rp < reqPins.length; rp++) {
                    const pinId = reqPins[rp];
                    const pinRef = `${comp.id}:${pinId}:${pinId}`;
                    let found = false;
                    for (const net of doc.nets) {
                        if (net.pinIds.some(p => p === pinRef)) {
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        autoFixes.push(`${comp.refDes}.${pinId} æœªè¿æ¥`);
                        validationErrors++;
                    }
                }
            }
        }
        // MCUå…³é”®å¼•è„š: VCC/GND/RSTè‡³å°‘æœ‰ä¸€ä¸ªè¿æ¥
        if (mcu !== null) {
            const mcuConns = pinCounts.get(mcu.id) ?? 0;
            if (mcuConns < 3) {
                autoFixes.push(`MCU ${mcu.refDes} ä»… ${mcuConns} ä¸ªå¼•è„šè¿æ¥ (éœ€è¦â‰¥3)`);
                validationErrors++;
            }
        }
        const summary = `å»ºç½‘ ${wiredNets} æ¡(â‰¥2è„š) Â· å¯¼çº¿ ${wireCount} Â· ä»ªå™¨è¿çº¿ ${instrumentLinks} Â· è¡¥ç¬¦å· ${addedSymbols}` +
            (validationErrors > 0 ? ` Â· éªŒè¯é—®é¢˜ ${validationErrors}` : '') +
            (notes.length > 0 ? `\n  Â· ${notes.join('\n  Â· ')}` : '') +
            (autoFixes.length > 0 ? `\n  ä¿®å¤ ${autoFixes.length}: ${autoFixes.join('; ')}` : '');
        Logger.info(INSTR_TRACE_TAG, `[AI_PIPE] semantic netsâ‰¥2=${wiredNets} wires=${wireCount}` +
            ` instr=${instrumentLinks} symbols+=${addedSymbols} fixes=${autoFixes.length}` +
            ` validation=${validationErrors}`);
        Logger.info('SemanticNet', summary);
        return {
            topology: outTopo, summary, wiredNets, instrumentLinks,
            addedSymbols, autoFixes
        };
    }
    // ---- åŠ¨æ€å¼•è„šè§£æ ----
    /** ä» pin_list ä¸­æŸ¥æ‰¾åŒ¹é…è¯­ä¹‰åˆ«åçš„å¼•è„š ID */
    resolvePin(pinList, aliases) {
        if (pinList.length === 0) {
            return null;
        }
        for (const alias of aliases) {
            const upper = alias.toUpperCase();
            // ç²¾ç¡®åŒ¹é…
            let match = pinList.find(p => (p.pin_label ?? p.pin_id).toUpperCase() === upper);
            if (match) {
                return match.pin_id;
            }
            // å‰ç¼€åŒ¹é… (VDD åŒ¹é… VDD_1)
            match = pinList.find(p => (p.pin_label ?? p.pin_id).toUpperCase().startsWith(upper));
            if (match) {
                return match.pin_id;
            }
            // çŸ­åˆ«åï¼ˆå¦‚ GPIOï¼‰ç¦æ­¢ includesï¼Œé¿å… VDDGPIO è¯¯å‘½ä¸­
            if (upper.length >= 4) {
                match = pinList.find(p => (p.pin_label ?? p.pin_id).toUpperCase().includes(upper));
                if (match) {
                    return match.pin_id;
                }
            }
        }
        return null;
    }
    /** ä» pin_list ä¸­æŸ¥æ‰¾æ‰€æœ‰åŒ¹é…è¯­ä¹‰åˆ«åçš„å¼•è„š ID åˆ—è¡¨ */
    resolvePins(pinList, aliases) {
        if (pinList.length === 0) {
            return [];
        }
        const result = [];
        for (const p of pinList) {
            const upper = (p.pin_label ?? p.pin_id).toUpperCase();
            for (const alias of aliases) {
                const aUpper = alias.toUpperCase();
                if (upper === aUpper || upper.startsWith(aUpper)) {
                    if (!result.includes(p.pin_id)) {
                        result.push(p.pin_id);
                    }
                    break;
                }
            }
        }
        return result;
    }
    // ---- I2C ä¸Šæ‹‰æ£€æµ‹ ----
    /** æ£€æµ‹ I2C å™¨ä»¶ (24C02, OLED ç­‰)ï¼Œè‡ªåŠ¨è¡¥æ”¾ 4.7kÎ© ä¸Šæ‹‰ç”µé˜» */
    wireI2cPullups(doc, vcc, resistors, notes, autoFixes) {
        if (vcc === null) {
            return;
        }
        const i2cDevices = SemanticNetBuilder.findAllByLib(doc, (id) => id === '24C02' || id === 'OLED_12864');
        // W25Q64 ä¸º SPIï¼Œä¸å¾—å½“ I2C è§¦å‘ä¸Šæ‹‰
        if (i2cDevices.length === 0) {
            // æ£€æŸ¥æ˜¯å¦æœ‰ I2C net (SDA/SCL)
            const hasI2c = doc.nets.some(n => {
                const up = n.name.toUpperCase();
                return up.includes('SDA') || up.includes('SCL') ||
                    up.includes('I2C');
            });
            if (!hasI2c) {
                return;
            }
        }
        // æ‰¾æœªä½¿ç”¨çš„ R_4.7k æˆ– R_10k
        const usedResistors = new Set();
        for (const net of doc.nets) {
            for (const pinRef of net.pinIds) {
                const parts = pinRef.split(':');
                usedResistors.add(parts[0]);
            }
        }
        let rSda = null;
        let rScl = null;
        for (const r of resistors) {
            if (!usedResistors.has(r.id) && r.libraryId.includes('4.7')) {
                if (rSda === null) {
                    rSda = r;
                }
                else if (rScl === null) {
                    rScl = r;
                    break;
                }
            }
        }
        if (rSda === null || rScl === null) {
            // è¡¥æ”¾
            if (rSda === null) {
                rSda = TemplateSchematicKit.place(doc, 'R_4.7k', `R${resistors.length + 1}`, { x: 500, y: 100 });
                autoFixes.push('è¡¥æ”¾ R_4.7k ä¸º I2C SDA ä¸Šæ‹‰');
            }
            if (rScl === null) {
                rScl = TemplateSchematicKit.place(doc, 'R_4.7k', `R${resistors.length + 2}`, { x: 500, y: 140 });
                autoFixes.push('è¡¥æ”¾ R_4.7k ä¸º I2C SCL ä¸Šæ‹‰');
            }
        }
        // ä¸Šæ‹‰åˆ° VCCï¼Œå¦ä¸€ç«¯å¹¶å…¥ SDA/SCL æ€»çº¿ï¼ˆç¦æ­¢åªæ¥ VCC æ‚¬ç©ºä¸‹ç«¯ï¼‰
        if (rSda === null || rScl === null) {
            return;
        }
        const vccPin = { comp: vcc, pinId: '1', pinName: 'VCC' };
        const rSdaVcc = { comp: rSda, pinId: '1', pinName: '1' };
        const rSclVcc = { comp: rScl, pinId: '1', pinName: '1' };
        TemplateSchematicKit.join(doc, 'VCC', NetType.POWER, [vccPin, rSdaVcc]);
        TemplateSchematicKit.join(doc, 'VCC', NetType.POWER, [vccPin, rSclVcc]);
        const sdaPull = { comp: rSda, pinId: '2', pinName: '2' };
        const sclPull = { comp: rScl, pinId: '2', pinName: '2' };
        const sdaPins = [sdaPull];
        const sclPins = [sclPull];
        for (let di = 0; di < i2cDevices.length; di++) {
            const dev = i2cDevices[di];
            const meta = this.library.getDeviceMeta(dev.libraryId);
            const pinList = meta.success && meta.data ? meta.data.pin_list : [];
            const sdaId = this.resolvePin(pinList, ['SDA', 'SDA1', 'I2C_SDA']) ?? 'SDA';
            const sclId = this.resolvePin(pinList, ['SCL', 'SCL1', 'I2C_SCL']) ?? 'SCL';
            const sdaDevPin = { comp: dev, pinId: sdaId, pinName: sdaId };
            const sclDevPin = { comp: dev, pinId: sclId, pinName: sclId };
            sdaPins.push(sdaDevPin);
            sclPins.push(sclDevPin);
        }
        // è‹¥æ–‡æ¡£å·²æœ‰ SDA/SCL ç½‘ï¼ŒæŠŠä¸Šæ‹‰è„šå¹¶å…¥åŒåæ ‡å·ç½‘
        TemplateSchematicKit.joinByLabel(doc, 'SDA', NetType.SIGNAL, sdaPins);
        TemplateSchematicKit.joinByLabel(doc, 'SCL', NetType.SIGNAL, sclPins);
        notes.push('I2C ä¸Šæ‹‰: R_4.7kÃ—2 VCCâ†”SDA/SCL');
    }
    /**
     * LM555 ç»å…¸å¤šè°æŒ¯è¡:
     *   VCCâ€”Raâ€”DISCH ; DISCHâ€”Rbâ€”THRESâ‰¡TRIGâ€”Ctâ€”GND
     *   RESETâ†’VCC ; CTRLâ€”Cbypassâ€”GND ; VCC/GND ç”µæºè„š
     *   OUTâ€”Rledâ€”LEDâ€”GND
     */
    wireTimer555Astable(doc, vcc, gnd, timer, resistors, caps, leds, notes, autoFixes) {
        let added = 0;
        const usedR = [];
        const usedC = [];
        const takeR = (prefer, tag, near) => {
            for (let i = 0; i < resistors.length; i++) {
                if (usedR.indexOf(resistors[i]) >= 0) {
                    continue;
                }
                if (prefer.length > 0 && resistors[i].libraryId !== prefer) {
                    continue;
                }
                usedR.push(resistors[i]);
                return resistors[i];
            }
            for (let i = 0; i < resistors.length; i++) {
                if (usedR.indexOf(resistors[i]) < 0) {
                    usedR.push(resistors[i]);
                    return resistors[i];
                }
            }
            const r = TemplateSchematicKit.place(doc, prefer.length > 0 ? prefer : 'R_10k', `R_${tag}`, { x: near.position.x - 60, y: near.position.y });
            added++;
            autoFixes.push(`è¡¥æ”¾ ${prefer.length > 0 ? prefer : 'R_10k'} (${tag})`);
            usedR.push(r);
            return r;
        };
        const takeC = (prefer, tag, near) => {
            for (let i = 0; i < caps.length; i++) {
                if (usedC.indexOf(caps[i]) >= 0) {
                    continue;
                }
                if (prefer.length > 0 && caps[i].libraryId !== prefer) {
                    continue;
                }
                usedC.push(caps[i]);
                return caps[i];
            }
            for (let i = 0; i < caps.length; i++) {
                if (usedC.indexOf(caps[i]) < 0) {
                    usedC.push(caps[i]);
                    return caps[i];
                }
            }
            const c = TemplateSchematicKit.place(doc, prefer.length > 0 ? prefer : 'C_10uF', `C_${tag}`, { x: near.position.x + 60, y: near.position.y + 40 });
            added++;
            autoFixes.push(`è¡¥æ”¾ ${prefer.length > 0 ? prefer : 'C_10uF'} (${tag})`);
            usedC.push(c);
            return c;
        };
        const ra = takeR('R_1k', '555_RA', timer);
        const rb = takeR('R_10k', '555_RB', timer);
        const rLed = takeR('R_330', '555_LED', timer);
        const ct = takeC('C_10uF', '555_T', timer);
        const cCtrl = takeC('C_100nF', '555_CV', timer);
        const cDec = takeC('C_100nF', '555_DEC', timer);
        const led = leds.length > 0 ? leds[0] : TemplateSchematicKit.place(doc, 'LED_RED', 'LED_555', { x: timer.position.x + 100, y: timer.position.y });
        if (leds.length === 0) {
            added++;
            autoFixes.push('è¡¥æ”¾ LED_RED æ¥ LM555.OUT');
        }
        TemplateSchematicKit.joinWired(doc, 'VCC', NetType.POWER, [
            { comp: vcc, pinId: '1', pinName: 'VCC' },
            { comp: timer, pinId: 'VCC', pinName: 'VCC' },
            { comp: timer, pinId: 'RESET', pinName: 'RESET' },
            { comp: ra, pinId: '1', pinName: '1' },
            { comp: cDec, pinId: '1', pinName: '1' }
        ]);
        TemplateSchematicKit.joinWired(doc, 'GND', NetType.GROUND, [
            { comp: gnd, pinId: '1', pinName: 'GND' },
            { comp: timer, pinId: 'GND', pinName: 'GND' },
            { comp: ct, pinId: '2', pinName: '2' },
            { comp: cCtrl, pinId: '2', pinName: '2' },
            { comp: cDec, pinId: '2', pinName: '2' },
            { comp: led, pinId: 'K', pinName: 'K' }
        ]);
        TemplateSchematicKit.joinWired(doc, '555_DISCH', NetType.SIGNAL, [
            { comp: ra, pinId: '2', pinName: '2' },
            { comp: timer, pinId: 'DISCH', pinName: 'DISCH' },
            { comp: rb, pinId: '1', pinName: '1' }
        ]);
        TemplateSchematicKit.joinWired(doc, '555_CAP', NetType.SIGNAL, [
            { comp: rb, pinId: '2', pinName: '2' },
            { comp: timer, pinId: 'THRES', pinName: 'THRES' },
            { comp: timer, pinId: 'TRIG', pinName: 'TRIG' },
            { comp: ct, pinId: '1', pinName: '1' }
        ]);
        TemplateSchematicKit.joinWired(doc, '555_CTRL', NetType.SIGNAL, [
            { comp: timer, pinId: 'CTRL', pinName: 'CTRL' },
            { comp: cCtrl, pinId: '1', pinName: '1' }
        ]);
        TemplateSchematicKit.joinWired(doc, 'LM555_OUT', NetType.SIGNAL, [
            { comp: timer, pinId: 'OUT', pinName: 'OUT' },
            { comp: rLed, pinId: '1', pinName: '1' }
        ]);
        TemplateSchematicKit.joinWired(doc, 'LED_NODE', NetType.SIGNAL, [
            { comp: rLed, pinId: '2', pinName: '2' },
            { comp: led, pinId: 'A', pinName: 'A' }
        ]);
        notes.push(`LM555 å¤šè°: ${timer.refDes} Ra=${ra.refDes} Rb=${rb.refDes} Ct=${ct.refDes} â†’ ${led.refDes}`);
        return { wired: true, added: added };
    }
    /**
     * RELAY_SPDT äº’æ–¥åŒè‰²æŒ‡ç¤ºï¼ˆå¯¹åº”ã€Œæ‰“å¼€ç»¿ç¯ / é—­åˆçº¢ç¯ã€ï¼‰:
     *   çº¿åœˆ: VCCâ†’SWâ†’coil1 / coil2â†’GNDï¼ˆæ—  SW åˆ™çº¿åœˆæµ®ç©ºç•™ç»™ä¸Šå±‚ï¼‰
     *   COMâ†’GND
     *   NC æ”¯è·¯: VCCâ†’Râ†’LED_GREENâ†’NCï¼ˆæ–­å¼€/æœªå¸åˆäº®ç»¿ï¼‰
     *   NO æ”¯è·¯: VCCâ†’Râ†’LED_REDâ†’NOï¼ˆé—­åˆ/å¸åˆäº®çº¢ï¼‰
     */
    wireRelaySpdtDualLed(doc, vcc, gnd, relay, sw, leds, resistors, notes, autoFixes) {
        let added = 0;
        let ledGreen = leds.find(l => l.libraryId === 'LED_GREEN') ?? null;
        let ledRed = leds.find(l => l.libraryId === 'LED_RED') ?? null;
        if (ledGreen === null) {
            ledGreen = leds[0];
        }
        if (ledRed === null) {
            ledRed = leds.length > 1 ? leds[1] : leds[0];
        }
        if (ledGreen === ledRed && leds.length > 1) {
            ledRed = leds[1];
        }
        const usedR = [];
        const takeR = (tag, near) => {
            for (let i = 0; i < resistors.length; i++) {
                if (usedR.indexOf(resistors[i]) < 0) {
                    usedR.push(resistors[i]);
                    return resistors[i];
                }
            }
            const r = TemplateSchematicKit.place(doc, 'R_330', `R_${tag}`, { x: near.position.x - 80, y: near.position.y });
            added++;
            autoFixes.push(`è¡¥æ”¾ ${tag} é™æµç”µé˜» R_330`);
            usedR.push(r);
            return r;
        };
        const rGreen = takeR('NC', ledGreen);
        const rRed = takeR('NO', ledRed);
        // COM â†’ GND
        TemplateSchematicKit.join(doc, 'GND', NetType.GROUND, [
            { comp: gnd, pinId: '1', pinName: 'GND' },
            { comp: relay, pinId: 'COM', pinName: 'COM' }
        ]);
        // NC: VCCâ†’Râ†’LED_GREEN.A ; LED_GREEN.Kâ†’NC
        TemplateSchematicKit.join(doc, 'VCC', NetType.POWER, [
            { comp: vcc, pinId: '1', pinName: 'VCC' },
            { comp: rGreen, pinId: '1', pinName: '1' }
        ]);
        TemplateSchematicKit.series2(doc, 'REL_NC_A', { comp: rGreen, pinId: '2', pinName: '2' }, { comp: ledGreen, pinId: 'A', pinName: 'A' });
        TemplateSchematicKit.join(doc, 'REL_NC', NetType.SIGNAL, [
            { comp: ledGreen, pinId: 'K', pinName: 'K' },
            { comp: relay, pinId: 'NC', pinName: 'NC' }
        ]);
        // NO: VCCâ†’Râ†’LED_RED.A ; LED_RED.Kâ†’NO
        TemplateSchematicKit.join(doc, 'VCC', NetType.POWER, [
            { comp: vcc, pinId: '1', pinName: 'VCC' },
            { comp: rRed, pinId: '1', pinName: '1' }
        ]);
        TemplateSchematicKit.series2(doc, 'REL_NO_A', { comp: rRed, pinId: '2', pinName: '2' }, { comp: ledRed, pinId: 'A', pinName: 'A' });
        TemplateSchematicKit.join(doc, 'REL_NO', NetType.SIGNAL, [
            { comp: ledRed, pinId: 'K', pinName: 'K' },
            { comp: relay, pinId: 'NO', pinName: 'NO' }
        ]);
        // çº¿åœˆé©±åŠ¨
        if (sw !== null) {
            TemplateSchematicKit.join(doc, 'VCC', NetType.POWER, [
                { comp: vcc, pinId: '1', pinName: 'VCC' },
                { comp: sw, pinId: '1', pinName: '1' }
            ]);
            TemplateSchematicKit.series2(doc, 'REL_COIL_DRV', { comp: sw, pinId: '2', pinName: '2' }, { comp: relay, pinId: '1', pinName: '1' });
            TemplateSchematicKit.join(doc, 'GND', NetType.GROUND, [
                { comp: gnd, pinId: '1', pinName: 'GND' },
                { comp: relay, pinId: '2', pinName: '2' }
            ]);
            notes.push(`ç»§ç”µå™¨äº’æ–¥LED: SWå¼€â†’${ledGreen.refDes}@NC äº®; SWé—­â†’${ledRed.refDes}@NO äº®`);
            return { wired: true, added: added };
        }
        // æ—  SWï¼šåªå»ºè§¦ç‚¹æ”¯è·¯ï¼Œä¸åŠæ¥çº¿åœˆï¼ˆé¿å… PINCONN/ä»¿çœŸè¯¯åˆ¤ï¼‰
        notes.push(`ç»§ç”µå™¨äº’æ–¥LED: NCâ†’${ledGreen.refDes} NOâ†’${ledRed.refDes}ï¼ˆç¼º SW_PUSHï¼Œçº¿åœˆæœªé©±åŠ¨ï¼‰`);
