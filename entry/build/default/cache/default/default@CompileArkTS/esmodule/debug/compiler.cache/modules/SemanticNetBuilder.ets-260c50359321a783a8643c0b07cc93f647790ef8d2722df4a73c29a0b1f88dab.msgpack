const SWCLK_ALIASES = ['SWCLK', 'TCK', 'SWD_CLK'];
const SWDIO_ALIASES = ['SWDIO', 'TMS', 'SWD_IO'];
export class SemanticNetBuilder {
    constructor(library) {
        this.library = library;
    }
    build(topo) {
        const doc = TopologyAdapter.fromTopology(topo);
        let addedSymbols = 0;
        let instrumentLinks = 0;
        const notes = [];
        const autoFixes = [];
        // ç¡®ä¿æœ‰ VCC/GND ç¬¦å·
        let vcc = SemanticNetBuilder.findByLib(doc, (id) => id === 'VCC');
