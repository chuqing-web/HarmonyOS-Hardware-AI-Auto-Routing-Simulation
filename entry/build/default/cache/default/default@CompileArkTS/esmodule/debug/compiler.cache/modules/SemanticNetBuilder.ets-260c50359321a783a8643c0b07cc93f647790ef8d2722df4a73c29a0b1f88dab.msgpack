                        c = caps[ci];
                        break;
                    }
                }
                if (c === null) {
                    // æ²¡æœ‰è¶³å¤Ÿçš„å»è€¦ç”µå®¹ï¼Œè¡¥æ”¾
                    const xOff = mcu.position.x + 60 + vi * 30;
                    const yOff = mcu.position.y - 40;
