    buildDividerChain(doc, vcc, gnd, resistors, sensors, notes) {
        if (resistors.length === 0) {
            return null;
        }
        // æ„å»ºé“¾ä¸Šå™¨ä»¶åºåˆ—
        const chain = [resistors[0]];
        if (sensors.length > 0) {
            chain.push(sensors[0]);
