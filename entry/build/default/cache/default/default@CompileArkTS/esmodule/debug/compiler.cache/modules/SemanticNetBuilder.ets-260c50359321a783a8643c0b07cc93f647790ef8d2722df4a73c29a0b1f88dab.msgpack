                }
            }
            // ---- VDDA ç‹¬ç«‹æ»¤æ³¢ (STM32) ----
            const vddaPin = this.resolvePin(pinList, ['VDDA', 'AVDD']);
            const vssaPin = this.resolvePin(pinList, ['VSSA', 'AVSS']);
            if (vddaPin !== null && vssaPin !== null) {
