                notes.push(`ä¸‡ç”¨è¡¨ ${vm.refDes} â†’ ${pair.high}â†”${pair.low}`);
                count++;
            }
        }
        // ç”µæµè¡¨å·²åœ¨ buildDividerChain ä¸­å¤„ç†ï¼Œä»…è®°å½•
        if (ammeter !== null) {
