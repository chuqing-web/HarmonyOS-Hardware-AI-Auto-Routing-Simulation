                if (boot0Pin !== null) {
                    TemplateSchematicKit.join(doc, 'GND', NetType.GROUND, [
                        { comp: gnd, pinId: '1', pinName: 'GND' },
                        { comp: mcu, pinId: boot0Pin, pinName: boot0Pin }
