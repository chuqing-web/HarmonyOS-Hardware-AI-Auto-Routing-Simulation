                count++;
            }
        }
        // ç”µæµè¡¨å·²åœ¨ buildDividerChain ä¸­å¤„ç†ï¼Œä»…è®°å½•
        if (ammeter !== null) {
            notes.push(`ç”µæµè¡¨ ${ammeter.refDes} å·²ä¸²è”åœ¨ VCCâ†’${topo.postAmmeterNet}`);
        }
        return count;
    }
    /**
