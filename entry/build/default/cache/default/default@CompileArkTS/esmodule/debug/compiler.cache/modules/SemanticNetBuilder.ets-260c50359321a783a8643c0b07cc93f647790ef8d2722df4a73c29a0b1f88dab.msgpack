            }
            notes.push(`MCU ${mcu.refDes}: è¿æ¥ ${vddPins.length} ä¸ª VDD + å»è€¦`);
            // ---- è¿æ¥æ‰€æœ‰ VSS ----
            for (let si = 0; si < vssPins.length; si++) {
                TemplateSchematicKit.join(doc, 'GND', NetType.GROUND, [
                    { comp: gnd, pinId: '1', pinName: 'GND' },
