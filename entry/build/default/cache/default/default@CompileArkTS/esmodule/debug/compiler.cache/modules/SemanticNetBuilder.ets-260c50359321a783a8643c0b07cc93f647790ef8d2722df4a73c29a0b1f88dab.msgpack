    static pickSignalHub(doc, mcu, leds) {
        const t555 = SemanticNetBuilder.findByLib(doc, (id) => id === 'LM555' || id === 'NE555');
        if (t555 !== null) {
            return { net: 'LM555_OUT', pin: { comp: t555, pinId: 'OUT', pinName: 'OUT' } };
        }
