            for (let i = 0; i < chain.length - 1; i++) {
                const nodeNet = chain.length === 2 ? 'SENSE' : `SENSE_${i + 1}`;
                TemplateSchematicKit.joinWired(doc, nodeNet, NetType.SIGNAL, [
