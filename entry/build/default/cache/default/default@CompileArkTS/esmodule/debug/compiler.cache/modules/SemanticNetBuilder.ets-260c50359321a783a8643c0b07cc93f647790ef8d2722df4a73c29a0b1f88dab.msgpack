            }
            if (vssPins.length > 1) {
                notes.push(`è¿æ¥ ${vssPins.length} ä¸ª GND å¼•è„š`);
            }
            // ---- å¤ä½å¼•è„š: ä¸Šæ‹‰ 10kÎ© åˆ° VCC ----
            const rRst = resistors.length > 0 ? resistors[0] : null;
            if (rRst !== null) {
