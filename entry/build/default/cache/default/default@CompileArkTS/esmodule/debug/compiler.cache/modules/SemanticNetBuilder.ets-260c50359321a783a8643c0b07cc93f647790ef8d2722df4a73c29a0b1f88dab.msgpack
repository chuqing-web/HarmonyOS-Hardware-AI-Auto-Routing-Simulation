        }
        const mcu = SemanticNetBuilder.findByLib(doc, (id) => id.startsWith('STM32') || id.startsWith('AT89') || id.startsWith('STC'));
        const caps = SemanticNetBuilder.findAllByLib(doc, (id) => id.startsWith('C_'));
