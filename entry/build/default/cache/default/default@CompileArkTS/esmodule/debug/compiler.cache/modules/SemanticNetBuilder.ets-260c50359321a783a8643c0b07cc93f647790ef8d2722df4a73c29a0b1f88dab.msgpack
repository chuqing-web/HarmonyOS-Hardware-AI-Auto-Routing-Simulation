                        { comp: mcu, pinId: eaPin, pinName: eaPin }
                    ]);
                    notes.push(`EA(${eaPin})â†’VCC`);
                }
            }
            // ---- VCAP å»è€¦ (STM32) ----
            if (isStm32) {
                const vcapPin = this.resolvePin(pinList, VCAP_ALIASES);
                if (vcapPin !== null) {
                    // è¡¥æ”¾ 1uF ç”µå®¹åš VCAP å»è€¦
