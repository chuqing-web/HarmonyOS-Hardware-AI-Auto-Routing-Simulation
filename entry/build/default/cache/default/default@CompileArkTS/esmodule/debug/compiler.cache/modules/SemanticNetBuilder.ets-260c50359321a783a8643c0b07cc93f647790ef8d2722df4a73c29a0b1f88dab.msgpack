import { TopologyAdapter, NetType, Logger, INSTR_TRACE_TAG } from 'common';
import { TemplateSchematicKit } from './TemplateSchematicKit';
// ---- å¼•è„šè¯­ä¹‰åˆ«åè¡¨ ----
const POWER_ALIASES = [
    ['VCC', 'VDD', 'AVDD', 'VCCIO', 'VREF+', 'V+'],
    ['GND', 'VSS', 'AVSS', 'VSSA', 'VREF-', 'V-']
];
