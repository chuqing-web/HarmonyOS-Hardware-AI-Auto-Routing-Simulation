}
function isMountFootprint(defId, refDes) {
    if (defId === 'FP_MOUNT') {
        return true;
    }
    if (refDes.length >= 2 && refDes.charAt(0) === 'H') {
        const c = refDes.charCodeAt(1);
        return c >= 48 && c <= 57;
