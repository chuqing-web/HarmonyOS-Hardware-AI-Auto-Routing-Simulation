function buildOrthoSegs(pts, hLayer, vLayer) {
    const segs = [];
    for (let i = 0; i < pts.length - 1; i++) {
        const p0 = pts[i];
        const p1 = pts[i + 1];
        if (dist(p0, p1) < 0.5) {
            continue;
        }
        const horiz = Math.abs(p0.y - p1.y) < 0.5;
        const vert = Math.abs(p0.x - p1.x) < 0.5;
        if (horiz || vert) {
            segs.push({ layer: horiz ? hLayer : vLayer, p0, p1 });
        }
        else {
            const mid = { x: p1.x, y: p0.y };
            if (dist(p0, mid) >= 0.5) {
                segs.push({ layer: hLayer, p0, p1: mid });
            }
            if (dist(mid, p1) >= 0.5) {
                segs.push({ layer: vLayer, p0: mid, p1 });
