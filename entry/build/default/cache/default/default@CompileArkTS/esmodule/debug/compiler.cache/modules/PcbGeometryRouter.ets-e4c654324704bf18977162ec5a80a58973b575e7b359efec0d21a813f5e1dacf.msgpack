function snap(v, grid) {
    if (grid <= 0) {
        return v;
    }
    return Math.round(v / grid) * grid;
}
function dist(a, b) {
    const dx = a.x - b.x;
    const dy = a.y - b.y;
    return Math.sqrt(dx * dx + dy * dy);
}
function findLayerForRole(policy, role) {
    const keys = Object.keys(policy.layerRoles);
    for (let i = 0; i < keys.length; i++) {
        if (policy.layerRoles[keys[i]] === role) {
            return keys[i];
        }
    }
    return null;
}
function addSeg(tracks, layer, a, b, netId, netName, width) {
    if (dist(a, b) < 0.5) {
        return;
    }
    tracks.push({
        id: IdUtil.generate('trk'),
        layer,
        start: { x: a.x, y: a.y },
        end: { x: b.x, y: b.y },
