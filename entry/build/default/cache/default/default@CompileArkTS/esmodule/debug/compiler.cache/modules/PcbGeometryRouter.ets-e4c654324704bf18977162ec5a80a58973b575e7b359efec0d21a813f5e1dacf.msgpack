    }
    return segs;
}
function collectJogOffsets(grid, width) {
    const base = Math.max(grid, 5);
    const clearPad = Math.max(base * 8, width * 4 + 40);
    const mults = [2, 4, 6, 8, 10, 12, 16, 20, 24, 32, 40, 48, 64];
    const out = [];
    const seen = new Set();
    const push = (v) => {
        const s = snap(v, grid);
        if (s === 0 || seen.has(s) || seen.has(-s)) {
            return;
        }
        seen.add(s);
        out.push(s);
        out.push(-s);
    };
    push(clearPad);
    for (let i = 0; i < mults.length; i++) {
        push(base * mults[i]);
    }
    return out;
}
/**
 * å¤šç­–ç•¥æ­£äº¤ï¼šL / å¯¹ä¾§ L / å¤§ jog / åŒ jog / å…ˆ escape stub
