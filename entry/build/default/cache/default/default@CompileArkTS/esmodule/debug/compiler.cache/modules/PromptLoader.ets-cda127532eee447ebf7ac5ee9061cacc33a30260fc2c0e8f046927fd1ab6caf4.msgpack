  includeFullPins?: boolean;
  /** ä»…æ³¨å…¥ libDevId é€—å·æ¸…å•ï¼ˆmodular_plan ç”¨ï¼Œä¸å¿…å…¨è„šï¼‰ */
  includeLibIds?: boolean;
  /** æŒ‰æ„å›¾ç»„è£… systemï¼ˆdevice_select / net_planï¼‰ */
  intent?: CircuitIntent;
  /**
   * æ¨¡å—å¹¶è¡Œå­é€‰å‹ï¼šæŒ‰ prompt æåˆ°çš„ libDevId è¿‡æ»¤å…¨è„šç›®å½•ï¼ˆå¤§å¹…ç¼©çŸ­ promptï¼‰ã€‚
