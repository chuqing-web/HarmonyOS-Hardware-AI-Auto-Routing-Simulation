    /**
     * å¸ƒå±€é˜¶æ®µï¼šæ¯ä¸ªå¾…æ‘†æ”¾å™¨ä»¶çš„é€‰ä¸­åŒºå°ºå¯¸ï¼ˆHIT_PADï¼‰ï¼Œä¾› AI é¿å…é‡åˆä¸ç•™èµ°çº¿é€šé“ã€‚
     * ç»™å‡º rotate=0 / 90 ä¸¤ç§ä¸‹çš„é€‰ä¸­åŒºå®½é«˜ï¼›æ‘†æ”¾åä¸–ç•Œ AABB = ä¸­å¿ƒÂ±åŠå®½é«˜ã€‚
     */
    static buildLayoutDeviceHitSummary(devices, library) {
        if (devices.length === 0) {
            return '(æ— å™¨ä»¶)';
        }
        const lines = [];
        lines.push(`å…± ${devices.length} ä¸ªå¾…æ‘†æ”¾å™¨ä»¶ã€‚é€‰ä¸­å‘½ä¸­åŒº pad=${SELECTION_HIT_PAD}ï¼ˆä¸ç¼–è¾‘å™¨ä¸€è‡´ï¼‰ã€‚`);
        lines.push('è§„åˆ™: ä»»æ„ä¸¤å™¨ä»¶æ‘†æ”¾åé€‰ä¸­åŒºAABBä¸å¾—ç›¸äº¤ï¼›åŒºé—´é€šé“ â‰¥80milï¼›ä¸­å¿ƒåæ ‡ä¸º (x,y)ã€‚');
        lines.push('');
        for (let i = 0; i < devices.length; i++) {
            const d = devices[i];
            const comp = library.getComponent(d.libDevId);
            let w0 = 110 + SELECTION_HIT_PAD * 2;
            let h0 = 60 + SELECTION_HIT_PAD * 2;
            let w90 = h0;
            let h90 = w0;
            let pinN = 0;
            if (comp.success && comp.data && comp.data.pins.length > 0) {
