            lines.push(`  é€‰ä¸­åŒºå°ºå¯¸ rot0=${w0}Ã—${h0}  rot90=${w90}Ã—${h90}  ` +
                `(ä¸­å¿ƒé—´è·è‡³å°‘ â‰ˆ åŠå®½ä¹‹å’Œ+80 / åŠé«˜ä¹‹å’Œ+80)`);
            lines.push(`  ä¾‹: è‹¥ rot=0ï¼Œä¸­å¿ƒè‡³å°‘ç›¸è· dxâ‰¥${Math.round(w0 / 2 + 40)} æˆ– dyâ‰¥${Math.round(h0 / 2 + 40)} æ‰å¤Ÿé€šé“`);
        }
