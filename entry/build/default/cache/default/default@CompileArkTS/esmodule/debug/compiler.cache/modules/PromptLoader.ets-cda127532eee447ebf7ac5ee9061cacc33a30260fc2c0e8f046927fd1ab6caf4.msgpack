export interface RenderEnrichOptions {
  /** æ³¨å…¥å…¨åº“æ¯ä¸ªå™¨ä»¶çš„å…¨éƒ¨å¼•è„šï¼ˆé€‰å‹å¿…å¼€ï¼‰ */
  includeFullPins?: boolean;
  /** ä»…æ³¨å…¥ libDevId é€—å·æ¸…å•ï¼ˆmodular_plan ç”¨ï¼Œä¸å¿…å…¨è„šï¼‰ */
