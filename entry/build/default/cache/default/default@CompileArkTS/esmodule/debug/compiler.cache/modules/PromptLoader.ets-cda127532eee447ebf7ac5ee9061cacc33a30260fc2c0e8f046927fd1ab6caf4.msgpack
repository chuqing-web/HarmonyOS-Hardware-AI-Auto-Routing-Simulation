                }
                let vDir = '';
                if (Math.abs(dy) > Math.abs(dx) * 0.5) {
                    vDir = dy > 0 ? 'â†“ä¸‹' : 'â†‘ä¸Š';
                }
                const dir = hDir + vDir;
                const dirStr = dir.length > 0 ? ` ${dir}` : '';
                let wireTip = '';
                if (dist <= 200) {
                    wireTip = ' [è¿‘è·-å¯¼çº¿ç›´è¿]';
                }
                else if (dist <= 500) {
