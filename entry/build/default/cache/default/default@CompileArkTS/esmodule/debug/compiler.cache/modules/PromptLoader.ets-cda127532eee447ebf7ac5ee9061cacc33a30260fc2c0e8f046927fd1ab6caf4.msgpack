                    hitStr = ` é€‰ä¸­åŒº=(${Math.round(hit.x)},${Math.round(hit.y)},${Math.round(hit.w)}Ã—${Math.round(hit.h)})`;
                }
            }
            lines.push(`  ${d.refName}${tag} @ (${Math.round(d.x)}, ${Math.round(d.y)})${hitStr}`);
        }
        lines.push('');
        lines.push('å™¨ä»¶å¯¹è·ç¦»ä¸æ–¹ä½ï¼ˆç”¨äºè§„åˆ’å¯¼çº¿èµ°å‘ï¼‰:');
        const pairs = [];
        for (let i = 0; i < topo.deviceList.length; i++) {
            for (let j = i + 1; j < topo.deviceList.length; j++) {
                const a = topo.deviceList[i];
                const b = topo.deviceList[j];
                const dx = Math.round(b.x - a.x);
                const dy = Math.round(b.y - a.y);
                const dist = Math.round(Math.hypot(dx, dy));
                let hDir = '';
                if (Math.abs(dx) > Math.abs(dy) * 0.5) {
                    hDir = dx > 0 ? 'â†’å³' : 'â†å·¦';
                }
                let vDir = '';
                if (Math.abs(dy) > Math.abs(dx) * 0.5) {
                    vDir = dy > 0 ? 'â†“ä¸‹' : 'â†‘ä¸Š';
                }
                const dir = hDir + vDir;
                const dirStr = dir.length > 0 ? ` ${dir}` : '';
                let wireTip = '';
                if (dist <= 200) {
                    wireTip = ' [è¿‘è·-å¯¼çº¿ç›´è¿]';
                }
                else if (dist <= 500) {
                    wireTip = ' [ä¸­è·-å¯ç”¨å¯¼çº¿]';
                }
                else {
                    wireTip = ' [è¿œè·-è€ƒè™‘æ ‡å·]';
                }
                pairs.push(`  ${a.refName}â†”${b.refName}: dx=${dx} dy=${dy} dist=${dist}${dirStr}${wireTip}`);
            }
        }
        pairs.sort();
        for (let k = 0; k < pairs.length; k++) {
            lines.push(pairs[k]);
        }
        lines.push('');
        lines.push('å¸ƒçº¿åŒºåŸŸå»ºè®®:');
        lines.push('  å™¨ä»¶ä¸Šæ–¹(yå°)åŒºåŸŸ â†’ é€‚åˆèµ°ç”µæºçº¿ VCC');
        lines.push('  å™¨ä»¶ä¸‹æ–¹(yå¤§)åŒºåŸŸ â†’ é€‚åˆèµ°åœ°çº¿ GND');
        lines.push('  å™¨ä»¶å·¦å³ä¸¤ä¾§ â†’ é€‚åˆèµ°ä¿¡å·çº¿');
        lines.push(`  å¯¼çº¿ä¸åº”ç©¿è¿‡ä»»ä½•å™¨ä»¶çš„é€‰ä¸­å‘½ä¸­åŒº(HIT_PAD=${SELECTION_HIT_PAD}ï¼Œä¸ç¼–è¾‘å™¨é€‰ä¸­èŒƒå›´ä¸€è‡´)`);
        lines.push(`  å¯¼çº¿è·æ— å…³å¼•è„šå®‰å…¨è·ç¦» â‰¥${FOREIGN_PIN_CLEARANCE}mil`);
        lines.push('');
        lines.push('=== æ‹¥æŒ¤åº¦åˆ†æï¼ˆç”¨äºå†³å®š joinByLabel vs joinWiredï¼‰ ===');
        const clusters = PromptLoader.detectClusters(topo);
        if (clusters.length > 0) {
            lines.push(`æ£€æµ‹åˆ° ${clusters.length} ä¸ªå™¨ä»¶å¯†é›†åŒº:`);
            for (let ci = 0; ci < clusters.length; ci++) {
                const c = clusters[ci];
                const devNames = c.devices.map(d => d.refName).join(', ');
                lines.push(`  å¯†é›†åŒº${ci + 1}: [${devNames}] ` +
                    `ä¸­å¿ƒ(${Math.round(c.cx)},${Math.round(c.cy)}) èŒƒå›´${Math.round(c.radius)}mil ` +
                    `(${c.devices.length}ä¸ªå™¨ä»¶)`);
                if (c.devices.length >= 5) {
                    lines.push(`    âš  æ­¤åŒºåŸŸå™¨ä»¶å¯†é›†(${c.devices.length}ä¸ª) â†’ å¼ºçƒˆå»ºè®®ä½¿ç”¨ joinByLabel æ ‡å·è¿æ¥`);
                }
                else if (c.devices.length >= 3) {
                    lines.push(`    ğŸ’¡ æ­¤åŒºåŸŸå™¨ä»¶è¾ƒå¯†é›† â†’ è€ƒè™‘å¯¹ç©¿è¶Šæ­¤åŒºåŸŸçš„è·¨åŒºåŸŸä¿¡å·ä½¿ç”¨æ ‡å·`);
                }
            }
        }
        else {
            lines.push('  å™¨ä»¶åˆ†å¸ƒå‡åŒ€ï¼Œæ— å¯è¯†åˆ«çš„å¯†é›†åŒº');
        }
        const totalWireEstimate = topo.deviceList.length * 2;
        if (totalWireEstimate > 10) {
            lines.push(`  é¢„ä¼°å¯¼çº¿æ•°>${totalWireEstimate} â†’ å»ºè®®å¯¹è·¨åŒºåŸŸä¿¡å·ä¼˜å…ˆä½¿ç”¨ joinByLabel æ ‡å·ç®¡ç†`);
        }
        lines.push('  æ ‡å·å†³ç­–åŸåˆ™: 2ï½4è„šå±€éƒ¨å°ç½‘ä¼˜å…ˆå¯¼çº¿(WAR)ï¼›ä»ªå™¨/å¤§ç”µæºæ‰‡å‡º/è·¨åŒºç”¨æ ‡å·ï¼›å¯†é›†åŒºå¿…é¡»æ ‡å·ã€‚');
        lines.push('');
        lines.push('=== å¼•è„šå¯†åº¦åˆ†æï¼ˆé¢„æµ‹è¿çº¿æ‹¥æŒ¤åŒºåŸŸï¼Œå¸®åŠ©å†³å®šæ ‡å·ä½¿ç”¨ï¼‰ ===');
        const pinHotspots = PromptLoader.analyzePinDensity(topo);
        if (pinHotspots.length > 0) {
            for (const hs of pinHotspots) {
                const tag = hs.pinCount >= 15 ? 'æé«˜å¯†åº¦ âš ' :
                    hs.pinCount >= 8 ? 'é«˜å¯†åº¦ ğŸ’¡' : 'ä¸­å¯†åº¦';
                lines.push(`  åŒºåŸŸ(${hs.cellX},${hs.cellY}) ${tag}: ` +
                    `çº¦${hs.pinCount}ä¸ªå¼•è„šé›†ä¸­ â†’ é¢„è®¡${hs.estWireCount}æ¡å¯¼çº¿æ±‡èš`);
                if (hs.pinCount >= 15) {
                    lines.push(`    âš  æ­¤åŒºåŸŸå¼•è„šæåº¦å¯†é›† â†’ å¿…é¡»ä½¿ç”¨ joinByLabel æ ‡å·ç®¡ç†è·¨åŒºåŸŸä¿¡å·`);
                }
                else if (hs.pinCount >= 8) {
                    lines.push(`    ğŸ’¡ æ­¤åŒºåŸŸå¼•è„šè¾ƒå¯† â†’ å¼ºçƒˆå»ºè®®ç©¿è¶Šæ­¤åŒºåŸŸçš„ä¿¡å·ä½¿ç”¨æ ‡å·`);
                }
            }
        }
        else {
            lines.push('  å¼•è„šåˆ†å¸ƒå‡åŒ€ï¼Œæ— é«˜å¯†åº¦å¼•è„šé›†ä¸­åŒº');
        }
        return lines.join('\n');
    }
    static detectClusters(topo) {
        const visited = new Set();
        const clusters = [];
        const THRESHOLD = 150;
        for (const d of topo.deviceList) {
            if (visited.has(d.instUuid))
                continue;
            const group = [d];
            visited.add(d.instUuid);
            let head = 0;
            while (head < group.length) {
                const cur = group[head];
                for (const other of topo.deviceList) {
                    if (visited.has(other.instUuid))
                        continue;
                    const dist = Math.hypot(other.x - cur.x, other.y - cur.y);
                    if (dist < THRESHOLD) {
                        group.push(other);
                        visited.add(other.instUuid);
                    }
                }
                head++;
            }
            if (group.length >= 3) {
                let sumX = 0, sumY = 0;
                for (const dev of group) {
                    sumX += dev.x;
                    sumY += dev.y;
                }
                const cx = sumX / group.length;
                const cy = sumY / group.length;
                let maxR = 0;
                for (const dev of group) {
                    const r = Math.hypot(dev.x - cx, dev.y - cy);
                    if (r > maxR)
                        maxR = r;
                }
                clusters.push({ devices: group, cx, cy, radius: maxR + 30 });
            }
        }
        return clusters;
    }
    static analyzePinDensity(topo) {
        const CELL = 100;
        const cellMap = new Map();
        for (const dev of topo.deviceList) {
            const pinCount = PromptLoader.estimatePinCount(dev.libDevId);
            const cx = Math.floor(dev.x / CELL);
            const cy = Math.floor(dev.y / CELL);
            for (let dx = -1; dx <= 1; dx++) {
                for (let dy = -1; dy <= 1; dy++) {
                    const key = `${cx + dx},${cy + dy}`;
                    cellMap.set(key, (cellMap.get(key) ?? 0) + pinCount);
                }
            }
        }
        const hotspots = [];
        cellMap.forEach((pinCount, key) => {
            if (pinCount >= 5) {
                const parts = key.split(',');
                const cellX = Number(parts[0]) * CELL;
                const cellY = Number(parts[1]) * CELL;
                const devsInCell = [];
                for (const dev of topo.deviceList) {
                    const devCellX = Math.floor(dev.x / CELL);
                    const devCellY = Math.floor(dev.y / CELL);
                    if (Math.abs(devCellX - Number(parts[0])) <= 1 &&
                        Math.abs(devCellY - Number(parts[1])) <= 1) {
                        devsInCell.push(dev.refName ?? dev.libDevId);
                    }
                }
                hotspots.push({
                    cellX, cellY, pinCount,
                    estWireCount: Math.round(pinCount * 0.6),
                    devices: devsInCell.slice(0, 5)
                });
            }
        });
        hotspots.sort((a, b) => b.pinCount - a.pinCount);
        return hotspots.slice(0, 5);
    }
    static estimatePinCount(libDevId) {
        const id = (libDevId ?? '').toUpperCase();
        if (id.length === 0)
            return 4;
        if (id.includes('STM32') || id.includes('AT89') || id.includes('STC'))
            return 40;
        if (id.includes('MCU') || id.includes('ESP32'))
            return 30;
        if (id.includes('LCD') || id.includes('DISPLAY'))
            return 16;
        if (id.includes('OP') || id.includes('LM358') || id.includes('LM324') || id.includes('LM555'))
            return 8;
        if (id.includes('LOGIC') || id.includes('GATE') || id.includes('74'))
            return 14;
        if (id.includes('I2C') || id.includes('SPI') || id.includes('UART'))
            return 8;
        if (id.includes('AMMETER') || id.includes('VOLTMETER') || id.includes('METER'))
            return 3;
        if (id.includes('OSCILLOSCOPE'))
            return 4;
        if (id.startsWith('R_') || id.startsWith('C_') || id.startsWith('LED_') ||
            id.startsWith('L_') || id.startsWith('D_'))
            return 2;
        if (id.includes('XTAL') || id.includes('CRYSTAL') || id.includes('OSC'))
            return 2;
        if (id === 'VCC' || id === 'GND')
            return 1;
        return 4;
    }
}
