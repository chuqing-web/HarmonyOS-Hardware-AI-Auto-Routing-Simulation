                    const p = comp.data.pins[pi];
                    // ç²¾ç¡®ä¸–ç•Œåæ ‡ï¼šåº“è„šå±€éƒ¨åæ ‡ Ã— æ—‹è½¬é•œåƒ + å™¨ä»¶åŸç‚¹
                    const t = DeviceHitGeometry.transformLocal(p.position, d.rotate, d.mirrorH);
