                    lines.push(`  é€‰ä¸­åŒºAABB: (${Math.round(hit.x)},${Math.round(hit.y)},${Math.round(hit.w)}Ã—${Math.round(hit.h)})`);
                    lines.push(`  å¼•è„šç²¾ç¡®ä¸–ç•Œåæ ‡: ${pinLines.join('  ')}`);
                }
                else {
                    lines.push('  å¼•è„š: (æ— å¼•è„šä¿¡æ¯)');
                }
            }
        }
        lines.push('');
        lines.push(`ã€å¯¼çº¿ç¦åŒºã€‘é€‰ä¸­åŒºAABB + æ— å…³å¼•è„š${FOREIGN_PIN_CLEARANCE}mil å®‰å…¨åœˆ â€” routeWaypoints ä¸å¾—è½å…¥`);
