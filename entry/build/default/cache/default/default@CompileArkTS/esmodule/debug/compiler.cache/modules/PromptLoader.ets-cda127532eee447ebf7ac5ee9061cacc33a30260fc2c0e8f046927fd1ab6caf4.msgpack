/** ä» prompt æå–æåˆ°çš„åº“å†… libDevIdï¼ˆå« libDevId=XXXï¼‰ */
function collectMentionedLibIds(library, prompt) {
    const want = new Set();
    const allIds = listAllLibIds(library);
    const text = prompt ?? '';
    const textU = text.toUpperCase();
    // æ˜¾å¼ libDevId=XXX
    const re = /libDevId\s*=\s*([A-Za-z0-9_.-]+)/gi;
    let m = re.exec(text);
    while (m) {
        const id = (m[1] ?? '').trim();
        if (id.length > 0) {
            want.add(id);
        }
        m = re.exec(text);
    }
    for (let i = 0; i < allIds.length; i++) {
        const id = allIds[i];
        if (id.length < 2) {
            continue;
        }
        if (textU.indexOf(id.toUpperCase()) >= 0) {
            want.add(id);
        }
    }
    // ç”µæºä¸å¸¸è§æ¿€åŠ±å§‹ç»ˆå¸¦ä¸Š
    const always = ['VCC', 'GND', 'VAC', 'SW_PUSH'];
    for (let ai = 0; ai < always.length; ai++) {
        want.add(always[ai]);
    }
    // æåˆ°ç¤ºæ³¢å™¨/ç”µå‹è¡¨ç­‰ä¸­æ–‡æ—¶è¡¥ä»ªå™¨
    if (text.indexOf('ç¤ºæ³¢å™¨') >= 0 || textU.indexOf('OSC') >= 0) {
        want.add('OSCILLOSCOPE');
    }
    if (text.indexOf('ç”µå‹è¡¨') >= 0) {
        want.add('VOLTMETER_DC');
    }
    if (text.indexOf('ç”µæµè¡¨') >= 0) {
        want.add('AMMETER_DC');
    }
    if (text.indexOf('ä¸‡ç”¨è¡¨') >= 0 || text.indexOf('å¤šç”¨ç”µè¡¨') >= 0 ||
        text.indexOf('ç”µé˜»æ¡£') >= 0 || text.indexOf('äºŒæç®¡æ¡£') >= 0) {
        want.add('VIRTUAL_METER');
    }
    if (text.indexOf('åŠŸç‡è¡¨') >= 0 || text.indexOf('æµ‹åŠŸç‡') >= 0) {
        want.add('POWER_METER');
    }
    if (text.indexOf('é¢‘ç‡è®¡') >= 0) {
        want.add('FREQ_COUNTER');
    }
    if (text.indexOf('ä¿¡å·å‘ç”Ÿå™¨') >= 0 || text.indexOf('ä¿¡å·æº') >= 0) {
        want.add('SIGNAL_GEN');
    }
    if (text.indexOf('é€»è¾‘åˆ†æ') >= 0) {
        want.add('LOGIC_ANALYZER');
    }
    if (text.indexOf('ç”µä½å™¨') >= 0 || textU.indexOf('POT') >= 0 ||
        textU.indexOf('RV1') >= 0 || textU.indexOf('RV2') >= 0) {
        want.add('POT_1k');
        want.add('POT_10k');
        want.add('POT_100k');
    }
    // è¢«åŠ¨ä»¶æ—ï¼šæåˆ° R_/C_ ä»»ä¸€åˆ™è¡¥å¸¸ç”¨æ¡£ï¼Œé¿å… Ï„ é€‰å‹å¡æ­»
    let needR = false;
    let needC = false;
    for (const id of want) {
        if (id.indexOf('R_') === 0) {
            needR = true;
        }
        if (id.indexOf('C_') === 0) {
            needC = true;
        }
    }
    if (text.indexOf('ç”µé˜»') >= 0 || needR) {
        const rs = ['R_330', 'R_1k', 'R_4.7k', 'R_10k', 'R_47k', 'R_100k'];
        for (let ri = 0; ri < rs.length; ri++) {
            want.add(rs[ri]);
        }
    }
    if (text.indexOf('ç”µå®¹') >= 0 || needC) {
        const cs = ['C_10nF', 'C_100nF', 'C_1uF', 'C_10uF', 'C_100uF'];
        for (let ci = 0; ci < cs.length; ci++) {
            want.add(cs[ci]);
        }
    }
    return want;
}
function listAllLibIds(library) {
    const ids = [];
    const categories = library.getCategories();
    for (const cat of categories) {
        const result = library.listByCategory(cat, 1, 200);
        for (const d of result.items) {
            ids.push(d.id);
        }
    }
    return ids;
}
/**
 * å…¨è„šç›®å½•ï¼›filterIds éç©ºæ—¶åªå±•å¼€è¿™äº›å™¨ä»¶çš„å¼•è„šï¼ˆä»é€‚åˆæ¨¡å—å­é€‰å‹ï¼‰ã€‚
 */
function formatCatalogWithPins(library, filterIds) {
    const lines = [];
    if (filterIds !== null) {
        lines.push('ã€æœ¬æ¨¡å—ç›¸å…³å™¨ä»¶å¼•è„š â€” ä¼˜å…ˆé€‰ç”¨ï¼›å¼•è„šå¿…é¡»ä½¿ç”¨ä¸‹åˆ— pinId/pinNameã€‘');
        lines.push('æ ¼å¼: pinId(pinName):type@local(x,y)ï¼›type=ç”µæ°”è§’è‰²(input/output/power/ground/â€¦)ï¼›è¿çº¿é¡»å°Šé‡ type è¯­ä¹‰');
        lines.push('ï¼ˆå®Œæ•´å¯ç”¨ libDevId æ¸…å•è§æ–‡æœ«ï¼›æœªåˆ—å…¨è„šçš„å™¨ä»¶ä»å¯é€‰ï¼Œä½†é¡»ç”¨åº“å†…çœŸè„šï¼‰');
    }
    else {
        lines.push('ã€å®Œæ•´å™¨ä»¶åº“ â€” åªèƒ½é€‰ç”¨ä¸‹åˆ— libDevIdï¼›å¼•è„šå¿…é¡»ä½¿ç”¨ä¸‹åˆ— pinId/pinNameã€‘');
        lines.push('æ ¼å¼: pinId(pinName):type@local(x,y)ï¼›type=ç”µæ°”è§’è‰²(input/output/power/ground/â€¦)ï¼›è¿çº¿é¡»å°Šé‡ type è¯­ä¹‰');
    }
    const categories = library.getCategories();
    for (const cat of categories) {
        const result = library.listByCategory(cat, 1, 200);
        if (result.items.length === 0) {
            continue;
        }
        const items = filterIds !== null
            ? result.items.filter(d => filterIds.has(d.id))
            : result.items;
        if (items.length === 0) {
            continue;
        }
        lines.push(`\n## ${cat}`);
        for (const d of items) {
            const pins = d.pins ?? [];
            lines.push(`${d.id} | ${d.name} | pins=${pins.length}`);
            if (pins.length === 0) {
                const meta = library.getDeviceMeta(d.id);
                const metaPins = meta.success && meta.data ? meta.data.pin_list : [];
                if (metaPins.length > 0) {
                    const bits = [];
                    for (let i = 0; i < metaPins.length; i++) {
                        const mp = metaPins[i];
                        const px = Math.round(mp.x ?? 0);
                        const py = Math.round(mp.y ?? 0);
                        const ptype = mp.pin_type ?? 'passive';
                        bits.push(`${mp.pin_id}(${mp.pin_label ?? mp.pin_id}):${ptype}@local(${px},${py})`);
                    }
                    lines.push(`  å¼•è„š: ${bits.join(', ')}`);
                }
                else {
                    lines.push('  å¼•è„š: (æ— )');
                }
            }
            else {
                const bits = [];
                for (let i = 0; i < pins.length; i++) {
                    const p = pins[i];
                    const px = Math.round(p.position?.x ?? 0);
                    const py = Math.round(p.position?.y ?? 0);
                    const ptype = `${p.type ?? 'passive'}`;
                    bits.push(`${p.id}(${p.name}):${ptype}@local(${px},${py})`);
                }
                lines.push(`  å¼•è„š: ${bits.join(', ')}`);
            }
        }
    }
    return lines.length > 0 ? lines.join('\n') : '(å™¨ä»¶åº“ä¸ºç©º)';
}
function buildLibIdList(library) {
    return listAllLibIds(library).join(', ');
}
/** ä»å™¨ä»¶åº“åŠ¨æ€ç”Ÿæˆä»ªå™¨/ç”µä½å™¨çœŸè„šé€ŸæŸ¥ï¼ˆç¦æ­¢ç¡¬ç¼–ç è„šåè¡¨ï¼‰ */
function buildInstrumentPinCheatsheet(library) {
    const focus = [
        'OSCILLOSCOPE', 'VOLTMETER_DC', 'AMMETER_DC', 'UART_TERMINAL',
        'LOGIC_ANALYZER', 'POWER_METER', 'FREQ_COUNTER', 'VIRTUAL_METER',
        'SIGNAL_GEN', 'POT_1k', 'POT_10k', 'POT_100k', 'RELAY_SPDT'
    ];
    const lines = ['ã€åº“å†…çœŸè„šé€ŸæŸ¥ â€” ç¦æ­¢å‡è®¾è„šåã€‘:'];
    for (let i = 0; i < focus.length; i++) {
        const id = focus[i];
        const bits = [];
        try {
            const comp = library.getComponent(id);
            if (comp.success && comp.data && comp.data.pins && comp.data.pins.length > 0) {
                for (let pi = 0; pi < comp.data.pins.length; pi++) {
                    const p = comp.data.pins[pi];
                    bits.push(`${p.id}:${p.type ?? 'passive'}`);
                }
            }
            else {
                const meta = library.getDeviceMeta(id);
                if (meta.success && meta.data && meta.data.pin_list) {
                    for (let pi = 0; pi < meta.data.pin_list.length; pi++) {
                        const mp = meta.data.pin_list[pi];
                        bits.push(`${mp.pin_id}:${mp.pin_type ?? 'passive'}`);
                    }
                }
            }
        }
        catch (_e) {
            // skip
        }
        if (bits.length > 0) {
            lines.push(`- ${id}: ${bits.join(', ')}`);
        }
    }
    if (lines.length <= 1) {
        return '';
    }
    return `\n${lines.join('\n')}`;
}
/** ä» template.id æ¨æ–­é˜¶æ®µåï¼ˆdevice_select_v5 â†’ device_selectï¼‰ */
function inferStageFromTemplateId(id) {
    const keys = [
        'device_select', 'modular_plan', 'net_plan', 'self_review',
        'edit_plan', 'gen_sch', 'layout', 'route', 'diag'
    ];
    const low = (id ?? '').toLowerCase();
    for (let i = 0; i < keys.length; i++) {
        if (low.indexOf(keys[i]) >= 0) {
            return keys[i];
        }
    }
    return '';
}
export class PromptLoader {
    /** ä» templates åŠ è½½ï¼›runtime_key å¯¹åº” skill/prompts README æ˜ å°„è¡¨ */
    static load(name) {
        switch (name) {
            case 'device_select':
                return DEVICE_SELECT_PROMPT;
            case 'requirement':
                return REQUIREMENT_PROMPT;
            case 'layout':
                return LAYOUT_PROMPT;
            case 'route':
                return ROUTE_PROMPT;
            case 'diag':
                return DIAG_PROMPT;
            case 'gen_sch':
                return GEN_SCH_PROMPT;
            case 'net_plan':
                return NET_PLAN_PROMPT;
            case 'self_review':
                return SELF_REVIEW_PROMPT;
            case 'modular_plan':
                return MODULAR_PLAN_PROMPT;
            case 'edit_plan':
                return EDIT_PLAN_PROMPT;
            default:
                Logger.error(INSTR_TRACE_TAG, `[AI_PROMPT] unknown template name="${name}" â€” refuse silent DEVICE_SELECT fallback`);
                // è¿”å›ç©ºæ¨¡æ¿è¿«ä½¿è°ƒç”¨æ–¹å¤±è´¥ï¼Œç¦æ­¢é™é»˜é”™ç”¨ device_select
                return {
                    id: 'unknown',
                    version: '0',
                    system: '',
                    userTemplate: ''
                };
        }
    }
    /** æŒ‰ CircuitIntent æ›¿æ¢ device_select / net_plan çš„ system */
    static loadForIntent(name, intent, userPrompt = '', libIds = []) {
        const base = PromptLoader.load(name);
        if (name === 'device_select') {
            const t = {
                id: base.id,
                version: base.version,
                system: assembleDeviceSelectSystem(intent, userPrompt, libIds),
                userTemplate: base.userTemplate
            };
            return t;
        }
        if (name === 'net_plan') {
            const t = {
                id: base.id,
                version: base.version,
                system: assembleNetPlanSystem(intent, libIds),
                userTemplate: base.userTemplate
            };
            return t;
        }
        return base;
    }
    static render(template, vars) {
        if (!template.system || template.system.length === 0) {
            Logger.error(INSTR_TRACE_TAG, `[AI_PROMPT] refuse render empty template id=${template.id}`);
            return '';
        }
        const user = applyPromptVars(template.userTemplate, vars);
        const stageCap = stageCapabilityBlurb(inferStageFromTemplateId(template.id));
        return `${template.system}${stageCap}${JSON_ONLY_OUTPUT_RULE}\n\n${user}`;
    }
    /**
     * å¢å¼ºç‰ˆ promptï¼šæ³¨å…¥å™¨ä»¶åº“ç›®å½• + æ‹“æ‰‘åæ¨¡å¼ï¼ˆSharedPromptRulesï¼‰ã€‚
     * @param options.includeFullPins é€‰å‹é˜¶æ®µ trueï¼šæ³¨å…¥æ¯ä¸ªå™¨ä»¶å…¨éƒ¨å¼•è„š
     * @param options.intent è‹¥æä¾›ä¸”æ¨¡æ¿ä¸º device_select/net_planï¼Œç”¨æ„å›¾ç»„è£… system
     */
    static renderEnriched(template, vars, library, options) {
        let effective = template;
        if (options?.intent) {
            let userPromptHint = options.filterPinsByPrompt ?? '';
            if (userPromptHint.length === 0 && vars) {
                for (let vi = 0; vi < vars.length; vi++) {
                    if (vars[vi].key === 'user_prompt') {
                        userPromptHint = vars[vi].value ?? '';
                        break;
                    }
                }
            }
            if (template.id.indexOf('device_select') >= 0) {
                const fragIds = options.libIdsForFragments ?? [];
                effective = PromptLoader.loadForIntent('device_select', options.intent, userPromptHint, fragIds);
            }
            else if (template.id.indexOf('net_plan') >= 0) {
                const fragIds = options.libIdsForFragments ?? [];
                effective = PromptLoader.loadForIntent('net_plan', options.intent, '', fragIds);
            }
        }
        if (cachedCatalogSummary.length === 0) {
            cachedCatalogSummary = buildCompactCatalog(library);
            cachedCatalogLibIds = buildLibIdList(library);
        }
        if (options?.includeFullPins && cachedFullPinCatalog.length === 0) {
            cachedFullPinCatalog = buildFullCatalogWithPins(library);
        }
        let catalogForUser = options?.includeFullPins ? cachedFullPinCatalog : cachedCatalogSummary;
        const filterHint = options?.filterPinsByPrompt ?? '';
        if (options?.includeFullPins && filterHint.length > 0) {
            const mentioned = collectMentionedLibIds(library, filterHint);
            // è‡³å°‘å‘½ä¸­ 1 ä¸ªéç”µæºå™¨ä»¶æ‰è¿‡æ»¤ï¼Œå¦åˆ™å›é€€å…¨åº“é¿å…ç©ºç›®å½•
            let nonPwr = 0;
            const mentIds = Array.from(mentioned);
            for (let mi = 0; mi < mentIds.length; mi++) {
                const id = mentIds[mi];
                if (id !== 'VCC' && id !== 'GND' && id !== 'VAC' && id !== 'SW_PUSH') {
                    nonPwr++;
                }
            }
            if (nonPwr >= 1) {
                catalogForUser = formatCatalogWithPins(library, mentioned);
            }
        }
        let enrichedUser = effective.userTemplate;
        if (enrichedUser.includes('{{library_catalog}}')) {
            enrichedUser = enrichedUser.replace('{{library_catalog}}', catalogForUser);
        }
        if (enrichedUser.includes('{{library_summary}}')) {
            enrichedUser = enrichedUser.replace('{{library_summary}}', `å¯ç”¨ libDevId: ${cachedCatalogLibIds}\n${catalogForUser}`);
        }
        const user = applyPromptVars(enrichedUser, vars);
        // layout / routeï¼šçŸ­ JSON å¡«ç©ºï¼Œç¦æ­¢æ‹“æ‰‘åæ¨¡å¼ï¼ˆæ˜“è¯±ä½¿é•¿æ–‡ï¼‰ï¼›å…¶ä½™é˜¶æ®µä¿ç•™åæ¨¡å¼
        // å…¨é˜¶æ®µå¼ºåˆ¶æ³¨å…¥ JSON_ONLY
        const isLayout = effective.id.indexOf('layout') >= 0;
        const isRoute = effective.id.indexOf('route') >= 0;
        const skipTopoGuard = isLayout || isRoute;
        const guard = skipTopoGuard ? '' : `${INSTRUMENT_TOPOLOGY_RULES}${TOPOLOGY_ANTIPATTERN_GUARD}`;
        const pinRule = skipTopoGuard ? '' : (options?.includeFullPins
            ? '\nã€é€‰å‹é“å¾‹ã€‘explicitModel å¿…é¡»æ˜¯ä¸Šæ–¹æ¸…å•ä¸­çš„ç²¾ç¡® libDevIdï¼›å¼•è„šè¿æ¥åªèƒ½ä½¿ç”¨è¯¥å™¨ä»¶åˆ—å‡ºçš„ pinId/pinNameï¼›ç¦æ­¢ç¼–é€ åº“å¤–å‹å·ã€‚'
            : (options?.includeLibIds
                ? '\nã€åº“çº¦æŸ â€” ç¡¬æ€§ã€‘modules[].prompt ä¸­çš„å™¨ä»¶å¿…é¡»æ˜¯ä¸Šæ–¹æ¸…å•ä¸­çš„ç²¾ç¡® libDevIdï¼›ç¦æ­¢ 2N3906/BC547 ç­‰åº“å¤–å‹å·ï¼›555 å®šæ—¶å™¨ç”¨ LM555ã€‚'
                : ''));
        const wantLibIds = !skipTopoGuard && !!(options?.includeFullPins || options?.includeLibIds);
        const idHint = wantLibIds
            ? `\n\nã€å¯ç”¨å™¨ä»¶ libDevId æ¸…å• â€” åªèƒ½ä½¿ç”¨ä¸‹åˆ— IDã€‘:\n${cachedCatalogLibIds}${pinRule}`
            : pinRule;
        const instrumentHint = !skipTopoGuard && (options?.includeLibIds || options?.includeFullPins)
            ? buildInstrumentPinCheatsheet(library)
            : '';
        const stageName = (options?.stageName ?? '').length > 0
            ? options.stageName
            : inferStageFromTemplateId(effective.id);
        const stageCap = stageCapabilityBlurb(stageName);
        return `${effective.system}${stageCap}${JSON_ONLY_OUTPUT_RULE}${guard}${instrumentHint}${idHint}\n\n${user}`;
    }
    static clearCatalogCache() {
        cachedCatalogSummary = '';
        cachedCatalogLibIds = '';
        cachedFullPinCatalog = '';
    }
    static extractJson(content) {
        if (!content) {
            return null;
        }
        const isolated = PromptLoader.isolateJsonObject(content);
        if (isolated !== null) {
            try {
                return JSON.parse(isolated);
            }
            catch (_e0) {
                const repaired = PromptLoader.tryRepairTruncatedJson(isolated);
                if (repaired) {
                    try {
                        return JSON.parse(repaired);
                    }
                    catch (_e0b) {
                        // fall through to legacy paths
                    }
                }
            }
        }
        const trimmed = content.trim();
        try {
            return JSON.parse(trimmed);
        }
        catch (_e) {
            // continue
        }
        const codeStart = trimmed.indexOf('```');
        if (codeStart >= 0) {
            const afterStart = trimmed.indexOf('\n', codeStart + 3);
            if (afterStart >= 0) {
                const codeEnd = trimmed.indexOf('```', afterStart + 1);
                if (codeEnd > afterStart) {
                    const inner = trimmed.substring(afterStart + 1, codeEnd).trim();
                    if (inner.length > 0) {
                        try {
                            return JSON.parse(inner);
                        }
                        catch (_e2) {
                            // continue
                        }
                    }
                }
            }
        }
        const start = trimmed.indexOf('{');
        const end = trimmed.lastIndexOf('}');
        if (start >= 0 && end > start) {
            try {
                return JSON.parse(trimmed.substring(start, end + 1));
            }
            catch (_e3) {
                const repaired = PromptLoader.tryRepairTruncatedJson(trimmed.substring(start));
                if (repaired) {
                    try {
                        return JSON.parse(repaired);
                    }
                    catch (_e4) {
                        // continue
                    }
                }
            }
        }
        return null;
    }
    /**
     * ä»å¯èƒ½æ··æœ‰ thinking / è¯´æ˜ / markdown çš„å›å¤ä¸­éš”ç¦»å‡ºæœ€å¤–å±‚ JSON å¯¹è±¡æ­£æ–‡ã€‚
     * ä¼˜å…ˆå‰¥ç¦» <think> / <thinking> å—ï¼Œå†æŒ‰æ‹¬å·å¹³è¡¡ï¼ˆå°Šé‡å­—ç¬¦ä¸²ï¼‰æŠ½å–ã€‚
     */
    static isolateJsonObject(content) {
        if (!content) {
            return null;
        }
        let s = PromptLoader.stripThinkBlocks(content).trim();
        if (s.length === 0) {
            return null;
        }
        // markdown fence â†’ take inner
        const fence = s.indexOf('```');
        if (fence >= 0) {
            const afterNl = s.indexOf('\n', fence + 3);
            if (afterNl >= 0) {
                const endFence = s.indexOf('```', afterNl + 1);
                if (endFence > afterNl) {
                    s = s.substring(afterNl + 1, endFence).trim();
                }
            }
        }
        if (s.charAt(0) === '{' && s.charAt(s.length - 1) === '}') {
            try {
                JSON.parse(s);
                return s;
            }
            catch (_e) {
                // continue to brace scan
            }
        }
        return PromptLoader.extractBalancedJsonObject(s);
    }
    /** å»æ‰ DeepSeek / é€šç”¨ thinking æ³„æ¼æ ‡ç­¾ä¸æ®‹ç•™ */
    static stripThinkBlocks(content) {
        let s = content;
        // <think>...</think> ä»¥åŠæœªé—­åˆæ®‹æ®µ
        s = s.replace(/<think>[\s\S]*?<\/think>/gi, '');
        s = s.replace(/<thinking>[\s\S]*?<\/thinking>/gi, '');
        s = s.replace(/<\/?think>/gi, '');
        s = s.replace(/<\/?thinking>/gi, '');
        // å¸¸è§ã€Œæ¨ç†ç»“æŸåçš„ JSON:ã€å‰è¨€ï¼šä¿ç•™ä»é¦–ä¸ª { èµ·çš„å†…å®¹ç”± isolate å¤„ç†
        return s;
    }
    /**
     * æ‹¬å·å¹³è¡¡æŠ½å–ï¼šå–ã€Œæœ€åä¸€ä¸ªå¯è§£æçš„å®Œæ•´ {â€¦} å¯¹è±¡ã€
     * ï¼ˆthinking å¸¸åœ¨å‰ï¼Œæœ€ç»ˆ JSON åœ¨åï¼‰
     */
    static extractBalancedJsonObject(content) {
        const s = content;
        let lastOk = null;
        for (let i = 0; i < s.length; i++) {
            if (s.charAt(i) !== '{') {
                continue;
            }
            let depth = 0;
            let inStr = false;
            let esc = false;
            for (let j = i; j < s.length; j++) {
                const ch = s.charAt(j);
                if (inStr) {
                    if (esc) {
                        esc = false;
                    }
                    else if (ch === '\\') {
                        esc = true;
                    }
                    else if (ch === '"') {
                        inStr = false;
                    }
                    continue;
                }
                if (ch === '"') {
                    inStr = true;
                    continue;
                }
                if (ch === '{') {
                    depth++;
                }
                else if (ch === '}') {
                    depth--;
                    if (depth === 0) {
                        const cand = s.substring(i, j + 1);
                        try {
                            const v = JSON.parse(cand);
                            if (v !== null && typeof v === 'object' && !Array.isArray(v)) {
                                lastOk = cand;
                            }
                        }
                        catch (_e) {
                            // ignore this span
                        }
                        break;
                    }
                }
            }
        }
        return lastOk;
    }
    /**
     * ä¸¥æ ¼çº¯ JSON å¯¹è±¡æ­£æ–‡ï¼štrim åå¿…é¡»ä»¥ { å¼€å¤´ } ç»“å°¾ï¼Œä¸”æ•´æ®µå¯ parseï¼Œç¦æ­¢ markdown å›´æ ã€‚
     * ç”¨äºæ£€æµ‹ LLM æ˜¯å¦è¿åã€Œåªå‡º JSONã€ï¼›å¯æŠ½å–è§£ææˆåŠŸä½† impure æ—¶è§¦å‘ critique é‡è¯•ã€‚
     * æ¨ç†å¼€åœºæ™¯ï¼šå‰¥ think æ ‡ç­¾åï¼Œæˆ–ä»…æœ‰çŸ­å‰è¨€ä½†å¯éš”ç¦»å‡ºå®Œæ•´ JSONï¼Œäº¦è§†ä¸ºé€šè¿‡ã€‚
     */
    static isStrictJsonObjectReply(content) {
        if (!content) {
            return false;
        }
        const stripped = PromptLoader.stripThinkBlocks(content).trim();
        const t = stripped.length > 0 ? stripped : content.trim();
        if (t.length < 2) {
            return false;
        }
        if (t.indexOf('```') >= 0) {
            // ä»å°è¯•éš”ç¦» fence å†… JSON
            const isolatedFence = PromptLoader.isolateJsonObject(content);
            if (isolatedFence !== null) {
                try {
                    const vf = JSON.parse(isolatedFence);
                    return vf !== null && typeof vf === 'object' && !Array.isArray(vf);
                }
                catch (_ef) {
                    return false;
                }
            }
            return false;
        }
        if (t.charAt(0) === '{' && t.charAt(t.length - 1) === '}') {
            try {
                const v = JSON.parse(t);
                return v !== null && typeof v === 'object' && !Array.isArray(v);
            }
            catch (_e) {
                // fall through to isolate
            }
        }
        // çŸ­å‰è¨€ / æ¨ç†æ³„æ¼ï¼šèƒ½éš”ç¦»å‡ºå®Œæ•´å¯¹è±¡å³æ¥å—ï¼Œé¿å… thinking å¼€å¯æ—¶æ— è°“é‡è¯•
        const isolated = PromptLoader.isolateJsonObject(content);
        if (isolated === null) {
            return false;
        }
        const pre = t.indexOf('{');
        if (pre > 200) {
            return false;
        }
        try {
            const v2 = JSON.parse(isolated);
            return v2 !== null && typeof v2 === 'object' && !Array.isArray(v2);
        }
        catch (_e2) {
            return false;
        }
    }
    /** æ‚è´¨æ‘˜è¦ï¼ˆæ—¥å¿—/critique ç”¨ï¼‰ */
    static describeJsonImpurity(content) {
        if (!content || content.trim().length === 0) {
            return 'empty';
        }
        const raw = content.trim();
        const stripped = PromptLoader.stripThinkBlocks(raw).trim();
        const t = stripped.length > 0 ? stripped : raw;
        const bits = [];
        if (raw !== stripped && stripped.length > 0) {
            bits.push('had_think_tags');
        }
        if (t.charAt(0) !== '{') {
            bits.push('not_start_{');
        }
        if (t.charAt(t.length - 1) !== '}') {
            bits.push('not_end_}');
        }
        if (t.indexOf('```') >= 0) {
            bits.push('markdown_fence');
        }
        const pre = t.indexOf('{');
        if (pre > 0) {
            bits.push(`preamble_chars=${pre}`);
        }
        if (PromptLoader.isolateJsonObject(content) !== null && bits.length > 0) {
            bits.push('isolatable');
        }
        return bits.length > 0 ? bits.join(',') : 'parse_fail';
    }
    /** å°½åŠ›é—­åˆè¢«æˆªæ–­çš„ JSONï¼ˆpositions æ•°ç»„å¸¸è§ï¼‰ */
    static tryRepairTruncatedJson(fragment) {
        if (!fragment || fragment.indexOf('{') < 0) {
            return null;
        }
        let s = fragment.trim();
        // å»æ‰æœ«å°¾æ®‹ç¼ºé”®å€¼
        const lastComma = s.lastIndexOf(',');
        const lastBrace = s.lastIndexOf('}');
        const lastBracket = s.lastIndexOf(']');
        if (lastComma > lastBrace && lastComma > lastBracket) {
            s = s.substring(0, lastComma);
        }
        let openBrace = 0;
        let openBracket = 0;
        let inStr = false;
        let esc = false;
        for (let i = 0; i < s.length; i++) {
            const ch = s.charAt(i);
            if (inStr) {
                if (esc) {
                    esc = false;
                }
                else if (ch === '\\') {
                    esc = true;
                }
                else if (ch === '"') {
                    inStr = false;
                }
                continue;
            }
            if (ch === '"') {
                inStr = true;
            }
            else if (ch === '{') {
                openBrace++;
            }
            else if (ch === '}') {
                openBrace--;
            }
            else if (ch === '[') {
                openBracket++;
            }
            else if (ch === ']') {
                openBracket--;
            }
        }
        if (inStr) {
            s += '"';
        }
        while (openBracket > 0) {
            s += ']';
            openBracket--;
        }
        while (openBrace > 0) {
            s += '}';
            openBrace--;
        }
        return s;
    }
    static getCachedLibIds() {
        return cachedCatalogLibIds;
