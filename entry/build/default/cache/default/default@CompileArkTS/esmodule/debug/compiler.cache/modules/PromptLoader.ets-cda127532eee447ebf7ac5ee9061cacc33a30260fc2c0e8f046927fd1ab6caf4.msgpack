/** ä» prompt æå–æåˆ°çš„åº“å†… libDevIdï¼ˆå« libDevId=XXXï¼‰ */
function collectMentionedLibIds(library, prompt) {
    const want = new Set();
    const allIds = listAllLibIds(library);
    const text = prompt ?? '';
    const textU = text.toUpperCase();
    // æ˜¾å¼ libDevId=XXX
    const re = /libDevId\s*=\s*([A-Za-z0-9_.-]+)/gi;
    let m = re.exec(text);
    while (m) {
        const id = (m[1] ?? '').trim();
        if (id.length > 0) {
            want.add(id);
        }
        m = re.exec(text);
    }
    for (let i = 0; i < allIds.length; i++) {
        const id = allIds[i];
        if (id.length < 2) {
            continue;
        }
        if (textU.indexOf(id.toUpperCase()) >= 0) {
            want.add(id);
        }
    }
    // ç”µæºä¸å¸¸è§æ¿€åŠ±å§‹ç»ˆå¸¦ä¸Š
    const always = ['VCC', 'GND', 'VAC', 'SW_PUSH'];
    for (let ai = 0; ai < always.length; ai++) {
        want.add(always[ai]);
    }
    // æåˆ°ç¤ºæ³¢å™¨/ç”µå‹è¡¨ç­‰ä¸­æ–‡æ—¶è¡¥ä»ªå™¨
    if (text.indexOf('ç¤ºæ³¢å™¨') >= 0 || textU.indexOf('OSC') >= 0) {
        want.add('OSCILLOSCOPE');
    }
    if (text.indexOf('ç”µå‹è¡¨') >= 0) {
        want.add('VOLTMETER_DC');
    }
    if (text.indexOf('ç”µæµè¡¨') >= 0) {
        want.add('AMMETER_DC');
    }
    if (text.indexOf('ä¸‡ç”¨è¡¨') >= 0 || text.indexOf('å¤šç”¨ç”µè¡¨') >= 0 ||
        text.indexOf('ç”µé˜»æ¡£') >= 0 || text.indexOf('äºŒæç®¡æ¡£') >= 0) {
        want.add('VIRTUAL_METER');
    }
    if (text.indexOf('åŠŸç‡è¡¨') >= 0 || text.indexOf('æµ‹åŠŸç‡') >= 0) {
        want.add('POWER_METER');
    }
    if (text.indexOf('é¢‘ç‡è®¡') >= 0) {
        want.add('FREQ_COUNTER');
    }
    if (text.indexOf('ä¿¡å·å‘ç”Ÿå™¨') >= 0 || text.indexOf('ä¿¡å·æº') >= 0) {
        want.add('SIGNAL_GEN');
    }
    if (text.indexOf('é€»è¾‘åˆ†æ') >= 0) {
        want.add('LOGIC_ANALYZER');
    }
    if (text.indexOf('ç”µä½å™¨') >= 0 || textU.indexOf('POT') >= 0 ||
        textU.indexOf('RV1') >= 0 || textU.indexOf('RV2') >= 0) {
        want.add('POT_1k');
        want.add('POT_10k');
        want.add('POT_100k');
    }
    // è¢«åŠ¨ä»¶æ—ï¼šæåˆ° R_/C_ ä»»ä¸€åˆ™è¡¥å¸¸ç”¨æ¡£ï¼Œé¿å… Ï„ é€‰å‹å¡æ­»
    let needR = false;
    let needC = false;
    for (const id of want) {
        if (id.indexOf('R_') === 0) {
            needR = true;
        }
        if (id.indexOf('C_') === 0) {
            needC = true;
        }
    }
    if (text.indexOf('ç”µé˜»') >= 0 || needR) {
        const rs = ['R_330', 'R_1k', 'R_4.7k', 'R_10k', 'R_47k', 'R_100k'];
        for (let ri = 0; ri < rs.length; ri++) {
            want.add(rs[ri]);
        }
    }
    if (text.indexOf('ç”µå®¹') >= 0 || needC) {
        const cs = ['C_10nF', 'C_100nF', 'C_1uF', 'C_10uF', 'C_100uF'];
        for (let ci = 0; ci < cs.length; ci++) {
            want.add(cs[ci]);
        }
    }
    return want;
}
function listAllLibIds(library) {
    const ids = [];
    const categories = library.getCategories();
    for (const cat of categories) {
        const result = library.listByCategory(cat, 1, 200);
        for (const d of result.items) {
            ids.push(d.id);
        }
    }
    return ids;
}
/**
 * å…¨è„šç›®å½•ï¼›filterIds éç©ºæ—¶åªå±•å¼€è¿™äº›å™¨ä»¶çš„å¼•è„šï¼ˆä»é€‚åˆæ¨¡å—å­é€‰å‹ï¼‰ã€‚
