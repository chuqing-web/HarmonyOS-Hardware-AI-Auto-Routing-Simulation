function buildCompactCatalog(library) {
    const lines = [];
    const categories = library.getCategories();
    for (const cat of categories) {
        const result = library.listByCategory(cat, 1, 200);
        if (result.items.length === 0) {
            continue;
        }
        lines.push(`ã€${cat}ã€‘`);
        for (const d of result.items) {
            const pinCount = d.pins?.length ?? 0;
            const rules = d.aiWiringRules?.join(',') ?? '-';
            lines.push(`  ${d.id} | ${d.name} | å¼•è„šæ•°:${pinCount} | è§„åˆ™:${rules}`);
        }
    }
    return lines.length > 0 ? lines.join('\n') : '(å™¨ä»¶åº“ä¸ºç©º)';
}
/** å…¨åº“å™¨ä»¶ + æ¯ä¸ªå¼•è„š id/name/å±€éƒ¨åæ ‡ â€” é€‰å‹é˜¶æ®µå¼ºåˆ¶æ³¨å…¥ */
function buildFullCatalogWithPins(library) {
