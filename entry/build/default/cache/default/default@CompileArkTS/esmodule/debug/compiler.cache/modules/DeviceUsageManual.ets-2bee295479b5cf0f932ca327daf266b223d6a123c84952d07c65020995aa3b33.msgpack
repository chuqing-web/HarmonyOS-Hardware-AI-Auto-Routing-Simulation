/** æ—æ¨¡æ¿ï¼šå‰ç¼€åŒ¹é…ï¼ˆé•¿å‰ç¼€ä¼˜å…ˆï¼‰ */
function buildFamilyTemplates() {
    return [
        {
            prefix: 'R_',
            entry: entry('', 'ç”µé˜»(é™æµ/åˆ†å‹/ä¸Šæ‹‰ä¸‹æ‹‰/å®šæ—¶)', 'é€šç”¨æ— æºç”µé˜»ã€‚æŒ‰åŠŸèƒ½ï¼šLED é™æµ(â‰¥220Î© ä¼˜å…ˆ R_330)ã€åˆ†å‹ã€I2C/å¤ä½/TRIG ä¸Šæ‹‰ã€555 å®šæ—¶ç”µé˜»ã€‚explicitModel å°½é‡å†™æ¸…é˜»å€¼ ID(R_1k/R_10k/R_4.7k)ã€‚', '1/2=ä¸¤ç«¯ï¼ˆæ— ææ€§ï¼‰', 'â‘ åˆ†å‹ï¼šVCCâ€”R1â€”SENSEâ€”R2â€”GNDã€‚â‘¡LED é™æµï¼šé©±åŠ¨æºâ€”Râ€”LED.Aï¼ŒLED.Kâ€”GNDï¼ˆN ç¯ N ç”µé˜»ï¼‰ã€‚' +
                'â‘¢ä¸Šæ‹‰ï¼šä¿¡å·ç½‘â€”Râ€”VCCï¼›ä¸‹æ‹‰ï¼šä¿¡å·ç½‘â€”Râ€”GNDã€‚' +
                'â‘£ã€555 æ— ç¨³æ€å®šæ—¶Â·ç¡¬ã€‘Ra(å¸¸ R_1k)ï¼šVCCâ€”DISCHï¼ˆä»…è¿™ä¸¤ç«¯ï¼‰ï¼›Rb(å¸¸ R_10k)ï¼šDISCHâ€”THRESâ‰¡TRIGï¼ˆä»…è¿™ä¸¤ç«¯ï¼‰ï¼›' +
                'ç¦æ­¢ä¸¤é¢—å®šæ—¶ R éƒ½æ¥ VCCï¼›ç¦æ­¢ Ra ç›´é€š THRES è€Œç»•è¿‡ DISCHã€‚' +
                'â‘¤ã€555 å•ç¨³æ€ã€‘å®šæ—¶ Rï¼šVCCâ€”DISCHï¼›TRIG ä¸Šæ‹‰ï¼šVCCâ€”Râ€”TRIGã€‚' +
                'â‘¥ã€ä¸²è” RC å……æ”¾ç”µÂ·ä»…æ—  555ã€‘VCCâ€”(SW)â€”Râ€”RC_MIDâ€”Câ€”GNDã€‚â‘¦I2Cï¼šSDA/SCL å„ R_4.7k ä¸Šæ‹‰ã€‚â‘§è¿æ”¾ Rin/Rf/Rg ç½‘ç»œã€‚', 'âœ•1ç¦æ­¢ä¸¤ç«¯åŒç½‘çŸ­è·¯ã€‚âœ•2 N è·¯ LED ç¦æ­¢å…±ç”¨ä¸€é¢—ç”µé˜»å´å£°ç§°ç‹¬ç«‹ã€‚' +
                'âœ•3ã€ç¡¬Â·æœ‰ LM555ã€‘ç¦æ­¢æŠŠå®šæ—¶/ä¸Šæ‹‰ç”µé˜»æ”¹æ¥åˆ° VCCâ†’SWâ†’Râ†’Câ†’GND ä¸²è” RCã€‚' +
                'âœ•4ç¦æ­¢å½“å¯¼çº¿ 0Î© çŸ­ç”µæºã€‚âœ•5ç¦æ­¢ç”¨ç”µé˜»å†’å……ç”µå®¹/ç”µæ„Ÿã€‚' +
                'âœ•6ã€æ— ç¨³æ€Â·ç¡¬ã€‘ç¦æ­¢æŠŠ Ra ä¸ Rb éƒ½æ¥åˆ° VCCï¼›ç¦æ­¢ Rb é«˜ç«¯æ¥ VCCã€‚', 'value ç”± libDevId å†³å®š(R_10kâ†’10kÎ©)', 'ç†æƒ³ç”µé˜»', 5)
        },
        {
            prefix: 'C_',
            entry: entry('', 'ç”µå®¹(å»è€¦/æ»¤æ³¢/å®šæ—¶/æ—è·¯)', 'æ»¤æ³¢å»è€¦ã€555 å®šæ—¶ã€CTRL æ—è·¯ã€è€¦åˆã€‚ç”µè§£æ³¨æ„ææ€§ï¼›ç“·ç‰‡å¸¸ C_100nF ä½œæ—è·¯ã€‚', '1/2ï¼ˆç”µè§£è‹¥åº“æ ‡æ³¨ææ€§åˆ™éµå®ˆï¼‰', 'â‘ å»è€¦ï¼šç´§é  IC ç”µæºè„šâ€”Câ€”GNDã€‚â‘¡ç”µæºå…¥å£ï¼šå¤§ç”µè§£+å°ç“·ç‰‡å¹¶è”åˆ° GNDã€‚' +
                'â‘¢ã€555 æ— ç¨³æ€å®šæ—¶ CÂ·ç¡¬ã€‘ä¸€ç«¯ä»… THRESâ‰¡TRIG åŒç½‘ï¼Œå¦ä¸€ç«¯ GNDï¼›ç¦æ­¢æ¥åˆ° DISCH å•ç‹¬æˆç½‘å´æ¼ THRESã€‚' +
