        for (let i = 0; i < parts.length; i++) {
            const p = parts[i].trim();
            if (p.length === 0 || p.indexOf('=') >= 0) {
                continue;
            }
            if (p.indexOf('å»ºç½‘') >= 0 || p.indexOf('æ—æ³¨') >= 0 || p.indexOf('å¿…é¡»') >= 0 ||
