                }
                if (id === 'LM7805' || id === 'LM7812' || id === 'AMS1117_3V3') {
                    if (up === 'IN' || up === 'OUT' || up === 'GND' || up === 'VIN' || up === 'VOUT') {
                        failures.push(`${id} æ‰‹å†Œä¸»è„š "${tok}" ä¸æ˜¯åº“ pinId(åº”ä¸º 1/2/3)ï¼›è¯·å†™ 1=IN å½¢å¼`);
                        continue;
                    }
                }
                if (!aliasOk) {
                    failures.push(`${id} æ‰‹å†Œè„š "${tok}" ä¸åœ¨åº“ pin.id [${libIds.slice(0, 10).join(',')}]`);
                }
            }
        }
        return failures;
    }
    /** å…¨åº“è¦†ç›–ï¼šæ¯ä¸ª ALL_CATALOG id éƒ½èƒ½ resolveï¼ˆç²¾ç¡®æˆ–æ—ï¼‰ */
    static coverageReport() {
        const covered = [];
        const missing = [];
        for (let i = 0; i < ALL_CATALOG_LIBRARY_IDS.length; i++) {
            const id = ALL_CATALOG_LIBRARY_IDS[i];
            if (DeviceUsageManual.resolve(id)) {
                covered.push(id);
            }
            else {
                missing.push(id);
            }
        }
        const total = ALL_CATALOG_LIBRARY_IDS.length;
        const percent = total === 0 ? 0 : Math.round(covered.length * 100 / total);
        const report = {
            covered: covered,
            missing: missing,
            total: total,
            percent: percent
        };
        return report;
    }
}
