/** æ—æ¨¡æ¿ï¼šå‰ç¼€åŒ¹é…ï¼ˆé•¿å‰ç¼€ä¼˜å…ˆï¼‰ */
function buildFamilyTemplates(): FamilyTemplate[] {
  return [
    {
      prefix: 'R_',
      entry: entry('', 'ç”µé˜»(é™æµ/åˆ†å‹/ä¸Šæ‹‰ä¸‹æ‹‰/å®šæ—¶)',
        'é€šç”¨æ— æºç”µé˜»ã€‚æŒ‰åŠŸèƒ½ï¼šLED é™æµ(â‰¥220Î© ä¼˜å…ˆ R_330)ã€åˆ†å‹ã€I2C/å¤ä½/TRIG ä¸Šæ‹‰ã€555 å®šæ—¶ç”µé˜»ã€‚explicitModel å°½é‡å†™æ¸…é˜»å€¼ ID(R_1k/R_10k/R_4.7k)ã€‚',
        '1/2=ä¸¤ç«¯ï¼ˆæ— ææ€§ï¼‰',
        'â‘ åˆ†å‹ï¼šVCCâ€”R1â€”SENSEâ€”R2â€”GNDã€‚â‘¡LED é™æµï¼šé©±åŠ¨æºâ€”Râ€”LED.Aï¼ŒLED.Kâ€”GNDï¼ˆN ç¯ N ç”µé˜»ï¼‰ã€‚' +
        'â‘¢ä¸Šæ‹‰ï¼šä¿¡å·ç½‘â€”Râ€”VCCï¼›ä¸‹æ‹‰ï¼šä¿¡å·ç½‘â€”Râ€”GNDã€‚' +
        'â‘£ã€555 æ— ç¨³æ€å®šæ—¶Â·ç¡¬ã€‘Ra(å¸¸ R_1k)ï¼šVCCâ€”DISCHï¼ˆä»…è¿™ä¸¤ç«¯ï¼‰ï¼›Rb(å¸¸ R_10k)ï¼šDISCHâ€”THRESâ‰¡TRIGï¼ˆä»…è¿™ä¸¤ç«¯ï¼‰ï¼›' +
        'ç¦æ­¢ä¸¤é¢—å®šæ—¶ R éƒ½æ¥ VCCï¼›ç¦æ­¢ Ra ç›´é€š THRES è€Œç»•è¿‡ DISCHã€‚' +
        'â‘¤ã€555 å•ç¨³æ€ã€‘å®šæ—¶ Rï¼šVCCâ€”DISCHï¼›TRIG ä¸Šæ‹‰ï¼šVCCâ€”Râ€”TRIGã€‚' +
        'â‘¥ã€ä¸²è” RC å……æ”¾ç”µÂ·ä»…æ—  555ã€‘VCCâ€”(SW)â€”Râ€”RC_MIDâ€”Câ€”GNDã€‚â‘¦I2Cï¼šSDA/SCL å„ R_4.7k ä¸Šæ‹‰ã€‚â‘§è¿æ”¾ Rin/Rf/Rg ç½‘ç»œã€‚',
        'âœ•1ç¦æ­¢ä¸¤ç«¯åŒç½‘çŸ­è·¯ã€‚âœ•2 N è·¯ LED ç¦æ­¢å…±ç”¨ä¸€é¢—ç”µé˜»å´å£°ç§°ç‹¬ç«‹ã€‚' +
