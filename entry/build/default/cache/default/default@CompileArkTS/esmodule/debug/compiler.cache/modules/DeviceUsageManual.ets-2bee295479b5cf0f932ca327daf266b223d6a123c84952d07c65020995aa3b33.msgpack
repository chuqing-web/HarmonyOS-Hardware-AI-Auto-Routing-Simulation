const MAX_CHARS_FULL_BLOCK = 8000;
const MAX_CHARS_PER_DEVICE_FULL = 800;
const MAX_CHARS_COMPACT_BLOCK = 3500;
function entry(id, title, summary, pins, typicalWiring, forbidden, params, simNotes, priority) {
    const e = {
        libDevId: id,
        title: title,
        summary: summary,
        pins: pins,
        typicalWiring: typicalWiring,
        forbidden: forbidden,
        params: params,
        simNotes: simNotes,
        priority: priority
    };
    return e;
}
