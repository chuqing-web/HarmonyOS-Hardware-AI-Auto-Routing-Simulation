const EXACT = buildExactEntries();
const FAMILIES = buildFamilyTemplates();
function cloneWithId(base, libDevId) {
    const e = {
        libDevId: libDevId,
        title: base.title,
        summary: base.summary,
        pins: base.pins,
        typicalWiring: base.typicalWiring,
