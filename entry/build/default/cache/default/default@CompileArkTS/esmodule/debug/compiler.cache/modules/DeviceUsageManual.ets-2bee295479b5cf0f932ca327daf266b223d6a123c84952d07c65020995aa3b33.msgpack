/** æ—æ¨¡æ¿ï¼šå‰ç¼€åŒ¹é…ï¼ˆé•¿å‰ç¼€ä¼˜å…ˆï¼‰ */
function buildFamilyTemplates(): FamilyTemplate[] {
  return [
    {
      prefix: 'R_',
      entry: entry('', 'ç”µé˜»(é™æµ/åˆ†å‹/ä¸Šæ‹‰ä¸‹æ‹‰/å®šæ—¶)',
        'é€šç”¨æ— æºç”µé˜»ã€‚æŒ‰åŠŸèƒ½ï¼šLED é™æµ(â‰¥220Î© ä¼˜å…ˆ R_330)ã€åˆ†å‹ã€I2C/å¤ä½/TRIG ä¸Šæ‹‰ã€555 å®šæ—¶ç”µé˜»ã€‚explicitModel å°½é‡å†™æ¸…é˜»å€¼ ID(R_1k/R_10k/R_4.7k)ã€‚',
        '1/2=ä¸¤ç«¯ï¼ˆæ— ææ€§ï¼‰',
