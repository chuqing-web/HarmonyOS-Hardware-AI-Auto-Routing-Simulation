}
export class DeviceUsageManual {
    /** è§£æå•å™¨ä»¶æ‰‹å†Œï¼›æ— ç²¾ç¡®/æ—åŒ¹é…è¿”å› null */
    static resolve(libDevId) {
        if (!libDevId || libDevId.length === 0) {
            return null;
        }
        for (let i = 0; i < EXACT.length; i++) {
            if (EXACT[i].libDevId === libDevId) {
                return EXACT[i];
            }
        }
        // é•¿å‰ç¼€ä¼˜å…ˆ
        let best = null;
        for (let i = 0; i < FAMILIES.length; i++) {
            const f = FAMILIES[i];
            if (libDevId.indexOf(f.prefix) === 0) {
                if (!best || f.prefix.length > best.prefix.length) {
                    best = f;
                }
            }
        }
        if (best) {
            return cloneWithId(best.entry, libDevId);
        }
        return null;
    }
    /**
     * è§£æå¹¶å…è®¸åº“ description å…œåº•ï¼ˆéé™é»˜ç©ºï¼‰
     * missIds æ”¶é›†æœªå‘½ä¸­æ‰‹å†Œçš„ IDï¼›criticalMissIds ä¸º MCU/IC/ä»ªå™¨ç­‰å…³é”®ç¼ºå£
     */
    static resolveWithLibraryFallback(libDevId, library, missIds, criticalMissIds) {
        const hit = DeviceUsageManual.resolve(libDevId);
        if (hit) {
            return hit;
        }
        missIds.push(libDevId);
        if (criticalMissIds && DeviceUsageManual.isCriticalLibId(libDevId)) {
            criticalMissIds.push(libDevId);
        }
        let desc = libDevId;
        let pinStr = '(æŸ¥åº“å¼•è„šè¡¨)';
        if (library) {
            try {
                const r = library.getComponent(libDevId);
                if (r.success && r.data) {
                    desc = r.data.description || r.data.name || libDevId;
                    const bits = [];
                    for (let pi = 0; pi < r.data.pins.length && pi < 16; pi++) {
                        const p = r.data.pins[pi];
                        bits.push(`${p.id}:${p.name}`);
                    }
                    if (bits.length > 0) {
                        pinStr = bits.join(', ');
                    }
                }
            }
            catch (_e) {
                // keep defaults
            }
        }
        return entry(libDevId, `${libDevId}(åº“æè¿°å…œåº•Â·è¯·è¡¥ç²¾ç¡®æ‰‹å†Œ)`, `${desc}ã€‚æœ¬æ¡æ— ç²¾ç¡®/æ—æ‰‹å†Œï¼Œå»ºç½‘é¡»ä¸¥æ ¼æŒ‰åº“å¼•è„šè¡¨ï¼Œç¦æ­¢ç¼–é€ è„šåã€‚`, pinStr, 'â‘ æŒ‰åº“å¼•è„šä¸ç”¨æˆ·åŠŸèƒ½å»ºç½‘ï¼šç”µæºè„šâ†’VCC/VEEï¼Œåœ°â†’GNDï¼Œä¿¡å·è„šå…¥åŠŸèƒ½ç½‘ã€‚â‘¡ä¼˜å…ˆ joinByLabelã€‚â‘¢ä»ªå™¨æ¢é’ˆæ ‡å·è¿æ¥ä¸”é¡»æœ‰ GND/COMã€‚', 'âœ•1ç¦æ­¢ç¼–é€ åº“å¤–è„šåã€‚âœ•2ç¦æ­¢ç”µæºçŸ­è·¯ã€‚âœ•3ç¦æ­¢æŠŠæœ¬å…œåº•æ¡ç›®å½“æˆå®Œæ•´æ‹“æ‰‘é…æ–¹ã€‚', 'è§å™¨ä»¶ defaultParams', 'è§è¡Œä¸º/SPICE æ¨¡å‹ï¼›å…³é”® IC åº”è¡¥ DeviceUsageManual ç²¾ç¡®æ¡ç›®', 2);
    }
    /** æ— æºæ—å¯å¼±å…œåº•ï¼›MCU/IC/ä»ªå™¨/ä¼ æ„Ÿå™¨/å­˜å‚¨ç­‰è§†ä¸ºå…³é”® */
    static isCriticalLibId(libDevId) {
        const u = (libDevId ?? '').toUpperCase();
        if (u.length === 0) {
            return false;
        }
        if (u === 'VCC' || u === 'GND' || u === 'VEE' || u === 'VAC') {
            return false;
        }
        if (u.startsWith('R_') || u.startsWith('C_') || u.startsWith('L_') ||
            u.startsWith('POT_') || u.startsWith('LED_') || u.startsWith('XTAL_') ||
            u.startsWith('FUSE_')) {
            return false;
        }
        return true;
    }
    static formatEntry(e, mode) {
        if (mode === 'compact') {
            return `- ${e.libDevId}(${e.title}): ${e.summary}` +
                ` è„š:${e.pins} | ã€ç»å…¸æ¥æ³•ã€‘${e.typicalWiring} | ã€ç»å…¸ç¦æ¥ã€‘${e.forbidden}`;
        }
        const lines = [
            `### ${e.libDevId} â€” ${e.title}`,
            `ç”¨é€”: ${e.summary}`,
            `çœŸè„š: ${e.pins}`,
            `ã€ç»å…¸æ¥æ³•ã€‘: ${e.typicalWiring}`,
            `ã€ç»å…¸ç¦æ¥ã€‘: ${e.forbidden}`,
            `å‚æ•°: ${e.params}`,
            `ä»¿çœŸ: ${e.simNotes}`
        ];
        let text = lines.join('\n');
        if (text.length > MAX_CHARS_PER_DEVICE_FULL) {
            text = text.substring(0, MAX_CHARS_PER_DEVICE_FULL - 1) + 'â€¦';
        }
        return text;
    }
    /**
     * ä¸ºæœ¬æ¬¡é€‰å‹ libDevId åˆ—è¡¨æ„å»ºæ‰‹å†Œå—
     * @returns text + miss + uniqueCount
     */
    static buildForLibIds(libDevIds, mode, library) {
        const uniqIds = [];
        const seen = new Set();
        for (let i = 0; i < libDevIds.length; i++) {
            const id = libDevIds[i];
            if (!id || seen.has(id)) {
                continue;
            }
            seen.add(id);
            uniqIds.push(id);
        }
        const miss = [];
        const criticalMiss = [];
        const entries = [];
        for (let i = 0; i < uniqIds.length; i++) {
            entries.push(DeviceUsageManual.resolveWithLibraryFallback(uniqIds[i], library, miss, criticalMiss));
        }
        entries.sort((a, b) => b.priority - a.priority);
        const maxBlock = mode === 'compact' ? MAX_CHARS_COMPACT_BLOCK : MAX_CHARS_FULL_BLOCK;
        const parts = [];
        let chars = 0;
        let included = 0;
        const header = mode === 'compact'
            ? 'ã€æœ¬æ¬¡é€‰å‹å™¨ä»¶ä½¿ç”¨è¯´æ˜Â·æ‘˜è¦ â€” å†…å¿ƒéµå®ˆï¼Œå‹¿å†™å…¥å›å¤ã€‘'
            : 'ã€æœ¬æ¬¡é€‰å‹å™¨ä»¶ä½¿ç”¨è¯´æ˜Â·æ‰‹å†Œ â€” å»ºç½‘å¿…é¡»éµå®ˆï¼›å‹¿å¤è¿°å…¨æ–‡åˆ° JSONã€‘';
        parts.push(header);
        chars += header.length;
        for (let i = 0; i < entries.length; i++) {
