                if (net.pinIds.length <= 1) {
                    result.push(ErcEngine.makeViolation(ErcSeverity.INFO, ErcRuleType.FLOATING_NET, `ç”µæº/åœ°ç½‘ç»œ "${net.name}" ä»…ç¬¦å·å…¥ç½‘ï¼ˆå¾…æ¥è´Ÿè½½ï¼‰`, net.id, undefined, undefined, 'å°† GND/VCC/VEE ç¬¦å·ç”¨å¯¼çº¿è¿æ¥åˆ°å™¨ä»¶ç”µæºè„š'));
