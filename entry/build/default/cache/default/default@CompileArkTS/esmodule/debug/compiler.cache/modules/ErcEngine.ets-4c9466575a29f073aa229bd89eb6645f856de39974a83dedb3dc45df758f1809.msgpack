        if (libraryId === 'FREQ_COUNTER')
            return ['IN', 'GND'];
        if (libraryId === 'LOGIC_ANALYZER')
            return [];
        if (libraryId === 'POWER_METER')
            return ['V+', 'V-', 'I+', 'I-'];
        if (libraryId === 'LCD1602') {
