import { ErcSeverity, ErcRuleType, NetType, PinType } from '../types/CommonTypes';
import { IdUtil } from './IdUtil';
import { appendArray } from './MapHelpers';
import { DeviceHitGeometry, WIRE_OBSTACLE_PAD } from './DeviceHitGeometry';
export class ErcEngine {
    static run(doc, mcuLibraryIds, pinResolver) {
        const violations = [];
