        if (libraryId === '1N4148' || libraryId === '1N4007' || libraryId === '1N5819') {
            return ['A', 'K'];
        }
        // ä¼ æ„Ÿå™¨ç®€è„š
        if (libraryId.includes('LDR') || libraryId.includes('NTC') || libraryId.includes('PTC')) {
            return ['1', '2'];
        }
        if (libraryId.includes('DHT11') || libraryId.includes('DS18B20')) {
            return ['VCC', 'DATA', 'GND'];
        }
