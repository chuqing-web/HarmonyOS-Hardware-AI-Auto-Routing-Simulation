        result.push(ErcEngine.makeViolation(
          ErcSeverity.WARNING, ErcRuleType.MISSING_RESET,
          `MCU ${mcu.refDes} å¯èƒ½ç¼ºå°‘å»è€¦/å¤ä½ç”µå®¹`,
          undefined, mcu.id, undefined,
          'æ·»åŠ  100nF å»è€¦ç”µå®¹å’Œ 10kÎ© ä¸Šæ‹‰ç”µé˜»'
        ));
