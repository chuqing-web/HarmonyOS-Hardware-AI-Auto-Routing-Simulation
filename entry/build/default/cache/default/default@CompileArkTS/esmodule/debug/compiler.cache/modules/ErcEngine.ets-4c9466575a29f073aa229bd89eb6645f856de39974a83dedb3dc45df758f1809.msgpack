            return 2;
        }
        if (libraryId.includes('74HC')) {
            return 14;
        }
        if (libraryId.includes('STM32F407')) {
            return 100;
        }
        if (libraryId.includes('STM32')) {
            return 48;
        }
        if (libraryId.includes('AT89') || libraryId.includes('STC')) {
