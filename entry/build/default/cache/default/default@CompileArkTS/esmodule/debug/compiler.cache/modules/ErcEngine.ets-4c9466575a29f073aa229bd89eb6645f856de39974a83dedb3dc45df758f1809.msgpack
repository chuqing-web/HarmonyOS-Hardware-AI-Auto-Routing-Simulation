    /** ç”µæº/åœ°ç½‘ç»œï¼ˆä¸åº”æŒ‰æ™®é€šä¿¡å·ç½‘ç»œåšæ‚¬ç©ºåˆ¤å®šï¼‰ */
    static isPowerOrGroundNet(net) {
        if (net.type === NetType.POWER || net.type === NetType.GROUND) {
            return true;
        }
        const upper = (net.name ?? '').toUpperCase();
        return upper === 'GND' || upper === 'VSS' || upper === 'VEE' ||
            upper === 'VCC' || upper === 'VDD' || upper === '0' ||
            upper === '-12V' || upper === '-5V';
    }
    /** ç”»å¸ƒæ˜¯å¦å·²æ”¾ç½®ä¸è¯¥è½¨å¯¹åº”çš„ç”µæº/åœ°ç¬¦å·ï¼ˆVCC/GND/VEEï¼‰ */
    static docHasMatchingPowerSymbol(doc, net) {
