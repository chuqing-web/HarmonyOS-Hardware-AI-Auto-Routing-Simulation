    /**
     * KiCad-like å¼•è„šç”µæ°”ç±»å‹å†²çªçŸ©é˜µï¼ˆåŒç½‘ï¼‰ï¼š
     * Out+Out â†’ ERRORï¼›Out/BiDi+Power â†’ ERRORï¼›BiDi+Out/BiDi â†’ WARNINGï¼›
     * Passive/Input/OC å¯å…±ç½‘ï¼›Power+Ground åŒç½‘ â†’ ERRORã€‚
     */
    static checkPinTypeConflicts(doc, pinResolver) {
        const result = [];
        if (pinResolver == null) {
            return result;
        }
        for (let ni = 0; ni < doc.nets.length; ni++) {
            const net = doc.nets[ni];
            if (net.pinIds.length < 2) {
                continue;
            }
            let outN = 0;
            let bidN = 0;
            let pwrN = 0;
            let gndN = 0;
            let ocN = 0;
            let passiveN = 0;
            const drivers = [];
            for (let pi = 0; pi < net.pinIds.length; pi++) {
                const parts = net.pinIds[pi].split(':');
                if (parts.length < 2) {
