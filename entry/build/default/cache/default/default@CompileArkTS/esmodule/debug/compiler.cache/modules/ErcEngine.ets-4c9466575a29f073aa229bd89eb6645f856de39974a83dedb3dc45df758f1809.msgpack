                    result.push(ErcEngine.makeViolation(ErcSeverity.INFO, ErcRuleType.UNCONNECTED_PIN, `å™¨ä»¶ ${comp.refDes} å¼•è„š ${pinDefId} æœªè¿æ¥`, undefined, comp.id, pinDefId, 'è¿æ¥å¼•è„šæˆ–æ·»åŠ  No ERC æ ‡è®°'));
                }
