            }
            else if (outN >= 1 && bidN >= 1) {
                result.push(ErcEngine.makeViolation(ErcSeverity.WARNING, ErcRuleType.PIN_CONFLICT, `ç½‘ç»œ "${net.name}" OUTPUT ä¸ BIDI å…±ç½‘ï¼ˆ${drivers.slice(0, 4).join(', ')}ï¼‰`, net.id, undefined, undefined, 'ç¡®è®¤æ€»çº¿äº‰ç”¨å¯æ¥å—ï¼Œå¦åˆ™éš”ç¦»é©±åŠ¨'));
            }
            else if (bidN >= 2) {
                result.push(ErcEngine.makeViolation(ErcSeverity.INFO, ErcRuleType.PIN_CONFLICT, `ç½‘ç»œ "${net.name}" å¤šä¸ª BIDI å…±ç½‘ï¼ˆå¯èƒ½æ€»çº¿äº‰ç”¨ï¼‰`, net.id, undefined, undefined, 'ç¡®è®¤åˆ†æ—¶é©±åŠ¨æˆ–åŠ æ–¹å‘æ§åˆ¶'));
            }
            // Out/BiDi ç›´è¿ç”µæºï¼šæ— é˜»å®¹ç­‰åŒç½‘ PASSIVE æ—¶ ERRORï¼›æœ‰ PASSIVE é™ä¸º WARNINGï¼ˆå°‘è¯¯æ€ï¼‰
            if ((outN > 0 || bidN > 0) && pwrN > 0) {
                result.push(ErcEngine.makeViolation(passiveN > 0 ? ErcSeverity.WARNING : ErcSeverity.ERROR, ErcRuleType.PIN_CONFLICT, `ç½‘ç»œ "${net.name}" ä¿¡å·é©±åŠ¨è„šä¸ç”µæºè„šåŒç½‘`, net.id, undefined, undefined, 'ä¿¡å·ç½‘å‹¿ç›´æ¥æŒ‚åˆ° VCC/ç”µæºè„š'));
            }
            // OC å¹¶è”å…è®¸ï¼›OC+å¼º OUTPUT è­¦å‘Š
            if (ocN > 0 && outN > 0) {
                result.push(ErcEngine.makeViolation(ErcSeverity.WARNING, ErcRuleType.PIN_CONFLICT, `ç½‘ç»œ "${net.name}" å¼€æ¼ä¸æ¨æŒ½è¾“å‡ºå…±ç½‘`, net.id, undefined, undefined, 'å¼€æ¼ç½‘åº”ä»…æ¥ OC/è¾“å…¥/ä¸Šæ‹‰ï¼Œå‹¿æ¥æ¨æŒ½ OUTPUT'));
            }
        }
        return result;
    }
    /** H4ï¼šä¿¡å·æ ‡å·é”šç‚¹è½å…¥å™¨ä»¶é€‰ä¸­åŒºï¼ˆå‹ä½ç¬¦å·ï¼‰ */
    static checkLabelOverDevice(doc, pinResolver) {
        const result = [];
        const labels = doc.netLabels;
        if (labels === undefined || labels.length === 0 || pinResolver == null) {
            return result;
        }
        for (let li = 0; li < labels.length; li++) {
            const lb = labels[li];
            const upper = (lb.text ?? '').toUpperCase();
            // ç”µæº/åœ°æ ‡å·å¸¸è´´åœ¨ç”µæºç¬¦ä¸Šï¼Œä¸ç®— H4
            if (upper === 'VCC' || upper === 'VDD' || upper === 'V+' || upper === 'VEE' ||
                upper === 'GND' || upper === 'VSS' || upper === '0') {
                continue;
            }
            for (let ci = 0; ci < doc.components.length; ci++) {
                const comp = doc.components[ci];
                const resolvedPins = pinResolver(comp.libraryId);
                const pins = resolvedPins !== null ? resolvedPins : [];
                const di = {
                    instUuid: comp.id,
                    libDevId: comp.libraryId,
                    refName: comp.refDes,
                    x: comp.position.x,
                    y: comp.position.y,
                    rotate: comp.rotation,
                    mirrorH: comp.mirrored,
                    mirrorV: false,
