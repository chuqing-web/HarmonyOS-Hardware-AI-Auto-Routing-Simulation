    /** è½¨ç½‘å â†’ å¯¹åº”ç”µæºç¬¦å· libraryIdï¼›éæ ‡å‡†åè¿”å›ç©º */
    static powerSymbolLibForNet(net) {
        const upper = (net.name ?? '').toUpperCase();
        if (upper === 'VCC' || upper === 'VDD') {
            return 'VCC';
        }
        if (upper === 'GND' || upper === 'VSS' || upper === '0') {
            return 'GND';
        }
        if (upper === 'VEE' || upper === '-12V' || upper === '-5V') {
            return 'VEE';
