            `ç”µæº/åœ°ç½‘ç»œ "${net.name}" æœªè¿æ¥åˆ°å…¶ä»–å™¨ä»¶ï¼ˆä»… ${net.pinIds.length} å¤„è¿æ¥ï¼‰`,
            net.id, undefined, undefined,
            'å°† GND/VCC ç¬¦å·ç”¨å¯¼çº¿è¿æ¥åˆ° MCUã€ç”µé˜»ç­‰å™¨ä»¶å¼•è„š'
          ));
        }
        continue;
      }
      if (net.pinIds.length === 0) {
        continue;
      }
      if (net.pinIds.length <= 1 && net.type === NetType.SIGNAL) {
        result.push(ErcEngine.makeViolation(
          ErcSeverity.WARNING, ErcRuleType.FLOATING_NET,
          `ç½‘ç»œ "${net.name}" ä»…æœ‰ä¸€å¤„è¿æ¥ï¼ˆæ‚¬ç©ºï¼‰`,
          net.id, undefined, undefined,
          'æ·»åŠ ç½‘ç»œæ ‡å·æˆ–è¿æ¥åˆ°å™¨ä»¶å¼•è„š'
        ));
