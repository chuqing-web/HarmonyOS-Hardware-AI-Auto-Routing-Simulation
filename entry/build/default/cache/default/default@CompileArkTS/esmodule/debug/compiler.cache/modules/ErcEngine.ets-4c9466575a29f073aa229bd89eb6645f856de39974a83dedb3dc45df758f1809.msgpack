          `ç½‘ç»œ "${net.name}" OUTPUT ä¸ BIDI å…±ç½‘ï¼ˆ${drivers.slice(0, 4).join(', ')}ï¼‰`,
          net.id, undefined, undefined,
          'ç¡®è®¤æ€»çº¿äº‰ç”¨å¯æ¥å—ï¼Œå¦åˆ™éš”ç¦»é©±åŠ¨'
        ));
      } else if (bidN >= 2) {
        result.push(ErcEngine.makeViolation(
          ErcSeverity.INFO, ErcRuleType.PIN_CONFLICT,
          `ç½‘ç»œ "${net.name}" å¤šä¸ª BIDI å…±ç½‘ï¼ˆå¯èƒ½æ€»çº¿äº‰ç”¨ï¼‰`,
          net.id, undefined, undefined,
          'ç¡®è®¤åˆ†æ—¶é©±åŠ¨æˆ–åŠ æ–¹å‘æ§åˆ¶'
        ));
