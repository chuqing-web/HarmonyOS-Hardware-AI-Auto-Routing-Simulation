 */
import { WireAutoRouter, DeviceHitGeometry, WIRE_OBSTACLE_PAD, IdUtil, makeRouteLine, Logger, INSTR_TRACE_TAG, traceAiWireDraw, traceAiWireFix, traceAiWireInventory, WarRouteOrder, MainThreadYield } from 'common';
import { PinWorldResolver } from './PinWorldResolver';
export class WarRouteAdapter {
    constructor() {
        this.library = null;
    }
    setComponentLibrary(lib) {
        this.library = lib;
    }
    /** ä¿ç•™ stub/çŸ­çº¿ï¼ˆpoints ç©ºæˆ– â‰¤3ï¼‰ï¼Œæ¸…é•¿çº¿ä¾› WAR é‡å¸ƒ */
    static stripNonStubWires(wires) {
        const out = [];
        const dropped = [];
        for (let i = 0; i < wires.length; i++) {
            const w = wires[i];
            if (!w.points || w.points.length < 2 || w.points.length <= 3) {
                out.push(w);
            }
            else {
                dropped.push(`wireId=${w.uuid ?? '?'} pts=${w.points.length} net=${w.netUuid.substring(0, 12)}`);
            }
        }
        if (dropped.length > 0) {
            Logger.info(INSTR_TRACE_TAG, `[AI_WIRE] STRIP_NON_STUB kept=${out.length} dropped=${dropped.length}`);
            for (let i = 0; i < Math.min(dropped.length, 24); i++) {
                traceAiWireFix('DROP', `strip_non_stub ${dropped[i]} why=war_prep`);
            }
        }
        return out;
    }
    /**
     * å¯¹ nodeListâ‰¥2 ä¸”å°šæ— å®Œæ•´å¯¼çº¿çš„ç½‘ï¼Œç”¨ WAR é“¾å¼è¿çº¿ã€‚
     * å±€éƒ¨çŸ­ç½‘ä¼˜å…ˆï¼›é“¾åºå¤±è´¥æ—¶æ¢è¿‘é‚»/åè½¬å†è¯•ã€‚
     * å‡ ä½•ä»å¤±è´¥ â†’ è¯¥ç½‘é™çº§ä¸º joinByLabel stubï¼ˆç”¨æˆ·å…è®¸ï¼‰ï¼Œä¸æ•´å• abortã€‚
     * ã€ç¡¬ã€‘async + æ®µé—´è®©å‡ºï¼šæ¨¡æ‹Ÿå™¨ä¸ŠåŒæ­¥ Aæ˜Ÿå¯»è·¯ä¸é€ƒé€¸é‡è¯•å¯è§¦å‘ THREAD_BLOCKã€‚
     */
    async routeTopology(topo, warEnabled = true, isCancel) {
        if (!this.library) {
            Logger.error(INSTR_TRACE_TAG, '[AI_AGENT] WAR library not set');
            return {
                ok: false, routedNets: 0, failedNets: [], demotedNets: [],
                reason: 'WAR library not injected'
            };
        }
        const failed = [];
        const demoted = [];
        let routed = 0;
        let drawnSegs = 0;
        const grid = topo.gridStep > 0 ? topo.gridStep : 10;
        const wiresBefore = topo.wireList.length;
        Logger.info(INSTR_TRACE_TAG, `[AI_WIRE] WAR_BEGIN nets=${topo.netList.length} wires=${wiresBefore}`);
        // é¢„è®¡ç®—å¯å¸ƒç½‘åŠå…¶å±€éƒ¨è·¨åº¦ï¼ŒçŸ­ç½‘ä¼˜å…ˆï¼ˆé¿å… TRIANGLE é•¿çº¿å µæ­» HYSï¼‰
        const workIdx = [];
        const maxEdge = [];
        for (let ni = 0; ni < topo.netList.length; ni++) {
            const net = topo.netList[ni];
            if (!net.nodeList || net.nodeList.length < 2) {
                continue;
            }
            const pinsAll = this.resolveNetPinWorlds(topo, net);
            if (pinsAll.length < 2) {
