                Logger.warn(INSTR_TRACE_TAG, `[AI_AGENT] WAR skip net=${net.netName} pins=${pinsAll.length} (missing pin/dev)`);
                continue;
            }
            if (this.netDutPinsAlreadyLinked(topo, net, pinsAll)) {
