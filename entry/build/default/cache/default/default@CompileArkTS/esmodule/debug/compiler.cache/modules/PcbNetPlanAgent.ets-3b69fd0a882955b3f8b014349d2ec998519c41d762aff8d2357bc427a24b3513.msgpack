                reason: `net_plan coverage low: missing ${missingMust}/${mustRoute.length} routable nets`
            };
        }
        if (missingMust > 0) {
            Logger.warn(INSTR_TRACE_TAG, `[AI_PCB] net_plan soft-miss ${missingMust}/${mustRoute.length} routable nets`);
