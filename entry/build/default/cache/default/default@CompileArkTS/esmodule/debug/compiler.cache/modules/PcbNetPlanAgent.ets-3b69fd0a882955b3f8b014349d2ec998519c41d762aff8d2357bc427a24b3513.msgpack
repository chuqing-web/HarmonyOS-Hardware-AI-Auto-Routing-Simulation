            if (pads < 2) {
                continue;
            }
            mustRoute.push(n.id);
            if (!covered.has(n.id)) {
                const uname = n.name.toUpperCase();
                if (uname === 'GND' || uname === 'VSS' || uname.indexOf('GND') >= 0 ||
                    uname === 'VCC' || uname === 'VDD' || uname === 'VOUT' || uname.indexOf('VCC') >= 0) {
                    missingPowerGnd.push(n.name);
                }
            }
        }
        if (missingPowerGnd.length > 0) {
