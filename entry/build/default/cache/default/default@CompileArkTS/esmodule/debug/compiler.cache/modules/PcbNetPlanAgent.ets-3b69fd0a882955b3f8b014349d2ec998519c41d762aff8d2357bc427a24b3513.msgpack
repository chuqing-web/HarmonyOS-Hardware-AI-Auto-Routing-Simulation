        let missingMust = 0;
        for (let i = 0; i < mustRoute.length; i++) {
            if (!covered.has(mustRoute[i])) {
                missingMust++;
            }
        }
        if (mustRoute.length > 0 && missingMust > 0 && missingMust / mustRoute.length > 0.25) {
            return {
