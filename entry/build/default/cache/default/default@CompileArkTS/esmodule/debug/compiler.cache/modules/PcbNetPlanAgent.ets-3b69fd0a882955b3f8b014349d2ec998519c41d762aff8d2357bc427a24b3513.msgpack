                    e.layerHint = e.kind === 'gnd' ? 'stub' :
                        (e.kind === 'power' ? 'signal_h' : 'signal_h');
                }
                if ((e.kind === 'gnd' || e.kind === 'power') && e.busYOffset === undefined) {
