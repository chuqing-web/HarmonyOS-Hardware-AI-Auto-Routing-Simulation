  LTSPICE = 'ltspice',
  KICAD = 'kicad',
  NETLIST = 'netlist',
  BOM = 'bom',
  PDF = 'pdf',
  PNG = 'png',
  SVG = 'svg',
  CSV = 'csv'
}

export interface ProjectFile {
