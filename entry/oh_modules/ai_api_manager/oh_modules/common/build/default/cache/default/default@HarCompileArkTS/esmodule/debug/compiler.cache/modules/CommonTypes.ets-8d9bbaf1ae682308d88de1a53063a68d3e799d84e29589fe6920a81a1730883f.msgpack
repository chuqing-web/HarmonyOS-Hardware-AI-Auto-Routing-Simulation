  /** PCB Â∏ÉÂ±ÄÊñáÊ°£ÔºàÂèØÈÄâÔºåKiCad ÂºèÂèåÊñáÊ°£Â∑•Á®ãÔºâ */
  pcb?: PcbDocument;
