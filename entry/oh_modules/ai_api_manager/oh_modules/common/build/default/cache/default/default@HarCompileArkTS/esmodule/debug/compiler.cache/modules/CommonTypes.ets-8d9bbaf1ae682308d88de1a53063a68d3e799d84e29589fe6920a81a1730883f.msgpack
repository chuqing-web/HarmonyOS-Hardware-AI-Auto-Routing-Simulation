  CIRCUIT_GENERATION = 'circuit_generation',
  WAVEFORM_ANALYSIS = 'waveform_analysis',
  /** PCB Â∏ÉÂ±Ä AI Â∏ÉÁ∫ø / Â∏ÉÂ±ÄÁÆ°Á∫ø */
