  TRANSIENT = 'transient',
  NOISE = 'noise',
  PARAMETER_SWEEP = 'parameter_sweep',
  MONTE_CARLO = 'monte_carlo',
  MIXED = 'mixed'
}

export enum SimulationState {
  IDLE = 'idle',
  RUNNING = 'running',
  PAUSED = 'paused',
  STOPPED = 'stopped',
  ERROR = 'error'
}

export interface SimulationConfig {
  mode: SimulationMode;
