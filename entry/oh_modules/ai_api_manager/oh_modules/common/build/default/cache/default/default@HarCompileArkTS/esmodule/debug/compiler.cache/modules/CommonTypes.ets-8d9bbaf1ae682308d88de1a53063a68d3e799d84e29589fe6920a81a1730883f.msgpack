  netLabels: NetLabel[];
  subcircuits: SubcircuitRef[];
  metadata: SchematicMetadata;
  annotations?: SchematicAnnotation[];
  probes?: ProbeMeta[];
  simulationConfig?: SimulationConfig;
}

export interface ProbeMeta {
  id: string;
  netId: string;
  label: string;
  color: string;
}

export interface SubcircuitRef {
  id: string;
  name: string;
  documentId: string;
