        return [];
    }
    static buildPinArray(count, prefix) {
        const result = [];
        for (let i = 0; i < count; i++) {
            result.push(`${prefix}${i + 1}`);
        }
        return result;
    }
    static estimatePinCount(libraryId) {
        if (libraryId.startsWith('R_') || libraryId.startsWith('C_') || libraryId.startsWith('L_')) {
            return 2;
        }
