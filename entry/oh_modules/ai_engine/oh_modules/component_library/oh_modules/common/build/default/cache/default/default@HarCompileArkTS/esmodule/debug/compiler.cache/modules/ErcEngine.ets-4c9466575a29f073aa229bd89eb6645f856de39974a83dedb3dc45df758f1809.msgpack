    }
    static makeViolation(severity, ruleType, message, netId, componentId, pinId, fix) {
        return {
            id: IdUtil.generate('erc'),
            severity: severity,
            ruleType: ruleType,
            message: message,
            netId: netId,
            componentId: componentId,
            pinId: pinId,
            fixSuggestion: fix
        };
    }
