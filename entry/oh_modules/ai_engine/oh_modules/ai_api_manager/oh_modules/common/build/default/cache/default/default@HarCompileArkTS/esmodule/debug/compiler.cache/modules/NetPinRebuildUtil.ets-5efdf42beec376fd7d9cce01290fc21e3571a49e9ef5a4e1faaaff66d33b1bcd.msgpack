function pruneOrphanNets(doc) {
    const wireNetIds = new Set();
    for (let wi = 0; wi < doc.wires.length; wi++) {
        const nid = doc.wires[wi].netId;
        if (nid.length > 0) {
            wireNetIds.add(nid);
        }
    }
    const labelNetIds = new Set();
    for (let li = 0; li < doc.netLabels.length; li++) {
        const nid = doc.netLabels[li].netId;
        if (nid.length > 0) {
            labelNetIds.add(nid);
        }
