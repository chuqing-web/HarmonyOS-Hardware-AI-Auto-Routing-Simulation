      const k = ks[i];
      const cell = rec[k];
      if (cell === null || cell === undefined) {
        continue;
      }
      if (typeof cell === 'boolean' || typeof cell === 'number') {
        if (cell === true || (typeof cell === 'number' && cell !== 0)) {
