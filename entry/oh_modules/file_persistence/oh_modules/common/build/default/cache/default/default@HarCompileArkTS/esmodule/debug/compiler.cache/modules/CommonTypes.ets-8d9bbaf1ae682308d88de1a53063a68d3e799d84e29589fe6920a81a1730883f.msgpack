}

export interface ProbeMeta {
  id: string;
  netId: string;
  label: string;
  color: string;
}

export interface SubcircuitRef {
  id: string;
  name: string;
  documentId: string;
  position: Point2D;
  ports: Port[];
  embeddedDocument?: SchematicDocument;
}

export interface SchematicMetadata {
  author: string;
  createdAt: string;
  modifiedAt: string;
