  MONTE_CARLO = 'monte_carlo',
  MIXED = 'mixed'
}

export enum SimulationState {
  IDLE = 'idle',
  RUNNING = 'running',
  PAUSED = 'paused',
  STOPPED = 'stopped',
  ERROR = 'error'
}

