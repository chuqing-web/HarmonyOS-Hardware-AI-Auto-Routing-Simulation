  for (let i = 0; i < pinsA.length; i++) {
    const pa = pinsA[i];
    for (let j = 0; j < pinsB.length; j++) {
      const pb = pinsB[j];
      if (pa.compId === pb.compId && pa.pinId !== pb.pinId) {
        const aLab = pa.pinName.length > 0 ? pa.pinName : pa.pinId;
        const bLab = pb.pinName.length > 0 ? pb.pinName : pb.pinId;
        return `${refDesOfComp(doc, pa.compId)}.${aLab}â†”${bLab}`;
      }
    }
  }
  return '';
}

function safeUnion(
  uf: UnionFind, junctions: Map<string, Junction>, keyA: string, keyB: string
): boolean {
  if (wouldCreateSameCompShort(uf, junctions, keyA, keyB)) {
    return false;
  }
  uf.union(keyA, keyB);
  return true;
}

/** æ”¶é›†è½ç‚¹é™„è¿‘çš„å¼•è„šï¼ˆç”¨äº T æ¥æ—¶ jEp.pinRefs å°šæœªå¸¦ä¸Šé‚»è¿‘è„šçš„æƒ…å½¢ï¼‰ */
function pinsNearPoint(
  pinList: PinWorldRef[], x: number, y: number, tol: number
): JunctionPinRef[] {
  const out: JunctionPinRef[] = [];
  for (let i = 0; i < pinList.length; i++) {
    const p = pinList[i];
    if (Math.hypot(p.worldX - x, p.worldY - y) <= tol) {
      out.push(makeJunctionPinRef(p.compId, p.pinId, p.pinName, p.libraryId));
    }
  }
  return out;
}

/** UF æ ¹ä¸Šæ˜¯å¦å·²æœ‰ä¸ probe åŒå™¨ä»¶çš„å¼‚è„š */
function ufRootConflictsWithPins(
  uf: UnionFind, junctions: Map<string, Junction>, rootKey: string,
  probes: JunctionPinRef[]
): boolean {
  if (probes.length === 0) {
    return false;
  }
  const root = uf.find(rootKey);
  const onRoot: JunctionPinRef[] = [];
  junctions.forEach((j: Junction, k: string) => {
    if (uf.find(k) !== root) {
      return;
    }
    for (let i = 0; i < j.pinRefs.length; i++) {
      onRoot.push(j.pinRefs[i]);
    }
  });
  for (let i = 0; i < probes.length; i++) {
    const pa = probes[i];
    for (let j = 0; j < onRoot.length; j++) {
      const pb = onRoot[j];
      if (pa.compId === pb.compId && pa.pinId !== pb.pinId) {
        return true;
      }
    }
  }
  return false;
}

/** çº¿æ®µæ˜¯å¦å‹è¿‡å¼•è„šï¼ˆéå¯¼çº¿ä¸¤ç«¯ç›®æ ‡è„šï¼‰â†’ è„šæ’çŸ­è·¯é£é™© */
function pinOnSegmentInterior(
