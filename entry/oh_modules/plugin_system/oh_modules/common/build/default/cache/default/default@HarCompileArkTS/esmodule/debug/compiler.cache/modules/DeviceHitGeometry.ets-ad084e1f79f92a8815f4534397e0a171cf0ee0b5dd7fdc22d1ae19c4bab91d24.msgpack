    static labelHitsWires(pin, mid, label, flag, wirePaths, wireClr) {
        const stubSegs = mid !== null
            ? [[pin, mid], [mid, label]]
            : [[pin, label]];
        // æ——æ ‡ä¸å¾—å‹ä½è‡ªèº«å¼•å‡º stubï¼ˆä»…è±å…é”šç‚¹æ—æçŸ­è§†è§‰ stubï¼‰
        const ANCHOR_EXEMPT = 8;
