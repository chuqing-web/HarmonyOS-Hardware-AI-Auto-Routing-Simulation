import {
  SchematicDocument, ErcViolation, ErcSeverity, ErcRuleType,
  NetType, Pin, Net, PinType
} from '../types/CommonTypes';
import { IdUtil } from './IdUtil';
import { appendArray } from './MapHelpers';
