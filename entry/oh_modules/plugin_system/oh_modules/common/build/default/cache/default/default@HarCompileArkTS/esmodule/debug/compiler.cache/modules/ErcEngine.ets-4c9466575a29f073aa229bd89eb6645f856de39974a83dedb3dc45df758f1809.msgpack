                if (!isAuto) {
                    // æœ‰æ„ä¹‰ç½‘åä»… 1 è„šï¼šå¤šä¸ºæ ‡å·æœªå¹¶ç½‘ / æ··åˆ mode åˆ†è£‚ â†’ æŒ¡ AI é—¨ç¦
                    result.push(ErcEngine.makeViolation(ErcSeverity.WARNING, ErcRuleType.FLOATING_NET, `ä¿¡å·ç½‘ç»œ "${nm}" æœªå®Œå…¨è¿æ¥ï¼ˆä»… 1 è„šï¼Œæ ‡å·å¯èƒ½æœªå¹¶ç½‘ï¼‰`, net.id, undefined, undefined, 'æ£€æŸ¥åŒåç½‘ç»œæ ‡å·æ˜¯å¦è½åœ¨åŒä¸€å‡ ä½•ç½‘ï¼Œæˆ–æ”¹ä¸ºå¯¼çº¿ç›´è¿'));
                }
                else {
                    result.push(ErcEngine.makeViolation(ErcSeverity.INFO, ErcRuleType.FLOATING_NET, `ç½‘ç»œ "${net.name}" ä»…æœ‰ä¸€å¤„è¿æ¥ï¼ˆå¾…å¹¶ç½‘/æ ‡å·ï¼‰`, net.id, undefined, undefined, 'æ·»åŠ ç½‘ç»œæ ‡å·æˆ–è¿æ¥åˆ°å™¨ä»¶å¼•è„š'));
                }
