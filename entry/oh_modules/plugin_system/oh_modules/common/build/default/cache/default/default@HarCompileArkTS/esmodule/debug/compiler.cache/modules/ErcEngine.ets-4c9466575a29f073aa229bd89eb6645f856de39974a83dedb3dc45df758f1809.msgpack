        }
        if (!hasGnd) {
            result.push(ErcEngine.makeViolation(ErcSeverity.ERROR, ErcRuleType.POWER_REVERSED, 'åŸç†å›¾ç¼ºå°‘åœ°ç½‘ç»œ (GND/VSS)', undefined, undefined, undefined, 'æ·»åŠ åœ°ç¬¦å·å¹¶è¿æ¥åˆ°ç”µè·¯ GND'));
        }
        return result;
    }
    static checkSubcircuitPorts(doc) {
        const result = [];
        for (let i = 0; i < doc.subcircuits.length; i++) {
