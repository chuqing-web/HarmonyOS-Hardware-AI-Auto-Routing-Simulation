            }
            if (!hasCap) {
                result.push(ErcEngine.makeViolation(ErcSeverity.WARNING, ErcRuleType.MISSING_RESET, `MCU ${mcu.refDes} å¯èƒ½ç¼ºå°‘å»è€¦/å¤ä½ç”µå®¹`, undefined, mcu.id, undefined, 'æ·»åŠ  100nF å»è€¦ç”µå®¹å’Œ 10kÎ© ä¸Šæ‹‰ç”µé˜»'));
            }
            if (!hasResistor && !hasCap) {
                result.push(ErcEngine.makeViolation(ErcSeverity.WARNING, ErcRuleType.MISSING_RESET, `MCU ${mcu.refDes} å¤ä½ç”µè·¯å¯èƒ½ä¸å®Œæ•´`, undefined, mcu.id, undefined, 'æ·»åŠ  RST å¼•è„š 10kÎ© ä¸Šæ‹‰å’Œ 100nF ç”µå®¹'));
            }
        }
        return result;
    }
    static checkPowerPins(doc) {
        const result = [];
        let hasVcc = false;
        let hasGnd = false;
        let hasAltSource = false;
        let hasMcuOrDigital = false;
        for (let i = 0; i < doc.nets.length; i++) {
            const net = doc.nets[i];
            if (net.type === NetType.POWER || net.name === 'VCC' || net.name === 'VDD') {
                hasVcc = true;
            }
            if (net.type === NetType.GROUND || net.name === 'GND' || net.name === 'VSS') {
                hasGnd = true;
            }
        }
        for (let ci = 0; ci < doc.components.length; ci++) {
            const lib = doc.components[ci].libraryId;
            if (lib === 'VCC') {
                hasVcc = true;
            }
            if (lib === 'GND') {
                hasGnd = true;
            }
            if (lib === 'VAC' || lib === 'SIGNAL_GEN' || lib === 'VEE') {
                hasAltSource = true;
            }
            if (lib.includes('AT89') || lib.includes('STC') || lib.includes('STM32') ||
