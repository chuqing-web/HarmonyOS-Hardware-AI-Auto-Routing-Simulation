function isNetFullyConnected(doc: PcbDocument, netId: string, nodes: PadNode[]): boolean {
  if (nodes.length < 2) return true;
  for (let i = 1; i < nodes.length; i++) {
    if (!padsCopperConnected(doc, netId, nodes[0].pos, nodes[i].pos)) {
      return false;
    }
  }
  return true;
}

