let lastInstrLiveMs = 0;
let lastInstrLiveFingerprint = '';
/**
 * Interactive pot/switch: log ALL meter snaps + key node voltages.
 * Throttled (~10Hz) unless fingerprint changes (new wiper / MID / readings).
 * Filter: instr_trace â†’ [INSTR_LIVE]
 */
export function traceInteractiveInstrumentLive(reason, detail, namedVolts, meters, activeRefOrId, force = false) {
    const prefer = ['VCC', 'HI', 'NET_2', 'MID', 'ADC', '1WIRE', 'HALL', 'GND'];
    const netParts = [];
    for (let i = 0; i < prefer.length; i++) {
        const n = prefer[i];
        const v = namedVolts.get(n);
        if (v !== undefined) {
            netParts.push(`${n}=${v.toFixed(3)}V`);
        }
    }
    const meterParts = [];
    for (let i = 0; i < meters.length; i++) {
        const m = meters[i];
        meterParts.push(`${m.refDes}/${m.kind}=${m.value}`);
    }
    const fingerprint = `${reason}|${detail}|${netParts.join(',')}|${meterParts.join(';')}`;
    const now = Date.now();
    if (!force) {
        if (fingerprint === lastInstrLiveFingerprint && now - lastInstrLiveMs < 150) {
            return;
        }
        if (now - lastInstrLiveMs < 80) {
            return;
        }
    }
    lastInstrLiveMs = now;
    lastInstrLiveFingerprint = fingerprint;
    Logger.info(INSTR_TRACE_TAG, `[INSTR_LIVE] ${reason} ${detail} nets={${netParts.join(', ')}} ` +
        `meters=[${meterParts.join('; ')}] active=${activeRefOrId.length > 0 ? activeRefOrId : 'null'}`);
}
/** å°†æ¢è¡Œå‹æˆå¯è§æ ‡è®°ï¼Œä¾¿äº instr_trace å•è¡Œåˆ†ç‰‡å±•ç¤º */
function flattenAiTraceText(text) {
    let out = '';
    for (let i = 0; i < text.length; i++) {
        const ch = text.charAt(i);
        if (ch === '\n' || ch === '\r') {
            out += 'â';
        }
        else if (ch === '\t') {
            out += ' ';
        }
        else {
            out += ch;
        }
    }
    return out;
}
/**
 * AI æŒ‡ä»¤/å›å¤æ­£æ–‡å†™å…¥ instr_traceï¼ˆè‡ªåŠ¨æˆªæ–­åˆ†ç‰‡ï¼‰ã€‚
 * prefix ä¾‹ï¼šAI_API / AI_PIPE / AI_GENï¼›kind ä¾‹ï¼šPROMPT / REPLY / USER
 */
export function traceAiPayload(prefix, kind, text, meta = '') {
    const raw = text ?? '';
    const flat = flattenAiTraceText(raw);
    const maxTotal = 2400;
    const chunkSize = 360;
    const truncated = flat.length > maxTotal;
    const body = truncated ? flat.substring(0, maxTotal) : flat;
    const metaPart = meta.length > 0 ? ` ${meta}` : '';
    Logger.info(INSTR_TRACE_TAG, `[${prefix}] ${kind} len=${raw.length}` +
        `${truncated ? ` show=${body.length}` : ''}${metaPart}`);
    if (body.length === 0) {
        Logger.info(INSTR_TRACE_TAG, `[${prefix}] ${kind} | (empty)`);
        return;
    }
    let offset = 0;
    let part = 0;
    while (offset < body.length) {
        const end = Math.min(offset + chunkSize, body.length);
        Logger.info(INSTR_TRACE_TAG, `[${prefix}] ${kind}|${part} ${body.substring(offset, end)}`);
        offset = end;
        part++;
    }
    if (truncated) {
        Logger.info(INSTR_TRACE_TAG, `[${prefix}] ${kind} <<< truncated`);
    }
}
/** AI ç®¡çº¿/UI æ“ä½œæ­¥éª¤ï¼ˆé€‰å‹/æ‘†æ”¾/å»ºç½‘/è½å›¾ç­‰ï¼‰ */
export function traceAiOp(prefix, op, detail) {
    Logger.info(INSTR_TRACE_TAG, `[${prefix}] OP ${op} | ${detail}`);
}
/**
 * AI ç”Ÿå›¾é˜¶æ®µæ ‡å‡†åŒ–æ—¥å¿—ï¼ˆæ’é”™ä¸»çº¿ï¼‰ã€‚
 * è¿‡æ»¤ instr_trace åæŒ‰ STAGE_BEGIN â†’ METRIC â†’ STAGE_END / STAGE_ABORT å¤ç›˜ã€‚
 * phase: BEGIN | END | METRIC | ABORT | RETRY
 */
export function traceAiStage(prefix, stage, phase, detail = '') {
    const d = (detail ?? '').trim();
    Logger.info(INSTR_TRACE_TAG, `[${prefix}] STAGE_${phase} ${stage}` + (d.length > 0 ? ` | ${d}` : ''));
}
/**
 * AI è¯Šæ–­å¤šè¡Œæ˜ç»†ï¼ˆå¸ƒå±€ AABB/é—´è·ã€å»ºç½‘å¤±è´¥ã€ERC æ¡ç›®ç­‰ï¼‰ã€‚
 * stage ä¾‹ï¼šlayout_aabb / layout_gap / place_match / net_fail / erc_block
 */
export function traceAiDiag(prefix, stage, lines, maxLines = 48) {
    const n = lines.length;
    const show = Math.min(n, Math.max(1, maxLines));
    Logger.info(INSTR_TRACE_TAG, `[${prefix}] DIAG ${stage} | count=${n}` +
        `${n > show ? ` show=${show}` : ''}`);
    if (n === 0) {
        Logger.info(INSTR_TRACE_TAG, `[${prefix}] DIAG ${stage} | (none)`);
        return;
    }
    for (let i = 0; i < show; i++) {
        Logger.info(INSTR_TRACE_TAG, `[${prefix}] DIAG|${stage}|${i} ${lines[i]}`);
    }
    if (n > show) {
        Logger.info(INSTR_TRACE_TAG, `[${prefix}] DIAG ${stage} <<< truncated +${n - show}`);
    }
}
/**
 * AI ç”»çº¿æ˜ç»† â€” è¿‡æ»¤ instr_trace å‰ç¼€ [AI_WIRE] DRAW
 * via: war | net_plan_stub | fix_stub | a_star | other
 */
export function traceAiWireDraw(via, detail) {
    Logger.info(INSTR_TRACE_TAG, `[AI_WIRE] DRAW via=${via} | ${detail}`);
}
/**
 * AI æ‹†çº¿/æ”¹çº¿æ˜ç»† â€” è¿‡æ»¤ [AI_WIRE] DROP / MOVE
 * action: DROPï¼ˆåˆ å¯¼çº¿ï¼‰| MOVEï¼ˆè„šæ”¹æŒ‚ç½‘ï¼‰| KEEPï¼ˆå¹‚ç­‰è·³è¿‡ï¼‰
 */
export function traceAiWireFix(action, detail) {
    Logger.info(INSTR_TRACE_TAG, `[AI_WIRE] ${action} | ${detail}`);
}
/**
 * AI å¯¼çº¿æ¸…å•å¿«ç…§ â€” è¿‡æ»¤ [AI_WIRE] INV
 * stage ä¾‹ï¼šnet_plan_end / war_end / fix_batch_end / finalize
 */
export function traceAiWireInventory(stage, wires, netNameOf, maxLines = 40) {
    const n = wires.length;
    const show = Math.min(n, Math.max(1, maxLines));
    Logger.info(INSTR_TRACE_TAG, `[AI_WIRE] INV ${stage} | total=${n}` +
        `${n > show ? ` show=${show}` : ''}`);
    if (n === 0) {
        Logger.info(INSTR_TRACE_TAG, `[AI_WIRE] INV ${stage} | (no wires)`);
        return;
    }
    for (let i = 0; i < show; i++) {
        const w = wires[i];
        const pts = w.points ?? [];
        const a = pts.length > 0 ? pts[0] : undefined;
        const b = pts.length > 0 ? pts[pts.length - 1] : undefined;
        const ends = a && b
            ? `(${Math.round(a.x)},${Math.round(a.y)})â†’(${Math.round(b.x)},${Math.round(b.y)})`
            : '(no-pts)';
        Logger.info(INSTR_TRACE_TAG, `[AI_WIRE] INV|${stage}|${i} wireId=${w.uuid ?? '?'} net=${netNameOf(w.netUuid)}` +
            ` pts=${pts.length} ${ends}`);
    }
    if (n > show) {
        Logger.info(INSTR_TRACE_TAG, `[AI_WIRE] INV ${stage} <<< truncated +${n - show}`);
    }
}
/** è¿çº¿è½çº¿å¼€å§‹ â€” è¿‡æ»¤ instr_traceï¼Œå‰ç¼€ [WIRE_CONN] */
export function traceWireConnectBegin(wireId, netId, pts, fromX, fromY, toX, toY, inherited) {
