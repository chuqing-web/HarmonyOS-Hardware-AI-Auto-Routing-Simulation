/**
 * AI æ‹†çº¿/æ”¹çº¿æ˜ç»† â€” è¿‡æ»¤ [AI_WIRE] DROP / MOVE
 * action: DROPï¼ˆåˆ å¯¼çº¿ï¼‰| MOVEï¼ˆè„šæ”¹æŒ‚ç½‘ï¼‰| KEEPï¼ˆå¹‚ç­‰è·³è¿‡ï¼‰
 */
export function traceAiWireFix(action: string, detail: string): void {
