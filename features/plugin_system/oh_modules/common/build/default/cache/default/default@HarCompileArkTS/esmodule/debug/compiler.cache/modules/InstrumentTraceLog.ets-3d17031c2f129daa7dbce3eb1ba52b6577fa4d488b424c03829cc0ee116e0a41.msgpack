}

/**
 * AI ç”Ÿå›¾é˜¶æ®µæ ‡å‡†åŒ–æ—¥å¿—ï¼ˆæ’é”™ä¸»çº¿ï¼‰ã€‚
 * è¿‡æ»¤ instr_trace åæŒ‰ STAGE_BEGIN â†’ METRIC â†’ STAGE_END / STAGE_ABORT å¤ç›˜ã€‚
 * phase: BEGIN | END | METRIC | ABORT | RETRY
 */
export function traceAiStage(prefix: string, stage: string, phase: string,
  detail: string = ''): void {
  const d = (detail ?? '').trim();
  Logger.info(INSTR_TRACE_TAG,
    `[${prefix}] STAGE_${phase} ${stage}` + (d.length > 0 ? ` | ${d}` : ''));
}

/**
 * AI è¯Šæ–­å¤šè¡Œæ˜ç»†ï¼ˆå¸ƒå±€ AABB/é—´è·ã€å»ºç½‘å¤±è´¥ã€ERC æ¡ç›®ç­‰ï¼‰ã€‚
 * stage ä¾‹ï¼šlayout_aabb / layout_gap / place_match / net_fail / erc_block
 */
export function traceAiDiag(prefix: string, stage: string, lines: string[],
  maxLines: number = 48): void {
  const n = lines.length;
  const show = Math.min(n, Math.max(1, maxLines));
  Logger.info(INSTR_TRACE_TAG,
    `[${prefix}] DIAG ${stage} | count=${n}` +
    `${n > show ? ` show=${show}` : ''}`);
  if (n === 0) {
    Logger.info(INSTR_TRACE_TAG, `[${prefix}] DIAG ${stage} | (none)`);
    return;
  }
  for (let i = 0; i < show; i++) {
    Logger.info(INSTR_TRACE_TAG, `[${prefix}] DIAG|${stage}|${i} ${lines[i]}`);
  }
  if (n > show) {
    Logger.info(INSTR_TRACE_TAG,
      `[${prefix}] DIAG ${stage} <<< truncated +${n - show}`);
  }
}

