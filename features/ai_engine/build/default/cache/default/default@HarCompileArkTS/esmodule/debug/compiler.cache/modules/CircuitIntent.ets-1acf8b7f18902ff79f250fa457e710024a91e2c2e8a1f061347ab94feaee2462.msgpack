/** ä¸²è” RC å……æ”¾ç”µ / Ï„ è§‚æµ‹ï¼ˆç¦å¥—äº’æ–¥ç»§ç”µå™¨ï¼‰ */
function isSeriesRcChargePrompt(prompt) {
