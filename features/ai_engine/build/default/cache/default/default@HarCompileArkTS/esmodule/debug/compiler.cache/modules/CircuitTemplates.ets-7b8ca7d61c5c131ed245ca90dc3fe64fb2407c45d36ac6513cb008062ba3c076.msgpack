 * ç”µè·¯æ¨¡æ¿ç”Ÿæˆå™¨ v3.0 â€” AI å…³é”®è¯åˆ†æ´¾ + å®éªŒæ¨¡æ¿ ID åˆ†æ´¾ + ä»ªå™¨æ„ŸçŸ¥å¤åˆåŒ¹é…
 * v3.0: å¤åˆä»ªå™¨æ£€æµ‹(å¦‚"åˆ†å‹+ç”µå‹è¡¨")ã€ä»ªå™¨éœ€æ±‚æ ‡è®°ã€æ¨¡æ¿ç»„åˆç­–ç•¥
 */
import { SchematicDocument } from 'common';
import { LabTemplateRegistry } from './LabTemplateRegistry';

/** v3.0: æ¨¡æ¿åŒ¹é…ç»“æœ â€” æºå¸¦ä»ªå™¨éœ€æ±‚æ ‡è®° */
export interface TemplateMatchResult {
  templateId: string;
  /** ç”¨æˆ·éœ€æ±‚ä¸­éšå«çš„ä»ªå™¨ç±»å‹åˆ—è¡¨ */
  instrumentsNeeded: string[];
  /** æ˜¯å¦ä¸ºå¤åˆåœºæ™¯ï¼ˆå¦‚"åˆ†å‹+ç”µå‹è¡¨"ï¼‰ */
  isCompound: boolean;
}

export class CircuitTemplates {

  /** æŒ‰å®éªŒæ¨¡æ¿ ID ç”Ÿæˆï¼ˆæ•™å­¦é¢æ¿ä¸“ç”¨ï¼‰ */
  static generateById(templateId: string): SchematicDocument | null {
    return LabTemplateRegistry.generateById(templateId);
  }

  static generate(prompt: string, mcuFamily?: string): SchematicDocument | null {
    const match = CircuitTemplates.matchWithInstruments(prompt, mcuFamily);
    if (match !== null) {
      return CircuitTemplates.generateById(match.templateId);
    }
    // ç¦æ­¢é™é»˜ lab_power å…œåº•ï¼ˆç”Ÿäº§è·¯å¾„ä¸å¾—è°ƒç”¨æœ¬æ–¹æ³•ï¼‰
    return null;
  }

  /**
   * v3.0: å¸¦ä»ªå™¨æ„ŸçŸ¥çš„æ¨¡æ¿åŒ¹é… â€” æ£€æµ‹ç”µè·¯ç±»å‹ + éšå«çš„ä»ªå™¨éœ€æ±‚ã€‚
   * è¿”å›åŒ¹é…ç»“æœï¼ˆå«ä»ªå™¨åˆ—è¡¨ï¼‰ï¼Œä¾›ä¸Šå±‚åœ¨å¸ƒçº¿/å¸ƒå±€æ—¶è¿½åŠ ä»ªå™¨å¤„ç†ã€‚
   */
  static matchWithInstruments(prompt: string, mcuFamily?: string): TemplateMatchResult | null {
    const lower = prompt.toLowerCase();
    const instruments: string[] = [];

    // å…ˆæ£€æµ‹ä»ªå™¨éœ€æ±‚ï¼ˆç‹¬ç«‹äºç”µè·¯ç±»å‹ï¼‰
    if (lower.includes('ç”µæµè¡¨') || lower.includes('æµ‹ç”µæµ') || lower.includes('æ€»ç”µæµ')) {
      instruments.push('AMMETER_DC');
    }
    // æ£€æµ‹"Nä¸ªç”µå‹è¡¨"æˆ–"Nå—ç”µå‹è¡¨"
    const vmMatch = lower.match(/(\d+)\s*[ä¸ªå—åªå°]\s*ç”µå‹è¡¨/);
    if (vmMatch) {
      const count = parseInt(vmMatch[1]);
      for (let vi = 0; vi < count; vi++) {
        instruments.push('VOLTMETER_DC');
      }
    } else if (lower.includes('ç”µå‹è¡¨') || lower.includes('æµ‹ç”µå‹')) {
      // åˆ†å‹ç”µè·¯é»˜è®¤é…1å—ç”µå‹è¡¨ï¼ˆéœ€è½®æ¢æµ‹é‡ï¼‰ï¼ŒNä¸ªç”µé˜»åˆ™æ¨èNå—
      instruments.push('VOLTMETER_DC');
    }
    if (lower.includes('ç¤ºæ³¢å™¨') || lower.includes('æ³¢å½¢') || lower.includes('oscilloscope')) {
      instruments.push('OSCILLOSCOPE');
    }
    if (lower.includes('é€»è¾‘åˆ†æä»ª') || lower.includes('æ—¶åº')) {
      instruments.push('LOGIC_ANALYZER');
    }

    // å¤åˆåœºæ™¯åŒ¹é…: ç”µè·¯ç±»å‹ + ä»ªå™¨
    // "åˆ†å‹" æˆ– "ç”µé˜»åˆ†å‹" + ä»ªå™¨ â†’ lab_passive + instruments
    if ((lower.includes('åˆ†å‹') || (lower.includes('ç”µé˜»') && lower.includes('ä¸²è”'))) &&
      instruments.length > 0) {
      return { templateId: 'lab_passive', instrumentsNeeded: instruments, isCompound: true };
    }
    // "LED" + ç”µæµè¡¨ â†’ lab_51_led + ammeter
    if ((lower.includes('led') || lower.includes('ç¯') || lower.includes('æµæ°´')) &&
      instruments.some(i => i.includes('AMMETER'))) {
      const is51 = (mcuFamily !== undefined && mcuFamily.includes('8051')) ||
        lower.includes('8051') || lower.includes('at89') || lower.includes('stc89') ||
        lower.includes('stc') || /\b51\b/.test(lower);
      return {
        templateId: is51 ? 'lab_51_led' : 'lab_digital',
        instrumentsNeeded: instruments, isCompound: true
      };
    }
    // "è¿æ”¾/æ”¾å¤§" + ç¤ºæ³¢å™¨ â†’ lab_amp + scope
    if ((lower.includes('è¿æ”¾') || lower.includes('æ”¾å¤§') || lower.includes('åŒç›¸')) &&
      instruments.some(i => i.includes('OSCILLOSCOPE'))) {
      return { templateId: 'lab_amp', instrumentsNeeded: instruments, isCompound: true };
    }
    // "ç¨³å‹/ç”µæº" + ç”µå‹è¡¨ â†’ lab_power + voltmeter
    if ((lower.includes('7805') || lower.includes('ç¨³å‹') || lower.includes('ç”µæº')) &&
      instruments.some(i => i.includes('VOLTMETER'))) {
      return { templateId: 'lab_power', instrumentsNeeded: instruments, isCompound: true };
    }
    // "ä¼ æ„Ÿå™¨" + ä»ªå™¨ â†’ lab_sensor + instruments
    if (lower.includes('ä¼ æ„Ÿå™¨') && instruments.length > 0) {
      return { templateId: 'lab_sensor', instrumentsNeeded: instruments, isCompound: true };
    }

    // çº¯ä»ªå™¨åœºæ™¯ï¼ˆåªæœ‰ä»ªå™¨æ²¡æœ‰å…·ä½“ç”µè·¯ï¼‰
    if (instruments.length >= 2 && !lower.includes('ç”µé˜»') && !lower.includes('è¿æ”¾') &&
      !lower.includes('å•ç‰‡æœº') && !lower.includes('led')) {
      return { templateId: 'lab_passive', instrumentsNeeded: instruments, isCompound: true };
    }

    // çº¯ä»ªå™¨åœºæ™¯ fallback
    if (lower.includes('ä»ªå™¨') || lower.includes('ç¤ºæ³¢å™¨') || lower.includes('ä¸‡ç”¨è¡¨') ||
      lower.includes('ç”µæµè¡¨') || lower.includes('ç”µå‹è¡¨')) {
      return { templateId: 'lab_instruments', instrumentsNeeded: instruments, isCompound: false };
    }

    // å¼ºå…³é”®è¯åŒ¹é…ç”µè·¯ç±»å‹ï¼ˆæ— ä»ªå™¨éœ€æ±‚ï¼‰
    const baseId = CircuitTemplates.matchStrongTemplateId(prompt, mcuFamily);
    if (baseId !== null) {
      return { templateId: baseId, instrumentsNeeded: instruments, isCompound: instruments.length > 0 };
    }
    return null;
  }

  /**
   * å¼ºå…³é”®è¯åŒ¹é…å®éªŒæ¨¡æ¿ IDï¼›æ— å‘½ä¸­è¿”å› nullï¼ˆä¸å›è½ lab_powerï¼‰ã€‚
   * AI å…¨é—­ç¯ä»…åœ¨å¼ºå‘½ä¸­æ—¶èµ°æ¨¡æ¿æ·å¾„ã€‚
   */
  static matchStrongTemplateId(prompt: string, mcuFamily?: string): string | null {
    const lower = prompt.toLowerCase();

    if (lower.includes('7805') || lower.includes('ç¨³å‹')) {
      return 'lab_power';
    }
    if (lower.includes('è¿æ”¾') || lower.includes('æ”¾å¤§') || lower.includes('åŒç›¸') || lower.includes('åç›¸')) {
      return 'lab_amp';
    }
    if (lower.includes('rc') || lower.includes('æ»¤æ³¢')) {
      return 'lab_filter';
    }
    if ((lower.includes('8051') || lower.includes('at89') || lower.includes('stc89') ||
      lower.includes('stc') || /\b51\b/.test(lower)) &&
      (lower.includes('æµæ°´') || lower.includes('led') || lower.includes('ç¯'))) {
      return 'lab_51_led';
    }
    if (lower.includes('uart') || lower.includes('ä¸²å£')) {
      return 'lab_uart';
    }
    if (lower.includes('ç”µä½å™¨') || lower.includes('æ»‘åŠ¨å˜é˜»') || lower.includes('potentiometer') ||
      lower.includes('pot_')) {
      return 'lab_potentiometer';
    }
    if (lower.includes('æ— æº') && (lower.includes('ç”µé˜»') || lower.includes('ç”µå®¹') || lower.includes('å®éªŒ'))) {
      return 'lab_passive';
    }
    if (lower.includes('555') || lower.includes('å¤šè°') || lower.includes('æ— ç¨³æ€') ||
      lower.includes('astable')) {
      return 'lab_analog_ic';
    }
    if (lower.includes('åˆ†ç«‹') || lower.includes('ä¸‰æç®¡') || lower.includes('mosfet')) {
      return 'lab_discrete';
    }
    if (lower.includes('74hc') || (lower.includes('é€»è¾‘') && lower.includes('é—¨'))) {
      return 'lab_digital';
    }
    if (lower.includes('å­˜å‚¨') || lower.includes('eeprom') || lower.includes('flash')) {
      return 'lab_memory';
    }
    if (lower.includes('ä¼ æ„Ÿå™¨') || lower.includes('ds18') || lower.includes('éœå°”')) {
      return 'lab_sensor';
    }
    if (lower.includes('ä»ªå™¨') || lower.includes('ç¤ºæ³¢å™¨') || lower.includes('ä¸‡ç”¨è¡¨') ||
      lower.includes('ç”µæµè¡¨') || lower.includes('ç”µå‹è¡¨')) {
      return 'lab_instruments';
    }

    const isStm32 = (mcuFamily !== undefined && mcuFamily.includes('STM32')) || lower.includes('stm32');
    const is51 = (mcuFamily !== undefined && mcuFamily.includes('8051')) ||
      lower.includes('8051') || (lower.includes('stc') && lower.includes('å•ç‰‡æœº'));
    if (is51 && (lower.includes('led') || lower.includes('ç¯') || lower.includes('æœ€å°ç³»ç»Ÿ'))) {
      return 'lab_51_led';
    }
    if (isStm32 && (lower.includes('æœ€å°ç³»ç»Ÿ') || lower.includes('uart') || lower.includes('ä¸²å£'))) {
      return 'lab_uart';
    }
    return null;
  }

  private static fallbackDoc(prompt: string): SchematicDocument {
    const doc = LabTemplateRegistry.generateById('lab_power');
    if (doc !== null) {
      doc.metadata.description = prompt;
      return doc;
    }
    throw new Error('No template available');
  }
}
