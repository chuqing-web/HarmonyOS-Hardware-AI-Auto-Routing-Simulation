                reqs.push(makeDeviceRequirement('ç”µé˜»', 'resistor', 5, stringMap1('value', '1k')));
                reqs.push(makeDeviceRequirement('ç”µå®¹', 'cap', 5, stringMap1('value', '10uF')));
