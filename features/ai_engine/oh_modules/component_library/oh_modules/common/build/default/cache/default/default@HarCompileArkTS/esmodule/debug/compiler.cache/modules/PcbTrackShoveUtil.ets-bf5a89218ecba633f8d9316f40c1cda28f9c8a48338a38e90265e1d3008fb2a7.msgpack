export function doglegPadToPadSelectedTracks(doc, trackIds, padLockedEnds, dx, dy) {
    const doglegged = new Set();
    if (Math.abs(dx) < 0.01 && Math.abs(dy) < 0.01) {
        return doglegged;
    }
    let created = 0;
    const toDogleg = [];
    for (const trk of doc.tracks) {
        if (!trackIds.has(trk.id)) {
            continue;
        }
        const sLock = padLockedEnds.has(`${trk.id}|S`);
        const eLock = padLockedEnds.has(`${trk.id}|E`);
        if (sLock && eLock) {
            toDogleg.push(trk);
        }
    }
    for (const trk of toDogleg) {
        const a = { x: trk.start.x, y: trk.start.y };
        const b = { x: trk.end.x, y: trk.end.y };
        const a2 = { x: a.x + dx, y: a.y + dy };
        const b2 = { x: b.x + dx, y: b.y + dy };
        trk.start.x = a2.x;
        trk.start.y = a2.y;
        trk.end.x = b2.x;
        trk.end.y = b2.y;
        doglegged.add(trk.id);
        if (addTrack(doc, trk.layer, a, a2, trk.netId, trk.netName, trk.width)) {
            created++;
        }
        if (addTrack(doc, trk.layer, b2, b, trk.netId, trk.netName, trk.width)) {
            created++;
        }
    }
    if (created > 0) {
        tracePcb('TRACK_SHOVE_DOGLEG', `padToPad=${toDogleg.length} stubs=${created}`);
    }
    return doglegged;
}
function lCandidates(a, b) {
    const out = [];
    if (pointDist(a, b) < 0.5) {
        return out;
    }
    const midH = { x: b.x, y: a.y };
    out.push([a, midH, b]);
    const midV = { x: a.x, y: b.y };
    if (pointDist(midH, midV) > 0.5) {
        out.push([a, midV, b]);
    }
    const def = routeLPoints(a, b);
    if (def.length >= 2) {
        out.push(def);
    }
    return out;
}
function pathOk(doc, layer, pts, netId, width, existing) {
    for (let i = 0; i < pts.length - 1; i++) {
        if (!pathClearOfTracks(doc, layer, pts[i], pts[i + 1], netId, width, existing)) {
            return false;
        }
    }
    return true;
}
function replaceTrackWithPolyline(doc, old, pts) {
    const idx = doc.tracks.findIndex((t) => t.id === old.id);
    if (idx < 0) {
        return 0;
    }
    doc.tracks.splice(idx, 1);
    let n = 0;
    for (let i = 0; i < pts.length - 1; i++) {
        if (addTrack(doc, old.layer, pts[i], pts[i + 1], old.netId, old.netName, old.width)) {
            n++;
        }
    }
    return n;
}
