                break;
            }
            for (let di = 0; di < 4; di++) {
                const ngx = cur.gx + dirs[di][0];
                const ngy = cur.gy + dirs[di][1];
                if (ngx < minGx || ngx > maxGx || ngy < minGy || ngy > maxGy) {
                    continue;
                }
                const nkey = `${ngx},${ngy}`;
                if (closed.has(nkey)) {
