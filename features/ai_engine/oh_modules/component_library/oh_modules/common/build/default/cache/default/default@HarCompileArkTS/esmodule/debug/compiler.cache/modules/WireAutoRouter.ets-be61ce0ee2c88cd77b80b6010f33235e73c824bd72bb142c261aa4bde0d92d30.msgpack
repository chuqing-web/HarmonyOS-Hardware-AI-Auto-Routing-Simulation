    static applyLeadAtEnd(pts, atStart, ctx, extra) {
        if (pts.length < 2) {
            return pts;
        }
        const pin = atStart ? pts[0] : pts[pts.length - 1];
        const neighbor = atStart ? pts[1] : pts[pts.length - 2];
        const obs = WireAutoRouter.findExcludeObstacleAt(pin, ctx);
        if (obs === null) {
