  private static movxAccDptr(s: Mcu8051State): void {
    const ptr = ((s.regs.get('DPH') ?? 0) << 8) | (s.regs.get('DPL') ?? 0);
    s.regs.set('ACC', Mcu8051Engine.readMem(s, ptr));
