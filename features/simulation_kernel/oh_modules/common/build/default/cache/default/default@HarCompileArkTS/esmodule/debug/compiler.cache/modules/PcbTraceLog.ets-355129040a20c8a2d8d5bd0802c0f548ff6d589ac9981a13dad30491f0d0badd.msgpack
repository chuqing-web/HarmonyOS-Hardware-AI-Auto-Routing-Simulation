    }
    tracePcb3d('VIEW3D_SUMMARY', `topFp=${topFp} bottomFp=${bottomFp} interfâ‰ˆ${interf} ` +
        `fp=${doc.footprints.length} trk=${doc.tracks.length} via=${doc.vias.length} ` +
        `zoneBot=${zoneBot} zoneTop=${zoneTop} ` +
