import { SchematicDocument, ComponentInstance, NetType, Point2D } from '../types/CommonTypes';
import { SchTopology } from '../types/TopologyTypes';
import {
  PcbDocument, PcbFootprintInst, createEmptyPcbDocument, PcbNetRef
