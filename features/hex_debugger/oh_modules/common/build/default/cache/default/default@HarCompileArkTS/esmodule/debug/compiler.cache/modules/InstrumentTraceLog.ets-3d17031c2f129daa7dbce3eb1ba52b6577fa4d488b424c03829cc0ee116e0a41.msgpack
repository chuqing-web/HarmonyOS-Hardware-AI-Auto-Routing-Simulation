  refDes: string;
  nodeA: string;
  nodeB: string;
  ohms: number;
}



/** ä»¿çœŸç½‘è¡¨ç”µé˜»/ç”µæºæ±‡æ€» */
export function traceAnalogNetlistSummary(
  resistors: AnalogResistorStamp[],
  vsrcLines: string[]): void {
  Logger.info(INSTR_TRACE_TAG, `[NETLIST] resistors=${resistors.length} vsrc=${vsrcLines.length}`);
