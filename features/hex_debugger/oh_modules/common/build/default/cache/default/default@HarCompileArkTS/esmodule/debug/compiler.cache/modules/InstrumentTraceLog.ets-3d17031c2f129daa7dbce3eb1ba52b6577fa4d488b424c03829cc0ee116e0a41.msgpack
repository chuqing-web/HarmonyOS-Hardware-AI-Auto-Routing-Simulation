    const fingerprint = `${reason}|${detail}|${netParts.join(',')}|${meterParts.join(';')}`;
    const now = Date.now();
    if (!force) {
        if (fingerprint === lastInstrLiveFingerprint && now - lastInstrLiveMs < 150) {
