{
  "core_name": "cortex_m3",
  "instruction_set": "thumb2",
  "flash_addr_base": "0x08000000",
  "sram_addr_base": "0x20000000",
  "peripheral_list": [
    "GPIOA", "GPIOB", "TIM1", "TIM2", "ADC1", "USART1", "SPI1", "I2C1"
  ],
  "irq_map": {
    "exti0": 6,
    "tim1_up": 25
  },
  "boot_pin_logic": {
    "boot0_0_boot1_0": "flash",
    "boot0_1_boot1_0": "system_memory"
  },
  "uart_virtual_terminal": true
}
